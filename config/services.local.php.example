<?php

/**
 * Custom service configuration override.
 *
 * This file is intended for project-level customization and allows
 * overriding or extending services without modifying core or module code.
 *
 * Typical use cases:
 * - Inject custom configuration into existing services
 * - Replace service arguments
 * - Override service implementations for a specific project
 *
 * This configuration is loaded after core and module service definitions,
 * so it has higher priority.
 *
 * NOTE:
 * This file is intentionally empty by default.
 * Uncomment and adapt examples below when customization is needed.
 */

declare(strict_types=1);

namespace Symfony\Component\DependencyInjection\Loader\Configurator;

return static function (ContainerConfigurator $container): void {
    $services = $container->services();


