<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="data/cache/.phpunit.cache"
         executionOrder="defects,random"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true">
    <!-- Both suites share one process, and with cold caches its peak sits just under the 128M
         most php.ini files default to: the same run would pass on a warm checkout and die in a
         fresh one, which is what CI always is. -->
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Drives real requests through Kernel::handle(), against SQLite in memory built by
             the migrations. Needs no server and no installed site (see FunctionalTestCase). -->
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">system/src</directory>
            <directory suffix=".php">modules/johncms/guestbook/src</directory>
            <directory suffix=".php">modules/johncms/admin/src</directory>
            <directory suffix=".php">modules/johncms/homepage/src</directory>
            <directory suffix=".php">modules/johncms/news/src</directory>
            <directory suffix=".php">modules/johncms/forum/src</directory>
            <directory suffix=".php">modules/johncms/community/src</directory>
            <directory suffix=".php">modules/johncms/collections/src</directory>
        </include>
    </source>
</phpunit>
