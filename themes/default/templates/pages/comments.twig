{#
    The discussion of an object of a module, on a page of its own.

    @var subject    \Johncms\Comments\CommentSubjectDTO
    @var comments   list<\Johncms\Comments\Application\DTO\CommentViewDTO>
    @var total      int
    @var page       int
    @var pagination \Twig\Markup|null
    @var can_write  bool
    @var refusal    string Why the signed-in visitor may not write; empty when they may.
    @var upload_url string
    @var message    string|null
    @var error      string|null
    @var added      int|null
    @var text       string The text to put back into the form after an error.
    @var noindex    bool
#}
{% extends '@theme/layouts/default.twig' %}

{% block meta %}
    {% if noindex %}<meta name="robots" content="noindex,follow">{% endif %}
{% endblock %}

{% block content_class %}site-content--contained{% endblock %}

{# The way back to what is discussed, and how many comments it has. #}
{% block page_subtitle %}
    <p class="site-page-heading__subtitle">
        <a class="site-subject-link" href="{{ subject.url }}" title="{{ subject.title }}">
            {% include '@theme/components/icon.twig' with {name: 'arrow-left', size: 13} only %}
            <span class="site-subject-link__text">{{ subject.title }}</span>
        </a>
        {% include '@theme/components/comments/count.twig' with {subject: subject, total: total} only %}
    </p>
{% endblock %}

{% block content %}
    {% include '@theme/components/comments/discussion.twig' with {
        subject: subject,
        comments: comments,
        total: total,
        page: page,
        pagination: pagination,
        can_write: can_write,
        refusal: refusal,
        upload_url: upload_url,
        message: message,
        error: error,
        added: added,
        text: text,
        answered: answered,
        count_shown: true,
    } only %}
{% endblock %}
