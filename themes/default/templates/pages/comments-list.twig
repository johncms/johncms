{#
    The comments of an object, with the form that adds one.

    @var array            items        Rows prepared by the Comments service.
    @var array            error        Messages of the last attempt, empty when there were none.
    @var \Twig\Markup     message_form Empty when the visitor may not comment.
    @var \Twig\Markup     pagination   Empty when everything fits on one page.
    @var string           back_url
    @var bool             show_origin  Whether the address of an author may be shown.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: error} only %}

    {% if message_form %}
        <div class="mb-3">{{ message_form }}</div>
    {% endif %}

    {% if items is empty %}
        <div class="alert alert-info">{{ d__('system', 'The list is empty') }}</div>
    {% else %}
        {% for item in items %}
            <div class="new_post-item border-bottom shadow mb-2">
                <div class="new_post-header d-flex justify-content-between">
                    <div class="post-user">
                        {% if item.user_profile_link %}
                            <a href="{{ item.user_profile_link }}">
                                <div class="avatar">
                                    <img src="{{ avatar(item.user_id) }}" class="img-fluid" alt=".">
                                </div>
                            </a>
                        {% else %}
                            <div class="avatar">
                                <img src="{{ avatar(item.user_id) }}" class="img-fluid" alt=".">
                            </div>
                        {% endif %}
                        <span class="user-status {{ item.user_is_online ? 'online' : 'offline' }} shadow"></span>
                        {% if item.user_rights_name %}
                            <div class="post-of-user"
                                 data-bs-toggle="tooltip"
                                 data-bs-placement="top"
                                 data-bs-html="true"
                                 title="{{ item.user_rights_name }}">
                                <svg class="icon-post">
                                    <use xlink:href="{{ asset('icons/sprite.svg') }}?4#check"/>
                                </svg>
                            </div>
                        {% endif %}
                    </div>
                    <div class="flex-grow-1 post-user d-flex flex-wrap overflow-hidden d-flex align-items-center">
                        <div class="w-100">
                            {% if item.user_profile_link %}
                                <a href="{{ item.user_profile_link }}">
                                    <div class="user-name d-inline me-2">{{ item.name }}</div>
                                </a>
                            {% else %}
                                <div class="user-name d-inline me-2">{{ item.name }}</div>
                            {% endif %}
                            <span class="post-meta d-inline me-2">{{ item.created }}</span>
                            {% if item.edit_count %}
                                <div class="post-meta d-inline me-2"
                                     data-bs-toggle="tooltip"
                                     data-bs-placement="top"
                                     data-bs-html="true"
                                     title="{{ __('Edited:') }} {{ item.editor_name }} <br> ({{ item.edit_time }}) [{{ item.edit_count }}]">
                                    {{ __('Edited') }}
                                </div>
                            {% endif %}
                        </div>
                        {% if item.status %}
                            <div class="overflow-hidden text-nowrap text-dark-brown overflow-ellipsis small">
                                <span class="fw-bold">{{ item.status }}</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="post-body mt-2 border-top pt-2 pb-2">
                    {{ item.post_text }}
                    {% if item.reply_text %}
                        <div class="alert alert-warning mt-2 mb-n2">
                            <b><a href="{{ item.reply_author_url }}">{{ item.reply_author_name }}</a></b> {{ item.reply_time }}<br>
                            {{ item.reply_text }}
                        </div>
                    {% endif %}
                </div>
                <div class="post-footer d-flex justify-content-between mt-2">
                    <div class="overflow-hidden">
                        {% if show_origin %}
                            <div class="post-meta d-flex">
                                <div class="user-ip me-2">
                                    <a href="{{ item.search_ip_url }}">{{ item.ip }}</a>
                                    {% if item.ip_via_proxy %}
                                        / <a href="{{ item.search_ip_via_proxy_url }}">{{ item.ip_via_proxy }}</a>
                                    {% endif %}
                                </div>
                                <div class="useragent">
                                    <span>{{ item.user_agent }}</span>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                    <div class="d-flex">
                        {% if item.reply_url %}
                            <div class="ms-3">
                                <a href="{{ item.reply_url }}">{{ d__('system', 'Reply') }}</a>
                            </div>
                        {% endif %}
                        {% if item.has_edit %}
                            <div class="dropdown ms-3">
                                <div class="cursor-pointer" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <svg class="icon text-primary">
                                        <use xlink:href="{{ asset('icons/sprite.svg') }}#more_horizontal"/>
                                    </svg>
                                </div>
                                <div class="dropdown-menu dropdown-menu-right">
                                    {% if item.edit_url %}
                                        <a href="{{ item.edit_url }}" class="dropdown-item">{{ d__('system', 'Edit') }}</a>
                                    {% endif %}
                                    {% if item.delete_url %}
                                        <a href="{{ item.delete_url }}" class="dropdown-item">{{ d__('system', 'Delete') }}</a>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}

        {% if pagination %}
            {{ pagination }}
        {% endif %}
    {% endif %}

    {% if back_url %}
        <div class="mt-4">
            <a href="{{ back_url }}">{{ d__('system', 'Back') }}</a>
        </div>
    {% endif %}
{% endblock %}
