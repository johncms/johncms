{#
    Public shell; module content and the existing extension blocks remain server-rendered.

    @var page_title string Heading above the content, omitted when the page owns its heading.

    Block content_class: use site-content--contained for the shared content column;
    add site-content--wide when the page needs more room.

    Block page_subtitle: a line under the heading, e.g. what the page holds.
#}
{% extends '@theme/layouts/base.twig' %}

{% block body %}
    {% set layout_notifications = notifications() %}
    <a class="site-skip-link" href="#site-content">{{ d__('system', 'Skip to content') }}</a>
    <div class="site-shell" id="app">
        <aside class="site-sidebar" id="site-sidebar" tabindex="-1" aria-label="{{ d__('system', 'Menu') }}">
            <div class="site-sidebar__brand">
                {% include '@theme/components/site-brand.twig' only %}
                <button type="button" class="site-sidebar__close" data-site-nav-close aria-label="{{ d__('system', 'Close menu') }}">
                    {% include '@theme/components/icon.twig' with {name: 'x', size: 12} only %}
                </button>
            </div>
            <div class="site-sidebar__body">
                {% block sidebar_user %}
                    {% include '@theme/components/sidebar-user-menu.twig' only %}
                {% endblock %}
                {% block sidebar_menu %}
                    {% include '@theme/components/sidebar-main-menu.twig' only %}
                {% endblock %}
            </div>
            <div class="site-sidebar__foot">
                <a href="/online/" class="site-online">
                    <span class="site-online__dot" aria-hidden="true"></span>
                    <span>{{ d__('system', 'Online') }} <bdi dir="ltr">{{ online() }}</bdi></span>
                </a>
            </div>
        </aside>
        <button type="button" class="site-scrim" data-site-nav-close tabindex="-1" aria-label="{{ d__('system', 'Close menu') }}"></button>
        <div class="site-main">
            {% include '@theme/components/site-topbar.twig' with {notifications: layout_notifications} only %}
            <main class="site-content {% block content_class %}{% endblock %}" id="site-content" tabindex="-1">
                {% include '@theme/components/impersonation-banner.twig' only %}
                {% set layout_page_heading %}
                    {% block breadcrumbs %}
                        {% include '@theme/components/breadcrumbs.twig' only %}
                    {% endblock %}
                    {% if page_title|default('') %}<h1>{{ page_title }}</h1>{% endif %}
                    {% block page_subtitle %}{% endblock %}
                {% endset %}
                {% if layout_page_heading|trim %}<div class="site-page-heading">{{ layout_page_heading }}</div>{% endif %}
                {% set layout_header_ads = ads('content_header') %}
                {% if layout_header_ads %}
                    <div class="site-ads site-ads--content">
                        {% for block in layout_header_ads %}<div>{{ block }}</div>{% endfor %}
                    </div>
                {% endif %}
                {% block content %}{% endblock %}
                {% set layout_footer_ads = ads('content_footer') %}
                {% if layout_footer_ads %}
                    <div class="site-ads site-ads--content">
                        {% for block in layout_footer_ads %}<div>{{ block }}</div>{% endfor %}
                    </div>
                {% endif %}
                <div class="to-top to-top_hidden">
                    <button class="btn btn__top" aria-label="{{ d__('system', 'Scroll page') }}">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18"/>
                        </svg>
                    </button>
                </div>
            </main>
            <div class="site-footer-content">{% block footer_content %}{% endblock %}</div>
            {% include '@theme/components/site-footer.twig' only %}
        </div>
    </div>
    <div class="modal fade ajax_modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document"><div class="modal-content"></div></div>
    </div>
    {% include '@theme/components/site-cookie-consent.twig' only %}
{% endblock %}
