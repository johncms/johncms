{#
    The new password, after a recovery has been completed, plain text.

    @var string user_name
    @var string user_login
    @var string user_password
#}
{% extends '@theme/emails/layout.txt.twig' %}

{% set email_title = __('Password recovery') %}

{% block content %}
{{ __('Hello, %s!', user_name) }}

{{ __('You have changed your password on the <a href="%s">%s</a> website', home_url(), copyright())|striptags }}

{{ __('Your login:') }} {{ user_login }}
{{ __('Your password:') }} {{ user_password }}

{{ __('After logging in, you can change your password to new one.') }}
{% endblock %}
