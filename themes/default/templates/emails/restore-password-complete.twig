{#
    The new password, after a recovery has been completed.

    @var string user_name
    @var string user_login
    @var string user_password
#}
{% extends '@theme/emails/layout.twig' %}

{% set email_title = __('Password recovery') %}

{% block content %}
    {{ __('Hello, %s!', user_name) }}
    <p>
        {{ __('You have changed your password on the <a href="%s">%s</a> website', home_url(), copyright())|raw }}
    </p>
    <p>
        {{ __('Your login:') }} <b>{{ user_login }}</b><br>
        {{ __('Your password:') }} <b>{{ user_password }}</b>
    </p>
    <p>
        {{ __('After logging in, you can change your password to new one.') }}
    </p>
{% endblock %}
