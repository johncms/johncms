{#
    The link that starts a password recovery, plain text.

    @var string user_name
    @var string link_to_restore
#}
{% extends '@theme/emails/layout.txt.twig' %}

{% set email_title = __('Password recovery') %}

{% block content %}
{{ __('Hello, %s!', user_name) }}

{{ __('You start process of password recovery on the <a href="%s">%s</a> website', home_url(), copyright())|striptags }}

{{ __('In order to recover your password, you must click on the link:') }}

{{ link_to_restore }}

{{ __('Link valid for 1 hour') }}

{{ __('If you receive this mail by mistake, just ignore this letter') }}
{% endblock %}
