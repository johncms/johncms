{#
    Notice sent to the old address once a new one is set.

    @var string user_name
    @var string new_email
#}
{% extends '@theme/emails/layout.twig' %}

{% set email_title = __('Changing email address') %}

{% block content %}
    {{ __('Hello, %s!', user_name) }}
    <p>
        {{ __('You have started the process of changing the email address on the <a href="%s">%s</a> website', home_url(), copyright())|raw }}
    </p>
    <p>
        {{ __('The new email address is:') }} <b>{{ new_email }}</b>
    </p>
    <p>
        {{ __('If you have not started the procedure for changing email, please contact us in any way convenient for you.') }}
    </p>
{% endblock %}
