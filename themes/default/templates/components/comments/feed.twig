{#
    The changing part of a discussion: the count, the result of the last action, the comments of
    the page and the pagination. A region of the live list, swapped without reloading the page.

    @var subject    \Johncms\Comments\CommentSubjectDTO
    @var comments   list<\Johncms\Comments\Application\DTO\CommentViewDTO>
    @var total      int
    @var page       int
    @var pagination \Twig\Markup|null
    @var can_write  bool
    @var message    string|null What happened to the last comment.
    @var added      int|null    The comment just added: it shows the result itself, so the message
                                is only read out.
    @var titled     bool        The count is the heading of the discussion within a page about something else.
#}
<div class="site-discussion__region" data-live-list-region="comments">
    <input type="hidden" name="page" value="{{ page }}" form="comment-form-{{ subject.type }}-{{ subject.id }}">
    {% if titled|default(false) %}
        <h2 class="site-discussion__title" tabindex="-1" data-live-list-focus>
            {{ d__('system', 'Comments') }}
            <span class="site-discussion__title-count">{{ total|format_number }}</span>
        </h2>
    {% else %}
        <p class="site-discussion__count" tabindex="-1" data-live-list-focus>
            {{ dn__('system', '%d comment', '%d comments', total)|format(total) }}
        </p>
    {% endif %}
    {% if message %}
        {% include '@theme/components/toast.twig' with {message: message, announce: added is not null} only %}
    {% endif %}
    {% if comments is empty %}
        <div class="site-discussion__empty">{{ d__('system', 'No comments yet. Be the first.') }}</div>
    {% else %}
        <div class="site-discussion__feed">
            {% for comment in comments %}
                {% include '@theme/components/comments/comment.twig' with {
                    comment: comment,
                    subject: subject,
                    page: page,
                    added: comment.id == added,
                    can_reply: can_write,
                } only %}
            {% endfor %}
        </div>
        {% if pagination %}<div class="site-discussion__pagination">{{ pagination }}</div>{% endif %}
    {% endif %}
</div>
