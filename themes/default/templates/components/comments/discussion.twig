{#
    A discussion: its feed and the form to write in it. A live list: its pages are swapped in place
    and the forms are sent without leaving the page, while the editor keeps what is in it. Shown on
    the discussion page of the core, and within the page of a module that shows its discussion
    itself (CommentDiscussionView gives both the variables).

    @var subject    \Johncms\Comments\CommentSubjectDTO
    @var comments   list<\Johncms\Comments\Application\DTO\CommentViewDTO>
    @var total      int
    @var page       int
    @var pagination \Twig\Markup|null
    @var can_write  bool
    @var refusal    string Why the signed-in visitor may not write; empty when they may.
    @var upload_url string
    @var message    string|null
    @var error      string|null
    @var added      int|null
    @var text       string The text to put back into the form after an error.
    @var titled     bool   The discussion has a heading of its own: it is a part of a page about something else.
#}
<section class="site-discussion" id="comments" aria-label="{{ subject.wording.heading }}" data-live-list data-comments>
    {% include '@theme/components/comments/feed.twig' with {
        subject: subject,
        comments: comments,
        total: total,
        page: page,
        pagination: pagination,
        can_write: can_write,
        message: message,
        added: added,
        titled: titled|default(false),
    } only %}

    {% if can_write %}
        <section class="site-compose" id="comment-form" aria-labelledby="comment-form-title">
            <h2 class="visually-hidden" id="comment-form-title">{{ subject.wording.write }}</h2>
            {% include '@theme/components/comments/error.twig' with {error: error} only %}
            <form class="site-compose__form" id="comment-form-{{ subject.type }}-{{ subject.id }}" method="post" action="{{ subject.discussionUrl }}" data-live-list-form data-comment-form>
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                {# The comment the text answers, set by the Reply and Quote buttons; the label says which. #}
                <input type="hidden" name="reply_to" value="" data-comment-reply-field>
                <div class="site-compose__reply" data-comment-reply-label hidden>
                    {% include '@theme/components/icon.twig' with {name: 'reply', size: 14} only %}
                    <span class="site-compose__reply-text">
                        {{ d__('system', 'In answer to:') }}
                        <b class="site-compose__reply-name" data-comment-reply-name></b>
                        <span class="site-compose__reply-excerpt" data-comment-reply-excerpt></span>
                    </span>
                    <button type="button" class="btn-close site-compose__reply-cancel" data-comment-reply-cancel
                            title="{{ d__('system', 'Do not answer this comment') }}" aria-label="{{ d__('system', 'Do not answer this comment') }}"></button>
                </div>
                {% include '@theme/components/editor.twig' with {
                    name: 'text',
                    id: 'comment-text',
                    label: subject.wording.write,
                    label_hidden: true,
                    placeholder: subject.wording.write,
                    value: text,
                    upload_url: upload_url,
                    allow_upload: true,
                    required: true,
                } only %}
                <div class="site-compose__actions">
                    <button type="submit" class="btn btn-primary">
                        {% include '@theme/components/icon.twig' with {name: 'send', size: 14} only %} {{ d__('system', 'Send') }}
                    </button>
                </div>
            </form>
        </section>
    {% elseif refusal %}
        <div class="site-discussion__notice">{{ refusal }}</div>
    {% elseif not app.user.isValid %}
        <div class="site-discussion__notice">
            {# The link to the login page is part of the translated string. #}
            {{ subject.wording.loginNotice|raw }}
        </div>
    {% endif %}
</section>
