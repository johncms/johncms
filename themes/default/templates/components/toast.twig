{#
    The result of an action, shown as a toast at the top of the page. Without the script it stays
    in place as an alert; src/js/toast.js takes it out and shows it as a toast instead, on the page
    as it loads and in a fragment a live list brings in.

    @var message  string
    @var type     string  success, info, warning or error.
    @var announce bool    Only read out to a screen reader, not shown: the page already shows the
                          result, the comment just added for instance.
#}
{% set type = type|default('success') %}
<div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="{{ type == 'error' ? 'alert' : 'status' }}" data-toast="{{ type }}"{% if announce|default(false) %} data-toast-announce{% endif %}>{{ message }}</div>
