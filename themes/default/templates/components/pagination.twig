{#
    The page navigation.

    Item shape (Johncms\Http\Pagination\Pagination):
      {type: prev|page|ellipsis|next, page: int|null, url: string|null, active: bool}

    @param array      items
    @param array|null range {from: int, to: int, total: int}: which records the page shows, said beside the links.
#}
{% if items is not empty %}
    {% if range|default(null) %}
        <div class="site-pagination">
            <p class="site-pagination__range">{{ d__('system', 'Showing %1$s–%2$s of %3$s')|format(range.from|format_number, range.to|format_number, range.total|format_number) }}</p>
    {% endif %}
    <nav>
        <ul class="pagination">
            {% for item in items %}
                {# The arrows are written as entities, so they are literals of the template and
                   the escaper leaves them alone. Single angle quotes mirror themselves in RTL. #}
                {% if item.type == 'prev' %}
                    {% if item.url %}
                        <li class="page-item">
                            <a class="page-link" href="{{ item.url }}" rel="prev" aria-label="{{ d__('system', 'Previous page') }}">&lsaquo;</a>
                        </li>
                    {% else %}
                        <li class="page-item disabled" aria-disabled="true" aria-label="{{ d__('system', 'Previous page') }}">
                            <span class="page-link" aria-hidden="true">&lsaquo;</span>
                        </li>
                    {% endif %}
                {% elseif item.type == 'next' %}
                    {% if item.url %}
                        <li class="page-item">
                            <a class="page-link" href="{{ item.url }}" rel="next" aria-label="{{ d__('system', 'Next page') }}">&rsaquo;</a>
                        </li>
                    {% else %}
                        <li class="page-item disabled" aria-disabled="true" aria-label="{{ d__('system', 'Next page') }}">
                            <span class="page-link" aria-hidden="true">&rsaquo;</span>
                        </li>
                    {% endif %}
                {% elseif item.type == 'ellipsis' %}
                    <li class="page-item disabled" aria-disabled="true"><span class="page-link">&hellip;</span></li>
                {% elseif item.active %}
                    <li class="page-item active" aria-current="page"><span class="page-link">{{ item.page }}</span></li>
                {% else %}
                    <li class="page-item"><a class="page-link" href="{{ item.url }}">{{ item.page }}</a></li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
    {% if range|default(null) %}
        </div>
    {% endif %}
{% endif %}
