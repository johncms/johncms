{# The result of an action from the server: @theme/components/toast.twig. From a script: toast() of src/js/toast.js. #}
<div class="d-flex flex-wrap gap-2">
    <button type="button" class="btn btn-outline-secondary" data-toast-show="success" data-toast-message="{{ d__('system', 'Changes saved successfully.') }}">success</button>
    <button type="button" class="btn btn-outline-secondary" data-toast-show="info" data-toast-message="{{ d__('system', 'This is an informational message.') }}">info</button>
    <button type="button" class="btn btn-outline-secondary" data-toast-show="warning" data-toast-message="{{ d__('system', 'Check the entered data before continuing.') }}">warning</button>
    <button type="button" class="btn btn-outline-secondary" data-toast-show="error" data-toast-message="{{ d__('system', 'Access denied') }}">error</button>
</div>
