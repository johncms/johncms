{# Chips lead to a list, the segmented switch holds a few links of which one is current, the icon button names its action in aria-label. #}
<div class="d-flex flex-wrap align-items-center gap-3">
    <div class="d-flex flex-wrap gap-2">
        <a class="site-chip" href="#buttons">{% include '@theme/components/icon.twig' with {name: 'search', size: 12} only %} {{ d__('system', 'Search') }}</a>
        <a class="site-chip" href="#buttons" aria-current="true">{% include '@theme/components/icon.twig' with {name: 'star', size: 12} only %} {{ d__('system', 'Favorites') }} <span class="site-chip__count">12</span></a>
    </div>
    <div class="site-segmented" role="group" aria-label="{{ d__('system', 'Sorting') }}">
        <a class="site-segmented__item" href="#buttons" aria-current="true">{{ d__('system', 'by time') }}</a>
        <a class="site-segmented__item" href="#buttons">{{ d__('system', 'by name') }}</a>
    </div>
    <div class="d-flex gap-1">
        <button type="button" class="site-icon-button" aria-label="{{ d__('system', 'Edit') }}" title="{{ d__('system', 'Edit') }}">{% include '@theme/components/icon.twig' with {name: 'pencil', size: 13} only %}</button>
        <button type="button" class="site-icon-button site-icon-button--danger" aria-label="{{ d__('system', 'Delete') }}" title="{{ d__('system', 'Delete') }}">{% include '@theme/components/icon.twig' with {name: 'trash-2', size: 13} only %}</button>
        <button type="button" class="site-icon-button" aria-label="{{ d__('system', 'Up') }}" title="{{ d__('system', 'Up') }}" disabled>{% include '@theme/components/icon.twig' with {name: 'chevron-up', size: 13} only %}</button>
    </div>
</div>
