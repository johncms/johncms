{# The items come from Johncms\Http\Pagination\Pagination; a controller hands them over as they are. #}
{# A list keeps the bottom margin of a list; inside a block that gives the spacing it is removed. #}
<div class="pagination-no-padding">
    {% include '@theme/components/pagination.twig' with {items: [
        {type: 'prev', page: null, url: null, active: false},
        {type: 'page', page: 1, url: null, active: true},
        {type: 'page', page: 2, url: '#pagination', active: false},
        {type: 'page', page: 3, url: '#pagination', active: false},
        {type: 'ellipsis', page: null, url: null, active: false},
        {type: 'page', page: 12, url: '#pagination', active: false},
        {type: 'next', page: 2, url: '#pagination', active: false},
    ]} only %}
</div>
{# A long list says which records the page shows: $pagination->render(withRange: true). #}
<div class="pagination-no-padding mt-3">
    {% include '@theme/components/pagination.twig' with {items: [
        {type: 'prev', page: 1, url: '#pagination', active: false},
        {type: 'page', page: 1, url: '#pagination', active: false},
        {type: 'page', page: 2, url: null, active: true},
        {type: 'page', page: 3, url: '#pagination', active: false},
        {type: 'next', page: 3, url: '#pagination', active: false},
    ], range: {from: 21, to: 40, total: 55}} only %}
</div>
