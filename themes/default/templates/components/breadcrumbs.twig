{# The navigation chain of the page, as the controllers have built it. #}
{% set items = breadcrumbs() %}
{% if items %}
    <nav class="site-breadcrumbs" aria-label="breadcrumb">
        <ol class="breadcrumb" vocab="https://schema.org/" typeof="BreadcrumbList">
            {% for key, item in items %}
                {% set name = item.name|default('') %}
                <li class="breadcrumb-item {{ item.active|default(false) ? 'active' }}" property="itemListElement" typeof="ListItem">
                    {% if item.url|default('') and not item.active|default(false) %}
                        <a property="item" typeof="WebPage" href="{{ item.url }}" title="{{ name }}">
                            <span property="name">{{ name }}</span>
                        </a>
                    {% else %}
                        <span property="name"{% if item.active|default(false) %} aria-current="page"{% endif %}>{{ name }}</span>
                    {% endif %}
                    <meta property="position" content="{{ key + 1 }}">
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
