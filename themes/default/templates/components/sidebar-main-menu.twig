{# Real module menus; images and icons from external modules keep their existing contract. #}
{% set before_menu_ads = ads('before_menu') %}
{% set after_menu_ads = ads('after_menu') %}
{% set staff_items = menu_items('staff') %}
{% if before_menu_ads %}
    <div class="site-ads site-ads--sidebar">
        {% for block in before_menu_ads %}<div>{{ block }}</div>{% endfor %}
    </div>
{% endif %}
<nav class="site-nav" aria-label="{{ d__('system', 'Menu') }}">
    <a class="site-nav__home" href="/"{% if app.is_home_page %} aria-current="page"{% endif %}>
        {% include '@theme/components/icon.twig' with {name: 'house', size: 18} only %}
        <span>{{ d__('system', 'Home') }}</span>
    </a>
    <ul class="site-nav__list" data-site-menu="main">
        {% for item in menu_items('main') %}
            {% set badge = item.badge %}
            <li>
                <a href="{{ item.url }}">
                    {% if item.icon %}
                        {% include '@theme/components/icon.twig' with {name: item.icon, image: item.hasImageIcon, size: 18} only %}
                    {% endif %}
                    <span>{{ item.title }}</span>
                    {% if badge > 0 %}<span class="site-nav__badge badge" dir="ltr">+{{ badge|format_number }}</span>{% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>
    {% if staff_items %}
        <ul class="site-nav__list site-nav__list--staff" data-site-menu="staff">
            {% for item in staff_items %}
                {% set badge = item.badge %}
                <li>
                    <a href="{{ item.url }}">
                        {% if item.icon %}
                            {% include '@theme/components/icon.twig' with {name: item.icon, image: item.hasImageIcon, size: 18} only %}
                        {% endif %}
                        <span>{{ item.title }}</span>
                        {% if badge > 0 %}<span class="site-nav__badge badge" dir="ltr">+{{ badge|format_number }}</span>{% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</nav>
{% if after_menu_ads %}
    <div class="site-ads site-ads--sidebar">
        {% for block in after_menu_ads %}<div>{{ block }}</div>{% endfor %}
    </div>
{% endif %}
