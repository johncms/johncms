{# The main menu of the site — the sections the modules declare, each with what is new in it — and the sidebar footer. #}
{% set before_menu_ads = ads('before_menu') %}
{% set after_menu_ads = ads('after_menu') %}
{% set languages = config('johncms.lng_list')|default({}) %}
{% set theme_toggle_title = app.dark_scheme ? d__('system', 'Set Light Theme') : d__('system', 'Set Dark Theme') %}
{% set icon_sprite = asset('icons/sprite.svg', true) %}
<div class="flex-grow-1">
    {% if before_menu_ads %}
        <div class="ps-4 pe-3 pt-3">
            {% for block in before_menu_ads %}
                <div>{{ block }}</div>
            {% endfor %}
        </div>
    {% endif %}
    <ul class="nav nav__vertical">
        {# The sections of the site. A module has no business editing a theme, so it declares a
           MenuItem and this draws it; items the visitor may not open never get here. #}
        {% for item in menu_items('main') %}
            {% set badge = item.badge %}
            <li>
                <a href="{{ item.url }}">
                    {% if item.icon %}
                        {% if item.hasImageIcon %}
                            <img class="icon" src="{{ item.icon }}" alt="">
                        {% else %}
                            <svg class="icon">
                                <use xlink:href="{{ asset('icons/sprite.svg') }}#{{ item.icon }}"/>
                            </svg>
                        {% endif %}
                    {% endif %}
                    <span class="flex-grow-1">{{ item.title }}</span>
                    {% if badge > 0 %}
                        <span class="badge rounded-pill bg-danger">+ {{ badge|format_number }}</span>
                    {% endif %}
                </a>
            </li>
        {% endfor %}

        {# The part of the staff, drawn apart below a line. #}
        {% for item in menu_items('staff') %}
            {% set badge = item.badge %}
            <li>
                {% if loop.first %}
                    <div class="border-bottom mt-3 mb-3"></div>
                {% endif %}
                <a href="{{ item.url }}">
                    {% if item.icon %}
                        {% if item.hasImageIcon %}
                            <img class="icon" src="{{ item.icon }}" alt="">
                        {% else %}
                            <svg class="icon text-danger">
                                <use xlink:href="{{ asset('icons/sprite.svg') }}#{{ item.icon }}"/>
                            </svg>
                        {% endif %}
                    {% endif %}
                    <span class="flex-grow-1 text-danger">{{ item.title }}</span>
                    {% if badge > 0 %}
                        <span class="badge rounded-pill bg-danger">{{ badge|format_number }}</span>
                    {% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>
    <div class="border-bottom"></div>
</div>
<div class="sidebar__footer">
    {% if after_menu_ads %}
        <div class="pe-3 pt-2 mb-2">
            {% for block in after_menu_ads %}
                <div>{{ block }}</div>
            {% endfor %}
        </div>
    {% endif %}
    <div>
        <a href="/online/">
            <svg class="icon sidebar_online">
                <use xlink:href="{{ asset('icons/sprite.svg') }}#user"/>
            </svg>
            {{ online() }}
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        {% if languages|length > 1 %}
            <div class="mt-1">
                <button class="btn btn-link ps-0" data-url="/language/" data-bs-toggle="modal" data-bs-target=".ajax_modal">
                    <img class="icon icon-flag" src="{{ asset('images/flags/' ~ app.locale|lower ~ '.svg') }}" alt="{{ app.locale }}">
                    {{ languages[app.locale].name|default(app.locale) }}
                </button>
            </div>
        {% endif %}
        <div>
            <button
                type="button"
                class="btn btn-link p-0"
                data-theme-toggle
                data-current-theme="{{ app.color_scheme }}"
                data-icon-sprite="{{ icon_sprite }}"
                data-title-dark="{{ d__('system', 'Set Dark Theme') }}"
                data-title-light="{{ d__('system', 'Set Light Theme') }}"
                title="{{ theme_toggle_title }}"
                aria-label="{{ theme_toggle_title }}"
            >
                <svg class="icon">
                    <use xlink:href="{{ icon_sprite }}#{{ app.dark_scheme ? 'sun' : 'moon' }}"/>
                </svg>
            </button>
        </div>
    </div>

</div>
