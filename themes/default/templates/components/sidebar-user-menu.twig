{# @var notifications array Unread counters from notifications(); guest model access is guarded. #}
{% set unread = notifications.all|default(0) %}
{% if app.user.isValid %}
    <details class="site-user">
        <summary class="site-user__summary">
            <img class="site-avatar" src="{{ avatar(app.user.id) }}" alt="" width="32" height="32">
            <span class="site-user__name">{{ app.user.name }}</span>
            {% if unread %}<span class="site-nav__badge">{{ unread|format_number }}</span>{% endif %}
            {% include '@theme/components/icon.twig' with {name: 'chevron-down', size: 14} only %}
        </summary>
        <nav class="site-user__links" aria-label="{{ d__('system', 'Personal') }}">
            <a href="/profile/account">
                {% include '@theme/components/icon.twig' with {name: 'user'} only %}
                <span>{{ d__('system', 'Personal') }}</span>
            </a>
            <a href="/notifications/">
                {% include '@theme/components/icon.twig' with {name: 'bell'} only %}
                <span>{{ d__('system', 'Notifications') }}</span>
                {% if unread %}<span class="site-nav__badge">{{ unread|format_number }}</span>{% endif %}
            </a>
            <a href="/logout">
                {% include '@theme/components/icon.twig' with {name: 'log-out'} only %}
                <span>{{ d__('system', 'Exit') }}</span>
            </a>
        </nav>
    </details>
{% else %}
    <div class="site-user site-user--guest">
        <a class="site-user__summary" href="/login/">
            {% include '@theme/components/icon.twig' with {name: 'log-in', size: 20} only %}
            <span>{{ d__('system', 'Log In') }}</span>
            {% include '@theme/components/icon.twig' with {name: 'chevron-right', size: 14, class: 'site-icon--directional'} only %}
        </a>
        <a class="site-user__register" href="/registration/">{{ d__('system', 'Registration') }}</a>
    </div>
{% endif %}
