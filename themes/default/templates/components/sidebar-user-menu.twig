{# The account of a signed-in user lives in the topbar; the sidebar invites a guest to sign in. #}
{% if not app.user.isValid %}
    <div class="site-user site-user--guest">
        <a class="site-user__summary" href="/login/">
            {% include '@theme/components/icon.twig' with {name: 'log-in', size: 14} only %}
            <span class="site-user__name">{{ d__('system', 'Log In') }}</span>
            {% include '@theme/components/icon.twig' with {name: 'chevron-right', size: 14, class: 'site-icon--directional'} only %}
        </a>
        <a class="site-user__register" href="/registration/">{{ d__('system', 'Registration') }}</a>
    </div>
{% endif %}
