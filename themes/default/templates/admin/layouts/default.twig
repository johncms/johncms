{#
    The layout of the admin panel: the sidebar with the menu, the top bar, the head of the page and
    a footer.

    The sidebar folds to its icons on a wide screen and opens over the page on a narrow one; both
    are driven by src/admin/js/shell.js.

    @var string page_title Heading printed in the head of the page.

    A page may fill two more blocks of the head: page_actions, the buttons next to the heading
    (the main action of the page), and page_tabs, the tabs under it.
#}
{% extends '@admin/layouts/base.twig' %}

{% block body %}
    {% set layout_notifications = notifications() %}
    <div class="admin-shell">
        <div class="admin-shell__scrim" data-admin-nav-close></div>

        <aside class="admin-sidebar" id="admin-sidebar">
            <a class="admin-sidebar__brand" href="/admin/">
                <span class="admin-sidebar__brand-mark">J</span>
                <span class="admin-sidebar__brand-text">
                    <span class="admin-sidebar__brand-name">JohnCMS</span>
                    <span class="admin-sidebar__brand-sub">{{ d__('admin', 'Admin Panel') }}</span>
                </span>
            </a>

            <nav class="admin-sidebar__nav" aria-label="{{ d__('admin', 'Admin Panel') }}">
                {% block sidebar_menu %}
                    {% include '@admin/components/sidebar-admin-menu.twig' with {
                        usr_menu: usr_menu|default({}),
                        module_menu: module_menu|default({}),
                        sys_menu: sys_menu|default({})
                    } only %}
                {% endblock %}
            </nav>

            <div class="admin-sidebar__foot">
                <a class="admin-sidebar__foot-btn" href="/online/" data-tip="{{ d__('admin', 'Online') }}">
                    {% include '@admin/components/ui/icon.twig' with {name: 'users', class: 'admin-sidebar__foot-icon'} only %}
                    <span class="admin-sidebar__foot-label">{{ d__('admin', 'Online') }}: {{ online() }}</span>
                </a>
                <a class="admin-sidebar__foot-btn" href="/" data-tip="{{ d__('admin', 'Back to the site') }}">
                    {% include '@admin/components/ui/icon.twig' with {name: 'arrow-left', class: 'admin-sidebar__foot-icon'} only %}
                    <span class="admin-sidebar__foot-label">{{ d__('admin', 'Back to the site') }}</span>
                </a>
                <button type="button" class="admin-sidebar__foot-btn admin-sidebar__fold" data-admin-sidebar-fold
                        data-tip="{{ d__('admin', 'Expand the menu') }}" aria-controls="admin-sidebar">
                    {% include '@admin/components/ui/icon.twig' with {name: 'panel-left-close', class: 'admin-sidebar__foot-icon admin-sidebar__fold-close'} only %}
                    {% include '@admin/components/ui/icon.twig' with {name: 'panel-left-open', class: 'admin-sidebar__foot-icon admin-sidebar__fold-open'} only %}
                    <span class="admin-sidebar__foot-label">{{ d__('admin', 'Collapse the menu') }}</span>
                </button>
            </div>
        </aside>

        <div class="admin-main">
            {% include '@admin/components/topbar.twig' with {notifications: layout_notifications} only %}

            <main class="admin-page">
                {% include '@admin/components/pending-migrations.twig' only %}
                <div class="admin-page__head">
                    {% block breadcrumbs %}
                        {% include '@theme/components/breadcrumbs.twig' only %}
                    {% endblock %}
                    <div class="admin-page__title-row">
                        {% if page_title|default('') %}
                            <h1 class="admin-page__title">{{ page_title }}</h1>
                        {% endif %}
                        <div class="admin-page__actions">{%- block page_actions -%}{%- endblock -%}</div>
                    </div>
                    {% block page_tabs %}{% endblock %}
                </div>

                {% block content %}{% endblock %}
                {% block footer_content %}{% endblock %}
            </main>

            <footer class="admin-footer">
                <div>&copy; {{ 'now'|date('Y') }}, <a href="https://johncms.com" target="_blank" rel="nofollow">JohnCMS</a></div>
                {% set layout_analytics = analytics() %}
                {% if layout_analytics %}
                    <div class="admin-footer__counters">
                        {% for counter in layout_analytics %}
                            <div>{{ counter }}</div>
                        {% endfor %}
                    </div>
                {% endif %}
                {% include '@theme/components/debug.twig' with {trigger_class: 'admin-footer__debug', trigger_style: ''} only %}
            </footer>
        </div>
    </div>
    {# The modal the dialogs of the panel open in: see components/ui/dialog.twig. #}
    <div class="modal fade" id="admin-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"></div>
        <template data-admin-modal-loading>
            <div class="modal-content">
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-body-tertiary" role="status">
                        <span class="visually-hidden">{{ d__('admin', 'Loading') }}</span>
                    </div>
                </div>
            </div>
        </template>
    </div>
    <div class="modal fade ajax_modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content"></div>
        </div>
    </div>
{% endblock %}
