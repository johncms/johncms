{#
    The document every page of the admin panel is built on: the head, the color scheme and the
    scripts that belong to every page, with no chrome around the content.

    The panel has a base of its own rather than extending the one of the public site: it loads its
    own bundle, carries only the icon it needs, and titles its pages the way a panel does — the
    name of the site is not appended to them.

    @var string title       Page title.
    @var string keywords    Meta keywords.
    @var string description Meta description.
    @var string canonical   Canonical URL of the page.
#}
{#
    Everything the layout keeps for itself is prefixed: a {% set %} here stays in the context the
    blocks of the page are rendered in, so an unprefixed name would silently shadow a variable of
    the page that happens to be called the same.
#}
{% set layout_document_title = title|default('') ?: config('johncms.copyright') %}
<!DOCTYPE html>
<html lang="{{ app.locale }}" dir="{{ app.locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=2.0">
    <meta name="HandheldFriendly" content="true">
    <meta name="MobileOptimized" content="width">
    <meta content="yes" name="apple-mobile-web-app-capable">
    <meta name="Generator" content="JohnCMS, https://johncms.com">
    {% block meta %}{% endblock %}
    {% if keywords|default('') %}
        <meta name="keywords" content="{{ keywords }}">
    {% endif %}
    {% if description|default('') %}
        <meta name="description" content="{{ description }}">
    {% endif %}
    {% if canonical|default('') %}
        <link rel="canonical" href="{{ canonical }}">
    {% endif %}
    <meta name="theme-color" content="#586776">
    {% block vite %}{{ vite('admin', app.locale == 'ar') }}{% endblock %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,400i,700,700i&display=swap">
    <link rel="shortcut icon" href="{{ asset('images/favicon.ico') }}">
    {% block styles %}{% endblock %}
    <title>{% block title %}{{ layout_document_title }}{% endblock %}</title>
</head>
<body class="{% block body_class %}{{ app.color_scheme }}{% endblock %}">
{% block body %}{% endblock %}
{% block scripts %}
    {% if app.locale != 'en' and asset_exists('js/flatpickr/' ~ app.locale ~ '.js') %}
        {# The bundle is a deferred module, so the locale has to wait for it to define flatpickr. #}
        <script src="{{ asset('js/flatpickr/' ~ app.locale ~ '.js') }}" defer></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                flatpickr.localize(flatpickr.l10ns.{{ app.locale }});
            });
        </script>
    {% endif %}
{% endblock %}
</body>
</html>
