{#
    The menu of the admin panel: its sections one under another, each a list of links.

    The item of the page being looked at is marked. A page names it by the key of the item in the
    array of its section: 'sys_menu': {'settings': true}. The counters come from admin_counters(),
    so a page that hides the sidebar runs no query.

    @var array usr_menu    The key of the active item of the "Users" section.
    @var array module_menu The same for the "Modules" section.
    @var array sys_menu    The same for the "System" section.
#}
{% set counters = admin_counters() %}
{% set can_manage_site = can('admin.settings.manage') %}

{# What the installed modules add. A module has no business editing a theme, so it declares a
   MenuItem and this draws it; items the visitor may not open never get here. Its icon is a name
   in the sprite of the panel (Lucide) or the address of an image. #}
{% set module_items = [] %}
{% for item in menu_items('admin') %}
    {% set module_items = module_items|merge([{
        url: item.url,
        icon: item.icon,
        image: item.hasImageIcon,
        title: item.title,
        count: item.badge,
        tone: 'accent',
    }]) %}
{% endfor %}

{# The number on the users is the accounts waiting for approval: the list holds them too. #}
{% set sections = [
    {
        title: d__('admin', 'Users'),
        active: usr_menu,
        items: [
            {key: 'search_ip', url: '/admin/ip-search', icon: 'search', title: d__('admin', 'Search')},
            {key: 'ip_whois', url: '/admin/ip-whois', icon: 'network', title: d__('admin', 'IP Whois')},
            {key: 'userlist', url: '/admin/users', icon: 'users', title: d__('admin', 'Users'), count: counters.registrations, tone: 'danger'},
            {key: 'roles', url: '/admin/roles', icon: 'key-round', title: d__('admin', 'Roles'), shown: can('admin.roles.manage')},
            {key: 'auth_log', url: '/admin/auth-log', icon: 'history', title: d__('admin', 'Sign-in log'), shown: can('admin.auth_log.view')},
            {key: 'ban_panel', url: '/admin/bans', icon: 'ban', title: d__('admin', 'Ban Panel'), count: counters.bans},
            {key: 'usr_clean', url: '/admin/users/cleanup', icon: 'database', title: d__('admin', 'Database cleanup'), shown: can_manage_site},
            {key: 'antiflood', url: '/admin/antiflood', icon: 'gauge', title: d__('admin', 'Antiflood'), shown: can_manage_site},
            {key: 'karma', url: '/admin/karma', icon: 'thumbs-up', title: d__('admin', 'Karma'), shown: can_manage_site},
        ],
    },
    {
        title: d__('admin', 'Modules'),
        active: module_menu,
        items: [
            {key: 'forum', url: '/admin/forum', icon: 'messages-square', title: d__('admin', 'Forum')},
            {key: 'news', url: '/admin/news/', icon: 'newspaper', title: d__('admin', 'News')},
            {key: 'collections', url: '/admin/collections', icon: 'layout-grid', title: d__('admin', 'Collections')},
            {key: 'ads', url: '/admin/ads', icon: 'megaphone', title: d__('admin', 'Advertisement')},
            {key: 'consents', url: '/admin/consents', icon: 'clipboard-check', title: d__('admin', 'Consents')},
            {key: 'contacts', url: '/admin/contacts', icon: 'inbox', title: d__('admin', 'Contacts')},
            {key: 'cookie_banner', url: '/admin/cookie-banner', icon: 'cookie', title: d__('admin', 'Cookie banner')},
            {key: 'counters', url: '/admin/counters', icon: 'chart-column', title: d__('admin', 'Counters'), shown: can_manage_site},
            {key: 'modules', url: '/admin/modules', icon: 'puzzle', title: d__('admin', 'Manage modules'), shown: can('system.modules.manage')},
        ]|merge(module_items),
    },
    {
        title: d__('admin', 'System'),
        active: sys_menu,
        items: [
            {key: 'settings', url: '/admin/settings', icon: 'settings', title: d__('admin', 'Settings')},
            {key: 'emoticons', url: '/admin/emoticons', icon: 'smile', title: d__('admin', 'Smilies')},
            {key: 'languages', url: '/admin/languages', icon: 'languages', title: d__('admin', 'Language Settings')},
            {key: 'system_check', url: '/admin/system_check/', icon: 'stethoscope', title: d__('admin', 'System check')},
            {key: 'maintenance', url: '/admin/maintenance', icon: 'wrench', title: d__('admin', 'Maintenance')},
            {key: 'style_guide', url: '/admin/style-guide', icon: 'palette', title: d__('admin', 'Style guide')},
        ],
    },
] %}

{% for section in sections %}
    {% set items = section.items|filter(item => item.shown ?? true) %}
    {% if items is not empty %}
        <div class="admin-nav__section">{{ section.title }}</div>
        {% for item in items %}
            {% set active = (item.key ?? false) and (attribute(section.active, item.key) ?? false) %}
            {% set tone = item.tone ?? '' %}
            {% set count = item.count ?? 0 %}
            <a href="{{ item.url }}"
               class="admin-nav__item{{ active ? ' admin-nav__item--active' }}{{ count and tone ? ' admin-nav__item--' ~ tone }}"
               data-tip="{{ item.title }}"
               {%- if active %} aria-current="page"{% endif %}>
                <span class="admin-nav__icon">
                    {% if item.image ?? false %}
                        <img src="{{ item.icon }}" width="16" height="16" alt="">
                    {% elseif item.icon %}
                        {% include '@admin/components/ui/icon.twig' with {name: item.icon} only %}
                    {% endif %}
                </span>
                <span class="admin-nav__label">{{ item.title }}</span>
                {% if count %}
                    <span class="admin-nav__count{{ tone ? ' admin-nav__count--' ~ tone }}">{{ count|format_number }}</span>
                {% endif %}
            </a>
        {% endfor %}
    {% endif %}
{% endfor %}
