{#
    A dialog shown as a page: what a link with data-admin-modal leads to when the script is not
    there to open it in the modal. The page extends the layout and puts this in its content.

    @param string dialog The template of the dialog, the one the controller answers the script with.
    @param array  data   What that template is given.
#}
<div class="modal admin-dialog-page" tabindex="-1">
    <div class="modal-dialog">
        {% include dialog with data only %}
    </div>
</div>
