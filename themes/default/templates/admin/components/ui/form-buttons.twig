{#
    The buttons that finish a form: a link back and the button that saves. The form is named by
    its id, so the buttons work outside it — in the head of the page and under the form alike.

    @param string form         The id of the form; empty for a form with nothing to save.
    @param string cancel_url   Where the link back leads; empty for no link.
    @param string cancel_title Cancel by default.
    @param string submit_title Save by default.
#}
{% if cancel_url|default('') %}
    <a class="btn btn-outline-secondary" href="{{ cancel_url }}">{{ cancel_title|default(d__('admin', 'Cancel')) }}</a>
{% endif %}
{% if form|default('') %}
    <button type="submit" class="btn btn-primary" form="{{ form }}">
        {% include '@admin/components/ui/icon.twig' with {name: 'save', size: 14} only %}
        {{ submit_title|default(d__('admin', 'Save')) }}
    </button>
{% endif %}
