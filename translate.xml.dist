<?xml version="1.0"?>
<scanRuleset>
    <description>JohnCMS ruleset for PHP code scanner for gettext</description>

    <!-- System -->
    <domain>
        <name>system</name>
        <target>system/locale</target>
        <sourceDir>modules/johncms/language</sourceDir>
        <sourceDir>modules/johncms/login</sourceDir>
        <sourceDir>modules/johncms/notifications</sourceDir>
        <sourceDir>modules/johncms/redirect</sourceDir>
        <sourceDir>system/src</sourceDir>
        <sourceDir>themes/default/templates</sourceDir>
        <sourceFile>system/helpers.php</sourceFile>
        <sourceFile>system/bootstrap.php</sourceFile>
        <sourceFile>config/places.global.php</sourceFile>
        <sourceFile>config/notifications.global.php</sourceFile>
    </domain>

    <!-- Admin module -->
    <domain>
        <name>admin</name>
        <target>modules/johncms/admin/locale</target>
        <sourceDir>modules/johncms/admin</sourceDir>
    </domain>

    <!-- Album module -->
    <domain>
        <name>album</name>
        <target>modules/johncms/album/locale</target>
        <sourceDir>modules/johncms/album</sourceDir>
    </domain>

    <!-- Collections module -->
    <domain>
        <name>collections</name>
        <target>modules/johncms/collections/locale</target>
        <sourceDir>modules/johncms/collections</sourceDir>
    </domain>

    <!-- Community module -->
    <domain>
        <name>community</name>
        <target>modules/johncms/community/locale</target>
        <sourceDir>modules/johncms/community</sourceDir>
    </domain>

    <!-- Downloads module -->
    <domain>
        <name>consent</name>
        <target>modules/johncms/consent/locale</target>
        <sourceDir>modules/johncms/consent</sourceDir>
    </domain>

    <!-- Contacts module -->
    <domain>
        <name>contacts</name>
        <target>modules/johncms/contacts/locale</target>
        <sourceDir>modules/johncms/contacts</sourceDir>
    </domain>

    <domain>
        <name>downloads</name>
        <target>modules/johncms/downloads/locale</target>
        <sourceDir>modules/johncms/downloads</sourceDir>
    </domain>

    <!-- Forum module -->
    <domain>
        <name>forum</name>
        <target>modules/johncms/forum/locale</target>
        <sourceDir>modules/johncms/forum</sourceDir>
    </domain>

    <!-- Guestbook module -->
    <domain>
        <name>guestbook</name>
        <target>modules/johncms/guestbook/locale</target>
        <sourceDir>modules/johncms/guestbook</sourceDir>
    </domain>

    <!-- Help module -->
    <domain>
        <name>help</name>
        <target>modules/johncms/help/locale</target>
        <sourceDir>modules/johncms/help</sourceDir>
    </domain>

    <!-- Homepage module -->
    <domain>
        <name>homepage</name>
        <target>modules/johncms/homepage/locale</target>
        <sourceDir>modules/johncms/homepage</sourceDir>
    </domain>

    <!-- Library module -->
    <domain>
        <name>library</name>
        <target>modules/johncms/library/locale</target>
        <sourceDir>modules/johncms/library</sourceDir>
    </domain>

    <!-- Mail module -->
    <domain>
        <name>mail</name>
        <target>modules/johncms/mail/locale</target>
        <sourceDir>modules/johncms/mail</sourceDir>
    </domain>

    <!-- News module -->
    <domain>
        <name>news</name>
        <target>modules/johncms/news/locale</target>
        <sourceDir>modules/johncms/news</sourceDir>
    </domain>

    <!-- Online module -->
    <domain>
        <name>online</name>
        <target>modules/johncms/online/locale</target>
        <sourceDir>modules/johncms/online</sourceDir>
    </domain>

    <!-- Profile module -->
    <domain>
        <name>profile</name>
        <target>modules/johncms/profile/locale</target>
        <sourceDir>modules/johncms/profile</sourceDir>
    </domain>

    <!-- Registration module -->
    <domain>
        <name>registration</name>
        <target>modules/johncms/registration/locale</target>
        <sourceDir>modules/johncms/registration</sourceDir>
    </domain>

    <!-- Notifications module -->
    <domain>
        <name>notifications</name>
        <target>modules/johncms/notifications/locale</target>
        <sourceDir>modules/johncms/notifications</sourceDir>
    </domain>

    <!-- Installation -->
    <domain>
        <name>install</name>
        <target>public/install/locale</target>
        <sourceDir>public/install</sourceDir>
    </domain>
</scanRuleset>
