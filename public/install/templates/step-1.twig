{#
    Step one: the language of the installation.

    @var array  data   lng_list, keyed by language code.
    @var string locale
#}
{% extends '@install/layout.twig' %}

{% block content %}
    <h4 class="mb-3">{{ __('Welcome to JohnCMS installation wizard') }}</h4>

    <p>
        {{ __('During the installation process, a basic check of the hosting will be performed for compliance with the CMS requirements.') }} <br>
        {{ __('If errors occurred during the installation stage and you do not know how to solve them, you can ask for help on <a href="https://johncms.com/forum/" class="text-underline" rel="nofollow" target="_blank">our forum.</a>')|raw }}
    </p>

    <h4 class="mb-3">{{ __('Choose language') }}</h4>

    <form action="/install/?step=2" method="post" class="mb-3">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-3">
            {% for key, language in data.lng_list %}
                <div class="col">
                    <div class="form-check mb-2">
                        <input type="radio" id="lang_{{ key }}" name="lang" class="form-check-input" value="{{ key }}"{% if key == locale %} checked="checked"{% endif %}>
                        <label class="form-check-label" for="lang_{{ key }}">
                            <img src="{{ asset('images/flags/' ~ key|lower ~ '.svg') }}" class="icon icon-flag" alt=".">
                            {{ language.name }}
                        </label>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="mt-3">
            <button type="submit" name="submit" value="submit" class="btn btn-primary">{{ __('Continue') }}</button>
        </div>
    </form>
{% endblock %}

{% block scripts %}
    {# No jQuery here: the bundle is a module script and so runs after this one. #}
    <script>
        document.addEventListener('change', function (event) {
            if (event.target.matches('input[name=lang]')) {
                document.location.href = '/install/?set_locale=' + encodeURIComponent(event.target.value);
            }
        });
    </script>
{% endblock %}
