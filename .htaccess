# The document root of JohnCMS is the public/ directory.
#
# This file is only a fallback for shared hosting where the document root
# cannot be changed. It forwards every request into public/ and denies access
# to the application code. If you can point the document root at public/,
# do that instead: it keeps the code out of the web tree entirely.

Options -Indexes

RedirectMatch 403 ^/(config|data|modules|system|tests|vendor)/
RedirectMatch 403 ^/themes/[^/]+/(src|templates)/

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Loop guard. Matched against the per-directory URI, which has no leading
    # slash and no directory prefix, so an installation in a subdirectory works.
    RewriteRule ^public/ - [L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
