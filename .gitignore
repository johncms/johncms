# Common ignores
/.idea
/.claude
/config/autoload/*.local.php
/config/*.local.php
/dist
/distributive
/node_modules
/phpcs.xml
/translate.xml
/vendor
.env
docker-compose.override.yml

# Data folder ignores
/data/cache/*
!/data/cache/.gitkeep
/data/logs/*
!/data/logs/.gitkeep
/data/admin_tasks/

# Vite dev server marker, written while "npm run dev" is running
/public/hot

# Upload folder ignores
/public/upload/downloads/files/*
!/public/upload/downloads/files/index.php
/public/upload/downloads/screen/*
!/public/upload/downloads/screen/index.php
/public/upload/forum/attach/*
!/public/upload/forum/attach/index.php
/public/upload/forum/topics/*
!/public/upload/forum/topics/index.php
/public/upload/mail/*
!/public/upload/mail/index.php
/public/upload/users/album/*
!/public/upload/users/album/index.php
/public/upload/users/avatar/*
!/public/upload/users/avatar/index.php
/public/upload/users/photo/*
!/public/upload/users/photo/index.php
/public/upload/library/tmp/*
!/public/upload/library/tmp/.gitkeep
/public/upload/library/images/big/*
!/public/upload/library/images/big/.gitkeep
/public/upload/library/images/orig/*
!/public/upload/library/images/orig/.gitkeep
/public/upload/library/images/small/*
!/public/upload/library/images/small/.gitkeep
/public/upload/forum_files/*

# Generated sitemap files
/public/sitemap.xml
/public/sitemap-*.xml

# Codex runtime marker
.codex
