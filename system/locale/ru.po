#: system/src/Validator/messages.php:51
msgid "The input is not a valid email address. Use the basic format local-part@hostname"
msgstr "Введен неверный адрес электронной почты. Используйте базовый формат local-part@hostname"

#: system/src/Validator/messages.php:52
#, php-format
msgid "'%hostname%' is not a valid hostname for the email address"
msgstr "'%hostname%' не является допустимым хостом для адреса электронной почты"

#: system/src/Validator/messages.php:53
#, php-format
msgid "'%hostname%' does not appear to have any valid MX or A records for the email address"
msgstr "'%hostname%' Похоже, что записи MX или A для адреса электронной почты не действительны"

#: system/src/Validator/messages.php:54
#, php-format
msgid "'%hostname%' is not in a routable network segment. The email address should not be resolved from public network"
msgstr "'%hostname%' не находится в маршрутизируемой сети. Адрес электронной почты не должен быть разрешен из публичной сети"

#: system/src/Validator/messages.php:55
#, php-format
msgid "'%localPart%' can not be matched against dot-atom format"
msgstr "'%localPart%' не может быть совпадает с форматом dot-atom"

#: system/src/Validator/messages.php:56
#, php-format
msgid "'%localPart%' can not be matched against quoted-string format"
msgstr "'%localPart%' не может быть сопоставлен с форматом quoted-string"

#: system/src/Validator/messages.php:57
msgid "'%localPart%' is not a valid local part for the email address"
msgstr "'%localPart%' не является допустимой локальной частью для адреса электронной почты"

#: system/src/Validator/messages.php:58
msgid "The input exceeds the allowed length"
msgstr "Значение превышает допустимую длину"

#: system/src/Validator/messages.php:60
msgid "The input appears to be a DNS hostname but the given punycode notation cannot be decoded"
msgstr "Значение похоже на DNS имя хоста, но указанная нотация не может быть декодирована"

#: system/src/Validator/messages.php:62
msgid "The input appears to be a DNS hostname but contains a dash in an invalid position"
msgstr "Значение похоже на DNS имя хоста, но содержит тире в недопустимом месте"

#: system/src/Validator/messages.php:63
msgid "The input does not match the expected structure for a DNS hostname"
msgstr "Введенные данные не соответствуют структуре DNS имени хоста"

#: system/src/Validator/messages.php:64
msgid "The input appears to be a DNS hostname but cannot match against hostname schema for TLD '%tld%'"
msgstr "Значение похоже на DNS имя хоста, но не соответствует схеме имен хостов для TLD '%tld%' "

#: system/src/Validator/messages.php:65
msgid "The input does not appear to be a valid local network name"
msgstr "Значение не является допустимым локальным сетевым именем"

#: system/src/Validator/messages.php:66
msgid "The input does not appear to be a valid URI hostname"
