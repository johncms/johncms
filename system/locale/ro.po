#: system/src/Validator/messages.php:50
#: system/src/Validator/messages.php:61
msgid "Invalid type given. String expected"
msgstr "Tip nevalid trimis. Șir așteptat"

#: system/src/Validator/messages.php:51
msgid "The input is not a valid email address. Use the basic format local-part@hostname"
msgstr "Intrarea nu este o adresă de e-mail validă. Utilizați formatul de bază local-part@hostname"

#: system/src/Validator/messages.php:52
#, php-format
msgid "'%hostname%' is not a valid hostname for the email address"
msgstr "'%hostname%' nu este un nume de gazdă valid pentru adresa de e-mail"

#: system/src/Validator/messages.php:53
#, php-format
msgid "'%hostname%' does not appear to have any valid MX or A records for the email address"
msgstr "'%hostname%' nu pare să aibă înregistrări MX sau A valide pentru adresa de e-mail"

#: system/src/Validator/messages.php:54
#, php-format
msgid "'%hostname%' is not in a routable network segment. The email address should not be resolved from public network"
msgstr "'%hostname%' nu se află într-un segment de rețea care poate fi redirecționat. Adresa de e-mail nu trebuie rezolvată din rețeaua publică"

#: system/src/Validator/messages.php:55
#, php-format
msgid "'%localPart%' can not be matched against dot-atom format"
msgstr "'%localPart%' nu poate fi potrivit împotriva formatului dot-atom"

#: system/src/Validator/messages.php:56
#, php-format
msgid "'%localPart%' can not be matched against quoted-string format"
msgstr "'%localPart%' nu poate fi potrivit după formatul de șir de citate"

#: system/src/Validator/messages.php:57
msgid "'%localPart%' is not a valid local part for the email address"
msgstr "'%hostname%' nu este un nume de gazdă valid pentru adresa de e-mail"

#: system/src/Validator/messages.php:58
msgid "The input exceeds the allowed length"
msgstr "Intrarea depășește lungimea permisă"

#: system/src/Validator/messages.php:60
msgid "The input appears to be a DNS hostname but the given punycode notation cannot be decoded"
msgstr "Intrarea pare a fi un nume de gazdă DNS, dar notația de punycode dată nu poate fi decodată"

#: system/src/Validator/messages.php:62
msgid "The input appears to be a DNS hostname but contains a dash in an invalid position"
msgstr "Intrarea pare să fie un nume de gazdă DNS, dar conține un dash într-o poziție nevalidă"

#: system/src/Validator/messages.php:63
msgid "The input does not match the expected structure for a DNS hostname"
msgstr "Intrarea nu se potrivește cu structura așteptată pentru un nume de gazdă DNS"

#: system/src/Validator/messages.php:64
msgid "The input appears to be a DNS hostname but cannot match against hostname schema for TLD '%tld%'"
msgstr "Intrarea pare a fi un nume de gazdă DNS, dar nu se poate potrivi cu schema de nume gazdă pentru TLD '%tld%'"

#: system/src/Validator/messages.php:65
msgid "The input does not appear to be a valid local network name"
msgstr "Intrarea nu pare a fi un nume valid de rețea locală"

#: system/src/Validator/messages.php:66
msgid "The input does not appear to be a valid URI hostname"
msgstr "Intrarea nu pare a fi un nume de gazdă URI valid"

#: system/src/Validator/messages.php:67
msgid "The input appears to be an IP address, but IP addresses are not allowed"
msgstr "Intrarea pare să fie o adresă IP, dar adresele IP nu sunt permise"

#: system/src/Validator/messages.php:68
msgid "The input appears to be a local network name but local network names are not allowed"
msgstr "Intrarea pare să fie un nume de rețea locală, dar numele locale ale rețelei nu sunt permise"

#: system/src/Validator/messages.php:69
msgid "The input appears to be a DNS hostname but cannot extract TLD part"
msgstr "Intrarea pare a fi un nume de gazdă DNS, dar nu poate extrage partea TLD"

#: system/src/Validator/messages.php:70
msgid "The input appears to be a DNS hostname but cannot match TLD against known list"
