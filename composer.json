{
    "name": "johncms/johncms",
    "description": "Content Management System",
    "version": "9.7.0",
    "homepage": "https://johncms.com",
    "license": "GPL-3.0-only",
    "keywords": [
        "johncms",
        "cms",
        "php",
        "mysql",
        "mobile"
    ],
    "authors": [
        {
            "name": "JohnCMS Contributors",
            "homepage": "https://github.com/johncms/johncms/graphs/contributors"
        }
    ],
    "support": {
        "forum": "https://johncms.com/forum",
        "source": "https://github.com/johncms/johncms",
        "issues": "https://johncms.com/forum/index.php?id=67"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "vendor-dir": "system/vendor"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "aura/autoload": "^2.0",
        "dragonmantank/cron-expression": "^3.4",
        "ezyang/htmlpurifier": "^4.13",
        "gettext/translator": "^1.0",
        "guzzlehttp/psr7": "^2.8",
        "illuminate/cache": "^12.41.1",
        "illuminate/database": "^12.41.1",
        "illuminate/filesystem": "^12.41.1",
        "imangazaliev/didom": "^2.0.1",
        "intervention/image": "^2.5",
        "james-heinrich/getid3": "^1.9",
        "johncms/johncms-pagination": "^2.0.1",
        "laminas/laminas-servicemanager": "^3.6",
        "laminas/laminas-uri": "^2.8",
        "laminas/laminas-validator": "^2.14",
        "league/flysystem": "^2.0",
        "mobicms/captcha": "^4.0",
        "mobicms/render": "^2.0",
        "monolog/monolog": "^3.9",
        "simba77/ckeditor-media-embed": "^1.1",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/mailer": "^v7.4.0",
        "symfony/routing": "^7.4"
    },
    "require-dev": {
        "gettext/gettext": "^5.5",
        "gettext/php-scanner": "^2.0",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-master",
        "squizlabs/php_codesniffer": "^3.6",
        "symfony/var-dumper": "^7.4",
        "vimeo/psalm": "^6.8"
    },
    "autoload": {
        "files": [
            "config/constants.php",
            "system/helpers.php"
        ],
        "psr-4": {
            "Johncms\\": "system/src/",
            "Johncms\\System\\Legacy\\": "system/src-legacy/",
            "Johncms\\Modules\\Album\\": "modules/album/src/",
            "Johncms\\Modules\\Guestbook\\": "modules/guestbook/src/",
            "Johncms\\Modules\\Admin\\": "modules/admin/src/",
            "Johncms\\Modules\\Homepage\\": "modules/homepage/src/",
            "Johncms\\Modules\\News\\": "modules/news/src/",
            "Johncms\\Modules\\Forum\\": "modules/forum/src/",
            "Johncms\\Modules\\Downloads\\": "modules/downloads/src/",
            "Downloads\\": "modules/downloads/classes/",
            "Johncms\\Modules\\Community\\": "modules/community/src/",
            "Johncms\\Modules\\Online\\": "modules/online/src/",
            "Johncms\\Modules\\Help\\": "modules/help/src/",
            "Johncms\\Modules\\Library\\": "modules/library/src/",
            "Johncms\\Modules\\Mail\\": "modules/mail/src/",
            "Johncms\\Modules\\Profile\\": "modules/profile/src/",
            "Johncms\\Modules\\Notifications\\": "modules/notifications/src/",
            "Johncms\\Modules\\Language\\": "modules/language/src/",
            "Johncms\\Modules\\Login\\": "modules/login/src/",
            "Johncms\\Modules\\Redirect\\": "modules/redirect/src/",
            "Johncms\\Modules\\Registration\\": "modules/registration/src/",
            "Library\\": "modules/library/classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "psalm": "XDG_CACHE_HOME=/tmp/.cache psalm",
        "psalm-fix": "XDG_CACHE_HOME=/tmp/.cache psalm --alter --issues=MissingReturnType,MissingParamType",
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --testsuite unit --colors=always",
        "translate": "php system/bin/console i18n:translate",
        "translate-scan": "php system/bin/console i18n:scan"
    },
  "repositories": [
    {
      "type": "path",
      "url": "system/third-party/johncms-pagination",
      "options": {
        "versions": {
          "johncms/johncms-pagination": "2.0.1"
        }
      }
    }
  ]
}
