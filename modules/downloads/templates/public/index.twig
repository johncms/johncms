{#
    Contents of a category: subcategories first, then the files of the category itself.
    The root of the downloads is the same page with id = 0.

    @var id             int          Identifier of the current category, 0 in the root.
    @var urls           array        downloads, new, sort_action
    @var categories     array        Subcategories of the current one.
    @var total_cat      int
    @var files          array        Presented files, see FilePresenter::present().
    @var total_files    int
    @var total_new      int          Files marked as new, for the badge of the button.
    @var pagination     \Twig\Markup Null when everything fits on one page.
    @var can_upload     bool         The visitor may upload into this category.
    @var can_manage     bool         The visitor may create, edit and scan categories.
    @var can_review     bool         The visitor may open the review of comments.
    @var sort_by_name   bool         Files are sorted by name, by time otherwise.
    @var sort_ascending bool
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if not id %}
        <div class="mb-3 mt-n1">
            {% if urls.new %}
                <a href="{{ urls.new }}" class="btn btn-outline-primary btn-sm me-1 mt-1">
                    {{ __('New Files') }} <span class="badge text-bg-secondary rounded-pill ms-1">{{ total_new }}</span>
                </a>
            {% endif %}
            <a href="/downloads/search/" class="btn btn-outline-primary btn-sm me-1 mt-1">{{ __('Search') }}</a>
            <a href="/downloads/top/" class="btn btn-outline-primary btn-sm me-1 mt-1">{{ __('Top Files') }}</a>
            <a href="/downloads/top-users/" class="btn btn-outline-primary btn-sm mt-1">{{ __('Top Users') }}</a>
        </div>
    {% endif %}

    {% for category in categories %}
        <div class="forum-section">
            <div class="section-header d-flex justify-content-between {{ category.desc ? '' : 'border-0 pb-0' }}">
                <div class="d-flex align-items-center">
                    <a href="{{ category.url }}" class="text-dark-brown">{{ category.rus_name }}</a>
                    <span class="badge rounded-pill counter-badge border ms-3">{{ category.total }}</span>
                </div>
            </div>
            {% if category.desc or category.field %}
                <div class="small pt-2 text-muted">
                    {% if category.desc %}
                        <div>{{ category.desc }}</div>
                    {% endif %}
                    {% if category.text %}
                        <div>{{ __('Allowed extensions') }}: {{ category.text }}</div>
                    {% endif %}
                </div>
            {% endif %}
            {% if category.has_edit %}
                <div class="pt-2 small">
                    {% if total_cat > 1 %}
                        <a href="{{ category.up_url }}" class="me-2">{{ __('Up') }}</a>
                        <a href="{{ category.down_url }}" class="me-2">{{ __('Down') }}</a>
                    {% endif %}
                    <a href="{{ category.edit_url }}" class="me-2">{{ __('Edit') }}</a>
                    <a href="{{ category.delete_url }}">{{ __('Delete') }}</a>
                </div>
            {% endif %}
        </div>
    {% endfor %}

    {% if total_cat > 0 and total_files > 0 %}
        <h4 class="mt-3">{{ __('List of files') }}</h4>
    {% endif %}

    {% if urls.sort_action %}
        <form class="form-inline mb-2" method="post" action="{{ urls.sort_action }}">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <label class="my-1 me-2" for="sort_down">{{ __('Sorting') }}</label>
            <select class="form-control d-inline w-auto my-1 me-sm-2" name="sort_down" id="sort_down">
                <option value="0"{% if not sort_by_name %} selected="selected"{% endif %}>{{ __('by time') }}</option>
                <option value="1"{% if sort_by_name %} selected="selected"{% endif %}>{{ __('by name') }}</option>
            </select>
            <label for="sort_down2" class="me-2 d-none d-sm-inline-block">&mdash;</label>
            <select class="form-control d-inline w-auto my-1 me-sm-2" name="sort_down2" id="sort_down2">
                <option value="0"{% if not sort_ascending %} selected="selected"{% endif %}>{{ __('descending') }}</option>
                <option value="1"{% if sort_ascending %} selected="selected"{% endif %}>{{ __('ascending') }}</option>
            </select>
            <button type="submit" class="btn btn-primary my-1">{{ __('Sort') }}</button>
        </form>
    {% endif %}

    {% for file in files %}
        {% include '@downloads/public/components/file-row.twig' with {file: file} only %}
    {% endfor %}

    {% if total_files %}
        <div class="mt-2">
            <div>{{ __('Total') }}: {{ total_files }}</div>
            {% if pagination %}
                <div class="mt-2">{{ pagination }}</div>
            {% endif %}
        </div>
    {% endif %}

    {% if not total_cat and not total_files %}
        <div class="row">
            <div class="col-md-5">
                <div class="alert alert-info shadow border-0">{{ __('List is empty') }}</div>
            </div>
        </div>
    {% endif %}

    <div class="mt-3">
        {% if can_manage %}
            <div class="btn-group">
                {% if id %}
                    <div class="dropdown me-2">
                        <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            {{ __('Add file') }}
                        </button>
                        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                            <a class="dropdown-item" href="/downloads/upload/{{ id }}/">{{ __('Upload File') }}</a>
                            <a class="dropdown-item" href="/downloads/import/{{ id }}/">{{ __('Import File') }}</a>
                        </div>
                    </div>
                {% endif %}
                <div class="dropdown">
                    <button class="btn btn-danger dropdown-toggle btn-sm" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        {{ __('Section actions') }}
                    </button>
                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                        <a class="dropdown-item" href="/downloads/categories/create{{ id ? '?refid=' ~ id : '' }}">{{ __('Create Folder') }}</a>
                        <a class="dropdown-item" href="/downloads/scan-dir{{ id ? '?id=' ~ id : '' }}">{{ __('Update Files') }}</a>
                        {% if id %}
                            <a class="dropdown-item" href="/downloads/categories/{{ id }}/edit">{{ __('Change Folder') }}</a>
                            <a class="dropdown-item" href="/downloads/categories/{{ id }}/delete">{{ __('Delete Folder') }}</a>
                            <a class="dropdown-item" href="/downloads/scan-dir?do=clean&amp;id={{ id }}">{{ __('Remove missing files') }}</a>
                            <a class="dropdown-item" href="/downloads/recount?id={{ id }}">{{ __('Update counters') }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% elseif can_upload %}
            <div><a href="/downloads/upload/{{ id }}/" class="btn btn-primary">{{ __('Upload File') }}</a></div>
        {% endif %}

        <div class="mt-2">
            {% if id %}
                <a href="{{ urls.downloads }}">{{ __('Downloads') }}</a>
            {% else %}
                {% if can_review %}
                    <a href="/downloads/comments-review/">{{ __('Review comments') }}</a><br>
                {% endif %}
                <a href="/downloads/favorites/">{{ __('Favorites') }}</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
