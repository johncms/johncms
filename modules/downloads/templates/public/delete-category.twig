{#
    Confirmation of deleting a category.

    @var folder_name string
    @var action_url  string
    @var back_url    string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="alert alert-danger">
        <div>
            <strong>{{ __('Folder') }}: {{ folder_name }}.</strong>
        </div>
        <div class="pb-2">
            {{ __('Do you really want to delete?') }}
        </div>
        <div>
            <form action="{{ action_url }}" method="post">
                <button type="submit" name="delete" value="1" class="btn btn-danger btn-sm">{{ __('Delete') }}</button>
                <a href="{{ back_url }}" class="btn btn-outline-secondary btn-sm">{{ __('Cancel') }}</a>
            </form>
        </div>
    </div>
{% endblock %}
