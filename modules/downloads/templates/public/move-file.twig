{#
    Choosing the category to move a file into: one level of the tree at a time.

    @var sections array  rus_name, section_open_url, section_move_url
    @var urls     array  move_to_current_url, empty in the root and in the category of the file
    @var back_url string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if sections %}
        <div class="h4 fw-bold">{{ __('Select a section to move') }}</div>
        <div class="list-group">
            {% for section in sections %}
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                        <a href="{{ section.section_open_url }}" class="mb-1">{{ section.rus_name }}</a>
                        {% if section.section_move_url %}
                            <a href="{{ section.section_move_url }}" class="btn btn-primary btn-sm">{{ __('Move file to this section') }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">{{ __('The list is empty') }}</div>
    {% endif %}
    {% if urls.move_to_current_url %}
        <div class="mt-3">
            <a href="{{ urls.move_to_current_url }}" class="btn btn-primary">{{ __('Move file here') }}</a>
        </div>
    {% endif %}
    <div class="mt-3">
        <a href="{{ back_url }}">{{ __('Cancel') }}</a>
    </div>
{% endblock %}
