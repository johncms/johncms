{#
    The description editor of a file, as a Vue component.

    @var label string
    @var name  string Name of the field in the form.
    @var value string
#}
{% if app.locale != 'en' and asset_exists('ckeditor5/translations/' ~ app.locale ~ '.js') %}
    <script src="{{ asset('ckeditor5/translations/' ~ app.locale ~ '.js', true) }}"></script>
{% endif %}
<script src="{{ asset('ckeditor5/ckeditor.js', true) }}"></script>
<div class="vue_app">
    <ckeditor-input-component
        upload_url=""
        name="{{ name }}"
        language="{{ app.locale }}"
        errors=""
        id="{{ name }}"
        label="{{ label }}"
        value="{{ value|default('') }}"
        :allow_upload="false"
    ></ckeditor-input-component>
</div>
