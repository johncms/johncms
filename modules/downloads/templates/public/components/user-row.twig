{#
    One user in the top of uploaders and in the header of their file list.

    @var item array id, name, user_is_online, user_profile_link, files_url, files_count,
                    search_ip_url, ip, search_ip_via_proxy_url, ip_via_proxy, browser
#}
<div class="user-row card shadow border-0 mb-2">
    <div class="card-body">
        <div class="d-flex align-items-start">
            <div class="user-avatar me-2 me-md-4">
                <div class="avatar-image rounded-circle overflow-hidden">
                    <img src="{{ avatar(item.id) }}" class="img-fluid" alt=".">
                </div>
                <div class="user-status {{ item.user_is_online ? 'online' : 'offline' }} shadow"></div>
            </div>
            <div class="overflow-auto flex-grow-1">
                <div class="user-name">
                    {% if item.user_profile_link %}
                        <a href="{{ item.user_profile_link }}" class="user-login me-2">{{ item.name }}</a>
                    {% else %}
                        <a class="user-login me-2">{{ item.name }}</a>
                    {% endif %}
                </div>
                {% if item.files_url|default('') %}
                    <div class="text">
                        <a href="{{ item.files_url }}">{{ __('User Files') }}: {{ item.files_count }}</a>
                    </div>
                {% endif %}
            </div>
        </div>
        {% if app.user.isValid and app.user.rights >= 3 %}
            <div class="post-footer d-flex justify-content-between border-top pt-2 mt-2">
                <div class="post-user-info d-flex overflow-hidden small align-items-center">
                    <div class="user-ip me-2">
                        <a href="{{ item.search_ip_url }}">{{ item.ip }}</a>
                        {% if item.ip_via_proxy %}
                            / <a href="{{ item.search_ip_via_proxy_url }}">{{ item.ip_via_proxy }}</a>
                        {% endif %}
                    </div>
                    <div class="useragent">
                        <span>User-Agent:</span>
                        <span>{{ item.browser }}</span>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
    <div class="footer"></div>
</div>
