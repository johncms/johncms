{#
    The latest comments of all the files, for a moderator to look through.

    @var items      array        One entry per comment, post_text and reply_text are markup.
    @var pagination \Twig\Markup Null when everything fits on one page.
    @var urls       array        downloads
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if items is empty %}
        <div class="alert alert-info">{{ __('The list is empty') }}</div>
    {% else %}
        {% for item in items %}
            <div class="new_post-item mb-2">
                <div class="new_post-header d-flex justify-content-between">
                    <div class="post-user">
                        <a href="/profile/{{ item.user_id }}">
                            <div class="avatar">
                                <img src="{{ avatar(item.user_id) }}" class="img-fluid" alt=".">
                            </div>
                        </a>
                    </div>
                    <div class="flex-grow-1 post-user d-flex flex-wrap overflow-hidden d-flex align-items-center">
                        <div class="w-100">
                            <a href="/profile/{{ item.user_id }}"><span class="user-name d-inline me-2">{{ item.name }}</span></a>
                            <span class="post-meta d-inline me-2">{{ item.created }}</span>
                            {% if item.edit_count %}
                                <div class="post-meta d-inline me-2"
                                     data-bs-toggle="tooltip"
                                     data-bs-placement="top"
                                     data-bs-html="true"
                                     title="{{ __('Edited:') }} {{ item.editor_name }} <br> ({{ item.edit_time }}) [{{ item.edit_count }}]">
                                    {{ __('Edited') }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="post-body mt-2 border-top pt-2 pb-2">
                    {{ item.post_text }}
                    {% if item.reply_text %}
                        <div class="alert alert-warning mt-2 mb-2">
                            <b><a href="{{ item.reply_author_url }}">{{ item.reply_author_name }}</a></b> {{ item.reply_time }}<br>
                            {{ item.reply_text }}
                        </div>
                    {% endif %}
                </div>
                <div class="small">
                    {% if item.file_url %}
                        <a href="{{ item.file_url }}" class="me-2">{{ item.rus_name }}</a>
                    {% endif %}
                    {% if item.comments_url %}
                        <a href="{{ item.comments_url }}">{{ __('Comments') }}</a>
                    {% endif %}
                </div>

                {% set can_see_meta = app.user.isValid and app.user.rights %}
                {% if can_see_meta or item.edit_count %}
                    <div class="post-footer d-flex justify-content-between pt-2">
                        <div class="overflow-hidden">
                            {% if can_see_meta %}
                                <div class="post-meta d-flex">
                                    <div class="user-ip me-2">
                                        <a href="{{ item.search_ip_url }}">{{ item.ip }}</a>
                                        {% if item.ip_via_proxy %}
                                            / <a href="{{ item.search_ip_via_proxy_url }}">{{ item.ip_via_proxy }}</a>
                                        {% endif %}
                                    </div>
                                    <div class="useragent">
                                        <span>{{ item.user_agent }}</span>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                        <div class="d-flex">
                            {% if item.edit_url or item.delete_url %}
                                <div class="dropdown ms-3">
                                    <div class="cursor-pointer" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <svg class="icon text-primary">
                                            <use xlink:href="{{ asset('icons/sprite.svg') }}?1#more_horizontal"/>
                                        </svg>
                                    </div>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        {% if item.edit_url %}
                                            <a href="{{ item.edit_url }}" class="dropdown-item">{{ __('Edit') }}</a>
                                        {% endif %}
                                        {% if item.delete_url %}
                                            <a href="{{ item.delete_url }}" class="dropdown-item">{{ __('Delete') }}</a>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endfor %}

        {% if pagination %}
            <div class="mt-3">
                {{ pagination }}
            </div>
        {% endif %}
    {% endif %}

    <div class="mt-3">
        <a href="{{ urls.downloads }}">{{ __('Downloads') }}</a>
    </div>
{% endblock %}
