{#
    Notification settings of the signed-in administrator.

    @var string form_action
    @var string message          Flash message about the last save, may be empty.
    @var array  current_settings
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: message} only %}

    <form method="post" action="{{ form_action }}" class="admin-notifications-page">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">

        <section class="card">
            <div class="card-body">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch"
                           name="show_forum_unread" value="1" id="show_forum_unread"
                           {% if current_settings.show_forum_unread %}checked{% endif %}>
                    <label class="form-check-label" for="show_forum_unread">{{ d__('notifications', 'Display the number of unread messages in the forum') }}</label>
                </div>
            </div>
        </section>

        {% include '@admin/components/ui/form-footer.twig' with {cancel_url: '/admin/notifications'} only %}
    </form>
{% endblock %}
