{#
    Confirming the removal of a collection or of a part of one. Answered to the modal as it is, and
    put into a page of its own (delete-confirm.twig) for a plain visit.

    @var string title
    @var string message     What deleting it does.
    @var string name        What is about to be deleted.
    @var array  facts       What goes with it: label, value; may be empty.
    @var array  hidden      Fields posted with it, name => value; may be absent.
    @var string form_action
    @var string back_url
#}
{% embed '@admin/components/ui/dialog.twig' with {
    title: title,
    action: form_action,
    close_url: back_url,
    message: message,
    name: name,
    facts: facts|default([]),
    hidden: hidden|default({}),
    errors: errors|default([]),
    deletion: deletion|default(null),
} only %}
    {% block body %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors} only %}
        {% for field, value in hidden %}
            <input type="hidden" name="{{ field }}" value="{{ value }}">
        {% endfor %}
        <p class="mb-2">{{ message }}</p>
        <div class="fw-semibold">{{ name }}</div>
        {% if facts is not empty %}
            <div class="mt-3">
                {% include '@admin/components/ui/facts.twig' with {items: facts} only %}
            </div>
        {% endif %}
        {% if deletion is not null %}
            <div class="mt-3">
                <label for="deletion-mode" class="form-label">{{ __('Items of this section and its subsections') }}</label>
                <select name="mode" id="deletion-mode" class="form-select" required>
                    <option value=""{% if deletion.mode == '' %} selected{% endif %}>{{ __('Choose an action') }}</option>
                    <option value="delete"{% if deletion.mode == 'delete' %} selected{% endif %}>{{ __('Permanently delete all items in the subtree') }}</option>
                    <option value="move"{% if deletion.mode == 'move' %} selected{% endif %}>{{ __('Move all items to another section') }}</option>
                </select>
            </div>
            <div class="mt-3">
                <label for="deletion-target" class="form-label">{{ __('Destination section (when moving items)') }}</label>
                <select name="target" id="deletion-target" class="form-select">
                    <option value="">{{ __('Choose a section') }}</option>
                    {% for option in deletion.options %}
                        <option value="{{ option.id }}"{% if deletion.target == option.id %} selected{% endif %}>{{ option.label }}</option>
                    {% endfor %}
                </select>
                <div class="form-text">{{ __('All nested sections will be deleted. Moved items keep their codes, publication settings and values; visibility follows the destination section.') }}</div>
            </div>
        {% endif %}
    {% endblock %}
    {% block footer %}
        <a href="{{ close_url }}" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Cancel') }}</a>
        <button type="submit" class="btn btn-danger">
            {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
            {{ __('Delete') }}
        </button>
    {% endblock %}
{% endembed %}
