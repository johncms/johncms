{#
    A section of a collection, new or existing.

    @var string form_action
    @var string back_url
    @var int    id          Null when a new section is being added.
    @var array  fields      Values of the form, keyed by field name.
    @var string parent_path The sections it stands in, from the top; empty at the top.
    @var array  errors      Validation messages, empty on the first render.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors} only %}

    <form action="{{ form_action }}" method="post" id="section-form" class="row g-3 align-items-start">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if id is not null %}
            <input type="hidden" name="id" value="{{ id }}">
        {% endif %}
        {% if fields.parent is not null %}
            <input type="hidden" name="parent" value="{{ fields.parent }}">
        {% endif %}

        <div class="col-lg-8">
            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'folder', size: 16} only %}
                    <h2 class="h6 mb-0 ms-2">{{ __('Section') }}</h2>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label" for="name">{{ __('Name') }}</label>
                            <input type="text" name="name" class="form-control" id="name" value="{{ fields.name }}" required>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="code">{{ __('Code') }}</label>
                            <input type="text" name="code" class="form-control font-monospace" id="code" value="{{ fields.code }}" required pattern="[a-z0-9_-]+">
                            <div class="form-text">{{ __('Its part of the address of the items: lowercase latin letters, digits, hyphen and underscore.') }}</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="description">{{ __('Description') }}</label>
                            <textarea name="description" class="form-control" id="description" rows="3">{{ fields.description }}</textarea>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'list-tree', size: 16} only %}
                    <h2 class="h6 mb-0 ms-2">{{ __('Place') }}</h2>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <div>
                        <div class="form-label">{{ __('Inside') }}</div>
                        <div>{{ parent_path ?: __('The top of the collection') }}</div>
                    </div>
                    <div>
                        <label class="form-label" for="sort">{{ __('Sorting') }}</label>
                        <input type="number" name="sort" class="form-control" id="sort" value="{{ fields.sort }}">
                        <div class="form-text">{{ __('The smaller the number, the higher the section among its neighbours.') }}</div>
                    </div>
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" role="switch" name="active" value="1" id="active"{% if fields.active %} checked{% endif %}>
                        <label class="form-check-label" for="active">{{ __('Active') }}</label>
                        <div class="form-text mt-0">{{ __('A turned off section and what stands in it are not shown on the site.') }}</div>
                    </div>
                </div>
            </section>
        </div>
    </form>

    {% include '@admin/components/ui/form-footer.twig' with {form: 'section-form', cancel_url: back_url} only %}
{% endblock %}
