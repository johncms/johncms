{#
    A field of a collection, new or existing.

    @var string form_action
    @var string back_url
    @var int    id           Null when a new field is being added.
    @var array  fields       Values of the form, keyed by field name.
    @var array  type_options Types a field may have, keyed by value.
    @var bool   managed      A field controlled by its owner declaration.
    @var array  errors       Validation messages, empty on the first render.
#}
{% extends '@admin/layouts/default.twig' %}

{% macro error(errors, key) %}
    {% if errors[key]|default('') %}<div class="invalid-feedback d-block" id="error-{{ key|replace({'.': '-'}) }}">{{ errors[key] }}</div>{% endif %}
{% endmacro %}

{% block content %}
    {% if managed %}<div class="alert alert-info">{{ __('This field is managed by its module. Change its declaration in code.') }} <strong>{{ owner_module }}</strong></div>{% endif %}
    {% if errors %}<div tabindex="-1" data-field-error-summary>{% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors} only %}</div>{% endif %}

    <form action="{{ form_action }}" method="post" id="field-form" data-collection-field-settings data-field-errors="{{ field_errors|json_encode }}" class="row g-3 align-items-start">

        <input type="hidden" name="collection_form_started" value="1">
        <input type="hidden" name="default_type" value="{{ fields.type }}">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if id is not null %}
            <input type="hidden" name="id" value="{{ id }}">
        {% endif %}

        <div class="col-lg-8">
            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'list', size: 16} only %}
                    <h2 class="h6 mb-0 ms-2">{{ __('Field') }}</h2>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6 admin-slug-name-column">
                            <label class="form-label" for="name">{{ __('Name') }}</label>
                            <input type="text" name="name" maxlength="255" class="form-control" id="name" value="{{ fields.name }}" required{% if managed %} disabled{% endif %}{% if field_errors['name']|default('') %} aria-invalid="true" aria-describedby="error-name"{% endif %}>
                            {{ _self.error(field_errors, 'name') }}
                        </div>
                        <div class="col-md-6 admin-slug-code-column">
                            {% if managed %}
                                <label class="form-label d-block" for="code">{{ __('Code') }}</label>
                                <input type="text" class="form-control" name="code" id="code" value="{{ fields.code }}" disabled>
                            {% else %}
                                {% include '@admin/components/ui/slug-field.twig' with {
                                    label: __('Code'), value: fields.code, linked: slug_linked, slug_url: '/admin/collections/slug',
                                    required: true, pattern: '[a-z0-9_\\-]+',
                                    hint: __('The name of the value in the API and the templates: lowercase latin letters, digits, hyphen and underscore.')
                                } only %}
                            {% endif %}
                            {{ _self.error(field_errors, 'code') }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="type">{{ __('Type') }}</label>
                            <select name="type" class="form-select" id="type"{% if managed or structure_locked %} disabled{% endif %}{% if field_errors['type']|default('') %} aria-invalid="true" aria-describedby="error-type"{% endif %}>
                                {% for value, label in type_options %}
                                    <option value="{{ value }}"{% if fields.type == value %} selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                            {{ _self.error(field_errors, 'type') }}
                            {% if structure_locked %}
                                <input type="hidden" name="type" value="{{ fields.type }}"{% if field_errors['type']|default('') %} aria-invalid="true" aria-describedby="error-type"{% endif %}>
                                <div class="form-text">{{ __('Convert existing values explicitly before changing their type or multiplicity.') }}</div>
                            {% endif %}
                        </div>
                        <div class="col-12 d-flex flex-column gap-3">
                            <div class="form-check form-switch" data-field-required{% if fields.type == 'boolean' %} hidden{% endif %}>
                                <input type="checkbox" class="form-check-input" role="switch" name="required" value="1" id="required"{% if fields.required %} checked{% endif %}{% if managed %} disabled{% endif %}>
                                <label class="form-check-label" for="required">{{ __('Required') }}</label>
                                <div class="form-text mt-0">{{ __('An item is not saved without a value.') }}</div>
                            </div>
                            <div class="form-check form-switch" data-field-multiple-switch{% if fields.type == 'boolean' and not fields.multiple %} hidden{% endif %}>
                                <input type="checkbox" class="form-check-input" role="switch" name="multiple" value="1" id="multiple"{% if fields.multiple %} checked{% endif %}{% if managed or structure_locked %} disabled{% endif %}>
                                {% if structure_locked and fields.multiple %}<input type="hidden" name="multiple" value="1">{% endif %}
                                <label class="form-check-label" for="multiple">{{ __('Allow multiple values') }}</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="field-hint">{{ __('Hint') }}</label>
                            <textarea class="form-control" id="field-hint" name="hint" rows="2" maxlength="2000"{% if managed %} disabled{% endif %}{% if field_errors['hint']|default('') %} aria-invalid="true" aria-describedby="error-hint"{% endif %}>{{ fields.hint }}</textarea>
                            {{ _self.error(field_errors, 'hint') }}
                        </div>
                    </div>
                </div>
            </section>

            <fieldset class="card mt-3"{% if managed %} disabled{% endif %}>
                <div class="card-header"><h2 class="h6 mb-0">{{ __('Input settings') }}</h2></div>
                <div class="card-body row g-3">
                    <fieldset class="col-12 mb-0" data-field-types="file"{% if fields.type != 'file' %} hidden disabled{% endif %}>
                        <input type="hidden" name="file_constraints_present" value="1">
                        <label class="form-label" for="max-file-bytes">{{ __('Maximum file size') }}</label>
                        <div class="input-group">
                            <input class="form-control" type="number" min="0" step="any" name="max_file_bytes" id="max-file-bytes" value="{{ fields.max_file_bytes }}" required{% if field_errors['max_file_bytes']|default('') %} aria-invalid="true" aria-describedby="error-max_file_bytes"{% endif %}>
                            <select class="form-select" name="file_size_unit" aria-label="{{ __('File size unit') }}">
                                {% for unit, label in {'1': __('Bytes'), '1024': __('KB'), '1048576': __('MB'), '1073741824': __('GB')} %}<option value="{{ unit }}"{% if file_size_unit == unit ~ '' %} selected{% endif %}>{{ label }}</option>{% endfor %}
                            </select>
                        </div>
                        {{ _self.error(field_errors, 'max_file_bytes') }}
                        {% if server_upload_limit %}<div class="form-text">{{ __('The server accepts up to %s.')|format(server_upload_limit|format_size) }}</div>{% endif %}
                        <fieldset class="mt-3 mb-0" id="file-types">
                            <legend class="form-label">{{ __('Allowed file types') }}</legend>
                            <div class="d-flex flex-column gap-2">
                                {% for group in file_type_groups %}
                                    {% set group_id = loop.index %}
                                    <div class="collection-file-types" data-file-type-group>
                                        <div class="form-check collection-file-types-group">
                                            <input type="checkbox" class="form-check-input" id="file-type-group-{{ group_id }}" data-file-type-toggle hidden>
                                            <label class="form-check-label" for="file-type-group-{{ group_id }}">{{ group.label }}</label>
                                        </div>
                                        <div class="d-flex flex-wrap gap-3">
                                            {% for mime, extension in group.types %}
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input" name="allowed_mime_types[]" id="file-type-{{ group_id }}-{{ loop.index }}" value="{{ mime }}"{% if mime in fields.allowed_mime_types %} checked{% endif %}>
                                                    <label class="form-check-label" for="file-type-{{ group_id }}-{{ loop.index }}" title="{{ mime }}">{{ extension|upper }}</label>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            {{ _self.error(field_errors, 'allowed_mime_types') }}
                        </fieldset>
                        <div class="form-text">{{ __('The actual file content is checked. Server upload and image limits also apply.') }}</div>
                    </fieldset>
                    <fieldset class="col-12 mb-0" data-field-types="relation"{% if fields.type != 'relation' %} hidden disabled{% endif %}>
                        <label class="form-label" for="relation-target">{{ __('Target collection') }}</label>
                        <select class="form-select" name="target_collection_id" id="relation-target" required{% if structure_locked %} disabled{% endif %}{% if field_errors['target_collection_id']|default('') %} aria-invalid="true" aria-describedby="error-target_collection_id"{% endif %}>
                            {% include '@collections/admin/components/select-options.twig' with {options: collection_options, current: fields.target_collection_id ~ '', empty_label: __('Choose a collection')} only %}
                        </select>
                        {{ _self.error(field_errors, 'target_collection_id') }}
                        {% if structure_locked %}<input type="hidden" name="target_collection_id" value="{{ fields.target_collection_id }}"{% if field_errors['target_collection_id']|default('') %} aria-invalid="true" aria-describedby="error-target_collection_id"{% endif %}>{% endif %}
                        <label class="form-label mt-2" for="relation-on-delete">{{ __('When a related item is deleted') }}</label>
                        <select class="form-select" id="relation-on-delete" name="relation_on_delete"{% if field_errors['relation_on_delete']|default('') %} aria-invalid="true" aria-describedby="error-relation_on_delete"{% endif %}>
                            <option value="restrict"{% if fields.relation_on_delete == 'restrict' %} selected{% endif %}>{{ __('Prevent deletion') }}</option>
                            <option value="clear"{% if fields.relation_on_delete == 'clear' %} selected{% endif %}>{{ __('Remove the link from the items') }}</option>
                        </select>
                        {{ _self.error(field_errors, 'relation_on_delete') }}
                        <div class="form-text" data-required-relation-help{% if not fields.required %} hidden{% endif %}>{{ __('A required relation always prevents deletion.') }}</div>
                        <div class="form-text" data-relation-delete-help="restrict"{% if fields.relation_on_delete != 'restrict' or fields.required %} hidden{% endif %}>{{ __('A record cannot be deleted while items link to it.') }}</div>
                        <div class="form-text" data-relation-delete-help="clear"{% if fields.relation_on_delete != 'clear' or fields.required %} hidden{% endif %}>{{ __('The link disappears from the items when the record is deleted.') }}</div>
                        <div class="form-text">{{ __('A record chosen as a default value cannot be deleted until the default changes.') }}</div>
                    </fieldset>
                    <fieldset class="col-12 mb-0" data-field-types="select"{% if fields.type != 'select' %} hidden disabled{% endif %}>
                        {% include '@collections/admin/components/option-settings.twig' with {options: option_rows, field_errors: field_errors} only %}
                        {{ _self.error(field_errors, 'options') }}
                    </fieldset>
                    <fieldset class="col-md-6 mb-0" data-field-types="string text html{{ fields.legacy_length_limits|default(false) ? ' select' : '' }}"{% if fields.type not in ['string', 'text', 'html'] and not (fields.legacy_length_limits and fields.type == 'select') %} hidden disabled{% endif %}>
                        <label class="form-label" for="min-length">{{ __('Minimum text length') }}</label>
                        <input type="number" class="form-control" min="0" id="min-length" name="min_length" value="{{ fields.min_length }}"{% if field_errors['min_length']|default('') %} aria-invalid="true" aria-describedby="error-min_length"{% endif %}>
                        {{ _self.error(field_errors, 'min_length') }}
                    </fieldset>
                    <fieldset class="col-md-6 mb-0" data-field-types="string text html{{ fields.legacy_length_limits|default(false) ? ' select' : '' }}"{% if fields.type not in ['string', 'text', 'html'] and not (fields.legacy_length_limits and fields.type == 'select') %} hidden disabled{% endif %}>
                        <label class="form-label" for="max-length">{{ __('Maximum text length') }}</label>
                        <input type="number" class="form-control" min="1" id="max-length" name="max_length" value="{{ fields.max_length }}"{% if field_errors['max_length']|default('') %} aria-invalid="true" aria-describedby="error-max_length"{% endif %}>
                        {{ _self.error(field_errors, 'max_length') }}
                    </fieldset>
                    <fieldset class="col-md-6 mb-0" data-field-types="integer double"{% if fields.type not in ['integer', 'double'] %} hidden disabled{% endif %}>
                        <label class="form-label" for="min-value">{{ __('Minimum numeric value') }}</label>
                        <input type="number" step="any" class="form-control" id="min-value" name="min_value" value="{{ fields.min_value }}"{% if field_errors['min_value']|default('') %} aria-invalid="true" aria-describedby="error-min_value"{% endif %}>
                        {{ _self.error(field_errors, 'min_value') }}
                    </fieldset>
                    <fieldset class="col-md-6 mb-0" data-field-types="integer double"{% if fields.type not in ['integer', 'double'] %} hidden disabled{% endif %}>
                        <label class="form-label" for="max-value">{{ __('Maximum numeric value') }}</label>
                        <input type="number" step="any" class="form-control" id="max-value" name="max_value" value="{{ fields.max_value }}"{% if field_errors['max_value']|default('') %} aria-invalid="true" aria-describedby="error-max_value"{% endif %}>
                        {{ _self.error(field_errors, 'max_value') }}
                    </fieldset>
                    <fieldset class="col-md-6 mb-0" data-field-multiple{% if not fields.multiple %} hidden disabled{% endif %}>
                        <label class="form-label" for="max-values">{{ __('Maximum number of values') }}</label>
                        <input type="number" class="form-control" min="1" max="1000" id="max-values" name="max_values" value="{{ fields.max_values }}"{% if field_errors['max_values']|default('') %} aria-invalid="true" aria-describedby="error-max_values"{% endif %}>
                        {{ _self.error(field_errors, 'max_values') }}
                        <div class="form-text">{{ __('Leave empty to use the storage limit.') }}</div>
                    </fieldset>
                    <p class="col-12 form-text mb-0" data-field-types="html"{% if fields.type != 'html' %} hidden{% endif %}>{{ __('HTML length includes markup. Limits apply to each value.') }}</p>
                    <p class="col-12 form-text mb-0" data-field-types="string"{% if fields.type != 'string' %} hidden{% endif %}>{{ __('Strings are stored with a maximum of 255 characters. Limits apply to each value.') }}</p>
                    <div class="col-12" data-default-settings{% if fields.type == 'file' %} hidden{% endif %} data-limit-error="{{ __('The default exceeds the configured number of values.') }}" data-yes="{{ __('Yes') }}" data-no="{{ __('No') }}" data-empty="{{ __('No value') }}" data-invalid="{{ __('Choose an available option for this field.') }}">
                        <div class="form-check mb-2" data-default-toggle{% if fields.type in ['date', 'datetime', 'relation'] %} hidden{% endif %}>
                            <input class="form-check-input" type="checkbox" name="use_default" id="use-default" value="1"{% if fields.use_default %} checked{% endif %}>
                            <label class="form-check-label" for="use-default">{{ __('Use a default value') }}</label>
                        </div>
                        <fieldset class="mb-3" data-date-default-settings{% if fields.type not in ['date', 'datetime'] %} hidden disabled{% endif %}>
                            <label class="form-label" for="date-default-mode">{{ __('Initial value') }}</label>
                            <select class="form-select" id="date-default-mode" name="date_default_mode">
                                <option value="none"{% if fields.date_default_mode == 'none' %} selected{% endif %}>{{ __('No value') }}</option>
                                <option value="current" data-current-date-label="{{ __('Today') }}" data-current-datetime-label="{{ __('Current date and time') }}"{% if fields.date_default_mode == 'current' %} selected{% endif %}>{{ fields.type == 'date' ? __('Today') : __('Current date and time') }}</option>
                                <option value="fixed"{% if fields.date_default_mode == 'fixed' %} selected{% endif %}>{{ __('Specified date') }}</option>
                            </select>
                            {{ _self.error(field_errors, 'date_default_mode') }}
                            <div class="form-text" data-date-current-help{% if fields.date_default_mode != 'current' %} hidden{% endif %}>{{ __('Filled when opening a new item form, using site time. You can edit the displayed value before saving.') }}</div>
                        </fieldset>
                        <fieldset class="mb-3" data-default-lookup data-url="{{ form_action }}/choices"
                                  data-relation-singular="{{ __('Default value') }}" data-relation-plural="{{ __('Default values') }}"
                                  data-relation-target="{{ __('Select the target collection first.') }}"
                                  data-relation-context="{{ __('Search in collection: %s') }}"
                                  data-relation-no-records="{{ __('This collection has no records yet.') }}"
                                  data-relation-more="{{ __('Up to 30 matching items. Refine your search to find another item.') }}"
                                  data-relation-loading="{{ d__('system', 'Please wait...') }}"
                                  data-relation-invalid="{{ __('The selected record is unavailable in this collection. Clear it or select another record.') }}"
                                  data-relation-unavailable="{{ __('Unavailable record') }}"
                                  data-relation-count-label="{{ __('Selected: %d') }}" data-relation-count-limit="{{ __('Selected: %d of %d') }}"
                                  data-relation-up="{{ __('Move up') }}" data-relation-down="{{ __('Move down') }}" data-relation-remove="{{ __('Remove value') }}"
                                  data-options="{{ default_options|json_encode }}"{% if fields.type != 'relation' %} hidden disabled{% endif %} data-error="{{ __('Could not load default choices. Try again.') }}" data-empty="{{ __('No matching values were found. Refine your search.') }}">
                            <label class="form-label" for="default-query">{{ __('Search default values') }}</label>
                            {% for action, icon in {'up': 'arrow-up', 'down': 'arrow-down', 'remove': 'x', 'check': 'check'} %}
                                <template data-relation-icon="{{ action }}">{% include '@admin/components/ui/icon.twig' with {name: icon, size: 14} only %}</template>
                            {% endfor %}
                            <div class="relation-default-control" data-relation-control>
                                <div class="input-group">
                                    <input type="search" class="form-control" id="default-query" name="default_query" maxlength="255" value="{{ default_query }}">
                                    <button type="button" class="btn btn-outline-secondary" data-relation-clear hidden>{{ __('Clear') }}</button>
                                </div>
                                <div class="relation-default-popup shadow" data-relation-popup hidden>
                                    <div class="list-group list-group-flush relation-default-results" id="relation-default-results" role="listbox" aria-label="{{ __('Search results') }}" data-relation-results hidden></div>
                                    <div class="relation-default-footer" data-relation-footer hidden>
                                        <span class="small text-muted" role="status" data-relation-count></span>
                                        <button type="button" class="btn btn-primary btn-sm" data-relation-done>{{ __('Done') }}</button>
                                    </div>
                                </div>
                            </div>
                            <p class="form-text mb-0" role="status" id="default-lookup-status" data-default-lookup-status>{{ default_lookup_error }}</p>
                            <p class="form-text text-danger mb-0" id="relation-default-warning" role="alert" data-relation-warning hidden></p>
                            <ul class="relation-default-selected" data-relation-selected aria-label="{{ __('Default values') }}" hidden></ul>
                        </fieldset>
                        <fieldset class="border rounded p-3 mb-3" data-default-choice hidden disabled>
                            <label class="form-label" for="default-choice">{{ __('Choose the default value to keep. Other values remain in the draft until you save.') }}</label>
                            <select class="form-select mb-2" id="default-choice"></select>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-default-choose>{{ __('Use this value') }}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-default-cancel>{{ __('Cancel') }}</button>
                        </fieldset>
                        {{ _self.error(field_errors, 'default') }}
                        <fieldset class="mb-0" data-default-single{% if fields.type == 'relation' or fields.multiple or (fields.type in ['date', 'datetime'] and fields.date_default_mode != 'fixed') %} hidden{% endif %}{% if fields.multiple or (fields.type in ['date', 'datetime'] and fields.date_default_mode != 'fixed') %} disabled{% endif %}>
                            <label class="form-label" for="field-default">{{ __('Default value') }}</label>
                            <textarea class="form-control" id="field-default" name="default_value" rows="2"{% if field_errors['default_value']|default('') %} aria-invalid="true" aria-describedby="error-default_value"{% endif %}>{{ fields.default_value }}</textarea>
                            {{ _self.error(field_errors, 'default_value') }}
                        </fieldset>
                        <fieldset data-default-multiple class="mt-2 mb-0"{% if fields.type == 'relation' or not fields.multiple or (fields.type in ['date', 'datetime'] and fields.date_default_mode != 'fixed') %} hidden{% endif %}{% if not fields.multiple or (fields.type in ['date', 'datetime'] and fields.date_default_mode != 'fixed') %} disabled{% endif %}>
                            {% include '@collections/admin/components/repeated-values.twig' with {
                                entries: default_entries, input_name: 'default_values', action_key: 'default', id_prefix: 'field-default',
                                type: 'text', label: __('Default values'), limit: 1000, row_errors: field_errors, allow_upload: false, upload_url: ''
                            } only %}
                        </fieldset>
                        <div class="form-text" data-default-format-help>{{ __('Pre-filled for new items. Existing items are not changed.') }}
                            <span data-default-raw-help data-default-help-types="boolean"{% if fields.type != 'boolean' %} hidden{% endif %}>{{ __('Use 1 for Yes and 0 for No.') }}</span>
                            <span data-default-raw-help data-default-help-types="date"{% if fields.type != 'date' %} hidden{% endif %}>{{ __('Enter a date as YYYY-MM-DD, for example 2026-11-06.') }}</span>
                            <span data-default-raw-help data-default-help-types="datetime"{% if fields.type != 'datetime' %} hidden{% endif %}>{{ __('Enter date and time as YYYY-MM-DD HH:MM:SS, for example 2026-11-06 12:30:00.') }}</span></div>
                    </div>
                </div>
            </fieldset>
        </div>

        <div class="col-lg-4">
            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'settings', size: 16} only %}
                    <h2 class="h6 mb-0 ms-2">{{ __('Properties') }}</h2>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <div class="col-12" data-field-role{% if not role_available %} hidden{% endif %}>
                        <label class="form-label" for="field-role">{{ __('Field role') }}</label>
                        <select name="role" class="form-select" id="field-role"{% if managed %} disabled{% endif %}{% if field_errors['role']|default('') %} aria-invalid="true" aria-describedby="error-role"{% endif %}>
                            <option value="">{{ __('Ordinary field') }}</option>
                            {% for role in role_options %}
                                <option value="{{ role.code }}" data-types="{{ role.types|join(' ') }}"{% if role.multiple %} data-multiple{% endif %}{% if fields.role == role.code %} selected{% endif %}>{{ role.label }}</option>
                            {% endfor %}
                        </select>
                        {{ _self.error(field_errors, 'role') }}
                        <div class="form-text">{{ __('A role gives the value a special meaning on the site.') }}</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="sort">{{ __('Sorting') }}</label>
                        <input type="number" name="sort" min="-2147483648" max="2147483647" class="form-control" id="sort" value="{{ fields.sort }}"{% if managed %} disabled{% endif %}{% if field_errors['sort']|default('') %} aria-invalid="true" aria-describedby="error-sort"{% endif %}>
                        {{ _self.error(field_errors, 'sort') }}
                        <div class="form-text">{{ __('The order of the fields in the form of an item and of the columns of the list.') }}{% if layout_sort %} {{ __('The form of an item orders this field by the layout of the collection.') }}{% endif %}</div>
                    </div>
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" role="switch" name="in_list" value="1" id="in_list"{% if fields.in_list %} checked{% endif %}{% if managed %} disabled{% endif %}>
                        <label class="form-check-label" for="in_list">{{ __('Show in the list of items') }}</label>
                        <div class="form-text mt-0">{{ __('The value becomes a column of the list of the items in the panel.') }}</div>
                    </div>
                </div>
            </section>
        </div>
        <input type="hidden" name="collection_form_complete" value="1">
    </form>

    <template data-default-editor-template>
        {% include '@admin/components/ui/editor.twig' with {name: '', id: 'default-editor-template', value: '', label: __('Default value'), allow_upload: false} only %}
    </template>
    {% if managed %}
        <a href="{{ back_url }}" class="btn btn-outline-secondary mt-3">{{ __('Back') }}</a>
    {% else %}
        {% include '@admin/components/ui/form-footer.twig' with {form: 'field-form', cancel_url: back_url} only %}
    {% endif %}
{% endblock %}
