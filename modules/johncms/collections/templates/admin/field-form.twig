{#
    A field of a collection, new or existing.

    @var string form_action
    @var string back_url
    @var int    id           Null when a new field is being added.
    @var array  fields       Values of the form, keyed by field name.
    @var array  type_options Types a field may have, keyed by value.
    @var array  errors       Validation messages, empty on the first render.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger shadow border-0', alert: errors} only %}

    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if id is not null %}
            <input type="hidden" name="id" value="{{ id }}">
        {% endif %}

        <div class="form-group">
            <label for="name">{{ __('Name') }}</label>
            <input type="text" name="name" class="form-control" id="name" value="{{ fields.name }}">
        </div>

        <div class="form-group mt-2">
            <label for="code">{{ __('Code') }}</label>
            <input type="text" name="code" class="form-control" id="code" value="{{ fields.code }}">
            <div class="text-muted small">{{ __('Machine code: lowercase latin letters, digits, hyphen and underscore') }}</div>
        </div>

        <div class="form-group mt-2">
            <label for="type">{{ __('Type') }}</label>
            <select name="type" class="form-control" id="type">
                {% for value, label in type_options %}
                    <option value="{{ value }}"{% if fields.type == value %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group mt-2">
            <label for="sort">{{ __('Sorting') }}</label>
            <input type="number" name="sort" class="form-control" id="sort" value="{{ fields.sort }}">
        </div>

        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" name="required" value="1" id="required"{% if fields.required %} checked{% endif %}>
            <label class="form-check-label" for="required">{{ __('Required') }}</label>
        </div>

        <div class="form-check mt-2">
            <input type="checkbox" class="form-check-input" name="multiple" value="1" id="multiple"{% if fields.multiple %} checked{% endif %}>
            <label class="form-check-label" for="multiple">{{ __('Allow multiple values') }}</label>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">{{ __('Save') }}</button>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
