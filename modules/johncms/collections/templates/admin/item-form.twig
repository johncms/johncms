{#
    An item of a collection, new or existing: what it says and the fields the collection defines on
    the left, when and where the site shows it on the right.

    @var string form_action
    @var string back_url
    @var int    id              Null when a new item is being added.
    @var array  fields          Values of the form, keyed by field name.
    @var bool   has_sections
    @var array  section_options Sections to put the item in, keyed by id, named by their path.
    @var array  field_defs      Fields of the collection: input_name, name, type, multiple,
                                required, value.
    @var array  errors          Validation messages, empty on the first render.
    @var array  field_errors    Validation messages keyed by field name.
#}
{% extends '@admin/layouts/default.twig' %}

{% macro card_head(icon, title) %}
    <div class="card-header">
        {% include '@admin/components/ui/icon.twig' with {name: icon, size: 16} only %}
        <h2 class="h6 mb-0 ms-2">{{ title }}</h2>
    </div>
{% endmacro %}

{% block content %}
    {% if repeat_message|default('') %}<div class="alert alert-info" role="status">{{ repeat_message }}</div>{% endif %}
    {% import _self as ui %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors} only %}

    <form action="{{ form_action }}" method="post" enctype="multipart/form-data" id="item-form" class="row g-3 align-items-start">
        <input type="hidden" name="upload_context" value="{{ fields.upload_context }}">
        <input type="hidden" name="collection_form_started" value="1">
        <input type="hidden" name="back" value="{{ back_url }}">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if id is not null %}
            <input type="hidden" name="id" value="{{ id }}">
        {% endif %}

        <div class="col-lg-8 d-flex flex-column gap-3">
            <section class="card">
                {{ ui.card_head('file-text', workspace_labels.singular) }}
                <div class="card-body">
                    <div class="row g-3">
                        <div class="{{ 'code' in hidden_blocks ? 'col-12' : 'col-md-7' }}">
                            <label class="form-label" for="name">{{ __('Name') }}</label>
                            <input type="text" name="name" class="form-control{{ field_errors.name|default([]) ? ' is-invalid' : '' }}" id="name" value="{{ fields.name }}" required>
                            {% include '@theme/components/field-errors.twig' with {errors: field_errors.name|default([])} only %}
                        </div>
                        {% if 'code' not in hidden_blocks %}
                        <div class="col-md-5">
                            <label class="form-label" for="code">{{ __('Code') }}</label>
                            <input type="text" name="code" class="form-control{{ field_errors.code|default([]) ? ' is-invalid' : '' }} font-monospace" id="code" value="{{ fields.code }}" pattern="[\w.+\-]*">
                            {% include '@theme/components/field-errors.twig' with {errors: field_errors.code|default([])} only %}
                            <div class="form-text">{{ __('The last part of the address. Leave it empty to make it from the name.') }}</div>
                        </div>
                        {% endif %}
                        {% if 'preview_text' not in hidden_blocks %}
                        <div class="col-12">
                            {% include '@admin/components/ui/editor.twig' with {name: 'preview_text', label: __('Preview text'), value: fields.preview_text, allow_upload: true, upload_url: upload_url, errors: field_errors.preview_text|default([])|join(' ')} only %}
                        </div>
                        {% endif %}
                        {% if 'detail_text' not in hidden_blocks %}
                        <div class="col-12">
                            {% include '@admin/components/ui/editor.twig' with {name: 'detail_text', label: __('Detail text'), value: fields.detail_text, allow_upload: true, upload_url: upload_url} only %}
                        </div>
                        {% endif %}
                    </div>
                </div>
            </section>

            {% for group in field_groups %}
                <section class="card">
                    {{ ui.card_head('list', group.title) }}
                    <div class="card-body">
                        <div class="row g-3">
                            {% for def in group.fields %}
                                {% include '@collections/admin/components/item-field.twig' %}
                            {% endfor %}
                        </div>
                    </div>
                </section>
            {% endfor %}
        </div>

        <div class="col-lg-4 d-flex flex-column gap-3">
            <section class="card">
                {{ ui.card_head('check', __('Actions')) }}
                <div class="card-body d-flex flex-column gap-2">
                    <button class="btn btn-outline-primary" type="submit" name="continue" value="1">{{ __('Save and continue editing') }}</button>
                    {% for action in item_actions %}
                        <a class="btn btn-outline-secondary" href="{{ action.url }}" target="_blank" rel="noopener">
                            {% include '@admin/components/ui/icon.twig' with {name: action.icon, size: 14} only %}
                            {{ action.title }}
                        </a>
                    {% endfor %}
                    {% if item_actions %}<div class="form-text">{{ __('Save changes before opening the preview or the published page.') }}</div>{% endif %}
                </div>
            </section>

            {% if not can_publish %}<div class="alert alert-info mb-0">{{ __('Publication settings require a separate permission.') }}</div>{% endif %}
            {% if can_publish and 'publication' not in hidden_blocks %}
            <section class="card">
                {{ ui.card_head('eye', __('Publication')) }}
                <div class="card-body d-flex flex-column gap-3">
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" role="switch" name="active" value="1" id="active"{% if fields.active %} checked{% endif %}>
                        <label class="form-check-label" for="active">{{ __('Active') }}</label>
                        <div class="form-text mt-0">{{ __('A turned off item is not shown on the site, whatever its dates.') }}</div>
                    </div>
                    <div>
                        <label class="form-label" for="active_from">{{ __('Active from') }}</label>
                        <input type="datetime-local" name="active_from" class="form-control{{ field_errors.active_from|default([]) ? ' is-invalid' : '' }}" id="active_from" value="{{ fields.active_from }}">
                            {% include '@theme/components/field-errors.twig' with {errors: field_errors.active_from|default([])} only %}
                    </div>
                    <div>
                        <label class="form-label" for="active_to">{{ __('Active to') }}</label>
                        <input type="datetime-local" name="active_to" class="form-control{{ field_errors.active_to|default([]) ? ' is-invalid' : '' }}" id="active_to" value="{{ fields.active_to }}">
                            {% include '@theme/components/field-errors.twig' with {errors: field_errors.active_to|default([])} only %}
                        <div class="form-text">{{ __('Leave the dates empty to show the item from the moment it is saved and without an end.') }}</div>
                    </div>
                </div>
            </section>
            {% endif %}

            {% if 'place' not in hidden_blocks %}
            <section class="card">
                {{ ui.card_head('folder', has_sections ? __('Place') : __('Order')) }}
                <div class="card-body d-flex flex-column gap-3">
                    {% if has_sections %}
                        <div>
                            <label class="form-label" for="section_id">{{ __('Section') }}</label>
                            {% if not can_move %}<input type="hidden" name="section_id" value="{{ fields.section_id|default(0) }}">{% endif %}
                            <select{% if not can_move %} disabled{% endif %} name="section_id" class="form-select{{ field_errors.section_id|default([]) ? ' is-invalid' : '' }}" id="section_id">
                                <option value="0">{{ __('Without a section') }}</option>
                                {% for section_id, title in section_options %}
                                    <option value="{{ section_id }}"{% if fields.section_id == section_id %} selected{% endif %}>{{ title }}</option>
                                {% endfor %}
                            </select>
                            {% include '@theme/components/field-errors.twig' with {errors: field_errors.section_id|default([])} only %}
                        </div>
                    {% endif %}
                    <div>
                        <label class="form-label" for="sort">{{ __('Sorting') }}</label>
                        <input type="number" name="sort" class="form-control{{ field_errors.sort|default([]) ? ' is-invalid' : '' }}" id="sort" value="{{ fields.sort }}">
                            {% include '@theme/components/field-errors.twig' with {errors: field_errors.sort|default([])} only %}
                        <div class="form-text">{{ __('The smaller the number, the higher the item in the lists.') }}</div>
                    </div>
                </div>
            </section>
            {% endif %}
        </div>
        <input type="hidden" name="collection_form_complete" value="1">
    </form>

    {% include '@admin/components/ui/form-footer.twig' with {form: 'item-form', cancel_url: back_url, sticky: true} only %}
{% endblock %}
