{#
    The fields an item of a collection carries.

    @var string collection_name
    @var array  items           Rows: sort, name, code, type_label, required, multiple, urls.
    @var string add_url
    @var string back_url
    @var string success_message Empty unless an action has just been performed.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}

    <div class="mb-3 text-muted">{{ __('Collection') }}: <b>{{ collection_name }}</b></div>

    <div class="mb-3">
        <a href="{{ add_url }}" class="btn btn-primary btn-sm">{{ __('New field') }}</a>
    </div>

    {% if items is empty %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: __('The list is empty')} only %}
    {% endif %}

    {% for item in items %}
        <div class="new_post-item without_avatar">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span class="text-muted me-1">[{{ item.sort }}]</span>
                    <a href="{{ item.edit_url }}" class="h3 mb-0">{{ item.name }}</a>
                    <span class="badge rounded-pill text-bg-light border ms-2">{{ item.code }}</span>
                </div>
                <span class="badge rounded-pill bg-secondary">{{ item.type_label }}</span>
            </div>
            <div class="small text-muted mt-1">
                {% if item.required %}<span class="me-2">{{ __('Required') }}</span>{% endif %}
                {% if item.multiple %}<span>{{ __('Multiple') }}</span>{% endif %}
            </div>
            <div class="mt-2">
                <a href="{{ item.edit_url }}">{{ __('Edit') }}</a>
                <a href="{{ item.delete_url }}" class="text-danger ms-2">{{ __('Delete') }}</a>
            </div>
        </div>
    {% endfor %}

    <div class="mt-3">
        <a href="{{ back_url }}">{{ __('Back') }}</a>
    </div>
{% endblock %}
