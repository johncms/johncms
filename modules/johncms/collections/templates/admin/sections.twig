{#
    The sections of a collection, a tab of it: the whole tree, each section under its parent, with
    the items of its subtree.

    @var array  rows    Rows: id, name, code, active, depth, items (in the section itself),
                        items_in_subtree, items_url, edit_url, actions.
    @var string add_url

    The head of the collection comes from collection/layout.twig.
#}
{% extends '@collections/admin/collection/layout.twig' %}

{% block collection_actions %}
    <a href="{{ add_url }}" class="btn btn-primary">
        {% include '@admin/components/ui/icon.twig' with {name: 'plus', size: 14} only %}
        {{ __('New section') }}
    </a>
{% endblock %}

{% block collection_content %}
    <div class="card">
        {% if rows is empty %}
            {% include '@admin/components/ui/empty-state.twig' with {
                icon: 'folder',
                title: __('There are no sections yet'),
                description: __('Sections group the items into a tree and become a part of their address on the site.'),
            } only %}
            <div class="text-center pb-4">
                <a href="{{ add_url }}" class="btn btn-outline-secondary">
                    {% include '@admin/components/ui/icon.twig' with {name: 'plus', size: 14} only %}
                    {{ __('New section') }}
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle admin-collection-tree">
                    <thead>
                        <tr>
                            <th scope="col">{{ __('Section') }}</th>
                            <th scope="col" class="text-end">{{ __('Items') }}</th>
                            <th scope="col">{{ __('Status') }}</th>
                            <th scope="col"><span class="visually-hidden">{{ __('Actions') }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr class="{{ row.depth == 0 ? 'admin-collection-tree__root' }}">
                                <td>
                                    <div class="admin-collection-tree__section" style="--depth: {{ row.depth }}">
                                        {% include '@admin/components/ui/icon.twig' with {name: 'folder', size: 15, class: 'admin-collection-tree__icon'} only %}
                                        <div class="min-w-0">
                                            <a class="admin-collection-tree__name" href="{{ row.edit_url }}">{{ row.name }}</a>
                                            <div class="admin-collection-tree__code">{{ row.code }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end">
                                    {# The link leads to the items of the section and of those under it, so the number counts them all. #}
                                    {% if row.items_in_subtree %}
                                        <a class="admin-collection-tree__number" href="{{ row.items_url }}">{{ row.items_in_subtree|format_number }}</a>
                                    {% else %}
                                        <span class="admin-collection-tree__number text-body-tertiary">0</span>
                                    {% endif %}
                                    {% if row.items != row.items_in_subtree %}
                                        <div class="admin-collection-tree__code">{{ __('Own: %s')|format(row.items|format_number) }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if row.active %}
                                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis badge-dot">{{ __('Shown') }}</span>
                                    {% else %}
                                        <span class="badge rounded-pill text-bg-light badge-dot">{{ __('Hidden') }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    {% include '@admin/components/ui/row-actions.twig' with {actions: row.actions, label: __('Actions')} only %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
