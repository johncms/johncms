{#
    The items of a collection, a tab of it: a search, the section and the status, and a table with
    the fields the collection shows as columns.

    The page is a live list (src/admin/js/live-list.js): the regions are drawn by templates of their
    own, and collections::admin/items-live puts them back in place as the search is typed or a
    filter is picked.

    @var array        controls     Built by ItemListControlsMapper.
    @var list<string> columns      The names of the fields shown as columns.
    @var bool         has_sections
    @var array        rows         Built by ItemListRowMapper.
    @var string       search
    @var int          total        What the filter lets through.
    @var \Twig\Markup pagination
    @var string       add_url

    The head of the collection comes from collection/layout.twig.
#}
{% extends '@collections/admin/collection/layout.twig' %}

{% block collection_actions %}
    {% if can_create %}
    <a href="{{ add_url }}" class="btn btn-primary">
        {% include '@admin/components/ui/icon.twig' with {name: 'plus', size: 14} only %}
        {{ create_label }}
    </a>
    {% endif %}
{% endblock %}

{% block collection_content %}
    <div data-live-list>
        <form class="admin-toolbar" method="get" action="{{ controls.action }}" role="search" data-live-list-form>
            {% include '@admin/components/ui/search-field.twig' with {
                name: 'q',
                value: search,
                label: __('Search the items'),
                placeholder: __('Name, code or ID'),
            } only %}
            {% include '@admin/components/list-state.twig' with {controls: controls} only %}
            {% include '@admin/components/list-filters.twig' with {controls: controls} only %}
        </form>

{% include '@collections/admin/components/list-options.twig' with {controls: controls, options: list_controls} only %}
        {% include '@collections/admin/items-results.twig' with {
            controls: controls,
            columns: columns, bulk: bulk, meta_columns: meta_columns,
            has_sections: has_sections,
            rows: rows,
            total: total,
            pagination: pagination,
            add_url: add_url, can_create: can_create, create_label: create_label,
        } only %}
        {% if bulk %}
            {# Shown by src/admin/js/collection-bulk.js once a record is selected; the form above serves without it. #}
            <div class="collection-bulk-bar" data-bulk-bar data-limit="100" data-count-label="{{ __('Selected: %d') }}" data-hidden-label="{{ __('%d not shown') }}" data-limit-label="{{ __('Select at most %d records.') }}" hidden>
                <span class="collection-bulk-bar__count" data-bulk-count></span>
                <div class="collection-bulk-bar__actions">
                    {% if 'publish' in bulk.actions|keys %}<button type="button" class="btn btn-outline-secondary btn-sm" data-bulk-action="publish">{{ __('Publish') }}</button>{% endif %}
                    {% if 'hide' in bulk.actions|keys %}<button type="button" class="btn btn-outline-secondary btn-sm" data-bulk-action="hide">{{ __('Hide') }}</button>{% endif %}
                    {% if 'move' in bulk.actions|keys %}
                        <div class="dropup">
                            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">{{ __('Move to') }}</button>
                            <ul class="dropdown-menu collection-bulk-bar__sections">
                                <li><button type="button" class="dropdown-item" data-bulk-action="move" data-bulk-target="0">{{ __('Without a section') }}</button></li>
                                {% for id, title in bulk.sections %}<li><button type="button" class="dropdown-item" data-bulk-action="move" data-bulk-target="{{ id }}">{{ title }}</button></li>{% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                    {% if 'delete' in bulk.actions|keys %}<button type="button" class="btn btn-outline-danger btn-sm" data-bulk-action="delete">{% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %} {{ __('Delete') }}</button>{% endif %}
                </div>
                <button type="button" class="btn btn-link btn-sm collection-bulk-bar__clear" data-bulk-clear>{{ __('Clear selection') }}</button>
                <span class="collection-bulk-bar__limit text-danger" data-bulk-limit hidden></span>
            </div>
        {% endif %}
    </div>
{% endblock %}
