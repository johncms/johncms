{#
    The items of a collection.

    @var array        items           Rows: sort, name, code, active and the urls.
    @var string       add_url
    @var \Twig\Markup pagination

    The head of the collection comes from collection/layout.twig.
#}
{% extends '@collections/admin/collection/layout.twig' %}

{% block collection_actions %}
    <a href="{{ add_url }}" class="btn btn-primary">
        {% include '@admin/components/ui/icon.twig' with {name: 'plus', size: 14} only %}
        {{ __('New item') }}
    </a>
{% endblock %}

{% block collection_content %}
    {% if items is empty %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: __('The list is empty')} only %}
    {% endif %}

    {% for item in items %}
        <div class="new_post-item without_avatar">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span class="text-muted me-1">[{{ item.sort }}]</span>
                    <a href="{{ item.edit_url }}" class="h3 mb-0">{{ item.name }}</a>
                    <span class="badge rounded-pill text-bg-light border ms-2">{{ item.code }}</span>
                </div>
                <div>
                    {% if item.active %}
                        <span class="badge rounded-pill bg-success">{{ __('On') }}</span>
                    {% else %}
                        <span class="badge rounded-pill bg-danger">{{ __('Off') }}</span>
                    {% endif %}
                </div>
            </div>
            <div class="mt-2">
                <a href="{{ item.edit_url }}">{{ __('Edit') }}</a>
                <a href="{{ item.delete_url }}" class="text-danger ms-2" data-admin-modal>{{ __('Delete') }}</a>
            </div>
        </div>
    {% endfor %}

    <div class="mt-4">{{ pagination }}</div>

{% endblock %}
