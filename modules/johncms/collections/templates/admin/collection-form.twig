{#
    A new collection. The settings of an existing one are a tab of it (collection/settings.twig).

    @var string form_action
    @var int    id         Null: the collection is new.
    @var array  fields     Values of the form, keyed by field name.
    @var array  errors     Validation messages, empty on the first render.
    @var string cancel_url
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@collections/admin/collection/form.twig' with {form_action: form_action, id: id, fields: fields, errors: errors} only %}
    {% include '@admin/components/ui/form-footer.twig' with {form: 'collection-form', cancel_url: cancel_url} only %}
{% endblock %}
