{#
    A collection, new or existing.

    @var string form_action
    @var int    id     Null when a new collection is being added.
    @var array  fields Values of the form, keyed by field name.
    @var array  errors Validation messages, empty on the first render.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger shadow border-0', alert: errors} only %}

    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if id is not null %}
            <input type="hidden" name="id" value="{{ id }}">
        {% endif %}

        <div class="form-group">
            <label for="name">{{ __('Name') }}</label>
            <input type="text" name="name" class="form-control" id="name" value="{{ fields.name }}">
        </div>

        <div class="form-group mt-2">
            <label for="code">{{ __('Code') }}</label>
            <input type="text" name="code" class="form-control" id="code" value="{{ fields.code }}">
            <div class="text-muted small">{{ __('Machine code for the URL and API: lowercase latin letters, digits, hyphen and underscore') }}</div>
        </div>

        <div class="form-group mt-2">
            <label for="description">{{ __('Description') }}</label>
            <textarea name="description" class="form-control" id="description" rows="3">{{ fields.description }}</textarea>
        </div>

        <div class="form-group mt-2">
            <label for="sort">{{ __('Sorting') }}</label>
            <input type="number" name="sort" class="form-control" id="sort" value="{{ fields.sort }}">
        </div>

        <div class="form-group mt-2">
            <label for="per_page">{{ __('Items per page') }}</label>
            <input type="number" name="per_page" class="form-control" id="per_page" min="1" value="{{ fields.per_page }}">
        </div>

        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" name="has_sections" value="1" id="has_sections"{% if fields.has_sections %} checked{% endif %}>
            <label class="form-check-label" for="has_sections">{{ __('Use sections') }}</label>
        </div>

        <div class="form-check mt-2">
            <input type="checkbox" class="form-check-input" name="active" value="1" id="active"{% if fields.active %} checked{% endif %}>
            <label class="form-check-label" for="active">{{ __('Active') }}</label>
        </div>

        <div class="form-check mt-2">
            <input type="checkbox" class="form-check-input" name="public" value="1" id="public"{% if fields.public %} checked{% endif %}>
            <label class="form-check-label" for="public">{{ __('Public (accessible by URL)') }}</label>
            <div class="text-muted small">{{ __('A private collection has no public page and is available only through the API') }}</div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">{{ __('Save') }}</button>
            <a href="/admin/collections" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
