{#
    The settings of a collection, a tab of it, and the deleting of it at the bottom.

    @var string form_action
    @var int    id
    @var array  fields     Values of the form, keyed by field name.
    @var array  errors     Validation messages, empty on the first render.
    @var string cancel_url
    @var string delete_url

    The head of the collection comes from collection/layout.twig.
#}
{% extends '@collections/admin/collection/layout.twig' %}

{% block collection_content %}
    {% include '@collections/admin/collection/form.twig' with {form_action: form_action, id: id, fields: fields, errors: errors} only %}
    {% include '@admin/components/ui/form-footer.twig' with {form: 'collection-form', cancel_url: cancel_url} only %}

    <section class="card border-danger-subtle mt-4">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h2 class="h6 mb-1">{{ __('Delete collection') }}</h2>
                <div class="text-body-secondary small">{{ __('The collection is deleted with all its items, sections and fields. This cannot be undone.') }}</div>
            </div>
            <a href="{{ delete_url }}" class="btn btn-outline-danger" data-admin-modal>
                {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
                {{ __('Delete collection') }}
            </a>
        </div>
    </section>
{% endblock %}
