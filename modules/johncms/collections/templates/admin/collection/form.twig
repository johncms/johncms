{#
    The fields of the form of a collection, shared by a new collection and its settings.

    @param string form_action
    @param int    id     Null for a new collection.
    @param array  fields Values of the form, keyed by field name.
    @param array  errors Validation messages, empty on the first render.
#}
{% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors} only %}

<form action="{{ form_action }}" method="post" id="collection-form" class="row g-3 align-items-start">
    <input type="hidden" name="collection_form_started" value="1">
    <input type="hidden" name="workspace_present" value="1">
    <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
    {% if id is not null %}
        <input type="hidden" name="id" value="{{ id }}">
    {% endif %}

    <div class="col-lg-8">
        <section class="card">
            <div class="card-header">
                {% include '@admin/components/ui/icon.twig' with {name: 'layout-grid', size: 16} only %}
                <h2 class="h6 mb-0 ms-2">{{ __('Collection') }}</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6" data-slug-name>
                        <label class="form-label" for="name">{{ __('Name') }}</label>
                        <input type="text" name="name" class="form-control" id="name" value="{{ fields.name }}" required{% if fields.managed|default(false) %} readonly{% endif %}>
                    </div>
                    <div class="col-md-6" data-slug-code>
                        {% if fields.managed|default(false) %}
                            <label class="form-label" for="code">{{ __('Code') }}</label>
                            <input type="text" name="code" class="form-control font-monospace" id="code" value="{{ fields.code }}" readonly>
                        {% else %}
                            {% include '@admin/components/ui/slug-field.twig' with {
                                label: __('Code'), value: fields.code, linked: fields.slug_linked ?? true, slug_url: '/admin/collections/slug', required: true,
                                hint: __('The address of the collection on the site and its name in the API: lowercase latin letters, digits, hyphen and underscore.'),
                            } only %}
                        {% endif %}
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="content_permission">{{ __('Content permission') }}</label>
                        {% if fields.managed|default(false) %}
                            <input type="hidden" name="content_permission" value="{{ fields.content_permission }}">
                        {% endif %}
                        <select name="content_permission" class="form-select" id="content_permission"{% if fields.managed|default(false) %} disabled{% endif %}>
                            {% for key, label in fields.permission_options %}
                                <option value="{{ key }}"{% if key == fields.content_permission %} selected{% endif %}>{{ label }} ({{ key }})</option>
                            {% endfor %}
                        </select>
                        <div class="form-text">{{ __('Grant this permission to editors of this collection. Structure management requires collections.manage.') }}</div>
                    </div>
                    {% if fields.search_options is not empty %}
                        <div class="col-12">
                            <span class="form-label d-block">{{ __('Additional searchable fields') }}</span>
                            {% for code, label in fields.search_options %}
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="search_{{ code }}" name="search_fields[]" value="{{ code }}"{% if code in fields.search_fields %} checked{% endif %}>
                                    <label class="form-check-label" for="search_{{ code }}">{{ label }}</label>
                                </div>
                            {% endfor %}
                            <div class="form-text">{{ __('The name, preview and text are always searched. Select additional text fields here.') }}</div>
                        </div>
                    {% endif %}
                    <div class="col-12">
                        <label class="form-label" for="description">{{ __('Description') }}</label>
                        <textarea name="description" class="form-control" id="description" rows="3">{{ fields.description }}</textarea>
                    </div>
                </div>
            </div>
        </section>
        <section class="card mt-3">
            <div class="card-header"><h2 class="h6 mb-0">{{ __('Workspace labels') }}</h2></div>
            <div class="card-body">
                <p class="form-text">{{ __('Custom labels are shown as entered. Leave a label empty to use its translated default.') }}</p>
                <div class="row g-3">
                    {% for key, label in fields.workspace_label_titles %}
                        <div class="col-md-6">
                            <label class="form-label" for="workspace-label-{{ key }}">{{ label }}</label>
                            <input class="form-control" id="workspace-label-{{ key }}" name="workspace_labels[{{ key }}]" maxlength="120" value="{{ fields.workspace_labels[key]|default('') }}" placeholder="{{ fields.workspace_defaults[key] }}">
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
        <section class="card mt-3">
            <div class="card-header"><h2 class="h6 mb-0">{{ __('Record form layout') }}</h2></div>
            <div class="card-body">
                <input type="hidden" name="layout_present" value="1">
                <p class="form-text">{{ __('Group and order fields without changing their schema. Empty values inherit the module defaults.') }}</p>
                {% for row in fields.layout_rows %}
                    <div class="row g-2 mb-3 align-items-end">
                        <div class="col-md-4"><span class="form-label d-block">{{ row.name }}</span></div>
                        <div class="col-md-5">
                            <label class="form-label" for="layout-group-{{ row.code }}">{{ __('Group') }}</label>
                            <input class="form-control" id="layout-group-{{ row.code }}" name="layout_fields[{{ row.code }}][group]" maxlength="120" value="{{ row.group }}" placeholder="{{ row.default_group }}">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="layout-sort-{{ row.code }}">{{ __('Order') }}</label>
                            <input class="form-control" type="number" id="layout-sort-{{ row.code }}" name="layout_fields[{{ row.code }}][sort]" min="-1000000" max="1000000" value="{{ row.sort }}" placeholder="{{ row.default_sort }}">
                        </div>
                    </div>
                {% endfor %}
                <fieldset>
                    <legend class="h6">{{ __('Hidden blocks') }}</legend>
                    <p class="form-text">{{ __('Hidden values are preserved when editing. The name is always visible and required.') }}</p>
                    {% for key, title in fields.layout_blocks %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="hide-{{ key }}" name="hidden_blocks[]" value="{{ key }}"{% if key in fields.workspace_layout.hidden_blocks|default([]) %} checked{% endif %}>
                            <label class="form-check-label" for="hide-{{ key }}">{{ title }}</label>
                        </div>
                    {% endfor %}
                </fieldset>
            </div>
        </section>
        <section class="card mt-3">
            <div class="card-header"><h2 class="h6 mb-0">{{ __('Record list') }}</h2></div>
            <div class="card-body">
                <input type="hidden" name="listing_present" value="1">
                <div class="row g-3">
                    <fieldset class="col-md-6"><legend class="h6">{{ __('Columns') }}</legend>
                        {% for key, title in fields.listing_columns %}
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="list-column-{{ key }}" name="list_columns[]" value="{{ key }}"{% if key in fields.listing_values.columns %} checked{% endif %}><label class="form-check-label" for="list-column-{{ key }}">{{ title }}</label></div>
                        {% endfor %}
                    </fieldset>
                    <fieldset class="col-md-6"><legend class="h6">{{ __('Additional filters') }}</legend>
                        {% for key, title in fields.listing_filters %}
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="list-filter-{{ key }}" name="list_filters[]" value="{{ key }}"{% if key in fields.listing_values.filters %} checked{% endif %}><label class="form-check-label" for="list-filter-{{ key }}">{{ title }}</label></div>
                        {% endfor %}
                    </fieldset>
                    <div class="col-md-6"><label class="form-label" for="default-order">{{ __('Default sort') }}</label><select class="form-select" id="default-order" name="list_order">{% for key, title in fields.listing_sorts %}<option value="{{ key }}"{% if key == fields.listing_values.sort.field %} selected{% endif %}>{{ title }}</option>{% endfor %}</select></div>
                    <div class="col-md-6"><label class="form-label" for="default-direction">{{ __('Direction') }}</label><select class="form-select" id="default-direction" name="list_direction"><option value="asc"{% if fields.listing_values.sort.direction == 'asc' %} selected{% endif %}>{{ __('Ascending') }}</option><option value="desc"{% if fields.listing_values.sort.direction == 'desc' %} selected{% endif %}>{{ __('Descending') }}</option></select></div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-lg-4 d-flex flex-column gap-3">
        <section class="card">
            <div class="card-header"><h2 class="h6 mb-0">{{ __('Content action permissions') }}</h2></div>
            <div class="card-body d-flex flex-column gap-3">
                <input type="hidden" name="action_permissions_present" value="1">
                <p class="form-text">{{ __('Each action also requires content access. Empty selections inherit the content permission; schema managers keep full access.') }}</p>
                {% for action, title in fields.action_titles %}
                    <div>
                        <label class="form-label" for="permission-{{ action }}">{{ title }}</label>
                        <select class="form-select" id="permission-{{ action }}" name="action_permissions[{{ action }}]">
                            <option value="">{{ __('Use content permission') }}</option>
                            {% for key, label in fields.permission_options %}<option value="{{ key }}"{% if fields.action_permissions[action]|default('') == key %} selected{% endif %}>{{ label }} ({{ key }})</option>{% endfor %}
                        </select>
                    </div>
                {% endfor %}
            </div>
        </section>
        <section class="card">
            <div class="card-header">
                {% include '@admin/components/ui/icon.twig' with {name: 'eye', size: 16} only %}
                <h2 class="h6 mb-0 ms-2">{{ __('Visibility') }}</h2>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" role="switch" name="active" value="1" id="active"{% if fields.active %} checked{% endif %}>
                    <label class="form-check-label" for="active">{{ __('Active') }}</label>
                    <div class="form-text mt-0">{{ __('A turned off collection is not shown on the site and not given out by the API.') }}</div>
                </div>
                <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" role="switch" name="public" value="1" id="public"{% if fields.public %} checked{% endif %}{% if fields.managed|default(false) %} disabled{% endif %}>
                    <label class="form-check-label" for="public">{{ __('Public (accessible by URL)') }}</label>
                    <div class="form-text mt-0">{{ __('A private collection has no public page and is available only through the API') }}</div>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-header">
                {% include '@admin/components/ui/icon.twig' with {name: 'list-tree', size: 16} only %}
                <h2 class="h6 mb-0 ms-2">{{ __('Structure') }}</h2>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" role="switch" name="has_sections" value="1" id="has_sections"{% if fields.has_sections %} checked{% endif %}>
                    <label class="form-check-label" for="has_sections">{{ __('Use sections') }}</label>
                    <div class="form-text mt-0">{{ __('Items are grouped into a tree of sections, and the sections become a part of their address.') }}</div>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" for="per_page">{{ __('Items per page') }}</label>
                        <input type="number" name="per_page" class="form-control" id="per_page" min="1" value="{{ fields.per_page }}">
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="sort">{{ __('Sorting') }}</label>
                        <input type="number" name="sort" class="form-control" id="sort" value="{{ fields.sort }}">
                    </div>
                </div>
                <div class="form-text mt-0">{{ __('The sorting orders the collections in the list of the panel: the smaller the number, the higher.') }}</div>
            </div>
        </section>
    </div>
<input type="hidden" name="collection_form_complete" value="1">
</form>
