{# @var item \Johncms\Modules\Collections\Application\DTO\PublicItemDetailDTO #}
    {# HTML values and texts are rendered by the shared content pipeline. #}
    {% if item.previewText %}
        <div class="lead mb-3">{{ item.previewText }}</div>
    {% endif %}

    {% if item.detailText %}
        <div class="mb-3">{{ item.detailText }}</div>
    {% endif %}

    {% if item.values is not empty %}
        <dl class="row">
            {% for value in item.values %}
                <dt class="col-sm-3">{{ value.label }}</dt>
                <dd class="col-sm-9">
                    {% if value.files|default([]) %}
                        {% for file in value.files %}<a href="{{ file.url }}">{{ file.name }}</a> <span class="small text-body-secondary">({{ file.size|format_size }})</span>{% if not loop.last %}, {% endif %}{% endfor %}
                    {% else %}
                        {% for entry in value.values %}{{ entry }}{% if not loop.last %}, {% endif %}{% endfor %}
                    {% endif %}
                </dd>
            {% endfor %}
        </dl>
    {% endif %}
