{#
    @var post \Johncms\Modules\Guestbook\Application\DTO\GuestbookEntryDTO
    @var can_write bool
#}
<article class="site-comment" id="guestbook-entry-{{ post.id }}"{% if added|default(false) %} data-live-list-target{% endif %}>
    <div class="site-comment__avatar">
        {% if post.user and post.user.profileUrl %}<a href="{{ post.user.profileUrl }}">{% endif %}
        <img src="{{ avatar(post.user ? post.user.id : 0) }}" alt="" width="40" height="40" loading="lazy">
        {% if post.user and post.user.profileUrl %}</a>{% endif %}
        {% if post.isOnline %}<span class="site-comment__online"></span>{% endif %}
    </div>
    <div class="site-comment__main">
        <header class="site-comment__header">
            {% if post.user and post.user.profileUrl %}
                <a class="site-comment__name" href="{{ post.user.profileUrl }}">{{ post.name }}</a>
            {% else %}
                <span class="site-comment__name">{{ post.user ? post.name : __('Guest') ~ ': ' ~ post.name }}</span>
            {% endif %}
            {% if post.user and post.user.rightsName %}<span class="site-comment__role">{{ post.user.rightsName }}</span>{% endif %}
            <time class="site-comment__date">{{ post.createdAt }}</time>
            {% if post.editCount %}
                <span class="site-comment__date" title="{{ __('Edited:') }} {{ post.updatedBy }} ({{ post.updateAt }}) [{{ post.editCount }}]">{{ __('Edited') }}</span>
            {% endif %}
            <a class="site-comment__anchor" href="#guestbook-entry-{{ post.id }}">#{{ post.id }}</a>
        </header>
        {% if post.user and post.user.status %}<div class="site-comment__status">{{ post.user.status }}</div>{% endif %}
        <div class="site-comment__body ck-content">
            {{ post.text }}
            {% if post.replyText %}
                <div class="site-comment__reply">
                    <div class="site-comment__header"><b class="site-comment__name">{{ post.repliedBy }}</b><time class="site-comment__date">{{ post.repliedAt }}</time></div>
                    {{ post.replyText }}
                </div>
            {% endif %}
        </div>
        {% if can_write or post.meta %}
            <footer class="site-comment__footer">
                {% if post.meta and (post.meta.ip or post.meta.userAgent) %}
                    <div class="site-guestbook__meta">
                        {% if post.meta.ip %}
                            <a class="site-guestbook__ip" href="{{ post.meta.searchIpUrl }}" dir="ltr">{{ post.meta.ip }}</a>
                        {% endif %}
                        {% if post.meta.userAgent %}
                            <span class="site-guestbook__agent" dir="ltr" title="{{ post.meta.userAgent }}">{{ post.meta.userAgent }}</span>
                        {% endif %}
                    </div>
                {% endif %}
                <div class="site-comment__actions">
                    {% if can_write and post.userId != (app.user.isValid ? app.user.id : 0) %}
                        <a class="btn btn-outline-secondary btn-xs" href="#message2" data-editor-reply="{{ post.name }}">
                            {% include '@theme/components/icon.twig' with {name: 'message-square', size: 12} only %} {{ __('Reply') }}
                        </a>
                    {% endif %}
                    {% if post.meta and post.meta.canManage %}
                        <details class="site-popover" data-site-popover>
                            <summary class="btn btn-outline-secondary btn-xs btn-icon" aria-label="{{ __('Edit') }}">
                                {% include '@theme/components/icon.twig' with {name: 'chevron-down', size: 12} only %}
                            </summary>
                            <div class="site-popover__panel">
                                {% if post.meta.replyUrl %}
                                    <a class="site-popover__item" href="{{ post.meta.replyUrl }}">
                                        {% include '@theme/components/icon.twig' with {name: 'message-square', size: 14} only %}
                                        <span>{{ __('Reply') }}</span>
                                    </a>
                                {% endif %}
                                <a class="site-popover__item" href="{{ post.meta.editUrl }}">
                                    {% include '@theme/components/icon.twig' with {name: 'pencil', size: 14} only %}
                                    <span>{{ __('Edit') }}</span>
                                </a>
                                <form method="post" action="{{ post.meta.deleteUrl }}" data-live-list-form data-confirm="{{ __('Delete this message?') }}" data-confirm-button="{{ __('Delete') }}">
                                    <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                                    <input type="hidden" name="id" value="{{ post.id }}">
                                    <button type="submit" class="site-popover__item">
                                        {% include '@theme/components/icon.twig' with {name: 'trash-2', size: 14} only %}
                                        <span>{{ __('Delete') }}</span>
                                    </button>
                                </form>
                            </div>
                        </details>
                    {% endif %}
                </div>
            </footer>
        {% endif %}
    </div>
</article>
