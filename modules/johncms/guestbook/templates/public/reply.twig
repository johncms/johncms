{#
    @var id int
    @var author string
    @var post_text \Twig\Markup Text of the entry being replied to.
    @var text string Raw text of the reply, for editing.
    @var errors array
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    <div class="d-flex flex-column gap-4">
        {% embed '@theme/components/content-card.twig' with {
            title: __('Message'),
            icon: 'message-square',
            entry_id: id,
            author: author,
            post_text: post_text
        } only %}
            {% block body %}
                <div class="site-comment__header">
                    <span class="site-comment__name">{{ author }}</span>
                    <a class="site-comment__anchor" href="/guestbook/#guestbook-entry-{{ entry_id }}">#{{ entry_id }}</a>
                </div>
                <div class="site-comment__body ck-content">{{ post_text }}</div>
            {% endblock %}
        {% endembed %}

        <section class="site-compose mt-0" aria-labelledby="guestbook-reply-title">
            {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors._form|default([])} only %}
            <form class="site-compose__form" action="/guestbook/otvet?id={{ id }}" method="post">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}"/>
                <h2 class="h6 mb-0 p-3 border-bottom" id="guestbook-reply-title">{{ __('Reply') }}</h2>
                {% include '@theme/components/editor.twig' with {
                    name: 'message',
                    id: 'message2',
                    label: __('Reply'),
                    label_hidden: true,
                    placeholder: __('Reply'),
                    errors: errors.message|default([])|join(', '),
                    value: text,
                    upload_url: '/guestbook/upload_file/',
                    allow_upload: true
                } only %}
                <div class="site-compose__actions flex-wrap gap-2 justify-content-between">
                    <a href="/guestbook/#guestbook-entry-{{ id }}" class="btn btn-outline-secondary">
                        {% include '@theme/components/icon.twig' with {name: 'chevron-left', size: 14, class: 'site-icon--directional'} only %}
                        {{ __('Back') }}
                    </a>
                    <button type="submit" name="submit" value="submit" class="btn btn-primary">
                        {% include '@theme/components/icon.twig' with {name: 'check', size: 14} only %}
                        {{ __('Save') }}
                    </button>
                </div>
            </form>
        </section>
    </div>
{% endblock %}
