{#
    @var int messages_total Total messages in the current chat.
    @var summary string Description of the current chat.
    @param list<GuestbookEntryDTO> posts
    @param ?Markup                 pagination
    @param bool                    can_write
    @param bool                    can_clear
    @param array                   errors     Validation messages of the form.
    @param array                   form_data  Values the visitor has entered.
    @param ?\Johncms\Captcha\CaptchaChallenge captcha The verification, or null when none is asked for.
    @param string                  message    Flash message about the last action.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    {% include '@guestbook/public/components/subtitle.twig' with {messages_total: messages_total, summary: summary} only %}
{% endblock %}

{% block content %}
    <div class="site-guestbook" id="guestbook" data-live-list>
    {% if can_write %}
        <section class="site-compose">
            <div>
                {% include '@guestbook/public/components/feedback.twig' with {errors: errors} only %}
                <form class="site-compose__form" name="form" data-live-list-form data-guestbook-form action="/guestbook/{{ page > 1 ? '?page=' ~ page : '' }}" method="post">
                    <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}"/>
                    {% if app.user.isValid %}
                        <div class="site-guestbook__identity"><img src="{{ avatar(app.user.id) }}" alt="" width="32" height="32"><span>{{ app.user.name }}</span></div>
                    {% else %}
                        <div class="site-guestbook__field">
                            <label for="name">{{ __('Name') }}</label>
                            <input type="text"
                                   class="form-control "
                                   maxlength="25"
                                   name="name"
                                   id="name"
                                   required
                                   value="{{ form_data.name|default('') }}"
                                   placeholder="{{ __('Name') }}"
                            >
                        </div>
                    {% endif %}

                    {% include '@theme/components/editor.twig' with {
                        name: 'message',
                        id: 'message2',
                        label: __('Message'),
                        label_hidden: true,
                        placeholder: __('Message'),
                        value: form_data.message|default(''),
                        upload_url: '/guestbook/upload_file/',
                        allow_upload: true
                    } only %}

                    {% include '@guestbook/public/components/captcha.twig' with {captcha: captcha} only %}

                    <div class="site-compose__actions"><button type="submit" class="btn btn-primary" name="submit" value="1">{% include '@theme/components/icon.twig' with {name: 'send', size: 14} only %} {{ __('Write') }}</button></div>
                </form>
            </div>
        </section>
    {% elseif not app.user.isValid %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: __('For registered users only')} only %}
    {% endif %}


    {% include '@guestbook/public/components/feed.twig' with {posts: posts, pagination: pagination, can_write: can_write, message: message, added: added} only %}

    {% if can_clear %}
        <div class="d-flex mt-4 pb-2">
            <form method="post" action="/guestbook/clean" data-live-list-form data-confirm="{{ __('Clear guestbook') }}" data-confirm-button="{{ __('Clear') }}" data-confirm-fields="guestbook-clear-fields">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                <button type="submit" class="btn btn-outline-danger btn-sm">{{ __('Clear') }}</button>
            </form>
            <template id="guestbook-clear-fields">
                {% for value, label in {0: __('Older than 1 week'), 1: __('Older than 1 day'), 2: __('Clear all')} %}
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="cl" value="{{ value }}" id="guestbook-clear-{{ value }}"{% if loop.first %} checked{% endif %}>
                        <label class="form-check-label" for="guestbook-clear-{{ value }}">{{ label }}</label>
                    </div>
                {% endfor %}
            </template>
        </div>
    {% endif %}
    </div>
{% endblock %}
