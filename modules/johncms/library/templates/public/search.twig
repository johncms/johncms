{#
    Full text search over the library.

    @param string  query     What was searched for, empty on the first visit.
    @param bool    in_titles
    @param int     total
    @param array[] results   name and text carry the highlighting, so they are markup.
    @param ?Markup pagination
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form action="/library/search" method="get" class="mb-3">
        <div class="form-group">
            <label for="search">{{ __('Search query') }}</label>
            <input type="text" class="form-control" id="search" placeholder="{{ __('Search query') }}"
                   name="search" value="{{ query }}" maxlength="64" minlength="2" required>
        </div>
        <div class="form-group">
            <div class="custom-control custom-checkbox mb-3">
                <input type="checkbox" class="custom-control-input" name="t" value="1" id="search_t"{% if in_titles %} checked{% endif %}>
                <label class="custom-control-label" for="search_t">{{ __('Search in titles Articles') }}</label>
            </div>
        </div>
        <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Search') }}</button>
    </form>
    {% if total %}
        {% for result in results %}
            <div class="new_post-item without_avatar">
                <a href="{{ result.url }}" class="card-title h3">{{ result.name }}</a>
                <div class="post-body">{{ result.text }}</div>
                <div class="text-muted small d-flex align-items-center flex-wrap">
                    <div class="me-2">
                        <span>{{ __('Author:') }}</span>
                        {%- include '@library/public/components/uploader.twig' with {
                            user_id: result.uploader_id,
                            name: result.uploader,
                            date: result.date
                        } only %}
                    </div>
                    <div>
                        {{ __('Number of readings:') }} {{ result.count_views }}
                    </div>
                </div>
            </div>
        {% endfor %}
        <div class="mt-3">{{ __('Total') }}: {{ total }}</div>
        {% if pagination %}
            <div>{{ pagination }}</div>
        {% endif %}
    {% else %}
        {% if query %}
            <div class="row">
                <div class="col-md-6">
                    <div class="alert alert-info">{{ __('The list is empty') }}</div>
                </div>
            </div>
        {% endif %}
        <div class="row">
            <div class="col-md-6">
                <div class="alert alert-info">{{ __('Length of query: 4 min 64 max<br>Search is case-insensitive letters<br>Results are sorted by relevance')|raw }}</div>
            </div>
        </div>
    {% endif %}

    <div class="mt-2">
        {% if query %}
            <a href="/library/search">{{ __('New Search') }}</a><br>
        {% endif %}
        <a href="/library/">{{ __('To Library') }}</a>
    </div>
{% endblock %}
