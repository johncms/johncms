{#
    Articles waiting for a moderator.

    @param ?string approved_name Name of the article approved by the previous request.
    @param bool    approved_all
    @param int     total
    @param array[] articles
    @param ?Markup pagination
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if approved_all %}
        <div class="alert alert-success">{{ __('All Articles added in database') }}</div>
    {% elseif approved_name is not null %}
        <div class="alert alert-success">
            {{ __('Article') }} <strong>{{ approved_name }}</strong> {{ __('Added to the database') }}
        </div>
    {% endif %}

    {% if total %}
        {% for article in articles %}
            <div class="card mb-3 shadow border-0">
                <div class="card-body">
                    <a href="{{ article.url }}" class="card-title h3">{{ article.name }}</a>
                    <div class="text-muted small d-flex align-items-center flex-wrap mt-1">
                        <div class="me-2">
                            <span>{{ __('Author:') }}</span>
                            {%- include '@library/public/components/uploader.twig' with {
                                user_id: article.uploader_id,
                                name: article.uploader,
                                date: article.date
                            } only %}
                        </div>
                    </div>
                    <div class="mt-2">
                        <a href="/library/premod?approve={{ article.id }}" class="pe-2">{{ __('Approve') }}</a>
                        <a href="/library/article/{{ article.id }}/delete">{{ __('Delete') }}</a>
                    </div>
                </div>
            </div>
        {% endfor %}
        <div>{{ __('Total') }}: {{ total }}</div>
        {% if pagination %}
            <div>{{ pagination }}</div>
        {% endif %}
        <div class="mt-2"><a href="/library/premod?approve-all">{{ __('Approve all') }}</a></div>
    {% else %}
        <div class="alert alert-info">{{ __('No articles pending moderation.') }}</div>
    {% endif %}
    <p><a href="/library/">{{ __('To Library') }}</a></p>
{% endblock %}
