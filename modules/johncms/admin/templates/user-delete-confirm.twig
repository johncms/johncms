{#
    Deleting an account, as a page: what a link to the dialog leads to without the script that
    opens it in the modal — the profile links here as well.

    @var array dialog What users/delete-dialog.twig is given.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@admin/components/ui/dialog-page.twig' with {dialog: '@admin/users/delete-dialog.twig', data: dialog} only %}
{% endblock %}
