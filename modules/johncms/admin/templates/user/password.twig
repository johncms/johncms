{#
    A new password for an account, set by the staff.

    @var array errors Field => messages, from the last attempt.
#}
{% extends '@admin/user/layout.twig' %}

{% block user_content %}
    <div class="row">
        <div class="col-lg-7 col-xl-6">
            <form method="post" action="/admin/users/{{ user.id }}/password" class="card">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                <div class="card-header">{{ __('New password') }}</div>
                <div class="card-body d-flex flex-column gap-3">
                    <div>
                        <label class="form-label" for="user-password">{{ __('Password') }}</label>
                        <input type="password" class="form-control{{ errors.password is defined ? ' is-invalid' }}" id="user-password" name="password" autocomplete="new-password" required>
                        {% include '@theme/components/field-errors.twig' with {errors: errors.password|default([])} only %}
                        <div class="form-text">{{ __('At least 6 characters.') }}</div>
                    </div>
                    <div>
                        <label class="form-label" for="user-password-confirmation">{{ __('Repeat the password') }}</label>
                        <input type="password" class="form-control{{ errors.confirmation is defined ? ' is-invalid' }}" id="user-password-confirmation" name="confirmation" autocomplete="new-password" required>
                        {% include '@theme/components/field-errors.twig' with {errors: errors.confirmation|default([])} only %}
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="user-sign-out" name="sign_out" value="1" checked>
                        <label class="form-check-label" for="user-sign-out">{{ __('Sign the account out on every device') }}</label>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a class="btn btn-secondary" href="/admin/users/{{ user.id }}">{{ __('Cancel') }}</a>
                    <button type="submit" class="btn btn-primary">{{ __('Change the password') }}</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
