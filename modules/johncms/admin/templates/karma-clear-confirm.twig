{#
    Clearing the karma as a page: what the link to the dialog leads to without the script that
    opens it in the modal.

    @var array dialog What karma/clear-dialog.twig is given.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@admin/components/ui/dialog-page.twig' with {dialog: '@admin/karma/clear-dialog.twig', data: dialog} only %}
{% endblock %}
