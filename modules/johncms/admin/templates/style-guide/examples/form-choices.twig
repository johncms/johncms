<div class="row g-3">
    <div class="col-md-4">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="guide-check-1" checked>
            <label class="form-check-label" for="guide-check-1">form-check · checked</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="guide-check-2">
            <label class="form-check-label" for="guide-check-2">form-check</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="guide-check-3" disabled>
            <label class="form-check-label" for="guide-check-3">form-check · disabled</label>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-check">
            <input class="form-check-input" type="radio" name="guide-radio" id="guide-radio-1" checked>
            <label class="form-check-label" for="guide-radio-1">radio · checked</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="guide-radio" id="guide-radio-2">
            <label class="form-check-label" for="guide-radio-2">radio</label>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="guide-switch-1" checked>
            <label class="form-check-label" for="guide-switch-1">form-switch · on</label>
        </div>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="guide-switch-2">
            <label class="form-check-label" for="guide-switch-2">form-switch · off</label>
        </div>
    </div>
</div>
