{# The result of an action from the server: @admin/components/ui/toast.twig. From a script: toast() of src/admin/js/toast.js. #}
<div class="d-flex flex-wrap gap-2">
    <button type="button" class="btn btn-outline-secondary" data-admin-toast-show="success" data-admin-toast-message="{{ __('Changes saved successfully') }}">success</button>
    <button type="button" class="btn btn-outline-secondary" data-admin-toast-show="info" data-admin-toast-message="{{ __('New accounts wait for confirmation') }}">info</button>
    <button type="button" class="btn btn-outline-secondary" data-admin-toast-show="warning" data-admin-toast-message="{{ __('The cache has not been cleared for a long time.') }}">warning</button>
    <button type="button" class="btn btn-outline-secondary" data-admin-toast-show="error" data-admin-toast-message="{{ __('Access denied') }}">error</button>
</div>
