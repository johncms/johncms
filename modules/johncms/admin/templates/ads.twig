{#
    The advertising links of one place.

    @var array        items      Rows prepared by AdRowMapper.
    @var int          total
    @var int          per_page
    @var int          offset     Position of the first row of the page in the whole list.
    @var int          page
    @var array        filters    Tabs for the places: title, url, active, count, tone.
    @var string       add_url
    @var string       clear_url
    @var int          type
    @var \Twig\Markup pagination
    @var string       success_message Empty unless an action has just succeeded.
    @var string       error_message   Empty unless an action has just been refused.
#}
{% extends '@admin/layouts/default.twig' %}

{% block page_actions %}
    <a class="btn btn-outline-danger" href="{{ clear_url }}" data-admin-modal>
        {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
        {{ __('Delete inactive links') }}
    </a>
    <a class="btn btn-primary" href="{{ add_url }}">
        {% include '@admin/components/ui/icon.twig' with {name: 'plus', size: 14} only %}
        {{ __('Add link') }}
    </a>
{% endblock %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-warning', alert: error_message} only %}

    {% include '@admin/components/list-tabs.twig' with {tabs: filters} only %}

    <div class="card">
        {% if items is empty %}
            {% include '@admin/components/ui/empty-state.twig' with {
                icon: 'megaphone',
                title: __('The list is empty'),
                description: __('There are no links in this place yet.'),
            } only %}
            <div class="text-center pb-4">
                <a class="btn btn-outline-secondary" href="{{ add_url }}">
                    {% include '@admin/components/ui/icon.twig' with {name: 'plus', size: 14} only %}
                    {{ __('Add link') }}
                </a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle admin-ads-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ __('Link') }}</th>
                            <th scope="col">{{ __('Shown to') }}</th>
                            <th scope="col">{{ __('Limits') }}</th>
                            <th scope="col">{{ __('Status') }}</th>
                            <th scope="col"><span class="visually-hidden">{{ __('Actions') }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            {% set position = offset + loop.index0 %}
                            <tr>
                                <td class="admin-ads-table__link">
                                    <a href="/admin/ads/{{ item.id }}/edit"
                                       class="admin-ads-table__name{{ item.bold ? ' fw-bold' }}{{ item.italic ? ' fst-italic' }}{{ item.underline ? ' text-decoration-underline' }}"
                                       {% if item.color %}style="color: #{{ item.color }}"{% endif %}>{{ item.name }}</a>
                                    {% if item.other_names is not empty %}
                                        <span class="badge rounded-pill text-bg-light border ms-1" title="{{ item.other_names|join('; ') }}">+{{ item.other_names|length }}</span>
                                    {% endif %}
                                    <a class="admin-ads-table__url" href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.link }}</a>
                                </td>
                                <td data-label="{{ __('Shown to') }}">
                                    <div>{{ item.audience }}</div>
                                    <div class="admin-ads-table__sub">{{ item.layout }}</div>
                                </td>
                                <td data-label="{{ __('Limits') }}">
                                    <div>
                                        {% if item.direct_link %}
                                            {{ __('Hits are not counted') }}
                                        {% elseif item.hit_limit %}
                                            {{ n__('%1$s of %2$s hit', '%1$s of %2$s hits', item.hit_limit)|format(item.hits, item.hit_limit) }}
                                        {% else %}
                                            {{ n__('%s hit', '%s hits', item.hits)|format(item.hits) }}
                                        {% endif %}
                                    </div>
                                    <div class="admin-ads-table__sub">
                                        {{ item.expires_at ? __('Ends: %s')|format(item.expires_at) : __('Started: %s')|format(item.started_at) }}
                                    </div>
                                </td>
                                <td data-label="{{ __('Status') }}">
                                    {% if item.status == 'shown' %}
                                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis badge-dot">{{ __('Shown') }}</span>
                                    {% elseif item.status == 'exhausted' %}
                                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis badge-dot">{{ __('Limit reached') }}</span>
                                    {% else %}
                                        <span class="badge rounded-pill text-bg-light badge-dot">{{ __('Hidden') }}</span>
                                    {% endif %}
                                </td>
                                <td class="admin-ads-table__actions">
                                    <a href="/admin/ads/{{ item.id }}/edit" class="btn btn-outline-secondary btn-icon btn-sm" title="{{ __('Edit') }}" aria-label="{{ __('Edit') }}">
                                        {% include '@admin/components/ui/icon.twig' with {name: 'pencil', size: 14} only %}
                                    </a>
                                    {% set actions = [] %}
                                    {% if position > 0 %}
                                        {% set actions = actions|merge([{method: 'post', url: '/admin/ads/' ~ item.id ~ '/up', title: __('Move up'), icon: 'arrow-up', danger: false, fields: {page: page}}]) %}
                                    {% endif %}
                                    {% if position < total - 1 %}
                                        {% set actions = actions|merge([{method: 'post', url: '/admin/ads/' ~ item.id ~ '/down', title: __('Move down'), icon: 'arrow-down', danger: false, fields: {page: page}}]) %}
                                    {% endif %}
                                    {% if item.status == 'shown' %}
                                        {% set actions = actions|merge([{method: 'post', url: '/admin/ads/' ~ item.id ~ '/toggle', title: __('Hide'), icon: 'eye-off', danger: false, fields: {page: page}}]) %}
                                    {% elseif item.status == 'hidden' %}
                                        {% set actions = actions|merge([{method: 'post', url: '/admin/ads/' ~ item.id ~ '/toggle', title: __('Show'), icon: 'eye', danger: false, fields: {page: page}}]) %}
                                    {% endif %}
                                    {% set actions = actions|merge([{method: 'get', url: '/admin/ads/' ~ item.id ~ '/delete', title: __('Delete'), icon: 'trash-2', danger: true, fields: {}}]) %}
                                    {% include '@admin/components/ui/row-actions.twig' with {label: __('Actions'), actions: actions} only %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer admin-list-footer">
                <span class="admin-list-footer__total">{{ __('Total:') }} {{ total|format_number }}</span>
                {% if total > per_page %}
                    <div class="pagination-no-padding">{{ pagination }}</div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
