{#
    The dropdowns of the filters of a live list, beside its search field. Shared by the lists of
    the panel.

    @param array controls
#}
<div class="admin-toolbar__filters" data-live-list-region="filters">
    {% for filter in controls.filters %}
        {% include '@admin/components/ui/filter-dropdown.twig' with {
            label: filter.label,
            value: filter.value,
            applied: filter.applied,
            options: filter.options,
        } only %}
    {% endfor %}
</div>
