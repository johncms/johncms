{#
    The rest of the filter of a live list, submitted with the search field so that typing keeps
    it. Shared by the lists of the panel.

    @param array controls
#}
<div hidden data-live-list-region="state">
    {% for name, value in controls.state %}
        <input type="hidden" name="{{ name }}" value="{{ value }}">
    {% endfor %}
</div>
