{#
    The dashboard of the admin panel: what needs the administrator, what happened on the site today,
    and what the visitors wrote last.

    @var \Johncms\Modules\Admin\Application\DTO\DashboardContextDTO data
#}
{% extends '@admin/layouts/default.twig' %}

{% set level_icons = {danger: 'circle-alert', warning: 'triangle-alert', pending: 'inbox'} %}
{% set level_badges = {danger: 'text-bg-danger', warning: 'text-bg-warning', pending: 'text-bg-light'} %}

{% block content %}
    <div class="d-block d-lg-none text-center mb-3">
        <button type="button" class="btn btn-outline-primary w-100" data-admin-nav-open aria-controls="admin-sidebar">{{ __('Show admin menu') }}</button>
    </div>

    <section class="card admin-attention mb-3" aria-labelledby="admin-attention-title">
        <div class="card-header">
            {% include '@admin/components/ui/icon.twig' with {name: 'bell', size: 15, class: 'text-body-tertiary'} only %}
            <h2 class="flex-grow-1 m-0 fs-6 fw-semibold" id="admin-attention-title">{{ __('Needs attention') }}</h2>
        </div>
        {% if data.attention %}
            <div class="list-group list-group-flush">
                {% for item in data.attention %}
                    <a href="{{ item.url }}" class="list-group-item list-group-item-action admin-attention__item admin-attention__item--{{ item.level.value }}">
                        <span class="admin-attention__icon">
                            {% include '@admin/components/ui/icon.twig' with {name: item.icon ?: level_icons[item.level.value], size: 16} only %}
                        </span>
                        <span class="flex-grow-1">{{ item.name }}</span>
                        {% if item.count is not null %}
                            <span class="badge {{ level_badges[item.level.value] }}">{{ item.count|format_number }}</span>
                        {% endif %}
                        {% include '@admin/components/ui/icon.twig' with {name: 'chevron-right', size: 15, class: 'text-body-tertiary'} only %}
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="card-body admin-attention__clear">
                <span class="admin-attention__icon">
                    {% include '@admin/components/ui/icon.twig' with {name: 'circle-check', size: 16} only %}
                </span>
                {{ __('Nothing needs attention: the queues are empty and the server is fine.') }}
            </div>
        {% endif %}
    </section>

    {% if data.metrics %}
        <div class="admin-stats admin-metrics">
            {% for metric in data.metrics %}
                {% include '@admin/dashboard/metric.twig' with {metric: metric, day_ends: data.dayEnds} only %}
            {% endfor %}
        </div>
    {% endif %}

    <div class="row g-3 mt-0">
        <div class="col-lg-7">
            <section class="card h-100" aria-labelledby="admin-comments-title">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'messages-square', size: 15, class: 'text-body-tertiary'} only %}
                    <h2 class="flex-grow-1 m-0 fs-6 fw-semibold" id="admin-comments-title">{{ __('Latest comments') }}</h2>
                    {% if data.comments %}
                        <a class="small" href="/admin/comments">{{ __('All comments') }}</a>
                    {% endif %}
                </div>
                {% if data.comments %}
                    <ul class="list-group list-group-flush">
                        {% for comment in data.comments %}
                            {% include '@admin/comments/item.twig' with {comment: comment} only %}
                        {% endfor %}
                    </ul>
                {% else %}
                    {% include '@admin/components/ui/empty-state.twig' with {
                        icon: 'message-square',
                        title: __('No comments yet'),
                        description: __('Only the comments of the sections you moderate are shown here.'),
                    } only %}
                {% endif %}
            </section>
        </div>
        <div class="col-lg-5">
            {% include '@admin/dashboard/security.twig' with {security: data.security} only %}
        </div>
    </div>

    {% if data.system %}
        <div class="mt-3">
            {% include '@admin/dashboard/system.twig' with {system: data.system} only %}
        </div>
    {% endif %}
{% endblock %}
