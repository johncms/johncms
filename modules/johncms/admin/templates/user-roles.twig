{#
    The roles of one account, a tab of its pages: which it holds, and until when.

    @var array       user         Built by UserCardMapper::head().
    @var array       tabs
    @var string|null default_role The role everybody signed in holds without being given it.
    @var list<\Johncms\Modules\Admin\Application\DTO\UserRoleRowDTO> rows
    @var string      form_action
    @var string      back_url
    @var string      roles_url    Where the roles themselves are edited.
    @var array       errors       Messages about the form as a whole.
#}
{% extends '@admin/user/layout.twig' %}

{% block user_content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors} only %}

    <form method="post" action="{{ form_action }}" class="admin-role-form">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">

        <div class="card">
            <div class="card-header">
                <span class="flex-grow-1">{{ __('Roles') }}</span>
                <a class="small" href="{{ roles_url }}">{{ __('What each role may do') }}</a>
            </div>
            {% if default_role %}
                <div class="card-body pb-0 text-body-secondary">
                    {{ __('Everybody signed in holds the "%s" role; it is not given out.')|format(default_role) }}
                </div>
            {% endif %}
            <div class="table-responsive">
                <table class="table admin-user-roles-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ __('Role') }}</th>
                            <th scope="col" class="text-end">{{ __('Level') }}</th>
                            <th scope="col">{{ __('Valid until') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr{% if not row.manageable %} class="admin-roles-table__locked"{% endif %}>
                                <td>
                                    <div class="form-check form-switch mb-0">
                                        <input type="checkbox" class="form-check-input" role="switch" name="roles[]" value="{{ row.id }}" id="role-{{ row.id }}"
                                               {% if row.granted %}checked{% endif %}
                                               {% if not row.manageable %}disabled{% endif %}>
                                        <label class="form-check-label" for="role-{{ row.id }}">
                                            <span class="admin-roles-table__name">
                                                {{ row.name }}
                                                {% if row.expired %}
                                                    <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis badge-dot">{{ __('Expired') }}</span>
                                                {% endif %}
                                            </span>
                                            <span class="admin-roles-table__sub d-block">{{ row.slug }}</span>
                                        </label>
                                    </div>
                                </td>
                                <td class="text-end admin-roles-table__number">{{ row.level }}</td>
                                <td>
                                    {% if row.manageable %}
                                        <input type="date" class="form-control form-control-sm admin-user-roles-table__date" id="expires-{{ row.id }}" name="expires_{{ row.id }}"
                                               value="{{ row.expiresAt }}" aria-label="{{ __('Valid until') }}: {{ row.name }}">
                                    {% else %}
                                        <span class="admin-user-roles-table__locked-note" title="{{ __('This role stands above your own') }}">
                                            {% include '@admin/components/ui/icon.twig' with {name: 'lock', size: 14} only %}
                                            {{ __('This role stands above your own') }}
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-body-secondary small">
                {{ __('Leave the date empty to grant the role without an end date.') }}
            </div>
        </div>

        <div class="admin-role-form__actions">
            <a class="btn btn-secondary" href="{{ back_url }}">{{ __('Cancel') }}</a>
            <button type="submit" class="btn btn-primary">
                {% include '@admin/components/ui/icon.twig' with {name: 'save', size: 14} only %}
                {{ __('Save') }}
            </button>
        </div>
    </form>
{% endblock %}
