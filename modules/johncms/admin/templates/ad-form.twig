{#
    The form of an advertising link, for a new one and for an existing one.

    @var string     form_action
    @var int|null   id               Null when a new link is being added.
    @var array      fields           Values of the form, keyed by field name.
    @var array      errors           Validation messages, empty on the first render.
    @var array      audience_options Visitors the link is shown to: value, label.
    @var array      place_options    Place on the page: value, label.
    @var array      layout_options   Pages the link appears on: value, label.
#}
{% extends '@admin/layouts/default.twig' %}

{% macro choices(name, options, value) %}
    <div class="row g-3">
        {% for option in options %}
            <div class="col-md-6">
                <div class="form-check">
                    <input type="radio" class="form-check-input" name="{{ name }}" value="{{ option.value }}" id="ad-{{ name }}-{{ option.value }}"{% if value == option.value %} checked{% endif %}>
                    <label class="form-check-label" for="ad-{{ name }}-{{ option.value }}">
                        {{ option.label }}
                        <span class="form-text d-block mt-0">{{ option.hint }}</span>
                    </label>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% block page_actions %}
    <a class="btn btn-secondary" href="/admin/ads?type={{ fields.type }}">{{ __('Cancel') }}</a>
    <button type="submit" class="btn btn-primary" form="ad-form">
        {% include '@admin/components/ui/icon.twig' with {name: 'save', size: 14} only %}
        {{ __('Save') }}
    </button>
{% endblock %}

{% block content %}
    {% import _self as form %}

    <form action="{{ form_action }}" method="post" id="ad-form" class="admin-ad-form">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if id %}
            <input type="hidden" name="id" value="{{ id }}">
        {% endif %}

        {% if errors is not empty %}
            <div class="alert alert-danger shadow border-0">
                {% for error in errors %}<div>{{ error }}</div>{% endfor %}
            </div>
        {% endif %}

        <div class="card">
            <div class="card-header">
                {% include '@admin/components/ui/icon.twig' with {name: 'link', size: 15, class: 'text-body-tertiary'} only %}
                {{ __('Main') }}
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="ad-link">{{ __('Link') }}</label>
                        <input type="text" name="link" class="form-control" id="ad-link" value="{{ fields.link }}" autocomplete="url">
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="ad-name">{{ __('Title') }}</label>
                        <input type="text" name="name" class="form-control" id="ad-name" value="{{ fields.name }}">
                        <div class="form-text">{{ __('To change the name when updating pages, you must wtite names trought the symbol |') }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="ad-color">{{ __('Color') }}</label>
                        <div class="input-group">
                            <span class="input-group-text">#</span>
                            <input type="text" name="color" class="form-control font-monospace" id="ad-color" value="{{ fields.color }}" maxlength="6" autocomplete="off">
                        </div>
                        <div class="form-text">{{ __('In the format FFFFFF, if you do not want to use link color, simply do not fill this field') }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="ad-count">{{ __('Hits') }}</label>
                        <input type="number" name="count" class="form-control" id="ad-count" value="{{ fields.count_link }}" min="0">
                        <div class="form-text">{{ __('Number of hits for link existence which will be automatically removed from the page<br>0 - Unlimited')|raw }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="ad-days">{{ __('Days') }}</label>
                        <input type="number" name="day" class="form-control" id="ad-days" value="{{ fields.day }}" min="0">
                        <div class="form-text">{{ __('Number of days for link existence which will be automatically removed from the page<br>0 - Unlimited')|raw }}</div>
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" role="switch" name="show" value="1" id="ad-direct-link"{% if fields.show %} checked{% endif %}>
                            <label class="form-check-label" for="ad-direct-link">{{ __('Direct Link') }}</label>
                            <div class="form-text">{{ __('Click statistics won\'t be counted, If the direct link is turned on') }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                {% include '@admin/components/ui/icon.twig' with {name: 'users', size: 15, class: 'text-body-tertiary'} only %}
                {{ __('Show') }}
            </div>
            <div class="card-body">
                {{ form.choices('view', audience_options, fields.view) }}
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                {% include '@admin/components/ui/icon.twig' with {name: 'pin', size: 15, class: 'text-body-tertiary'} only %}
                {{ __('Disposition') }}
            </div>
            <div class="card-body">
                {{ form.choices('type', place_options, fields.type) }}
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                {% include '@admin/components/ui/icon.twig' with {name: 'layout-grid', size: 15, class: 'text-body-tertiary'} only %}
                {{ __('Layout') }}
            </div>
            <div class="card-body">
                {{ form.choices('layout', layout_options, fields.layout) }}
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                {% include '@admin/components/ui/icon.twig' with {name: 'palette', size: 15, class: 'text-body-tertiary'} only %}
                {{ __('Styling links') }}
            </div>
            <div class="card-body">
                <div class="row g-3">
                    {% for key, label in {bold: __('Bold'), italic: __('Italic'), underline: __('Underline')} %}
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="{{ key }}" value="1" id="ad-style-{{ key }}"{% if fields[key] %} checked{% endif %}>
                                <label class="form-check-label" for="ad-style-{{ key }}">{{ label }}</label>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </form>
{% endblock %}
