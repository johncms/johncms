{#
    The modules of this site: the installed ones, the new ones lying in the directory waiting to be
    installed, and those needing attention — broken, incompatible, or installed halfway. Every
    operation is confirmed in a dialog first.

    @var string tab             installed | available | problems
    @var array  tabs            The groups with something in them: title, url, active, count, tone.
    @var array  rows            Built by ModuleRowMapper, for the tab.
    @var bool   has_available   New modules are waiting to be installed.
    @var array  operation_steps Steps of the operation that has just run: step, outcome, detail.
    @var string success_message
    @var string error_message
#}
{% extends '@admin/layouts/default.twig' %}

{% block page_actions %}
    <a class="btn btn-primary" href="/admin/modules/upload">
        {% include '@admin/components/ui/icon.twig' with {name: 'upload', size: 14} only %}
        {{ __('Install a module from a file') }}
    </a>
{% endblock %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: error_message} only %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}

    {% if operation_steps %}
        <section class="card mb-3">
            <div class="card-header">
                {% include '@admin/components/ui/icon.twig' with {name: 'list', size: 16} only %}
                <h2 class="h6 mb-0 ms-2">{{ __('What was done') }}</h2>
            </div>
            <ul class="list-group list-group-flush admin-module-steps">
                {% for step in operation_steps %}
                    <li class="list-group-item admin-module-steps__step admin-module-steps__step--{{ step.outcome }}">
                        {% include '@admin/components/ui/icon.twig' with {
                            name: step.outcome == 'done' ? 'circle-check' : (step.outcome == 'skipped' ? 'circle-minus' : 'circle-x'),
                            size: 15,
                        } only %}
                        <span>{{ step.step }}{% if step.detail %}<span class="text-body-secondary">: {{ step.detail }}</span>{% endif %}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if has_available and tab != 'available' %}
        <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span>{{ __('New modules were found in the modules directory. They are not running until they are installed.') }}</span>
            <a class="alert-link" href="/admin/modules?tab=available">{{ __('Show new modules') }}</a>
        </div>
    {% endif %}

    {% include '@admin/components/list-tabs.twig' with {tabs: tabs} only %}

    <div class="card">
        {% if rows is empty %}
            {% include '@admin/components/ui/empty-state.twig' with {
                icon: 'puzzle',
                title: __('No modules are installed.'),
                description: '',
            } only %}
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle admin-modules-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ __('Module') }}</th>
                            <th scope="col" class="d-none d-md-table-cell">{{ __('Version') }}</th>
                            <th scope="col">{{ __('Status') }}</th>
                            <th scope="col"><span class="visually-hidden">{{ __('Actions') }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for module in rows %}
                            <tr>
                                <td>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="admin-modules-table__name">{{ module.name }}</span>
                                        {% if module.system %}
                                            <span class="badge rounded-pill text-bg-light border" title="{{ __('A system module cannot be switched off or removed.') }}">{{ __('System') }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="admin-modules-table__key">{{ module.key }}</div>
                                    {% if module.problem %}
                                        <div class="admin-modules-table__problem">
                                            {% include '@admin/components/ui/icon.twig' with {name: 'triangle-alert', size: 13} only %}
                                            {{ module.problem }}
                                        </div>
                                    {% endif %}
                                </td>
                                <td class="d-none d-md-table-cell admin-modules-table__version">{{ module.version }}</td>
                                <td>
                                    {% set tone = {
                                        success: 'bg-success-subtle text-success-emphasis',
                                        muted: 'text-bg-light',
                                        info: 'bg-info-subtle text-info-emphasis',
                                        danger: 'bg-danger-subtle text-danger-emphasis',
                                        warning: 'bg-warning-subtle text-warning-emphasis',
                                    }[module.status_tone] %}
                                    <span class="badge rounded-pill badge-dot {{ tone }}">{{ module.status_label }}</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        {% if module.install_url %}
                                            <a class="btn btn-sm btn-primary" href="{{ module.install_url }}" data-admin-modal>
                                                {% include '@admin/components/ui/icon.twig' with {name: 'download', size: 13} only %}
                                                {{ __('Install') }}
                                            </a>
                                        {% endif %}
                                        {% if module.actions is not empty %}
                                            {% include '@admin/components/ui/row-actions.twig' with {actions: module.actions, label: __('Actions')} only %}
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer admin-list-footer">
                <span class="admin-list-footer__total">{{ __('Total:') }} {{ rows|length|format_number }}</span>
            </div>
        {% endif %}
    </div>
{% endblock %}
