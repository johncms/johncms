{#
    Confirming the cleanup as a page: what the link to the dialog leads to without the script that
    opens it in the modal.

    @var array dialog What users/cleanup-dialog.twig is given.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@admin/components/ui/dialog-page.twig' with {dialog: '@admin/users/cleanup-dialog.twig', data: dialog} only %}
{% endblock %}
