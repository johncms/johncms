{#
    Confirming the removal of inactive advertising links. Answered to the modal as it is, and put
    into a page of its own (ad-clear-confirm.twig) for a plain visit.

    @var string message
    @var string form_action
    @var string back_url
#}
{% embed '@admin/components/ui/dialog.twig' with {
    title: __('Delete inactive links'),
    action: form_action,
    close_url: back_url,
    message: message,
} only %}
    {% block body %}
        <div class="alert alert-danger mb-0">{{ message }}</div>
    {% endblock %}
    {% block footer %}
        <a href="{{ close_url }}" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Cancel') }}</a>
        <button type="submit" class="btn btn-danger">
            {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
            {{ __('Delete') }}
        </button>
    {% endblock %}
{% endembed %}
