{#
    What the site does with a picture uploaded into the text editor: how large it may be and to
    what it is scaled on the left, the format it is stored in on the right.

    @var array  settings        Current values: max_size, max_width, max_height, quality, convert.
    @var array  format_options  Formats to store in: value, label, hint.
    @var int    server_limit    The largest upload PHP accepts, in bytes; zero when it sets none.
    @var bool   exceeds_server  Whether the configured limit is above what PHP accepts.
    @var string form_action
    @var string error_message   Empty unless the last save failed.
    @var string success_message Empty unless a save has just succeeded.
#}
{% extends '@admin/layouts/default.twig' %}

{% block page_tabs %}
    {% include '@admin/components/settings-tabs.twig' with {active: 'images'} only %}
{% endblock %}

{% macro card_head(icon, title) %}
    <div class="card-header">
        {% include '@admin/components/ui/icon.twig' with {name: icon, size: 16} only %}
        <h2 class="h6 mb-0 ms-2">{{ title }}</h2>
    </div>
{% endmacro %}

{% block content %}
    {% import _self as ui %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: error_message} only %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}

    <form action="{{ form_action }}" method="post" id="images-form" class="row g-3 align-items-start">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">

        <div class="col-lg-8 d-flex flex-column gap-3">
            <section class="card">
                {{ ui.card_head('upload', __('Upload limit')) }}
                <div class="card-body">
                    <label class="form-label" for="max_size">{{ __('Max. picture size') }}</label>
                    <div class="input-group">
                        <input type="number" min="1" name="max_size" class="form-control" id="max_size" value="{{ settings.max_size }}">
                        <span class="input-group-text">{{ __('KB') }}</span>
                    </div>
                    {% if server_limit %}
                        <div class="form-text">{{ __('The server accepts up to %s.')|format(server_limit|format_size) }}</div>
                    {% endif %}
                    {% if exceeds_server %}
                        <div class="alert alert-warning small mt-3 mb-0">
                            {{ __('The limit is above what the server accepts, so an upload larger than the server limit fails before the site sees it. Raise upload_max_filesize and post_max_size in php.ini, or lower this value.') }}
                        </div>
                    {% endif %}
                </div>
            </section>

            <section class="card">
                {{ ui.card_head('image', __('Resolution')) }}
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="max_width">{{ __('Max. width') }}</label>
                            <div class="input-group">
                                <input type="number" min="0" name="max_width" class="form-control" id="max_width" value="{{ settings.max_width }}">
                                <span class="input-group-text">px</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="max_height">{{ __('Max. height') }}</label>
                            <div class="input-group">
                                <input type="number" min="0" name="max_height" class="form-control" id="max_height" value="{{ settings.max_height }}">
                                <span class="input-group-text">px</span>
                            </div>
                        </div>
                        <div class="col-12 form-text mt-1">{{ __('A larger picture is scaled down to fit these bounds, keeping its proportions. A smaller one is left alone. Zero leaves the side unconstrained.') }}</div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="card">
                {{ ui.card_head('archive', __('Storage format')) }}
                <div class="card-body d-flex flex-column gap-3">
                    <div class="d-flex flex-column gap-2">
                        {% for option in format_options %}
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="convert" value="{{ option.value }}" id="convert_{{ option.value }}"{% if settings.convert == option.value %} checked{% endif %}>
                                <label class="form-check-label" for="convert_{{ option.value }}">
                                    {{ option.label }}
                                    {% if option.hint %}<span class="form-text d-block mt-0">{{ option.hint }}</span>{% endif %}
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                    <div>
                        <label class="form-label" for="quality">{{ __('Quality') }}</label>
                        <div class="input-group">
                            <input type="number" min="1" max="100" name="quality" class="form-control" id="quality" value="{{ settings.quality }}">
                            <span class="input-group-text">%</span>
                        </div>
                        <div class="form-text">{{ __('Applied when a picture is scaled down or re-encoded.') }}</div>
                    </div>
                </div>
            </section>
        </div>
    </form>

    {% include '@admin/components/ui/form-footer.twig' with {form: 'images-form', cancel_url: '/admin/settings'} only %}
{% endblock %}
