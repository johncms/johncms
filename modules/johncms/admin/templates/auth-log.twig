{#
    The sign-in log: who signed in, what was refused, who changed whose roles.

    A live list, as the list of users (src/admin/js/live-list.js): the regions are drawn by
    templates of their own, and admin::auth-log/live puts them back in place as the search is
    typed or a filter is picked.

    @var array        controls   Built by AuthLogControlsMapper.
    @var array        entries    Rows built by AuthLogRowMapper.
    @var string       search
    @var int          total      Entries the filter lets through.
    @var \Twig\Markup pagination
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    <div data-live-list>
        <form class="admin-toolbar" method="get" action="{{ controls.action }}" role="search" data-live-list-form>
            {% include '@admin/components/ui/search-field.twig' with {
                name: 'q',
                value: search,
                label: __('Search the log'),
                placeholder: __('Nickname, ID or IP'),
            } only %}
            {% include '@admin/components/list-state.twig' with {controls: controls} only %}
            {% include '@admin/components/list-filters.twig' with {controls: controls} only %}
        </form>

        {% include '@admin/auth-log/results.twig' with {
            controls: controls,
            entries: entries,
            total: total,
            pagination: pagination,
        } only %}
    </div>
{% endblock %}
