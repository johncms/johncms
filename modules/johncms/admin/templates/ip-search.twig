{#
    Looking accounts up by an address, a range or a mask, in the addresses they have now or in
    their history.

    A live list, as the list of users (src/admin/js/live-list.js): the results follow the search
    as it is typed, and admin::ip-search/live puts the regions back in place. An address typed
    half way is not an error yet, so what is wrong with the search is said quietly in place of the
    results rather than in red above them.

    @var string       search
    @var string       mode        actual | history
    @var string       form_action
    @var array        tabs        title, url, active, count, tone.
    @var array        users       Rows built by IpSearchRowMapper.
    @var bool         searched    Whether a valid search was made.
    @var array        errors      What is wrong with the search, empty when it is fine.
    @var bool         show_origin Whether the visitor may see the addresses and the browsers.
    @var int          total
    @var \Twig\Markup pagination
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    <div data-live-list>
        {% include '@admin/components/list-tabs.twig' with {tabs: tabs} only %}

        <form class="admin-toolbar" method="get" action="{{ form_action }}" role="search" data-live-list-form>
            {% include '@admin/components/ui/search-field.twig' with {
                name: 'search',
                value: search,
                label: __('Search IP'),
                placeholder: __('Address, range or mask'),
            } only %}
            <div class="admin-ip-search__hint">
                <span class="font-monospace">10.5.7.1</span>,
                <span class="font-monospace">10.5.7.1-10.5.7.100</span>
                {{ __('or') }}
                <span class="font-monospace">10.5.*.*</span>
            </div>
        </form>

        {% include '@admin/ip-search/results.twig' with {
            mode: mode,
            users: users,
            searched: searched,
            errors: errors,
            show_origin: show_origin,
            total: total,
            pagination: pagination,
        } only %}
    </div>
{% endblock %}
