{#
    The verification code, asked for after several failed attempts.

    @var \Johncms\Captcha\CaptchaChallenge captcha
    @var string user_login
    @var string user_pass
    @var bool   remember   Carried through, so the choice survives the verification step.
#}
{% extends '@admin/layouts/guest.twig' %}

{% block content %}
    <div class="min-vh-100 d-flex align-items-center">
        <div class="card w-100 mx-auto" style="max-width: 500px;">
            <div class="card-body">
                <form method="post">
                    <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                    <div class="text-center mb-2">
                        <img src="{{ asset('images/logo.svg') }}" alt="logo" style="max-width: 200px;" class="img-fluid">
                    </div>

                    {% include '@theme/components/captcha.twig' with {captcha: captcha, errors: []} only %}
                    <input type="hidden" name="n" value="{{ user_login }}"/>
                    <input type="hidden" name="p" value="{{ user_pass }}"/>
                    {% if remember %}<input type="hidden" name="mem" value="1"/>{% endif %}
                    <input type="submit" name="login" value="{{ __('Continue') }}" class="btn btn-primary"/>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
