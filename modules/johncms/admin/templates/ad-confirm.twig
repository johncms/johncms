{#
    Confirmation of deleting an advertising link or of clearing the inactive ones.

    @var string message
    @var string form_action
    @var string back_url
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    <div class="card admin-ad-confirm">
        <div class="card-body">
            <div class="admin-ad-confirm__icon">
                {% include '@admin/components/ui/icon.twig' with {name: 'triangle-alert', size: 22} only %}
            </div>
            <h2 class="h5">{{ __('Delete') }}</h2>
            <p class="text-body-secondary">{{ message }}</p>
            <div class="d-flex flex-wrap gap-2">
                <form action="{{ form_action }}" method="post">
                    <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                    <button type="submit" class="btn btn-danger">
                        {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
                        {{ __('Delete') }}
                    </button>
                </form>
                <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
            </div>
        </div>
    </div>
{% endblock %}
