{#
    The default language of the site.

    @var array  languages       Installed languages: code, name, active.
    @var string form_action
    @var string manage_url
    @var string error_message   Empty unless the last save failed.
    @var string success_message Empty unless a save has just succeeded.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    <div style="max-width: 640px">
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger shadow border-0', alert: error_message} only %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-success shadow border-0', alert: success_message} only %}

        <form method="post" action="{{ form_action }}">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <fieldset>
                <legend>{{ __('Default language') }}</legend>
                {% for language in languages %}
                    <div class="form-check mb-2">
                        <input type="radio" id="lng-{{ language.code }}" name="lng" class="form-check-input" value="{{ language.code }}"{% if language.active %} checked="checked"{% endif %}>
                        <label class="form-check-label" for="lng-{{ language.code }}">
                            <img class="icon icon-flag" src="{{ asset('images/flags/' ~ language.code|lower ~ '.svg') }}" alt=".">
                            {{ language.name }}
                        </label>
                    </div>
                {% endfor %}
            </fieldset>
            <input type="submit" class="btn btn-primary mt-4 mb-2" name="submit" value="{{ __('Save') }}"/>
            <input type="submit" class="btn btn-link mt-4 mb-2" name="update" value="{{ __('Update List') }}"/>
        </form>
        <div class="mt-3 mb-3">
            <a href="{{ manage_url }}">{{ __('Managing languages') }}</a>
        </div>
    </div>
{% endblock %}
