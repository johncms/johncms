{#
    The languages of the site: which of them are on offer and which is the default.

    @var array  languages       Every language whose files are on the disk: code, name, default, enabled.
    @var string form_action
    @var string error_message   Empty unless the last save failed.
    @var string success_message Empty unless a save has just succeeded.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: error_message} only %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}

    <form method="post" action="{{ form_action }}" id="languages-form" class="row g-3 align-items-start" data-language-settings>
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">

        <div class="col-lg-8">
            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'languages', size: 16} only %}
                    <h2 class="h6 mb-0 ms-2">{{ __('Languages of the site') }}</h2>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                        <tr>
                            <th>{{ __('Language') }}</th>
                            <th class="text-center">{{ __('Default') }}</th>
                            <th class="text-center">{{ __('On the site') }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for language in languages %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img class="admin-flag" src="{{ asset('images/flags/' ~ language.code|lower ~ '.svg') }}" alt="">
                                        <span>{{ language.name }}</span>
                                        <code class="text-body-secondary small">{{ language.code }}</code>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <input type="radio" class="form-check-input" name="lng" value="{{ language.code }}" id="default-{{ language.code }}"{% if language.default %} checked{% endif %} aria-label="{{ __('Default') }}: {{ language.name }}" data-language-default>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block mb-0">
                                        <input type="checkbox" class="form-check-input" role="switch" name="enabled[]" value="{{ language.code }}" id="enabled-{{ language.code }}" aria-label="{{ __('On the site') }}: {{ language.name }}"{% if language.enabled %} checked{% endif %}{% if language.default %} disabled{% endif %} data-language-enabled>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            {# Under the list rather than across the page: the column of the help is short. #}
            {% include '@admin/components/ui/form-footer.twig' with {form: 'languages-form', cancel_url: '/admin'} only %}
        </div>

        <div class="col-lg-4">
            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'info', size: 16} only %}
                    <h2 class="h6 mb-0 ms-2">{{ __('How it works') }}</h2>
                </div>
                <div class="card-body d-flex flex-column gap-2 small">
                    <p class="mb-0">{{ __('The default language is the one a guest sees first. It is always on the site.') }}</p>
                    <p class="mb-0">{{ __('A language turned off is not offered in the switch, in the profile and in the forms of the panel. Its files stay in place, so it can be turned on again at any time.') }}</p>
                    <p class="mb-0">{{ __('A member who has chosen a language that is turned off sees the site in the default language.') }}</p>
                </div>
            </section>
        </div>
    </form>
{% endblock %}
