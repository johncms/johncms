{#
    Who accepted which consent and when.

    @var array        items     Rows: id, user_id, consent_id, consent_title, context, version,
                                ip_address, accepted_at.
    @var string       back_url
    @var int          total
    @var int          per_page
    @var \Twig\Markup pagination
#}
{% extends '@admin/layouts/default.twig' %}

{% block page_actions %}
    <a href="{{ back_url }}" class="btn btn-outline-secondary">
        {% include '@admin/components/ui/icon.twig' with {name: 'arrow-left', size: 14} only %}
        {{ __('Back to consents') }}
    </a>
{% endblock %}

{% block content %}
    <div class="card">
        {% if items is empty %}
            {% include '@admin/components/ui/empty-state.twig' with {
                icon: 'clipboard-check',
                title: __('The list is empty'),
                description: __('Consent acceptance records will appear here.'),
            } only %}
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">{{ __('User') }}</th>
                        <th scope="col">{{ __('Consent') }}</th>
                        <th scope="col">{{ __('Version') }}</th>
                        <th scope="col">{{ __('IP address') }}</th>
                        <th scope="col">{{ __('Date') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in items %}
                        <tr>
                            <td class="text-muted">{{ item.id }}</td>
                            <td>
                                {% if item.user_id %}
                                    <a href="/profile/{{ item.user_id }}" class="text-nowrap">
                                        {% include '@admin/components/ui/icon.twig' with {name: 'user', size: 14} only %}
                                        {{ item.user_id }}
                                    </a>
                                {% else %}
                                    <span class="badge rounded-pill text-bg-light">{{ __('Guest') }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="fw-semibold">{{ item.consent_title ?? '#' ~ item.consent_id }}</div>
                                {% if item.context %}<div class="small text-muted"><code>{{ item.context }}</code></div>{% endif %}
                            </td>
                            <td><span class="badge text-bg-light border">{{ item.version }}</span></td>
                            <td><code>{{ item.ip_address }}</code></td>
                            <td class="text-nowrap">{{ item.accepted_at }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer admin-list-footer">
                <span class="admin-list-footer__total">{{ __('Total:') }} {{ total|format_number }}</span>
                {% if total > per_page %}<div class="pagination-no-padding">{{ pagination }}</div>{% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
