{#
    Confirmation of deleting a consent.

    @var array consent
    @var string form_action
    @var string back_url
#}
{% embed '@admin/components/ui/dialog.twig' with {
    title: __('Delete consent'),
    action: form_action,
    close_url: back_url,
    consent: consent,
} only %}
    {% block body %}
        <div class="alert alert-danger mb-0">
            {{ __('Are you sure you want to delete this consent?') }}
            <div class="mt-2"><strong>{{ consent.title }}</strong> ({{ consent.context }}, {{ __('Version') }}: {{ consent.version }})</div>
        </div>
    {% endblock %}
    {% block footer %}
        <a href="{{ close_url }}" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Cancel') }}</a>
        <button type="submit" class="btn btn-danger">{% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %} {{ __('Delete') }}</button>
    {% endblock %}
{% endembed %}
