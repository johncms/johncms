{#
    The verification code asked for after several failed attempts.

    @var captcha    \Johncms\Captcha\CaptchaChallenge
    @var user_login string
    @var user_pass  string Carried through the form, the visitor types it once.
    @var remember   bool   Carried through as well, so the choice survives the captcha step.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% include '@theme/components/captcha.twig' with {captcha: captcha, errors: []} only %}
        <input type="hidden" name="n" value="{{ user_login }}"/>
        <input type="hidden" name="p" value="{{ user_pass }}"/>
        {% if remember %}<input type="hidden" name="remember" value="1"/>{% endif %}
        <input type="submit" name="login" value="{{ __('Continue') }}" class="btn btn-primary"/>
    </form>
{% endblock %}
