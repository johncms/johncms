{#
    Entry page of the photo albums.

    @param AlbumIndexDTO data
    @param string        my_albums_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="list-group with_counters">
        <div class="list-group-item">
            <a href="/album/top" class="link">{{ __('New Photos') }}</a>
            <span class="counter badge counter-badge rounded-pill">{{ data.newPhotos }}</span>
        </div>
        <div class="list-group-item">
            <a href="/album/top/recent-comments" class="link">{{ __('New Comments') }}</a>
        </div>
    </div>

    <h3 class="mt-3">{{ __('Albums') }}</h3>

    <div class="list-group with_counters">
        <div class="list-group-item">
            <a href="/album/users/boys" class="link">{{ __('Guys') }}</a>
            <span class="counter badge counter-badge rounded-pill">{{ data.men }}</span>
        </div>
        <div class="list-group-item">
            <a href="/album/users/girls" class="link">{{ __('Girls') }}</a>
            <span class="counter badge counter-badge rounded-pill">{{ data.women }}</span>
        </div>
        <div class="list-group-item">
            <a href="{{ my_albums_url }}" class="link">{{ __('My Album') }}</a>
        </div>
    </div>

    <h3 class="mt-3">{{ __('Rating') }}</h3>

    <div class="list-group mb-3">
        <a href="/album/top/votes" class="list-group-item">{{ __('Top Votes') }}</a>
        <a href="/album/top/downloads" class="list-group-item">{{ __('Top Downloads') }}</a>
        <a href="/album/top/views" class="list-group-item">{{ __('Top Views') }}</a>
        <a href="/album/top/comments" class="list-group-item">{{ __('Top Comments') }}</a>
        <a href="/album/top/worst" class="list-group-item">{{ __('Top Worst') }}</a>
    </div>
{% endblock %}
