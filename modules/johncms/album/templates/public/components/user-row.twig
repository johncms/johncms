{#
    A user with the size of their album.

    @param array item id, nick, album_url, user_is_online, count_albums, count
#}
<div class="user-row">
    <div class="d-flex align-items-start">
        <div class="user-avatar me-2 me-md-4">
            <div class="avatar-image rounded-circle overflow-hidden">
                <img src="{{ avatar(item.id) }}" class="img-fluid" alt=".">
            </div>
            <div class="user-status {{ item.user_is_online ? 'online' : 'offline' }} shadow"></div>
        </div>
        <div class="overflow-auto flex-grow-1">
            <div class="user-name">
                {% if item.album_url|default('') %}
                    <a href="{{ item.album_url }}" class="user-login me-2">{{ item.nick }}</a>
                {% else %}
                    <a class="user-login me-2">{{ item.nick }}</a>
                {% endif %}
            </div>
            <div>
                {{ item.count_albums }} {{ n__('album', 'albums', item.count_albums) }},
                {{ item.count }} {{ n__('photo', 'photos', item.count) }}
            </div>
        </div>
    </div>
</div>
