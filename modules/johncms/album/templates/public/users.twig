{#
    Users who have albums.

    @param array    filters Tabs of the section, one of them active.
    @param iterable users
    @param int      total
    @param ?Markup  pagination
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="btn-group mb-3" role="group">
        {% for filter in filters %}
            <a href="{{ filter.url }}" class="btn btn-outline-secondary {{ filter.active ? 'active' }}">{{ filter.name }}</a>
        {% endfor %}
    </div>

    {% if users is empty %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: __('The list is empty')} only %}
    {% endif %}

    {% for item in users %}
        {% include '@album/public/components/user-row.twig' with {item: item} only %}
    {% endfor %}

    <div class="mt-3">
        {% if pagination %}
            {{ pagination }}
        {% endif %}
        {% if total > 0 %}
            <div>{{ __('Total:') }} {{ total }}</div>
        {% endif %}
    </div>
{% endblock %}
