{#
    Deleting a contact message, as a page for visits without the modal script.

    @var array dialog Data passed to message-delete-dialog.twig.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@admin/components/ui/dialog-page.twig' with {
        dialog: '@contacts/admin/message-delete-dialog.twig',
        data: dialog,
    } only %}
{% endblock %}
