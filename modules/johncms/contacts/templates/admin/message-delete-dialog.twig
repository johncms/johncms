{#
    The confirmation dialog for deleting a contact message.

    @var object message
    @var string form_action
    @var string back_url
#}
{% embed '@admin/components/ui/dialog.twig' with {
    title: __('Delete message'),
    action: form_action,
    close_url: back_url,
    message: message,
} only %}
    {% block body %}
        <div class="alert alert-danger">
            {{ __('Are you sure you want to delete this message?') }}
            <div class="text-muted small mt-2">{{ message.name }} &lt;{{ message.email }}&gt;</div>
            <div class="mt-2">{{ message.message|nl2br }}</div>
        </div>
    {% endblock %}
    {% block footer %}
        <a href="{{ close_url }}" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Cancel') }}</a>
        <button type="submit" class="btn btn-danger">
            {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
            {{ __('Delete') }}
        </button>
    {% endblock %}
{% endembed %}
