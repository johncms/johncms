{#
    One message from the contact form.

    @var object message         The message model: name, email, message, ip_address, user_agent.
    @var bool   is_processed
    @var string created_at
    @var string processed_at    Empty unless the message has been processed.
    @var string back_url
    @var string process_url
    @var string delete_url
#}
{% extends '@admin/layouts/default.twig' %}

{% block page_actions %}
    <a href="{{ delete_url }}" class="btn btn-outline-danger" data-admin-modal>
        {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
        {{ __('Delete') }}
    </a>
    <a href="mailto:{{ message.email }}" class="btn btn-outline-secondary">
        {% include '@admin/components/ui/icon.twig' with {name: 'mail', size: 14} only %}
        {{ __('Reply') }}
    </a>
    {% if not is_processed %}
        <form method="post" action="{{ process_url }}" class="d-inline">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <button type="submit" class="btn btn-primary">
                {% include '@admin/components/ui/icon.twig' with {name: 'check', size: 14} only %}
                {{ __('Mark as processed') }}
            </button>
        </form>
    {% endif %}
{% endblock %}

{% block content %}
    {% set status %}
        {% if is_processed %}
            <span class="badge rounded-pill bg-success-subtle text-success-emphasis badge-dot">{{ __('Processed message') }}</span>
        {% else %}
            <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis badge-dot">{{ __('New message') }}</span>
        {% endif %}
    {% endset %}
    {% set email %}
        <a class="text-break" href="mailto:{{ message.email }}">{{ message.email }}</a>
    {% endset %}

    <div class="row g-3 align-items-start">
        <div class="col-lg-8">
            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'message-square', size: 16} only %}
                    <h2 class="h6 mb-0 ms-2">{{ __('Message') }}</h2>
                </div>
                <div class="card-body contact-message-page__body">{{ message.message|nl2br }}</div>
            </section>
        </div>

        <div class="col-lg-4 d-flex flex-column gap-3">
            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'user', size: 16} only %}
                    <h2 class="h6 mb-0 ms-2">{{ __('Sender') }}</h2>
                </div>
                <div class="card-body">
                    {% include '@admin/components/ui/facts.twig' with {items: [
                        {label: __('Name'), value: message.name},
                        {label: __('E-mail'), value: email},
                    ]} only %}
                </div>
            </section>

            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'info', size: 16} only %}
                    <h2 class="h6 mb-0 ms-2">{{ __('Contact message') }}</h2>
                </div>
                <div class="card-body">
                    {% include '@admin/components/ui/facts.twig' with {items: [
                        {label: __('Status'), value: status},
                        {label: __('Received'), value: created_at},
                        {label: __('Processed on'), value: processed_at},
                        {label: __('IP address'), value: message.ip_address},
                        {label: __('Browser'), value: message.user_agent},
                    ]} only %}
                </div>
            </section>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ back_url }}" class="btn btn-outline-secondary">
            {% include '@admin/components/ui/icon.twig' with {name: 'arrow-left', size: 14} only %}
            {{ __('Back to messages') }}
        </a>
    </div>
{% endblock %}
