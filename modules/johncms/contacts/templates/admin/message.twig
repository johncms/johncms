{#
    One message from the contact form.

    @var object message         The message model: name, email, message, ip_address, user_agent.
    @var bool   is_processed
    @var string created_at
    @var string processed_at    Empty unless the message has been processed.
    @var string back_url
    @var string process_url
    @var string delete_url
    @var string success_message Empty unless an action has just been performed.
#}
{% extends '@admin/layouts/default.twig' %}

{% block page_actions %}
    <a href="{{ back_url }}" class="btn btn-outline-secondary">
        {% include '@admin/components/ui/icon.twig' with {name: 'arrow-left', size: 14} only %}
        {{ __('Back') }}
    </a>
    {% if not is_processed %}
        <form method="post" action="{{ process_url }}" class="d-inline">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <button type="submit" class="btn btn-primary">{{ __('Mark as processed') }}</button>
        </form>
    {% endif %}
    <a href="{{ delete_url }}" class="btn btn-outline-danger" data-admin-modal>
        {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
        {{ __('Delete') }}
    </a>
{% endblock %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}

    <div class="row g-3">
        <div class="col-lg-8">
            <section class="card h-100">
                <div class="card-header d-flex align-items-center gap-2">
                    {% include '@admin/components/ui/icon.twig' with {name: 'message-square', size: 16} only %}
                    <h2 class="h6 mb-0">{{ __('Message') }}</h2>
                    <span class="ms-auto">
                        {% if is_processed %}
                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis badge-dot">{{ __('Processed') }}</span>
                        {% else %}
                            <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis badge-dot">{{ __('New') }}</span>
                        {% endif %}
                    </span>
                </div>
                <div class="card-body">
                    <div class="text-body-secondary small mb-3">{{ created_at }}</div>
                    <div class="contact-message-page__body">{{ message.message|nl2br }}</div>
                </div>
            </section>
        </div>

        <div class="col-lg-4 d-flex flex-column gap-3">
            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'user', size: 16} only %}
                    <span class="ms-1">{{ __('Sender') }}</span>
                </div>
                <div class="card-body">
                    {% include '@admin/components/ui/facts.twig' with {items: [
                        {label: __('Sender'), value: message.name},
                    ]} only %}
                    <a href="mailto:{{ message.email }}" class="btn btn-outline-secondary btn-sm mt-3">
                        {% include '@admin/components/ui/icon.twig' with {name: 'mail', size: 14} only %}
                        {{ message.email }}
                    </a>
                </div>
            </section>

            <section class="card">
                <div class="card-header">
                    {% include '@admin/components/ui/icon.twig' with {name: 'info', size: 16} only %}
                    <span class="ms-1">{{ __('Technical information') }}</span>
                </div>
                <div class="card-body">
                    {% include '@admin/components/ui/facts.twig' with {items: [
                        {label: __('IP address'), value: message.ip_address},
                        {label: __('Browser'), value: message.user_agent},
                        {label: __('Processed'), value: processed_at},
                    ]} only %}
                </div>
            </section>
        </div>
    </div>
{% endblock %}
