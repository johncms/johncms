{#
    The messages sent through the contact form.

    @var array        items           Rows (ContactMessageListItemDTO): id, name, email, preview,
                                      status, createdAt.
    @var array        filters         Tabs prepared for the live list.
    @var \Twig\Markup pagination
    @var string       base_url        Address of the message list.
    @var string       success_message Empty unless an action has just been performed.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}

    <div data-live-list>
        {% include '@admin/components/list-tabs.twig' with {tabs: filters} only %}
        {% include '@contacts/admin/results.twig' with {items: items, pagination: pagination, base_url: base_url} only %}
    </div>

    <template data-admin-offcanvas-loading-template>
        <div class="offcanvas-body d-flex align-items-center justify-content-center">
            <div class="spinner-border text-body-tertiary" role="status">
                <span class="visually-hidden">{{ d__('admin', 'Loading') }}</span>
            </div>
        </div>
    </template>
    <div class="offcanvas offcanvas-end contact-message-offcanvas" tabindex="-1" id="contact-message-offcanvas"
         aria-labelledby="contact-message-offcanvas-title" data-admin-offcanvas-panel>
    </div>
{% endblock %}
