{#
    Contact message details for the offcanvas opened from the list.

    @var object message
    @var string title
    @var bool is_processed
    @var string created_at
    @var string processed_at
    @var string process_url
    @var string delete_url
#}
<div class="offcanvas-header">
    <div class="min-w-0">
        <div class="small text-body-secondary">{{ __('Contact message') }} #{{ message.id }}</div>
        <h2 class="offcanvas-title text-truncate" id="contact-message-offcanvas-title">{{ title }}</h2>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ d__('admin', 'Close') }}"></button>
</div>
<div class="offcanvas-body">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        {% if is_processed %}
            <span class="badge rounded-pill bg-success-subtle text-success-emphasis badge-dot">{{ __('Processed') }}</span>
        {% else %}
            <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis badge-dot">{{ __('New') }}</span>
        {% endif %}
        <span class="small text-body-secondary">{{ created_at }}</span>
    </div>

    <section class="mb-4">
        <h3 class="h6 mb-3">{{ __('Sender') }}</h3>
        <div class="contact-message-offcanvas__sender">
            <div class="contact-message-offcanvas__sender-icon">
                {% include '@admin/components/ui/icon.twig' with {name: 'user', size: 18} only %}
            </div>
            <div class="min-w-0">
                <div class="fw-semibold text-break">{{ message.name }}</div>
                <a class="small text-break" href="mailto:{{ message.email }}">{{ message.email }}</a>
            </div>
        </div>
    </section>

    <section class="mb-4">
        <h3 class="h6 mb-3">{{ __('Message') }}</h3>
        <div class="contact-message-offcanvas__message">{{ message.message|nl2br }}</div>
    </section>

    <section>
        <h3 class="h6 mb-3">{{ __('Technical information') }}</h3>
        <dl class="contact-message-offcanvas__facts">
            <dt>{{ __('IP address') }}</dt>
            <dd>{{ message.ip_address }}</dd>
            <dt>{{ __('Browser') }}</dt>
            <dd class="text-break">{{ message.user_agent ?: '—' }}</dd>
            {% if processed_at %}
                <dt>{{ __('Processed') }}</dt>
                <dd>{{ processed_at }}</dd>
            {% endif %}
        </dl>
    </section>
</div>
<div class="offcanvas-footer d-flex justify-content-between gap-2 p-3 border-top">
    <a href="{{ delete_url }}" class="btn btn-outline-danger" data-admin-modal>
        {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
        {{ __('Delete') }}
    </a>
    {% if not is_processed %}
        <form method="post" action="{{ process_url }}">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <button type="submit" class="btn btn-primary">{{ __('Mark as processed') }}</button>
        </form>
    {% endif %}
</div>
