{#
    Contact message details for the offcanvas opened from the list.

    @var object message
    @var string title
    @var bool is_processed
    @var string created_at
    @var string processed_at
    @var string process_url
    @var string delete_url
#}
<div class="offcanvas-header">
    <div class="min-w-0">
        <div class="small text-body-secondary">{{ __('Contact message') }} #{{ message.id }}</div>
        <h2 class="offcanvas-title text-truncate" id="contact-message-offcanvas-title">{{ title }}</h2>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ d__('admin', 'Close') }}"></button>
</div>
{% set status %}
    {% if is_processed %}
        <span class="badge rounded-pill bg-success-subtle text-success-emphasis badge-dot">{{ __('Processed message') }}</span>
    {% else %}
        <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis badge-dot">{{ __('New message') }}</span>
    {% endif %}
{% endset %}
{% set email %}
    <a class="text-break" href="mailto:{{ message.email }}">{{ message.email }}</a>
{% endset %}
<div class="offcanvas-body">
    <section class="mb-4">
        <h3 class="h6 mb-3">{{ __('Message') }}</h3>
        <div class="contact-message-offcanvas__message">{{ message.message|nl2br }}</div>
    </section>

    <section class="mb-4">
        <h3 class="h6 mb-3">{{ __('Sender') }}</h3>
        {% include '@admin/components/ui/facts.twig' with {items: [
            {label: __('Name'), value: message.name},
            {label: __('E-mail'), value: email},
        ]} only %}
    </section>

    <section>
        <h3 class="h6 mb-3">{{ __('Contact message') }}</h3>
        {% include '@admin/components/ui/facts.twig' with {items: [
            {label: __('Status'), value: status},
            {label: __('Received'), value: created_at},
            {label: __('Processed on'), value: processed_at},
            {label: __('IP address'), value: message.ip_address},
            {label: __('Browser'), value: message.user_agent},
        ]} only %}
    </section>
</div>
<div class="offcanvas-footer contact-message-offcanvas__footer p-3 border-top">
    <a href="{{ delete_url }}" class="btn btn-outline-danger" data-admin-modal>
        {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
        {{ __('Delete') }}
    </a>
    <a href="mailto:{{ message.email }}" class="btn btn-outline-secondary contact-message-offcanvas__reply">
        {% include '@admin/components/ui/icon.twig' with {name: 'mail', size: 14} only %}
        {{ __('Reply') }}
    </a>
    {% if not is_processed %}
        <form method="post" action="{{ process_url }}" class="contact-message-offcanvas__process">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <button type="submit" class="btn btn-primary">
                {% include '@admin/components/ui/icon.twig' with {name: 'check', size: 14} only %}
                {{ __('Mark as processed') }}
            </button>
        </form>
    {% endif %}
</div>
