{#
    Deleting a section, with what goes with it. Answered to the modal of the panel as it is, and put
    into a page of its own (delete-section.twig) for a plain visit.

    @var string name
    @var int    subsections The sections under it, at any depth.
    @var int    articles    The articles of the section and of those under it.
    @var string form_action
    @var string back_url    Where the list was; the form returns there.
#}
{% embed '@admin/components/ui/dialog.twig' with {
    title: __('Delete section'),
    action: form_action,
    close_url: back_url,
    name: name,
    subsections: subsections,
    articles: articles,
} only %}
    {% block body %}
        <input type="hidden" name="back" value="{{ close_url }}">
        <p class="fw-semibold">{{ name }}</p>
        {% if subsections > 0 or articles > 0 %}
            <ul class="mb-3">
                {% if subsections > 0 %}
                    <li>{{ n__('%d section under it', '%d sections under it', subsections)|format(subsections) }}</li>
                {% endif %}
                {% if articles > 0 %}
                    <li>{{ n__('%d article', '%d articles', articles)|format(articles) }}</li>
                {% endif %}
            </ul>
        {% endif %}
        <div class="alert alert-danger mb-0">{{ __('The section is deleted together with everything under it.') }}</div>
    {% endblock %}
    {% block footer %}
        <a href="{{ close_url }}" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Cancel') }}</a>
        <button type="submit" class="btn btn-danger">
            {% include '@admin/components/ui/icon.twig' with {name: 'trash-2', size: 14} only %}
            {{ __('Delete') }}
        </button>
    {% endblock %}
{% endembed %}
