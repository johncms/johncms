{#
    The settings of the news: the block of the home page and the meta tags of the pages of the
    module.

    @var \Johncms\Modules\News\Application\DTO\NewsSettingsDTO settings
    @var array  errors          Field => messages, from the last attempt.
    @var string form_action
    @var string list_url
    @var int    max_quantity
    @var int    max_days
    @var string error_message   Empty unless the configuration could not be written.
    @var string success_message Empty unless a save has just succeeded.
#}
{% extends '@admin/layouts/default.twig' %}

{% macro text(name, label, value, errors, max, help) %}
    <label class="form-label" for="news-{{ name }}">{{ label }}</label>
    <input type="text" class="form-control{{ errors[name] is defined ? ' is-invalid' }}" id="news-{{ name }}" name="{{ name }}" value="{{ value }}" maxlength="{{ max }}"
        {%- if help %} aria-describedby="news-{{ name }}-help"{% endif %}>
    {% include '@theme/components/field-errors.twig' with {errors: errors[name]|default([])} only %}
    {% if help %}
        <div class="form-text" id="news-{{ name }}-help">{{ help }}</div>
    {% endif %}
{% endmacro %}

{% macro textarea(name, label, value, errors) %}
    <label class="form-label" for="news-{{ name }}">{{ label }}</label>
    <textarea class="form-control{{ errors[name] is defined ? ' is-invalid' }}" id="news-{{ name }}" name="{{ name }}" rows="2" maxlength="1000">{{ value }}</textarea>
    {% include '@theme/components/field-errors.twig' with {errors: errors[name]|default([])} only %}
{% endmacro %}

{% block content %}
    {% import _self as form %}

    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: error_message} only %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}
    {% if errors is not empty %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: __('The settings are not saved: check the fields marked below.')} only %}
    {% endif %}

    <div class="row">
        <div class="col-xxl-9">
            <form method="post" action="{{ form_action }}" class="d-flex flex-column gap-3">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">

                <div class="card">
                    <div class="card-header">
                        {% include '@admin/components/ui/icon.twig' with {name: 'house', size: 15, class: 'text-body-tertiary'} only %}
                        {{ __('Home page settings') }}
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" name="homepage_show" value="1" id="homepage_show"{% if settings.homepageShow %} checked{% endif %}>
                                <label class="form-check-label" for="homepage_show">
                                    {{ __('Show on home page') }}
                                    <span class="form-text d-block mt-0">{{ __('The latest articles in a block of the home page.') }}</span>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="news-homepage_quantity">{{ __('Quantity of news') }}</label>
                            <div class="input-group has-validation">
                                <input type="number" class="form-control{{ errors.homepage_quantity is defined ? ' is-invalid' }}" id="news-homepage_quantity" name="homepage_quantity" value="{{ settings.homepageQuantity }}" min="1" max="{{ max_quantity }}" aria-describedby="news-homepage_quantity-help">
                                <span class="input-group-text">{{ __('articles') }}</span>
                                {% include '@theme/components/field-errors.twig' with {errors: errors.homepage_quantity|default([])} only %}
                            </div>
                            <div class="form-text" id="news-homepage_quantity-help">{{ __('From %d to %d')|format(1, max_quantity) }}</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="news-homepage_days">{{ __('How many days to show?') }}</label>
                            <div class="input-group has-validation">
                                <input type="number" class="form-control{{ errors.homepage_days is defined ? ' is-invalid' }}" id="news-homepage_days" name="homepage_days" value="{{ settings.homepageDays }}" min="0" max="{{ max_days }}" aria-describedby="news-homepage_days-help">
                                <span class="input-group-text">{{ __('days') }}</span>
                                {% include '@theme/components/field-errors.twig' with {errors: errors.homepage_days|default([])} only %}
                            </div>
                            <div class="form-text" id="news-homepage_days-help">{{ __('An article older than this leaves the block. 0 - always display.') }}</div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        {% include '@admin/components/ui/icon.twig' with {name: 'newspaper', size: 15, class: 'text-body-tertiary'} only %}
                        {{ __('Meta tags for the main page') }}
                    </div>
                    <div class="card-body d-flex flex-column gap-3">
                        <div>{{ form.text('title', __('Module name'), settings.title, errors, 250, '') }}</div>
                        <div>{{ form.text('meta_keywords', __('Keywords'), settings.metaKeywords, errors, 500, '') }}</div>
                        <div>{{ form.textarea('meta_description', __('Description'), settings.metaDescription, errors) }}</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        {% include '@admin/components/ui/icon.twig' with {name: 'folder', size: 15, class: 'text-body-tertiary'} only %}
                        <span class="flex-grow-1">{{ __('Meta tag templates for sections') }}</span>
                        <span class="small fw-normal text-body-secondary">{{ __('%s is replaced with the name of the section')|format('#section_name#') }}</span>
                    </div>
                    <div class="card-body d-flex flex-column gap-3">
                        <div class="form-text mt-0">{{ __('The title is always made of the template; the keywords and the description of it, where the section has none of its own.') }}</div>
                        <div>{{ form.text('section_title', __('Title'), settings.sectionTitle, errors, 250, '') }}</div>
                        <div>{{ form.text('section_meta_keywords', __('Keywords'), settings.sectionMetaKeywords, errors, 500, '') }}</div>
                        <div>{{ form.textarea('section_meta_description', __('Description'), settings.sectionMetaDescription, errors) }}</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        {% include '@admin/components/ui/icon.twig' with {name: 'file-text', size: 15, class: 'text-body-tertiary'} only %}
                        <span class="flex-grow-1">{{ __('Meta tag templates for articles') }}</span>
                        <span class="small fw-normal text-body-secondary">{{ __('%s is replaced with the name of the article')|format('#article_name#') }}</span>
                    </div>
                    <div class="card-body d-flex flex-column gap-3">
                        <div class="form-text mt-0">{{ __('Used where the article has no title, keywords or description of its own.') }}</div>
                        <div>{{ form.text('article_title', __('Title'), settings.articleTitle, errors, 250, '') }}</div>
                        <div>{{ form.text('article_meta_keywords', __('Keywords'), settings.articleMetaKeywords, errors, 500, '') }}</div>
                        <div>{{ form.textarea('article_meta_description', __('Description'), settings.articleMetaDescription, errors) }}</div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ list_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
                    <button type="submit" class="btn btn-primary">
                        {% include '@admin/components/ui/icon.twig' with {name: 'save', size: 14} only %}
                        {{ __('Save') }}
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
