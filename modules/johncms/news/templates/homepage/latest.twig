{# @var news iterable<array> Published articles selected by the module settings. #}
{% embed '@theme/components/content-card.twig' with {
    class: 'site-content-card--news', marker: true, id: 'home-news', title: d__('news', 'News'), icon: 'newspaper', url: '/news/', link_label: d__('news', 'All news'), news: news
} only %}
    {% block body %}
        {% for article in news %}
            <article class="site-content-card__item">
                <h3><a href="{{ article.url }}">{{ article.name }}</a></h3>
                {% if article.preview_text_safe is not empty %}
                    <div class="site-content-card__preview">{{ article.preview_text_safe }}</div>
                {% endif %}
                <div class="site-news-meta">
                    <a class="site-news-meta__item" href="{{ article.url }}#article-comments" aria-label="{{ d__('news', 'Comments') }}: {{ article.comments_count|format_number }}" title="{{ d__('news', 'Comments') }}">
                        {% include '@theme/components/icon.twig' with {name: 'message-square', size: 11} only %}
                        {{ article.comments_count|format_number }}
                    </a>
                    <span class="site-news-meta__item" title="{{ d__('news', 'Views') }}">
                        <span class="site-meta-separator" aria-hidden="true">·</span>
                        {% include '@theme/components/icon.twig' with {name: 'eye', size: 11} only %}
                        <span class="visually-hidden">{{ d__('news', 'Views') }}: </span>{{ article.view_count|format_number }}
                    </span>
                    <span class="site-news-meta__item" title="{{ d__('news', 'Rating') }}">
                        <span class="site-meta-separator" aria-hidden="true">·</span>
                        {% include '@theme/components/icon.twig' with {name: 'chart-column', size: 11} only %}
                        <span class="visually-hidden">{{ d__('news', 'Rating') }}: </span>{{ article.rating|format_number }}
                    </span>
                    <span class="site-news-meta__date"><span class="site-meta-separator" aria-hidden="true">·</span>{{ article.display_date }}</span>
                </div>
            </article>
        {% else %}
            {% include '@theme/components/empty-state.twig' with {
                icon: 'newspaper', title: d__('news', 'No news yet'),
                description: d__('news', 'Published news will appear here.')
            } only %}
        {% endfor %}
    {% endblock %}
{% endembed %}
