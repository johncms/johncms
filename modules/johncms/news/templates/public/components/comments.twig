{#
    The discussion of an article, rendered with the page so that search engines see it. The feed
    is a live list: its pages are swapped in place, and the forms are sent without leaving the
    page, while the form with the editor stays as it is.

    @var article_id int
    @var comments   list<NewsCommentViewDTO> The comments of the current page.
    @var total      int
    @var offset     int Comments before the current page.
    @var page       int
    @var pagination \Twig\Markup|null
    @var can_write  bool
    @var error      string|null What went wrong with the last comment.
    @var message    string|null What happened to the last comment.
    @var added      int|null    The comment just added, which the live list scrolls to.
    @var delete_error string|null Why the last comment could not be deleted.
    @var text       string The text to put back into the form after an error.
#}
<section class="site-news-comments" id="article-comments" aria-labelledby="article-comments-title" data-live-list>
    {% include '@news/public/components/comments-feed.twig' with {
        article_id: article_id,
        comments: comments,
        total: total,
        offset: offset,
        page: page,
        pagination: pagination,
        message: message,
        added: added,
        delete_error: delete_error,
    } only %}

    {% if can_write %}
        <section class="site-news-compose" id="comment-form" aria-labelledby="comment-form-title">
            <h3 class="visually-hidden" id="comment-form-title">{{ __('Write a comment') }}</h3>
            {% include '@news/public/components/comment-error.twig' with {error: error} only %}
            {# The form is the frame of the editor: the toolbar, the text and the button share one border. #}
            <form class="site-news-compose__form" id="news-comment-form-{{ article_id }}" method="post" action="/news/comments/add/{{ article_id }}/" data-live-list-form data-comment-form>
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                {% include '@theme/components/editor.twig' with {
                    name: 'text',
                    id: 'comment-text',
                    label: __('Write a comment'),
                    label_hidden: true,
                    placeholder: __('Write a comment'),
                    value: text,
                    upload_url: '/news/comments/upload_file/',
                    allow_upload: true,
                    required: true,
                } only %}
                <div class="site-news-compose__actions">
                    <button type="submit" class="btn btn-primary">
                        {% include '@theme/components/icon.twig' with {name: 'send', size: 14} only %} {{ __('Send') }}
                    </button>
                </div>
            </form>
        </section>
    {% elseif not app.user.isValid %}
        <div class="site-news-comments__login">
            {# The link to the login page is part of the translated string. #}
            {{ __('You are not logged in. You must be <a href="/login/">logged in</a> to comment.')|raw }}
        </div>
    {% endif %}
</section>
