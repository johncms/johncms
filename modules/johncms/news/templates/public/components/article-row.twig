{# @var article array Published article with sanitized preview and discussion statistics. #}
<article class="site-news-card">
    <h3 class="site-news-card__title"><a href="{{ article.url }}">{{ article.name }}</a></h3>
    {% if article.preview_text_safe %}
        <div class="site-news-card__preview">{{ article.preview_text_safe }}</div>
    {% endif %}
    <div class="site-news-card__meta">
        <span class="site-news-card__rating{{ article.rating > 0 ? ' site-news-card__rating--positive' : (article.rating < 0 ? ' site-news-card__rating--negative' : '') }}" title="{{ __('Rating') }}">
            {% include '@theme/components/icon.twig' with {name: article.rating < 0 ? 'thumbs-down' : 'thumbs-up', size: 12} only %}
            <span class="visually-hidden">{{ __('Rating') }}: </span>{{ article.rating > 0 ? '+' : '' }}{{ article.rating|format_number }}
        </span>
        <span class="site-news-card__stat" title="{{ __('Views') }}">
            {% include '@theme/components/icon.twig' with {name: 'eye', size: 12} only %}
            <span class="visually-hidden">{{ __('Views') }}: </span>{{ article.view_count|format_number }}
        </span>
        <a class="site-news-card__stat" href="{{ article.url }}#article-comments" aria-label="{{ __('Comments') }}: {{ article.comments_count|format_number }}" title="{{ __('Comments') }}">
            {% include '@theme/components/icon.twig' with {name: 'message-square', size: 12} only %}
            {{ article.comments_count|format_number }}
        </a>
        <span class="site-news-card__date" title="{{ article.display_date }}">{{ article.short_date }}</span>
    </div>
</article>
