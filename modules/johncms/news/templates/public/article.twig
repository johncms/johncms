{#
    @var article         array Article with sanitized text, author and discussion statistics.
    @var current_section array|null
    @var related         list<array> Other news of the section topped up with the latest news, the latest first.
    @var popular         list<array> The most viewed news, none of them shown above.
    @var author_articles int   Published news of the author.
    @var can_write       bool
    @var comments        list<NewsCommentViewDTO> Comments of the current page of the discussion.
    @var comments_total  int
    @var comments_offset int
    @var comments_page   int
    @var comments_pagination \Twig\Markup|null
    @var comment_error   string|null
    @var comment_message string|null
    @var comment_text    string
    @var edit_url        string|null
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--news site-content--news-article{% endblock %}

{% block page_subtitle %}
    <p class="site-page-heading__subtitle">
        <span class="site-page-stat">
            <span class="site-page-stat__dot" aria-hidden="true"></span>
            {{ __('published %s')|format(article.display_date) }} ·
            {{ n__('%s view', '%s views', article.view_count)|format(article.view_count|format_number) }}
        </span>
    </p>
{% endblock %}

{% block content %}
    {% set article_url = config('johncms.homeurl')|trim('/', 'right') ~ article.url %}
    <div class="site-news site-news--article" id="blog">
        <div class="site-news-layout">
            <div class="site-news-layout__main">
                <article class="site-news-article">
                    {% if current_section or article.tags is not empty or edit_url %}
                        <div class="site-news-article__labels">
                            {% if current_section %}
                                <a class="site-news-article__section" href="{{ current_section.url }}">{{ current_section.name }}</a>
                            {% endif %}
                            {% if article.tags is not empty %}
                                <nav class="site-news-article__tags" aria-label="{{ __('Tags:') }}">
                                    {% for tag in article.tags %}<a href="/news/search_tags/?tag={{ tag|url_encode }}">#{{ tag }}</a>{% endfor %}
                                </nav>
                            {% endif %}
                            {% if edit_url %}
                                <a href="{{ edit_url }}" class="site-news-article__edit" title="{{ __('Edit') }}" aria-label="{{ __('Edit') }}">
                                    {% include '@theme/components/icon.twig' with {name: 'pencil', size: 14} only %}
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                    <div class="site-news-article__body ck-content">
                        {{ article.text_safe }}
                    </div>
                    <footer class="site-news-article__footer">
                        <div class="vue_app">
                            <likes-component
                                :article_id="{{ article.id }}"
                                :rating="{{ article.rating }}"
                                :can_vote="{{ can('news.vote') ? 'true' : 'false' }}"
                                :voted="{{ article.current_vote }}"
                                icon_sprite="{{ asset('icons/public.svg', true) }}"
                                :i18n='{{ {like: __('Like'), dislike: __('Dislike'), rating: __('Rating'), loading: __('Loading...')}|json_encode }}'
                            ></likes-component>
                        </div>
                        <span class="site-news-article__stat" title="{{ __('Views') }}">
                            {% include '@theme/components/icon.twig' with {name: 'eye', size: 14} only %}
                            <span class="visually-hidden">{{ __('Views') }}: </span>{{ article.view_count|format_number }}
                        </span>
                        <a class="site-news-article__stat" href="#article-comments" aria-label="{{ __('Comments') }}: {{ article.comments_count|format_number }}">
                            {% include '@theme/components/icon.twig' with {name: 'message-square', size: 14} only %} {{ article.comments_count|format_number }}
                        </a>
                        <div class="site-news-share" data-news-share data-url="{{ article.url }}" data-copied="{{ __('Link copied') }}" data-error="{{ __('Could not copy the link.') }}">
                            <a class="btn btn-outline-secondary btn-sm" href="https://t.me/share/url?url={{ article_url|url_encode }}&amp;text={{ article.name|url_encode }}" target="_blank" rel="noopener noreferrer">
                                {% include '@theme/components/icon.twig' with {name: 'send', size: 14} only %} Telegram
                            </a>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-news-copy hidden>
                                {% include '@theme/components/icon.twig' with {name: 'copy', size: 14} only %} {{ __('Copy link') }}
                            </button>
                            <span class="site-news-share__status" role="status"></span>
                        </div>
                    </footer>
                </article>
                {% include '@news/public/components/comments.twig' with {
                    article_id: article.id,
                    comments: comments,
                    total: comments_total,
                    offset: comments_offset,
                    page: comments_page,
                    pagination: comments_pagination,
                    can_write: can_write,
                    error: comment_error,
                    message: comment_message,
                    text: comment_text,
                } only %}
            </div>

            <aside class="site-news-layout__side">
                {% if article.author %}
                    {% set author_url = profile_url(article.author.id) %}
                    <section class="site-news-panel" aria-labelledby="news-author-title">
                        <h2 class="site-news-panel__title" id="news-author-title">{{ __('Author') }}</h2>
                        <div class="site-news-author">
                            <img class="site-news-author__avatar" src="{{ avatar(article.author.id) }}" alt="" width="44" height="44" loading="lazy">
                            <div class="site-news-author__main">
                                {% if author_url %}
                                    <a class="site-news-author__name" href="{{ author_url }}" rel="nofollow">{{ article.author.name }}</a>
                                {% else %}
                                    <span class="site-news-author__name">{{ article.author.name }}</span>
                                {% endif %}
                                {% if article.author.rightsName %}<span class="site-news-author__role">{{ article.author.rightsName }}</span>{% endif %}
                            </div>
                        </div>
                        <dl class="site-news-author__stats">
                            <div>
                                <dt>{{ __('News') }}</dt>
                                <dd>{{ author_articles|format_number }}</dd>
                            </div>
                            {% if article.author.joinedAt > 0 %}
                                <div>
                                    <dt>{{ __('On the site since') }}</dt>
                                    <dd>{{ article.author.joinedAt|date('Y') }}</dd>
                                </div>
                            {% endif %}
                        </dl>
                    </section>
                {% endif %}

                {% if related is not empty %}
                    {% include '@news/public/components/side-list.twig' with {
                        id: 'news-related-title', title: __('Read also'), items: related
                    } only %}
                {% endif %}

                {% if popular is not empty %}
                    {% include '@news/public/components/side-list.twig' with {
                        id: 'news-popular-title', title: __('Popular'), items: popular
                    } only %}
                {% endif %}
            </aside>
        </div>
    </div>
{% endblock %}
