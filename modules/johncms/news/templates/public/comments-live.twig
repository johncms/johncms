{#
    The regions of the discussion, as the live list asks for them: those of the core, and the
    number of comments in the header of the article, which follows a comment added or deleted.
    A fragment, so it extends nothing.

    @var title      string Title of the page, without the site name.
    @var discussion array  The variables of the discussion (CommentDiscussionView).
#}
{% include '@theme/pages/comments-live.twig' with discussion|merge({title: title}) only %}
{% include '@news/public/components/comments-stat.twig' with {count: discussion.total} only %}
