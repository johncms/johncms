{#
    @var articles       iterable<array> Published articles.
    @var articles_total int             Published articles of the section with its subsections, or of all news.
    @var sections       iterable<array> Child sections of the current one.
    @var current_section array|null
    @var summary        string          Short description of the section, or of the news on their main page.
    @var pagination     \Twig\Markup|null
    @var workspace_url  string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--news{% endblock %}

{% block page_subtitle %}
    <p class="site-page-heading__subtitle">
        {% if summary %}<span>{{ summary }}</span>{% endif %}
        <span class="site-page-stat">
            <span class="site-page-stat__dot" aria-hidden="true"></span>
            {% if not current_section and sections|length > 0 %}
                {{ n__('%d section', '%d sections', sections|length)|format(sections|length) }} ·
            {% endif %}
            {{ n__('%d publication', '%d publications', articles_total)|format(articles_total) }}
        </span>
    </p>
{% endblock %}

{% block content %}
    {% set sections_block %}
        {% if sections|length > 0 %}
            <section aria-labelledby="news-sections-title">
                <h2 class="site-news__heading" id="news-sections-title">
                    {{ current_section ? __('Subsections') : __('Sections') }}
                    <span class="site-news__count">{{ sections|length }}</span>
                </h2>
                <div class="site-news__list site-news__list--tight">
                    {% for section in sections %}
                        {% include '@news/public/components/section-card.twig' with {section: section} only %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    {% endset %}

    <div class="site-news">
        <div class="site-news__toolbar">
            {% include '@news/public/components/search-form.twig' with {
                action: '/news/search/', field: 'query', placeholder: __('Search news…')
            } only %}
            {% if can('news.manage') %}
                <a href="{{ workspace_url }}" class="btn btn-outline-secondary btn-sm">
                    {% include '@theme/components/icon.twig' with {name: 'settings', size: 14} only %}
                    {{ __('Admin panel') }}
                </a>
            {% endif %}
        </div>

        {% if not current_section %}{{ sections_block }}{% endif %}

        <section aria-labelledby="news-list-title">
            <h2 class="site-news__heading" id="news-list-title">
                {{ current_section ? __('Section news') : __('All news') }}
                <span class="site-news__count">{{ articles_total|format_number }}</span>
            </h2>
            <div class="site-news__list">
                {% for article in articles %}
                    {% include '@news/public/components/article-row.twig' with {article: article} only %}
                {% else %}
                    {% include '@theme/components/empty-state.twig' with {
                        icon: 'newspaper', title: __('No news yet'), description: __('Published news will appear here.')
                    } only %}
                {% endfor %}
            </div>
            {% if pagination %}<div class="site-news__pagination">{{ pagination }}</div>{% endif %}
        </section>

        {% if current_section %}{{ sections_block }}{% endif %}

        {% if current_section and current_section.text_safe %}
            <div class="site-news__description ck-content">{{ current_section.text_safe }}</div>
        {% endif %}
    </div>
{% endblock %}
