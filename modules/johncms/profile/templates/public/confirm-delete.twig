{#
    Confirmation of a removal in the profile.

    @param string message
    @param string form_action
    @param string back_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="alert alert-danger">
        <div class="pb-2">
            {{ message }}
        </div>
        <div>
            <form action="{{ form_action }}" method="post">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                <button type="submit" name="delete" value="1" class="btn btn-danger btn-sm">{{ __('Delete') }}</button>
                <a href="{{ back_url }}" class="btn btn-outline-secondary btn-sm">{{ __('Cancel') }}</a>
            </form>
        </div>
    </div>
{% endblock %}
