{#
    Navigation, the total and the way back under a list of the profile.

    @param ?Markup pagination
    @param int     total
    @param string  back_url  Omitted when the page has no link back.
#}
<div class="mt-3">
    {% if pagination|default(null) %}
        <div class="mt-1">{{ pagination }}</div>
    {% endif %}
    {% if total > 0 %}
        <div>{{ __('Total:') }} {{ total }}</div>
    {% endif %}
</div>
{% if back_url|default('') %}
    <div>
        <a href="{{ back_url }}">{{ __('Back') }}</a>
    </div>
{% endif %}
