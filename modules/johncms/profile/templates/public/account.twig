{#
    The personal page of the visitor: their sections with counters.

    @param AccountDTO account
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <h3>{{ __('My Pages') }}</h3>

    <div class="list-group with_counters">
        <div class="list-group-item">
            <a href="/profile/{{ account.userId }}" class="link">{{ __('Profile') }}</a>
        </div>
        <div class="list-group-item">
            <a href="/profile/{{ account.userId }}/statistics/" class="link">{{ __('Statistics') }}</a>
        </div>
        <div class="list-group-item">
            <a href="/album/user/{{ account.userId }}" class="link">{{ __('Photo Album') }}</a>
            <span class="counter badge text-bg-light rounded-pill">{{ account.totalPhoto }}</span>
        </div>
        <div class="list-group-item">
            <a href="/profile/{{ account.userId }}/guestbook" class="link">{{ __('Guestbook') }}</a>
            <span class="counter badge text-bg-light rounded-pill">{{ account.guestbookCount }}</span>
        </div>
    </div>

    <h3 class="mt-3">{{ __('My Mailbox') }}</h3>

    <div class="list-group with_counters">
        <div class="list-group-item">
            <a href="/mail/incoming" class="link">{{ __('Received') }}</a>
            <span class="counter badge rounded-pill {{ account.newMessages > 0 ? 'bg-danger' : 'text-bg-light' }}">
                {{ account.inbox }}
                {%- if account.newMessages > 0 %} / +{{ account.newMessages }}{% endif %}
            </span>
        </div>
        <div class="list-group-item">
            <a href="/mail/outgoing" class="link">{{ __('Sent') }}</a>
            <span class="counter badge rounded-pill {{ account.unreadSent > 0 ? 'bg-danger' : 'text-bg-light' }}">
                {{ account.outbox }}
                {%- if account.unreadSent > 0 %} / +{{ account.unreadSent }}{% endif %}
            </span>
        </div>
        <div class="list-group-item">
            <a href="/mail/files" class="link">{{ __('Files') }}</a>
            <span class="counter badge rounded-pill text-bg-light">{{ account.files }}</span>
        </div>
    </div>

    <h3 class="mt-3">{{ __('Contacts') }}</h3>

    <div class="list-group with_counters">
        <div class="list-group-item">
            <a href="/mail/contacts" class="link">{{ __('Contacts') }}</a>
            <span class="counter badge rounded-pill text-bg-light">{{ account.contacts }}</span>
        </div>
        <div class="list-group-item">
            <a href="/mail/blocklist" class="link">{{ __('Blocked') }}</a>
            <span class="counter badge rounded-pill text-bg-light">{{ account.blockedContacts }}</span>
        </div>
    </div>

    <h3 class="mt-3">{{ __('Settings') }}</h3>

    <div class="list-group">
        <a href="/profile/{{ account.userId }}/edit" class="list-group-item">{{ __('Edit Profile') }}</a>
        <a href="/profile/{{ account.userId }}/password" class="list-group-item">{{ __('Change Password') }}</a>
        <a href="/profile/sessions" class="list-group-item">{{ __('My Devices') }}</a>
        <a href="/profile/settings" class="list-group-item">{{ __('System Settings') }}</a>
    </div>
{% endblock %}
