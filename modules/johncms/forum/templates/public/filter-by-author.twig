{#
    Choosing the authors whose posts stay visible in a topic.

    @var set_filter_action   string
    @var clear_filter_action string
    @var back_url            string The topic, at the page it was left on.
    @var topic_name          string
    @var list                array  user_id, user_name, count
    @var selected_user_ids   array  Identifiers already saved in the session.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="robots" content="noindex,follow">
{% endblock %}

{% block page_subtitle %}
    <p class="site-page-heading__subtitle">
        <a class="site-subject-link" href="{{ back_url }}" title="{{ topic_name }}">
            {% include '@theme/components/icon.twig' with {name: 'messages-square', size: 14} only %}
            <span class="site-subject-link__text">{{ topic_name }}</span>
        </a>
    </p>
{% endblock %}

{% block content %}
    {% if list is empty %}
        {% include '@theme/components/empty-state.twig' with {
            icon: 'users',
            title: __('The list is empty'),
        } only %}
        <div class="site-forum-form__actions">
            <a href="{{ back_url }}" class="btn btn-outline-secondary">{{ __('Back to topic') }}</a>
        </div>
    {% else %}
        <form class="site-forum-form" action="{{ set_filter_action }}" method="post">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <fieldset>
                <legend class="site-forum-form__title">{{ __('Filter will be display posts from selected authors only') }}</legend>
                <ul class="site-forum-authors">
                    {% for item in list %}
                        <li class="site-forum-authors__item">
                            <input class="form-check-input" type="checkbox" name="users[]" value="{{ item.user_id }}"
                                   id="user_{{ item.user_id }}"{% if item.user_id in selected_user_ids %} checked{% endif %}>
                            <label class="site-forum-authors__name" for="user_{{ item.user_id }}">{{ item.user_name }}</label>
                            <span class="site-forum-authors__count" title="{{ __('Posts') }}">{{ item.count|format_number }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </fieldset>
            <div class="site-forum-form__actions">
                <a href="{{ back_url }}" class="btn btn-outline-secondary">{{ __('Back to topic') }}</a>
                {% if selected_user_ids %}
                    <button type="submit" formaction="{{ clear_filter_action }}" class="btn btn-outline-secondary">{{ __('Cancel Filter') }}</button>
                {% endif %}
                <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Filter') }}</button>
            </div>
        </form>
    {% endif %}
{% endblock %}
