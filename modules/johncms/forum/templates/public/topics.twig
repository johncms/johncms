{#
    A section of the forum: the topics it holds, the pinned ones first.

    @var summary       string Description of the section, empty when it has none.
    @var topics        \Johncms\Modules\Forum\Application\DTO\ForumTopicRowDTO[]
    @var total         int
    @var totals        array  topics, posts — over the section, as the visitor sees it.
    @var pagination    \Twig\Markup Null when everything fits on one page.
    @var create_access bool   The visitor may open a topic here.
    @var new_topic_url string
    @var files_url     string
    @var online        array  online_u, online_g
    @var files_count   string
    @var unread_count  string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_actions %}
    {% if create_access %}
        <a href="{{ new_topic_url }}" class="btn btn-primary">
            {% include '@theme/components/icon.twig' with {name: 'plus', size: 14} only %} {{ __('New Topic') }}
        </a>
    {% endif %}
{% endblock %}

{% block page_subtitle %}
    {% include '@forum/public/components/stat.twig' with {totals: totals, summary: summary} only %}
{% endblock %}

{% block content %}
    <div class="site-forum">
        {% include '@forum/public/components/header.twig' with {
            unread_count: unread_count,
            files_count: files_count,
            files_url: files_url,
            files_name: __('Category Files'),
        } only %}

        {% if topics %}
            <div class="site-forum__rows" id="forum-topics">
                {% for topic in topics %}
                    {% include '@forum/public/components/topic-row.twig' with {topic: topic} only %}
                {% endfor %}
            </div>
            {% if pagination %}<div class="site-forum__pagination">{{ pagination }}</div>{% endif %}
        {% else %}
            {% include '@theme/components/empty-state.twig' with {
                icon: 'messages-square',
                title: __('No topics in this section'),
                description: create_access ? __('Start the first one.') : '',
            } only %}
        {% endif %}

        {% include '@forum/public/components/footer.twig' with {
            online: online,
            who_url: '/forum/visitors/',
            who_name: __('Who in Forum'),
        } only %}
    </div>
{% endblock %}
