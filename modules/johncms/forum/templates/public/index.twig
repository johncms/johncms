{#
    The root of the forum: its sections, each opening the sections under it.

    @var sections     \Johncms\Modules\Forum\Application\DTO\ForumSectionRowDTO[]
    @var totals       array  topics, posts — over the whole forum, as the visitor sees it.
    @var online       array  online_u, online_g
    @var files_count  string
    @var unread_count string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    {% include '@forum/public/components/stat.twig' with {totals: totals} only %}
{% endblock %}

{% block content %}
    <div class="site-forum">
        {% include '@forum/public/components/header.twig' with {
            unread_count: unread_count,
            files_count: files_count,
            files_url: '/forum/files/',
            files_name: __('Files'),
        } only %}

        {% if sections %}
            <div class="site-forum__rows">
                {% for row in sections %}
                    {% include '@forum/public/components/section-row.twig' with {row: row} only %}
                {% endfor %}
            </div>
        {% else %}
            {% include '@theme/components/empty-state.twig' with {
                icon: 'messages-square',
                title: __('The forum has no sections yet'),
                description: '',
            } only %}
        {% endif %}

        {% include '@forum/public/components/footer.twig' with {
            online: online,
            who_url: '/forum/visitors/',
            who_name: __('Who in Forum'),
        } only %}
    </div>
{% endblock %}
