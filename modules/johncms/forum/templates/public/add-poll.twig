{#
    Adding a poll to a topic. A form sent back keeps its fields and says what was wrong beside them.

    @var action_url string
    @var back_url   string The topic.
    @var topic_name string
    @var poll_name  string
    @var count_vote int    Answer fields on the form, from 2 to 20.
    @var votes      array  input_name, input_label, input_value
    @var errors     array  Messages by field: name_vote, answers.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    {% include '@forum/public/components/topic-subtitle.twig' with {url: back_url, name: topic_name} only %}
{% endblock %}

{% block content %}
    {% include '@forum/public/components/poll-form.twig' with {
        action_url: action_url,
        back_url: back_url,
        poll_name: poll_name,
        count_vote: count_vote,
        votes: votes,
        can_add: count_vote < 20,
        can_remove: count_vote > 2,
        errors: errors,
        submit_name: __('Add Poll'),
    } only %}
{% endblock %}
