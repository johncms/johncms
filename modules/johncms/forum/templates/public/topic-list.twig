{#
    Topics across the forum: the latest ones, the unread ones or those of a period. Each names the
    section it is in.

    @var topics              \Johncms\Modules\Forum\Application\DTO\ForumTopicRowDTO[]
    @var total               int
    @var pagination          \Twig\Markup Null when everything fits on one page.
    @var empty_message       string
    @var show_period         bool   Show the form that asks for a period.
    @var period_action       string
    @var period              int    Hours of the period shown; 0 when the page is not about a period.
    @var mark_as_read_action string Empty when there is nothing to mark.
    @var message             string The result of the last action, empty when there is none.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_actions %}
    {% if mark_as_read_action %}
        <form action="{{ mark_as_read_action }}" method="post"
              data-confirm="{{ __('Mark every topic as read?') }}" data-confirm-button="{{ __('Mark as read') }}" data-confirm-tone="primary">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <button type="submit" class="btn btn-outline-secondary">
                {% include '@theme/components/icon.twig' with {name: 'check', size: 14} only %} {{ __('Mark as read') }}
            </button>
        </form>
    {% endif %}
{% endblock %}

{% block page_subtitle %}
    {% if total %}
        <p class="site-page-heading__subtitle">
            <span class="site-page-stat"><span class="site-page-stat__dot" aria-hidden="true"></span>{{ n__('%s topic', '%s topics', total)|format(total|format_number) }}</span>
        </p>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="site-forum">
        {% if message %}{% include '@theme/components/toast.twig' with {message: message} only %}{% endif %}
        {% if show_period %}
            <form action="{{ period_action }}" method="get" class="site-forum-period">
                <label class="form-label mb-0" for="forum-period">{{ __('Hours') }}</label>
                <input type="number" class="form-control form-control-sm" id="forum-period" name="vr" min="1" max="999" value="{{ period }}">
                <button class="btn btn-outline-secondary btn-sm" type="submit">{{ __('Show period') }}</button>
            </form>
        {% endif %}

        {% if topics %}
            <div class="site-forum__rows" id="forum-topics">
                {% for topic in topics %}
                    {% include '@forum/public/components/topic-row.twig' with {topic: topic} only %}
                {% endfor %}
            </div>
            {% if pagination %}<div class="site-forum__pagination">{{ pagination }}</div>{% endif %}
        {% else %}
            {% include '@theme/components/empty-state.twig' with {icon: 'messages-square', title: empty_message, description: ''} only %}
        {% endif %}
    </div>
{% endblock %}
