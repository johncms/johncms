{#
    Search over the posts of the forum, or over the names of its topics. Before anything is searched
    for, the page says what the search takes; a query it does not take comes back in its field
    with the reason under it.

    @var query             string
    @var search_t          bool         Search over the topic names instead of the posts.
    @var searched          bool         A query was taken and searched for.
    @var error             string       Why the query was not taken; empty otherwise.
    @var results           array        name and formatted_text carry the highlight, so they are markup.
    @var total             int
    @var pagination        \Twig\Markup Null when everything fits on one page.
    @var search_history    array        Previous queries of the visitor.
    @var history_reset_url string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="robots" content="noindex,follow">
{% endblock %}

{% block page_subtitle %}
    {% if searched %}
        <p class="site-page-heading__subtitle">
            <span class="site-page-stat">
                <span class="site-page-stat__dot" aria-hidden="true"></span>
                {{ __('Found') }}: {{ total|format_number }}
            </span>
        </p>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="site-forum">
        <form action="/forum/search/" method="get" class="site-forum-search" role="search">
            <div class="site-search-field site-forum-search__field{% if error %} is-invalid{% endif %}">
                <input name="search" type="search" value="{{ query }}" maxlength="64" minlength="4" required
                       placeholder="{{ __('Search the forum') }}" aria-label="{{ __('Search the forum') }}"
                       {% if error %}aria-invalid="true" aria-describedby="forum-search-error"{% endif %}>
                <button type="submit" class="btn" aria-label="{{ __('Search') }}" title="{{ __('Search') }}">
                    {% include '@theme/components/icon.twig' with {name: 'search', size: 16} only %}
                </button>
            </div>
            <div class="form-check site-forum-search__option">
                <input class="form-check-input" type="checkbox" name="t" value="1" id="forum-search-topics"{% if search_t %} checked{% endif %}>
                <label class="form-check-label" for="forum-search-topics">{{ __('Search in the topic names') }}</label>
            </div>
            {% if error %}<p class="site-forum-search__error" id="forum-search-error">{{ error }}</p>{% endif %}
        </form>

        {% if searched %}
            {% if results %}
                <div class="site-forum-results">
                    {% for result in results %}
                        <article class="site-forum-result">
                            <a class="site-forum-result__title" href="{{ result.post_url ?: result.topic_url }}">{{ result.name }}</a>
                            <div class="site-forum-result__meta">
                                {% if profile_url(result.user_id) %}
                                    <a href="{{ profile_url(result.user_id) }}">{{ result.user_name }}</a>
                                {% else %}
                                    <span>{{ result.user_name }}</span>
                                {% endif %}
                                <span aria-hidden="true">·</span>
                                <time>{{ result.formatted_date }}</time>
                                {% if result.post_url %}
                                    <span aria-hidden="true">·</span>
                                    <a href="{{ result.topic_url }}">{{ __('Go to Topic') }}</a>
                                {% endif %}
                            </div>
                            {% if result.formatted_text %}
                                <div class="site-forum-result__text">{{ result.formatted_text }}</div>
                            {% endif %}
                        </article>
                    {% endfor %}
                </div>
                {% if pagination %}<div class="site-forum__pagination">{{ pagination }}</div>{% endif %}
            {% else %}
                {% include '@theme/components/empty-state.twig' with {
                    icon: 'search',
                    title: __('Your search did not match any results'),
                    description: search_t ? __('Try other words or search in the posts.') : __('Try other words or search in the topic names.'),
                } only %}
            {% endif %}
        {% elseif not error %}
            {% include '@theme/components/empty-state.twig' with {
                icon: 'search',
                title: __('Search the forum'),
                description: __('Over the posts or the names of the topics, without regard to case; from 4 to 64 characters. The best matches come first.'),
            } only %}
        {% endif %}

        {% if search_history %}
            <section class="site-forum-history" aria-labelledby="forum-search-history">
                <h2 class="site-forum-history__title" id="forum-search-history">{{ __('Search History') }}</h2>
                <div class="site-forum-history__terms">
                    {% for search_term in search_history %}
                        <a class="site-chip" href="/forum/search/?search={{ search_term|url_encode }}">{{ search_term }}</a>
                    {% endfor %}
                    <form method="post" action="{{ history_reset_url }}"
                          data-confirm="{{ __('Do you really want to clear the search history?') }}" data-confirm-button="{{ __('Clear') }}">
                        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                        <button type="submit" class="btn btn-link btn-sm">{{ __('Clear history') }}</button>
                    </form>
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
