{#
    Who is in the forum or in a topic right now: users, or guests for those who see where visitors
    come from.

    @var items           array        See the component of a user row for the keys.
    @var total           int
    @var pagination      \Twig\Markup Null when everything fits on one page.
    @var users_list_url  string
    @var guests_list_url string
    @var is_users        bool         Users are shown, guests otherwise.
    @var empty_message   string
    @var topic_name      string       Set on the visitors of a topic.
    @var topic_url       string       Set on the visitors of a topic.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    {% if topic_name|default('') %}
        {% include '@forum/public/components/topic-subtitle.twig' with {url: topic_url, name: topic_name} only %}
    {% endif %}
{% endblock %}

{% block content %}
    <div class="site-forum-list-head">
        {% if can('users.origin.view') %}
            <nav class="site-segmented" aria-label="{{ __('Who is here') }}">
                <a class="site-segmented__item" href="{{ users_list_url }}"{% if is_users %} aria-current="page"{% endif %}>{{ __('Users') }}</a>
                <a class="site-segmented__item" href="{{ guests_list_url }}"{% if not is_users %} aria-current="page"{% endif %}>{{ __('Guests') }}</a>
            </nav>
        {% else %}
            <h2 class="site-forum-list-head__title">{{ __('Users') }}</h2>
        {% endif %}
        <span class="site-forum-list-head__count">{{ __('Total') }}: {{ total|format_number }}</span>
    </div>

    {% if items %}
        <div class="site-forum-users">
            {% for item in items %}
                {% include '@forum/public/components/user-row.twig' with {item: item} only %}
            {% endfor %}
        </div>
        {% if pagination %}<div class="site-forum__pagination">{{ pagination }}</div>{% endif %}
    {% else %}
        {% include '@theme/components/empty-state.twig' with {icon: 'users', title: empty_message, description: ''} only %}
    {% endif %}
{% endblock %}
