{#
    Editing a post of a topic.

    @var action_url string
    @var back_url   string
    @var msg        string Source of the post, as it is stored.
    @var errors     array  Validation messages by field name; _form for the form as a whole.
    @var token      string One-time token of the form, kept in the session.
    @var file_limits    \Johncms\Modules\Forum\Application\DTO\ForumFileLimitsDTO
    @var files_attached int Files the post holds already; deleted under the post in the topic.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="edit_post" action="{{ action_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <input type="hidden" name="token" value="{{ token }}">
        {% if errors._form|default([]) %}
            <div class="alert alert-danger">{{ errors._form|join(', ') }}</div>
        {% endif %}
        {% include '@theme/components/editor.twig' with {
            name: 'msg',
            label: __('Message'),
            value: msg,
            errors: errors.message|default([])|join(', '),
            upload_url: '/forum/upload_file/',
            allow_upload: true
        } only %}
        <div class="mb-3">
            {% include '@forum/public/components/file-field.twig' with {
                id: 'post-files',
                limits: file_limits,
                errors: errors.files|default([]),
                attached: files_attached,
            } only %}
        </div>
        <div>
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Save') }}</button>
        </div>
        <div class="mt-3">
            <a href="/help/?act=smileys" class="pe-2">{{ __('Smilies') }}</a> <a href="{{ back_url }}">{{ __('Back') }}</a>
        </div>
    </form>
{% endblock %}
