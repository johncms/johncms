{#
    Opening a topic in a section. A form sent back keeps its fields and says what was wrong beside
    them; only the files have to be chosen again, as no browser keeps them.

    @var action_url      string
    @var back_url        string The section the topic is opened in.
    @var section_name    string
    @var th              string Title of the topic being opened.
    @var msg             string
    @var data            array  meta_description, meta_keywords
    @var errors          array  Validation messages by field: name, message, files; _form for the form as a whole.
    @var token           string One-time token of the form, kept in the session.
    @var file_limits     \Johncms\Modules\Forum\Application\DTO\ForumFileLimitsDTO
    @var show_preview    bool   The author pressed "Preview".
    @var preview_message \Twig\Markup
    @var preview_time    int    Timestamp shown in the preview.
    @var can_set_meta    bool   Meta tags are set by the staff only.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    <p class="site-page-heading__subtitle"><span>{{ __('In the section') }} <a href="{{ back_url }}">{{ section_name }}</a></span></p>
{% endblock %}

{% block content %}
    {% if show_preview %}
        {% include '@forum/public/components/post-preview.twig' with {
            title: th,
            author: app.user,
            date: preview_time|display_date,
            message: preview_message,
        } only %}
    {% endif %}

    {% if errors._form|default([]) %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors._form|join(' ')} only %}
    {% endif %}

    <form class="site-forum-write" name="new_topic" action="{{ action_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <input type="hidden" name="token" value="{{ token }}">

        <section class="site-forum-write__section">
            <h2 class="site-forum-write__title">{{ __('Topic') }}</h2>
            {% set name_errors = errors.name|default([]) %}
            <div class="site-forum-write__field">
                <label class="form-label" for="topic-name">{{ __('Title') }}</label>
                <input type="text" class="form-control{{ name_errors ? ' is-invalid' : '' }}" id="topic-name" name="th" value="{{ th }}"
                       maxlength="200" required aria-describedby="topic-name-hint{{ name_errors ? ' topic-name-errors' : '' }}">
                <div class="form-text" id="topic-name-hint">{{ __('From 3 to 200 characters, not repeating a topic of this section.') }}</div>
                {% if name_errors %}<div class="invalid-feedback d-block" id="topic-name-errors">{{ name_errors|join(' ') }}</div>{% endif %}
            </div>
            <div class="site-forum-write__field">
                {% include '@theme/components/editor.twig' with {
                    name: 'msg',
                    id: 'topic-message',
                    label: __('Message'),
                    value: msg,
                    errors: errors.message|default([])|join(' '),
                    upload_url: '/forum/upload_file/',
                    allow_upload: true,
                } only %}
            </div>
            <div class="site-forum-write__field">
                {% include '@forum/public/components/file-field.twig' with {
                    id: 'topic-files',
                    limits: file_limits,
                    errors: errors.files|default([]),
                } only %}
            </div>
        </section>

        {% if can_set_meta %}
            <section class="site-forum-write__section">
                <h2 class="site-forum-write__title">{{ __('Search engines') }}</h2>
                <p class="site-forum-write__note">{{ __('Left empty, the templates of the forum settings are used.') }}</p>
                <div class="site-forum-write__field">
                    <label class="form-label" for="topic-meta-description">{{ __('Meta description') }}</label>
                    <textarea class="form-control" id="topic-meta-description" name="meta_description" rows="2">{{ data.meta_description|default('') }}</textarea>
                </div>
                <div class="site-forum-write__field">
                    <label class="form-label" for="topic-meta-keywords">{{ __('Meta keywords') }}</label>
                    <textarea class="form-control" id="topic-meta-keywords" name="meta_keywords" rows="2">{{ data.meta_keywords|default('') }}</textarea>
                </div>
            </section>
        {% endif %}

        <div class="site-forum-write__actions">
            <a href="{{ back_url }}" class="btn btn-outline-secondary">
                {% include '@theme/components/icon.twig' with {name: 'chevron-left', size: 14, class: 'site-icon--directional'} only %} {{ __('Cancel') }}
            </a>
            <div class="site-forum-write__actions-end">
                {# Without the name "submit" the form comes back with the preview. #}
                <button type="submit" class="btn btn-outline-secondary">
                    {% include '@theme/components/icon.twig' with {name: 'eye', size: 14} only %} {{ __('Preview') }}
                </button>
                <button type="submit" name="submit" value="1" class="btn btn-primary">
                    {% include '@theme/components/icon.twig' with {name: 'send', size: 14} only %} {{ __('Create topic') }}
                </button>
            </div>
        </div>
    </form>
{% endblock %}
