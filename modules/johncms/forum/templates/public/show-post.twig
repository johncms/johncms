{#
    One post out of its topic, the way a direct link to it opens.

    @var post      \Johncms\Modules\Forum\Application\DTO\ForumPostDTO
    @var topic_url string The page of the topic the post is on, at the post.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="robots" content="noindex,follow">
{% endblock %}

{% block content %}
    <div class="site-forum">
        {% include '@forum/public/components/message.twig' with {post: post, can_moderate: false, last_post: false} only %}
        <div class="site-forum-post-back">
            <a class="btn btn-outline-secondary btn-sm" href="{{ topic_url }}">
                {% include '@theme/components/icon.twig' with {name: 'messages-square', size: 14} only %} {{ __('Show in the topic') }}
            </a>
        </div>
    </div>
{% endblock %}
