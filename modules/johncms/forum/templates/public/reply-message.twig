{#
    Writing a message into a topic: a new one, a reply or a quote.

    @var form_action string
    @var back_url    string
    @var token       string One-time token of the form, kept in the session.
    @var topic_name  string
    @var msg         string Body of the message, prefilled for a reply and a quote.
    @var reply_to    int    The post the text answers, when the form under the topic was sent with one; 0 otherwise.
    @var file_limits \Johncms\Modules\Forum\Application\DTO\ForumFileLimitsDTO
    @var file_errors list<string> What was wrong with the files sent; they are chosen anew.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="message_form" action="{{ form_action }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <input type="hidden" name="token" value="{{ token }}">
        {% if reply_to %}<input type="hidden" name="reply_to" value="{{ reply_to }}">{% endif %}
        <div class="h4">{{ __('Topic') }}: {{ topic_name }}</div>

        {% include '@theme/components/editor.twig' with {
            name: 'msg',
            label: __('Message'),
            value: msg,
            upload_url: '/forum/upload_file/',
            allow_upload: true
        } only %}
        <div class="mb-3">
            {% include '@forum/public/components/file-field.twig' with {
                id: 'message-files',
                limits: file_limits,
                errors: file_errors,
            } only %}
        </div>
        <div>
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Write') }}</button>
        </div>
        <div class="mt-3">
            <a href="/help/?act=smileys" class="pe-2">{{ __('Smilies') }}</a> <a href="{{ back_url }}">{{ __('Back') }}</a>
        </div>
    </form>
{% endblock %}
