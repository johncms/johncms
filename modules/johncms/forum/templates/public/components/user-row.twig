{#
    One person in a list of the forum: who is in the forum or a topic, who voted in a poll.

    @var item array id, name, user_is_online, user_profile_link, place (where the person is; empty
                    when the list does not say), ip, ip_via_proxy, browser
#}
<article class="site-forum-user">
    <span class="site-forum-user__avatar">
        <img src="{{ avatar(item.id|default(0)) }}" alt="" width="40" height="40" loading="lazy">
        {% if item.user_is_online|default(false) %}<span class="site-forum-user__online" title="{{ d__('system', 'Online') }}"></span>{% endif %}
    </span>
    <div class="site-forum-user__main">
        {% if item.user_profile_link|default('') %}
            <a class="site-forum-user__name" href="{{ item.user_profile_link }}">{{ item.name }}</a>
        {% else %}
            <span class="site-forum-user__name">{{ item.name }}</span>
        {% endif %}
        {% if item.place|default('') %}<span class="site-forum-user__place">{{ item.place }}</span>{% endif %}
    </div>
    {% if can('users.origin.view') %}
        {% include '@theme/components/moderator-meta.twig' with {
            ip: item.ip|default(''), ip_via_proxy: item.ip_via_proxy|default(''), user_agent: item.browser|default('')
        } only %}
    {% endif %}
</article>
