{#
    The bar above every listing of the forum: the collections of topics, the files and the search.

    @var unread_count string Unread topics of the member, formatted; "0" or empty shows the chip without it.
    @var files_url    string
    @var files_name   string
    @var files_count  string Files here, formatted; 0 when the forum does not count them.
#}
{# The visitor is here, so they may read; the banner is about what they may not do. A guest is
   told nothing: writing takes signing in, and that goes without saying. #}
{% if app.user.isValid and not can('forum.post') %}
    <div class="alert alert-danger">{{ __('Read only') }}</div>
{% endif %}

<div class="site-forum-toolbar">
    <nav class="site-forum-toolbar__chips" aria-label="{{ __('Topics') }}">
        {% if app.user.isValid %}
            <a class="site-chip" href="/forum/unread/">
                {% include '@theme/components/icon.twig' with {name: 'sparkles', size: 12} only %} {{ __('Unread') }}
                {% if unread_count %}<span class="site-chip__count">{{ unread_count }}</span>{% endif %}
            </a>
            <a class="site-chip" href="/forum/topics-period/">
                {% include '@theme/components/icon.twig' with {name: 'calendar', size: 12} only %} {{ __('Show for Period') }}
            </a>
        {% else %}
            <a class="site-chip" href="/forum/latest-topics/">
                {% include '@theme/components/icon.twig' with {name: 'calendar', size: 12} only %} {{ __('Last activity') }}
            </a>
        {% endif %}
        <a class="site-chip" href="{{ files_url }}" rel="nofollow">
            {% include '@theme/components/icon.twig' with {name: 'download', size: 12} only %} {{ files_name }}
            {% if files_count %}<span class="site-chip__count">{{ files_count }}</span>{% endif %}
        </a>
    </nav>
    <form action="/forum/search/" method="get" class="site-search-field" role="search">
        <input name="search" type="search" minlength="4" placeholder="{{ __('Search the forum') }}" aria-label="{{ __('Search the forum') }}">
        <button type="submit" class="btn" aria-label="{{ __('Search') }}" title="{{ __('Search') }}">
            {% include '@theme/components/icon.twig' with {name: 'search', size: 16} only %}
        </button>
    </form>
</div>
