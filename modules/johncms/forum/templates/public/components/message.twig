{#
    One post of a topic.

    @var post         \Johncms\Modules\Forum\Application\DTO\ForumPostDTO
    @var can_moderate bool The post can be marked for deleting together with others (the form #topic-bulk-delete).
    @var last_post    bool The post is the last one in sight: deleting it takes the topic with it.
#}
{% set author = post.author %}
<article class="site-comment site-forum-post{{ post.isDeleted ? ' site-forum-post--deleted' : '' }}" id="post-{{ post.id }}">
    <div class="site-comment__avatar">
        {% if author.profileUrl %}<a href="{{ author.profileUrl }}" tabindex="-1" aria-hidden="true">{% endif %}
        <img src="{{ avatar(author.id ?? 0) }}" alt="" width="40" height="40" loading="lazy">
        {% if author.profileUrl %}</a>{% endif %}
        {% if author.isOnline %}<span class="site-comment__online" title="{{ d__('system', 'Online') }}"></span>{% endif %}
    </div>
    <div class="site-comment__main">
        <header class="site-comment__header">
            {% if author.profileUrl %}
                <a class="site-comment__name" href="{{ author.profileUrl }}">{{ author.name }}</a>
            {% else %}
                <span class="site-comment__name">{{ author.name }}</span>
            {% endif %}
            {% if author.rightsName %}<span class="site-comment__role">{{ author.rightsName }}</span>{% endif %}
            {# The date is the lasting link of the post: it opens on a page of its own. #}
            <a class="site-comment__date" href="{{ post.url }}"><time>{{ post.createdAt }}</time></a>
            {% if post.editInfo %}
                <span class="site-comment__date" data-bs-toggle="tooltip" data-bs-placement="top"
                      title="{{ __('Edited:') }} {{ post.editInfo.editorName }} ({{ post.editInfo.editedAt }}) [{{ post.editInfo.editCount }}]">{{ __('Edited') }}</span>
            {% endif %}
            {% if post.isDeleted %}
                <span class="site-forum-badge site-forum-badge--danger">{{ __('Deleted') }}</span>
                <span class="site-forum-post__note">{{ __('Post deleted:') }} {{ post.deletedBy }}</span>
            {% elseif post.restoredBy %}
                <span class="site-forum-post__note">{{ __('Post restored by:') }} {{ post.restoredBy }}</span>
            {% endif %}
            {% if can_moderate %}
                <label class="site-forum-post__select" title="{{ __('Select for deleting') }}">
                    <input type="checkbox" class="form-check-input" name="post_ids[]" value="{{ post.id }}" form="topic-bulk-delete"
                           aria-label="{{ __('Select for deleting') }}">
                </label>
            {% endif %}
        </header>
        {% if author.status %}<div class="site-comment__status">{{ author.status }}</div>{% endif %}
        {% if post.replyTo %}
            {% set answered = post.replyTo %}
            {% if answered.hidden %}
                {# A hidden post is not named to whoever may not see it. #}
                <span class="site-comment__reply-to">
                    {% include '@theme/components/icon.twig' with {name: 'reply', size: 12} only %}
                    <span class="visually-hidden">{{ d__('system', 'In answer to:') }}</span>
                    <span class="site-comment__reply-excerpt">{{ __('A deleted post') }}</span>
                </span>
            {% else %}
                <a class="site-comment__reply-to" href="{{ answered.url }}">
                    {% include '@theme/components/icon.twig' with {name: 'reply', size: 12} only %}
                    <span class="visually-hidden">{{ d__('system', 'In answer to:') }}</span>
                    <span class="site-comment__reply-name">{{ answered.authorName }}</span>
                    {% if answered.excerpt %}<span class="site-comment__reply-excerpt">{{ answered.excerpt }}</span>{% endif %}
                </a>
            {% endif %}
        {% endif %}
        <div class="site-comment__body ck-content">{{ post.body }}</div>

        {% if post.files %}
            <ul class="site-forum-files image-gallery" aria-label="{{ __('Attached files') }}">
                {% for file in post.files %}
                    <li class="site-forum-file">
                        {% if file.previewUrl %}
                            <a class="site-forum-file__thumb gallery-item" href="{{ file.fileUrl }}" data-source="{{ file.fileUrl }}" title="{{ file.filename }}">
                                <img src="{{ file.previewUrl }}" alt="" loading="lazy">
                            </a>
                        {% else %}
                            <span class="site-forum-file__thumb">
                                {% include '@theme/components/icon.twig' with {name: 'file', size: 18} only %}
                            </span>
                        {% endif %}
                        <span class="site-forum-file__info">
                            <a class="site-forum-file__name" href="{{ file.fileUrl }}" title="{{ file.filename }}">{{ file.filename }}</a>
                            <span class="site-forum-file__meta">
                                {{ file.fileSize }} ·
                                {% include '@theme/components/icon.twig' with {name: 'download', size: 11} only %}
                                <span class="visually-hidden">{{ __('Downloads') }}:</span> {{ file.downloadCount }}
                            </span>
                        </span>
                        {% if file.deleteUrl %}
                            <form method="post" action="{{ file.deleteUrl }}"
                                  data-confirm="{{ __('Delete the file?') }}" data-confirm-text="{{ file.filename }}"
                                  data-confirm-button="{{ __('Delete') }}">
                                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                                <button type="submit" class="btn btn-outline-secondary btn-xs btn-icon site-comment__delete"
                                        title="{{ __('Delete') }}" aria-label="{{ __('Delete') }}">
                                    {% include '@theme/components/icon.twig' with {name: 'trash-2', size: 12} only %}
                                </button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% set actions = post.actions %}
        {% if actions.replyUrl or actions.editUrl or post.origin %}
            <footer class="site-comment__footer">
                <div class="site-comment__actions">
                    {% if actions.replyUrl %}
                        <a class="btn btn-outline-secondary btn-xs" href="{{ actions.replyUrl }}">
                            {% include '@theme/components/icon.twig' with {name: 'message-square', size: 12} only %} {{ __('Reply') }}
                        </a>
                        <a class="btn btn-outline-secondary btn-xs" href="{{ actions.quoteUrl }}">
                            {% include '@theme/components/icon.twig' with {name: 'quote', size: 12} only %} {{ __('Quote') }}
                        </a>
                    {% endif %}
                    {% if actions.editUrl %}
                        <a class="btn btn-outline-secondary btn-xs" href="{{ actions.editUrl }}">
                            {% include '@theme/components/icon.twig' with {name: 'pencil', size: 12} only %} {{ __('Edit') }}
                        </a>
                    {% endif %}
                    {% if actions.restoreUrl %}
                        <form method="post" action="{{ actions.restoreUrl }}">
                            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                            <button type="submit" class="btn btn-outline-secondary btn-xs">
                                {% include '@theme/components/icon.twig' with {name: 'rotate-ccw', size: 12} only %} {{ __('Restore') }}
                            </button>
                        </form>
                    {% endif %}
                    {% if actions.deleteUrl %}
                        {# The choice of hiding or deleting for good is the template of the topic page. #}
                        <form method="post" action="{{ actions.deleteUrl }}"
                              data-confirm="{{ __('Do you really want to delete?') }}"
                              {% if last_post %}data-confirm-text="{{ __('This is the last post of the topic: the topic is deleted with it.') }}"{% endif %}
                              {% if can('forum.post.destroy') %}data-confirm-fields="forum-post-delete-fields"{% endif %}
                              data-confirm-button="{{ __('Delete') }}">
                            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                            <button type="submit" class="btn btn-outline-secondary btn-xs btn-icon site-comment__delete"
                                    title="{{ __('Delete') }}" aria-label="{{ __('Delete') }}">
                                {% include '@theme/components/icon.twig' with {name: 'trash-2', size: 12} only %}
                            </button>
                        </form>
                    {% endif %}
                    {% if post.origin %}
                        {% include '@theme/components/moderator-meta.twig' with {
                            ip: post.origin.ip,
                            ip_via_proxy: post.origin.ipViaProxy,
                            user_agent: post.origin.userAgent,
                        } only %}
                    {% endif %}
                </div>
            </footer>
        {% endif %}
    </div>
</article>
