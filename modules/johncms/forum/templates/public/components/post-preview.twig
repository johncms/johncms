{#
    The post being written, shown the way the topic will show it.

    @var title   string             A heading above the post: the title of a new topic; empty for none.
    @var author  \Johncms\Users\User
    @var date    string
    @var message \Twig\Markup
#}
<section class="site-forum-preview" aria-label="{{ __('Preview') }}">
    <h2 class="site-forum-write__title">
        {% include '@theme/components/icon.twig' with {name: 'eye', size: 15} only %} {{ __('Preview') }}{% if title|default('') %}: {{ title }}{% endif %}
    </h2>
    <article class="site-comment">
        <div class="site-comment__avatar">
            <img src="{{ avatar(author.id) }}" alt="" width="40" height="40">
        </div>
        <div class="site-comment__main">
            <header class="site-comment__header">
                <span class="site-comment__name">{{ author.name }}</span>
                <span class="site-comment__date"><time>{{ date }}</time></span>
            </header>
            <div class="site-comment__body ck-content">{{ message }}</div>
        </div>
    </article>
</section>
