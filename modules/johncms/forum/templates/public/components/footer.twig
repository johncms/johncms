{#
    The line below every listing of the forum: who is here and the rules.

    @var who_url  string
    @var who_name string
    @var online   array online_u, online_g
#}
<div class="site-forum-foot">
    {% if online %}
        <div class="site-forum-foot__item">
            {% include '@theme/components/icon.twig' with {name: 'users', size: 14} only %}
            {% if app.user.isValid %}
                <a href="{{ who_url }}">{{ who_name }}</a>
            {% else %}
                <span>{{ who_name }}</span>
            {% endif %}
            <span class="site-forum-foot__count" title="{{ __('Users / guests') }}">{{ online.online_u }}&#160;/&#160;{{ online.online_g }}</span>
        </div>
    {% endif %}
    <div class="site-forum-foot__item">
        {% include '@theme/components/icon.twig' with {name: 'book-open', size: 14} only %}
        <a href="/help/?act=forum">{{ __('Forum rules') }}</a>
    </div>
</div>
