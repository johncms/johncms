{#
    Choosing the curators of a topic among the users who may be one: a curator moderates this
    topic only. Saved, the topic opens again with a note.

    @var action_url    string
    @var back_url      string
    @var topic_name    string
    @var curators_list array  user_id, user_name, checked
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    {% include '@forum/public/components/topic-subtitle.twig' with {url: back_url, name: topic_name} only %}
{% endblock %}

{% block content %}
    {% if curators_list is empty %}
        {% include '@theme/components/empty-state.twig' with {
            icon: 'shield',
            title: __('The list is empty'),
            description: __('Curators are chosen among those who write in the topic.'),
        } only %}
        <div class="site-forum-form__actions">
            <a href="{{ back_url }}" class="btn btn-outline-secondary">{{ __('Back to topic') }}</a>
        </div>
    {% else %}
        <form class="site-forum-form" action="{{ action_url }}" method="post">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <fieldset>
                <legend class="site-forum-form__title">{{ __('A curator moderates this topic only.') }}</legend>
                <ul class="site-forum-authors">
                    {% for item in curators_list %}
                        <li class="site-forum-authors__item">
                            <input class="form-check-input" type="checkbox" name="users[{{ item.user_id }}]" value="{{ item.user_name }}"
                                   id="curator_{{ item.user_id }}"{% if item.checked %} checked{% endif %}>
                            <label class="site-forum-authors__name" for="curator_{{ item.user_id }}">{{ item.user_name }}</label>
                        </li>
                    {% endfor %}
                </ul>
            </fieldset>
            <div class="site-forum-form__actions">
                <a href="{{ back_url }}" class="btn btn-outline-secondary">{{ __('Cancel') }}</a>
                <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Save') }}</button>
            </div>
        </form>
    {% endif %}
{% endblock %}
