{#
    Renaming a topic and editing its meta tags. The topic page asks the same in a dialog; this page
    is what the link of the menu opens without the script, and what shows the errors of the fields.

    @var action_url string
    @var back_url   string
    @var form_data  array  name, meta_keywords, meta_description
    @var errors     array  Validation messages by field name.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="rename_topic" action="{{ action_url }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}"/>
        {% if errors._form|default([]) %}
            <div class="alert alert-danger">{{ errors._form|join(', ') }}</div>
        {% endif %}
        {% include '@forum/public/components/change-topic-fields.twig' with {form_data: form_data, errors: errors, id_prefix: 'change-topic-page'} only %}
        <div>
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Save') }}</button>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Back to topic') }}</a>
        </div>
    </form>
{% endblock %}
