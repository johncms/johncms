{#
    A topic: the poll, the posts of the page, the form of the answer and the actions over them.

    @var id                int
    @var page              int
    @var topic             \Johncms\Modules\Forum\Domain\Models\ForumTopic
    @var state             array        closed, pinned, deleted, deleted_by — what the heading says of the topic.
    @var views             int
    @var messages          \Johncms\Modules\Forum\Application\DTO\ForumPostDTO[]
    @var topic_vote        \Johncms\Modules\Forum\Domain\Models\ForumVote    Null when the topic has no poll.
    @var poll_data         array        results (id, name, count, vote_percent, leader), show_form; empty without a poll.
    @var curators          array        id, name of each curator of the topic
    @var write_access      bool
    @var reply_above       bool         The reply form goes above the posts: the newest posts come first.
    @var reply_url         string
    @var filter_by_author  bool
    @var filter_url        string       Sets the filter, or clears it when one is on.
    @var can_moderate      bool         The visitor may delete posts in bulk and act on the topic.
    @var move_targets      array        id, title — where the topic can be moved; empty unless the visitor may move it.
    @var change_form       array        name, meta_keywords, meta_description — what the dialog of changing the topic starts from.
    @var message           string       The result of the last action on the topic, empty when there is none.
    @var one_post_in_sight bool         Deleting the post in sight takes the topic with it.
    @var can_set_curators  bool
    @var token             string       One-time token of the reply form.
    @var file_limits       ?\Johncms\Modules\Forum\Application\DTO\ForumFileLimitsDTO What the files of the reply form may be; null when the visitor does not write here.
    @var total             int          Posts in sight, the filter by author applied.
    @var pagination        \Twig\Markup Null when everything fits on one page.
    @var online            array        online_u, online_g
    @var files_count       string
    @var unread_count      string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_actions %}
    {% if write_access %}
        <a href="#topic-reply" class="btn btn-primary">
            {% include '@theme/components/icon.twig' with {name: 'message-square', size: 14} only %} {{ __('Reply') }}
        </a>
    {% endif %}
    {% if can_moderate %}
        {# Each item that changes the topic sends a form of its own, kept below the posts. #}
        <details class="site-popover site-forum-topic-actions" data-site-popover>
            <summary class="btn btn-outline-secondary">
                {% include '@theme/components/icon.twig' with {name: 'settings', size: 14} only %} {{ __('Actions with topic') }}
            </summary>
            <div class="site-popover__panel">
                {# Each opens the dialog of its form; without the script, the page of that form. #}
                <a class="site-popover__item" href="/forum/change-topic/{{ id }}/" data-confirm-form="topic-change">
                    {% include '@theme/components/icon.twig' with {name: 'pencil', size: 14} only %}<span>{{ __('Change the topic') }}</span>
                </a>
                <a class="site-popover__item" href="/forum/move-topic/{{ id }}/"{% if move_targets %} data-confirm-form="topic-move"{% endif %}>
                    {% include '@theme/components/icon.twig' with {name: 'folder', size: 14} only %}<span>{{ __('Move Topic') }}</span>
                </a>
                <button type="submit" form="topic-pin" class="site-popover__item">
                    {% include '@theme/components/icon.twig' with {name: 'pin', size: 14} only %}<span>{{ state.pinned ? __('Unfix Topic') : __('Pin Topic') }}</span>
                </button>
                <button type="submit" form="topic-close" class="site-popover__item">
                    {% include '@theme/components/icon.twig' with {name: 'lock-keyhole', size: 14} only %}<span>{{ state.closed ? __('Open Topic') : __('Close Topic') }}</span>
                </button>
                {% if can_set_curators %}
                    <a class="site-popover__item" href="/forum/curators/{{ id }}/{{ page > 1 ? '?page=' ~ page : '' }}">
                        {% include '@theme/components/icon.twig' with {name: 'users', size: 14} only %}<span>{{ __('Curators of the Topic') }}</span>
                    </a>
                {% endif %}
                <hr class="site-popover__divider">
                {% if topic_vote %}
                    <a class="site-popover__item" href="/forum/editvote/{{ id }}/">
                        {% include '@theme/components/icon.twig' with {name: 'chart-column', size: 14} only %}<span>{{ __('Edit Poll') }}</span>
                    </a>
                    <button type="submit" form="topic-delete-poll" class="site-popover__item site-popover__item--danger">
                        {% include '@theme/components/icon.twig' with {name: 'trash-2', size: 14} only %}<span>{{ __('Delete Poll') }}</span>
                    </button>
                {% else %}
                    <a class="site-popover__item" href="/forum/addvote/{{ id }}/">
                        {% include '@theme/components/icon.twig' with {name: 'chart-column', size: 14} only %}<span>{{ __('Add Poll') }}</span>
                    </a>
                {% endif %}
                <hr class="site-popover__divider">
                {% if state.deleted %}
                    <button type="submit" form="topic-restore" class="site-popover__item">
                        {% include '@theme/components/icon.twig' with {name: 'rotate-ccw', size: 14} only %}<span>{{ __('Restore Topic') }}</span>
                    </button>
                {% endif %}
                <button type="submit" form="topic-delete" class="site-popover__item site-popover__item--danger">
                    {% include '@theme/components/icon.twig' with {name: 'trash-2', size: 14} only %}<span>{{ __('Delete Topic') }}</span>
                </button>
            </div>
        </details>
    {% endif %}
{% endblock %}

{% block page_subtitle %}
    <p class="site-page-heading__subtitle site-forum-topic-head">
        {% if state.pinned %}<span class="site-forum-badge site-forum-badge--accent">{{ __('Pinned') }}</span>{% endif %}
        {% if state.closed %}<span class="site-forum-badge">{{ __('Closed') }}</span>{% endif %}
        {% if state.deleted %}
            <span class="site-forum-badge site-forum-badge--danger">{{ __('Deleted') }}</span>
            {% if state.deleted_by %}<span class="site-forum-topic-head__note">{{ __('deleted by %s')|format(state.deleted_by) }}</span>{% endif %}
        {% endif %}
        <span class="site-page-stat">
            <span class="site-page-stat__dot" aria-hidden="true"></span>
            {{ n__('%s post', '%s posts', total)|format(total|format_number) }} ·
            {{ n__('%s view', '%s views', views)|format(views|format_number) }}
        </span>
    </p>
{% endblock %}

{% block content %}
    {# A discussion for comments.js: the posts and the reply form under it. #}
    <div class="site-forum" data-comments>
        {% include '@forum/public/components/header.twig' with {
            unread_count: unread_count,
            files_count: files_count,
            files_url: '/forum/files/?t=' ~ id,
            files_name: __('Topic Files'),
        } only %}

        {% if message %}
            {% include '@theme/components/toast.twig' with {message: message} only %}
        {% endif %}

        {% if filter_by_author %}
            <div class="alert alert-warning site-forum-filter">
                <span>{{ __('Filter by author is activated') }}</span>
                <form action="{{ filter_url }}" method="post">
                    <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">{{ __('Cancel Filter') }}</button>
                </form>
            </div>
        {% endif %}

        {% if poll_data %}
            {% include '@forum/public/components/poll.twig' with {
                id: id,
                topic_url: topic.url,
                vote: topic_vote,
                poll: poll_data,
            } only %}
        {% endif %}

        {% if reply_above %}
            {{ block('reply') }}
        {% endif %}

        {% if pagination %}<div class="site-forum__pagination site-forum__pagination--top">{{ pagination }}</div>{% endif %}

        {% if messages %}
            <div class="site-forum-posts">
                {% for post in messages %}
                    {% include '@forum/public/components/message.twig' with {
                        post: post,
                        can_moderate: can_moderate,
                        last_post: one_post_in_sight and not post.isDeleted,
                    } only %}
                {% endfor %}
            </div>
        {% else %}
            {% include '@theme/components/empty-state.twig' with {
                icon: 'messages-square',
                title: __('No posts here'),
                description: filter_by_author ? __('The filter by author leaves none of them.') : '',
            } only %}
        {% endif %}

        {% if can_moderate and messages %}
            <div class="site-forum-bulk">
                {# The boxes of the posts belong to this form by its id: the posts hold forms of their own. #}
                <form action="/forum/bulk-delete-posts/{{ id }}/" method="post" id="topic-bulk-delete"
                      data-confirm="{{ __('Delete the chosen posts?') }}" data-confirm-button="{{ __('Delete') }}">
                    <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        {% include '@theme/components/icon.twig' with {name: 'trash-2', size: 14} only %} {{ __('Delete selected') }}
                    </button>
                </form>
            </div>
        {% endif %}

        {% if pagination %}<div class="site-forum__pagination">{{ pagination }}</div>{% endif %}

        {% if not reply_above %}
            {{ block('reply') }}
        {% endif %}

        <div class="site-forum-topic-foot">
            {% if curators %}
                <div class="site-forum-topic-foot__item">
                    {% include '@theme/components/icon.twig' with {name: 'shield', size: 14} only %}
                    <span>{{ __('Curators') }}:</span>
                    {% for curator in curators %}
                        {% if profile_url(curator.id) %}<a href="{{ profile_url(curator.id) }}">{{ curator.name }}</a>{% else %}{{ curator.name }}{% endif %}{% if not loop.last %},{% endif %}
                    {% endfor %}
                </div>
            {% endif %}
            <div class="site-forum-topic-foot__item">
                {% include '@theme/components/icon.twig' with {name: 'user', size: 14} only %}
                {% if filter_by_author %}
                    <form action="{{ filter_url }}" method="post">
                        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                        <button type="submit" class="btn btn-link p-0">{{ __('Cancel Filter') }}</button>
                    </form>
                {% else %}
                    <a href="{{ filter_url }}" rel="nofollow">{{ __('Filter by author') }}</a>
                {% endif %}
            </div>
        </div>

        {% include '@forum/public/components/footer.twig' with {
            online: online,
            who_url: '/forum/topic-visitors/' ~ id ~ '/',
            who_name: __('Who is here'),
        } only %}
    </div>

    {% if can('forum.post.destroy') %}
        <template id="forum-post-delete-fields">
            <div class="form-check">
                <input type="radio" class="form-check-input" name="action" value="hide" id="forum-post-delete-hide" checked>
                <label class="form-check-label" for="forum-post-delete-hide">{{ __('Hide') }}</label>
            </div>
            <div class="form-check">
                <input type="radio" class="form-check-input" name="action" value="delete" id="forum-post-delete-destroy">
                <label class="form-check-label" for="forum-post-delete-destroy">
                    {{ __('Delete for good') }}
                    <span class="form-text d-block mt-0 text-danger">{{ __('Its files go too. This cannot be undone.') }}</span>
                </label>
            </div>
        </template>
    {% endif %}

    {% if can_moderate %}
        {# The actions of the menu change the topic, so each sends a form of its own. #}
        <form method="post" action="/forum/close/{{ id }}/" id="topic-close">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <input type="hidden" name="closed" value="{{ state.closed ? 0 : 1 }}">
        </form>
        <form method="post" action="/forum/pin-topic/{{ id }}/" id="topic-pin">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <input type="hidden" name="pin" value="{{ state.pinned ? 0 : 1 }}">
        </form>
        {% if state.deleted %}
            <form method="post" action="/forum/restore-topic/{{ id }}/" id="topic-restore">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            </form>
        {% endif %}
        <form method="post" action="/forum/change-topic/{{ id }}/" id="topic-change"
              data-confirm="{{ __('Change the topic') }}" data-confirm-fields="forum-topic-change-fields"
              data-confirm-button="{{ __('Save') }}" data-confirm-tone="primary">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        </form>
        <template id="forum-topic-change-fields">
            {% include '@forum/public/components/change-topic-fields.twig' with {
                form_data: change_form,
                errors: [],
                id_prefix: 'topic-change',
            } only %}
        </template>
        {% if move_targets %}
            <form method="post" action="/forum/move-topic/{{ id }}/" id="topic-move"
                  data-confirm="{{ __('Move topic') }}" data-confirm-text="{{ topic.name }}" data-confirm-fields="forum-topic-move-fields"
                  data-confirm-button="{{ __('Move') }}" data-confirm-tone="primary">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                <input type="hidden" name="submit" value="1">
            </form>
            <template id="forum-topic-move-fields">
                {% include '@forum/public/components/move-topic-fields.twig' with {targets: move_targets, id_prefix: 'topic-move'} only %}
            </template>
        {% endif %}
        <form method="post" action="/forum/delete-topic/{{ id }}/" id="topic-delete"
              data-confirm="{{ __('Delete the topic?') }}" data-confirm-text="{{ topic.name }}"
              {% if can('forum.topic.destroy') %}data-confirm-fields="forum-topic-delete-fields"{% endif %}
              data-confirm-button="{{ __('Delete') }}">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        </form>
        {% if can('forum.topic.destroy') %}
            <template id="forum-topic-delete-fields">
                <div class="form-check">
                    <input type="radio" class="form-check-input" name="del" value="1" id="forum-topic-delete-hide" checked>
                    <label class="form-check-label" for="forum-topic-delete-hide">{{ __('Hide') }}</label>
                </div>
                <div class="form-check">
                    <input type="radio" class="form-check-input" name="del" value="2" id="forum-topic-delete-destroy">
                    <label class="form-check-label" for="forum-topic-delete-destroy">
                        {{ __('Delete for good') }}
                        <span class="form-text d-block mt-0 text-danger">{{ __('Its posts, poll and files go too. This cannot be undone.') }}</span>
                    </label>
                </div>
            </template>
        {% endif %}
        {% if topic_vote %}
            <form method="post" action="/forum/delvote/{{ id }}/" id="topic-delete-poll"
                  data-confirm="{{ __('Do you really want to delete a poll?') }}" data-confirm-text="{{ topic_vote.name }}"
                  data-confirm-button="{{ __('Delete') }}">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            </form>
        {% endif %}
    {% endif %}
{% endblock %}

{# The answer to the topic: the form for one who writes here, a word on why not for the others. #}
{% block reply %}
    {% if write_access %}
        <section class="site-compose site-forum-reply" id="topic-reply">
            <form class="site-compose__form" name="new_message" action="{{ reply_url }}" method="post" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                <input type="hidden" name="token" value="{{ token }}">
                {# The post the text answers, set by the Reply and Quote buttons; the label says which. #}
                <input type="hidden" name="reply_to" value="" data-comment-reply-field>
                <div class="site-compose__reply" data-comment-reply-label hidden>
                    {% include '@theme/components/icon.twig' with {name: 'reply', size: 14} only %}
                    <span class="site-compose__reply-text">
                        {{ d__('system', 'In answer to:') }}
                        <b class="site-compose__reply-name" data-comment-reply-name></b>
                        <span class="site-compose__reply-excerpt" data-comment-reply-excerpt></span>
                    </span>
                    <button type="button" class="btn-close site-compose__reply-cancel" data-comment-reply-cancel
                            title="{{ __('Do not answer this post') }}" aria-label="{{ __('Do not answer this post') }}"></button>
                </div>
                {% include '@theme/components/editor.twig' with {
                    name: 'msg',
                    id: 'topic-reply-message',
                    label: __('Message'),
                    label_hidden: true,
                    placeholder: __('Message'),
                    upload_url: '/forum/upload_file/',
                    allow_upload: true,
                } only %}
                <div class="site-compose__actions site-forum-reply__actions">
                    {% include '@forum/public/components/file-field.twig' with {
                        id: 'topic-reply-files',
                        limits: file_limits,
                        compact: true,
                    } only %}
                    <button type="submit" name="submit" value="1" class="btn btn-primary">
                        {% include '@theme/components/icon.twig' with {name: 'send', size: 14} only %} {{ __('Write') }}
                    </button>
                </div>
            </form>
        </section>
    {% elseif state.closed %}
        <div class="site-discussion__notice site-forum-reply" id="topic-reply">
            {% include '@theme/components/icon.twig' with {name: 'lock-keyhole', size: 14} only %} {{ __('The topic is closed: no new posts.') }}
        </div>
    {% elseif not app.user.isValid %}
        <div class="site-discussion__notice site-forum-reply" id="topic-reply">
            {{ __('Sign in to answer in the topic.') }}
            <a href="/login/">{{ d__('system', 'Log In') }}</a>
        </div>
    {% endif %}
{% endblock %}
