{#
    Files of one kind attached in the forum, each with the post it came with.

    @var files         array        Rows of the listing: filename, file_url, file_preview, file_size (KB), dlcount,
                                    user_name, user_profile_link, post_time, post_url, topic_url, excerpt.
    @var total         int
    @var pagination    \Twig\Markup Null when everything fits on one page.
    @var new_url       string
    @var new_count     int
    @var back_url      string       The kinds of the files.
    @var back_url_name string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="robots" content="noindex,follow">
{% endblock %}

{% block page_subtitle %}
    <p class="site-page-heading__subtitle">
        <span class="site-page-stat">
            <span class="site-page-stat__dot" aria-hidden="true"></span>
            {{ __('Total') }}: {{ total|format_number }}
        </span>
    </p>
{% endblock %}

{% block content %}
    <div class="site-forum">
        <nav class="site-forum-toolbar__chips site-forum-files-nav" aria-label="{{ __('Forum Files') }}">
            {% if back_url %}
                <a class="site-chip" href="{{ back_url }}">
                    {% include '@theme/components/icon.twig' with {name: 'chevron-left', size: 12, class: 'site-icon--directional'} only %} {{ back_url_name }}
                </a>
            {% endif %}
            {% if new_count|default(0) %}
                <a class="site-chip" href="{{ new_url }}">
                    {% include '@theme/components/icon.twig' with {name: 'sparkles', size: 12} only %} {{ __('New Files') }}
                    <span class="site-chip__count">{{ new_count|format_number }}</span>
                </a>
            {% endif %}
        </nav>

        {% if files %}
            <div class="site-forum-results">
                {% for file in files %}
                    <article class="site-forum-result site-forum-attachment">
                        {% if file.file_preview %}
                            <a class="site-forum-file__thumb" href="{{ file.file_url }}" title="{{ file.filename }}">
                                <img src="{{ file.file_preview }}" alt="" loading="lazy">
                            </a>
                        {% else %}
                            <span class="site-forum-file__thumb">
                                {% include '@theme/components/icon.twig' with {name: 'file', size: 18} only %}
                            </span>
                        {% endif %}
                        <div class="site-forum-attachment__main">
                            <a class="site-forum-result__title" href="{{ file.file_url }}">{{ file.filename }}</a>
                            <div class="site-forum-result__meta">
                                <span>{{ file.file_size }} {{ __('KB') }}</span>
                                <span aria-hidden="true">·</span>
                                <span>{% include '@theme/components/icon.twig' with {name: 'download', size: 11} only %}<span class="visually-hidden">{{ __('Downloads') }}:</span> {{ file.dlcount }}</span>
                            </div>
                            <div class="site-forum-result__meta">
                                {% if file.user_profile_link %}<a href="{{ file.user_profile_link }}">{{ file.user_name }}</a>{% else %}<span>{{ file.user_name }}</span>{% endif %}
                                <span aria-hidden="true">·</span>
                                <a href="{{ file.post_url }}">{{ file.post_time }}</a>
                                <span aria-hidden="true">·</span>
                                <a href="{{ file.topic_url }}">{{ __('To topic') }}</a>
                            </div>
                            {% if file.excerpt %}<p class="site-forum-result__text">{{ file.excerpt }}</p>{% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
            {% if pagination %}<div class="site-forum__pagination">{{ pagination }}</div>{% endif %}
        {% else %}
            {% include '@theme/components/empty-state.twig' with {icon: 'file', title: __('The list is empty'), description: ''} only %}
        {% endif %}
    </div>
{% endblock %}
