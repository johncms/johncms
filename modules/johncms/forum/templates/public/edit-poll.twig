{#
    Changing the poll of a topic: the saved answers are renamed or deleted one by one, the rest of
    the fields are new answers. A form sent back keeps its fields and says what was wrong.

    @var action_url string
    @var back_url   string The topic.
    @var topic_name string
    @var poll_name  string
    @var count_vote int    Answer fields on the form, never fewer than the saved ones.
    @var saved_vote int    Answers already saved.
    @var votes      array  input_name, input_label, input_value, delete_url
    @var errors     array  Messages by field: name_vote, answers.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    {% include '@forum/public/components/topic-subtitle.twig' with {url: back_url, name: topic_name} only %}
{% endblock %}

{% block content %}
    {% include '@forum/public/components/poll-form.twig' with {
        action_url: action_url,
        back_url: back_url,
        poll_name: poll_name,
        count_vote: count_vote,
        votes: votes,
        can_add: count_vote < 20,
        can_remove: count_vote > saved_vote,
        errors: errors,
        submit_name: __('Save'),
    } only %}
{% endblock %}
