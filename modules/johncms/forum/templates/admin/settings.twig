{#
    The settings of the forum: what its pages show, and the meta tags of its pages for the search
    engines — of the forum itself, and the templates for its sections and topics.

    @var \Johncms\Modules\Forum\Application\DTO\ForumSettingsDTO settings
    @var string form_action
    @var string list_url        The tree of the forum.
    @var string error_message   Empty unless the configuration could not be written.
    @var string success_message Empty unless a save has just succeeded.
#}
{% extends '@admin/layouts/default.twig' %}

{% macro textarea(name, label, value) %}
    <label class="form-label" for="forum-{{ name }}">{{ label }}</label>
    <textarea class="form-control" id="forum-{{ name }}" name="{{ name }}" rows="2">{{ value }}</textarea>
{% endmacro %}

{% block content %}
    {% import _self as form %}

    <div class="row">
        <div class="col-xxl-9">
            {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: error_message} only %}
            {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}

            <form method="post" action="{{ form_action }}" class="d-flex flex-column gap-3">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">

                <div class="card">
                    <div class="card-header">
                        {% include '@admin/components/ui/icon.twig' with {name: 'settings', size: 15, class: 'text-body-tertiary'} only %}
                        {{ __('Common settings') }}
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" name="file_counters" value="1" id="forum-file_counters"{% if settings.fileCounters %} checked{% endif %}>
                            <label class="form-check-label" for="forum-file_counters">
                                {{ __('Show file counters') }}
                                <span class="form-text d-block mt-0">{{ __('The number of attached files on the main page of the forum, in its sections and topics.') }}</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        {% include '@admin/components/ui/icon.twig' with {name: 'messages-square', size: 15, class: 'text-body-tertiary'} only %}
                        {{ __('Meta tags for the main page') }}
                    </div>
                    <div class="card-body d-flex flex-column gap-3">
                        <div>{{ form.textarea('forum_keywords', __('Forum keywords'), settings.forumKeywords) }}</div>
                        <div>{{ form.textarea('forum_description', __('Forum description'), settings.forumDescription) }}</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        {% include '@admin/components/ui/icon.twig' with {name: 'folder', size: 15, class: 'text-body-tertiary'} only %}
                        <span class="flex-grow-1">{{ __('Meta tag templates for sections') }}</span>
                        <span class="small fw-normal text-body-secondary">{{ __('Macros available: #name#, #description#') }}</span>
                    </div>
                    <div class="card-body d-flex flex-column gap-3">
                        <div class="form-text mt-0">{{ __('Used where the section has no keywords or description of its own.') }}</div>
                        <div>{{ form.textarea('section_keywords', __('Section keywords'), settings.sectionKeywords) }}</div>
                        <div>{{ form.textarea('section_description', __('Section description'), settings.sectionDescription) }}</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        {% include '@admin/components/ui/icon.twig' with {name: 'message-square', size: 15, class: 'text-body-tertiary'} only %}
                        <span class="flex-grow-1">{{ __('Meta tag templates for topics') }}</span>
                        <span class="small fw-normal text-body-secondary">{{ __('Macros available: #name#') }}</span>
                    </div>
                    <div class="card-body d-flex flex-column gap-3">
                        <div class="form-text mt-0">{{ __('Used where the topic has no keywords or description of its own.') }}</div>
                        <div>{{ form.textarea('topic_keywords', __('Topic keywords'), settings.topicKeywords) }}</div>
                        <div>{{ form.textarea('topic_description', __('Topic description'), settings.topicDescription) }}</div>
                    </div>
                </div>

                {% include '@admin/components/ui/form-footer.twig' with {cancel_url: list_url} only %}
            </form>
        </div>
    </div>
{% endblock %}
