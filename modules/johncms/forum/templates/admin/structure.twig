{#
    One level of the forum tree: the categories, or the sections of one category.

    @var array  items        Rows: sort, name, description, counter, list_url, public_url,
                             edit_url, delete_url.
    @var string add_form_url
    @var string back_url
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% if items is empty %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: __('The list is empty')} only %}
    {% endif %}

    {% for item in items %}
        <div class="new_post-item without_avatar">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span class="text-muted me-1">[{{ item.sort }}]</span>
                    <a href="{{ item.list_url }}">{{ item.name }}</a>
                    {% if item.counter %}
                        <span class="badge rounded-pill text-bg-light border ms-2">{{ item.counter }}</span>
                    {% endif %}
                </div>
                <div>
                    <a href="{{ item.public_url }}" class="btn btn-secondary btn-sm">{{ __('View') }}</a>
                </div>
            </div>
            {% if item.description %}
                <div class="small text-muted">{{ item.description }}</div>
            {% endif %}
            <div class="mt-2">
                <a href="{{ item.edit_url }}">{{ __('Edit') }}</a>
                <a href="{{ item.delete_url }}" class="text-danger ms-2">{{ __('Delete') }}</a>
            </div>
        </div>
    {% endfor %}

    <div class="mt-3">
        <a href="{{ add_form_url }}" class="btn btn-primary">{{ __('Add') }}</a>
    </div>
    <div class="mt-2">
        <a href="{{ back_url }}">{{ __('Back') }}</a>
    </div>
{% endblock %}
