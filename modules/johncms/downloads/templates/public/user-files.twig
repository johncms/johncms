{#
    The files one user has uploaded, under a card of the user.

    @var show_user  array        Author of the files, see the component of a user row.
    @var files      array        Presented files, see FilePresenter::present().
    @var total      int
    @var pagination \Twig\Markup Null when everything fits on one page.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    <div class="site-downloads">
        <div class="site-downloads__toolbar">
            {% include '@downloads/public/components/collections-nav.twig' only %}
        </div>
        {% include '@downloads/public/components/user-row.twig' with {item: show_user|merge({files_count: total})} only %}
        {% include '@downloads/public/components/file-list.twig' with {
            heading: __('Files'), count: total, files: files, pagination: pagination,
            empty_icon: 'upload', empty_title: __('No files yet'), empty_text: __('Files this user uploads appear here.'),
        } only %}
    </div>
{% endblock %}
