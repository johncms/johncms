{#
    The top of the files: the popular ones, the most downloaded, the most commented.

    @var files   array Presented files, see FilePresenter::present().
    @var buttons array Switches of the top: url, name, active.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    <div class="site-downloads">
        <div class="site-downloads__toolbar">
            {% include '@downloads/public/components/collections-nav.twig' with {current: 'top'} only %}
        </div>
        <section aria-labelledby="downloads-list-title">
            <div class="site-downloads__heading-row">
                <h2 class="site-downloads__heading" id="downloads-list-title">{{ __('Files') }} <span class="site-downloads__count">{{ files|length }}</span></h2>
                <div class="site-segmented site-downloads__sort" role="group" aria-label="{{ __('Top Files') }}">
                    {% for button in buttons %}
                        <a class="site-segmented__item" href="{{ button.url }}"{% if button.active %} aria-current="page"{% endif %}>{{ button.name }}</a>
                    {% endfor %}
                </div>
            </div>
            <div class="site-downloads__list">
                {% for file in files %}
                    {% include '@downloads/public/components/file-row.twig' with {file: file} only %}
                {% else %}
                    {% include '@theme/components/empty-state.twig' with {icon: 'trophy', title: __('List is empty'), description: __('The top fills up as files are downloaded.')} only %}
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock %}
