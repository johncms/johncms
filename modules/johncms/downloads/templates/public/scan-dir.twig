{#
    Scanning the directories of the downloads: first the choice of the scope, then what was added.

    @var id             int   Category to scan, 0 for the whole downloads.
    @var select_mode    bool  True while the scope has not been chosen yet.
    @var updated_info   array categories, files, additional_files
    @var urls           array downloads
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    {% if select_mode %}
        <section class="site-dlf__section">
            <h2 class="site-dlf__h2 site-dl-form__title">{{ __('What to scan') }}</h2>
            <p class="text-body-secondary small">{{ __('New files and folders found on disk are added to the downloads. Every option goes into the subfolders too.') }}</p>
            {% if id %}
                {% include '@downloads/public/components/scan-form.twig' with {id: id, mod: 0, label: __('This folder')} only %}
                {% include '@downloads/public/components/scan-form.twig' with {id: id, mod: 1, label: __('This folder, with the screenshots and descriptions lying next to the files')} only %}
            {% endif %}
            {% include '@downloads/public/components/scan-form.twig' with {id: 0, mod: 0, label: __('Entire Downloads')} only %}
        </section>
    {% else %}
        <section class="site-dlf__section mb-3">
            <h2 class="site-dlf__h2 site-dl-form__title">{{ __('Added') }}</h2>
            <dl class="site-dlf__props">
                <div class="site-dlf__prop"><dt>{{ __('Categories') }}</dt><dd>{{ updated_info.categories }}</dd></div>
                <div class="site-dlf__prop"><dt>{{ __('Files') }}</dt><dd>{{ updated_info.files }}</dd></div>
                <div class="site-dlf__prop"><dt>{{ __('Additional Files') }}</dt><dd>{{ updated_info.additional_files }}</dd></div>
            </dl>
        </section>
        <div class="d-flex flex-wrap gap-2 align-items-start">
            {% include '@downloads/public/components/clean-form.twig' with {id: id, class: 'btn btn-outline-danger btn-sm'} only %}
            {% include '@downloads/public/components/recount-form.twig' with {id: id, class: 'btn btn-outline-secondary btn-sm'} only %}
            {% include '@downloads/public/components/scan-form.twig' with {id: 0, mod: 0, label: __('Entire Downloads')} only %}
        </div>
        <div class="mt-2">
            <a href="{{ urls.downloads }}">{{ __('Downloads') }}</a>
        </div>
    {% endif %}
{% endblock %}
