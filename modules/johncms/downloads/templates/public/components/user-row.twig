{#
    One user in the top of uploaders and in the header of their file list.

    @var item array id, name, user_is_online, user_profile_link, files_url (empty on their own
                    list), files_count, ip, ip_via_proxy, browser
#}
<article class="card site-dl-user">
    <div class="card-body site-dl-user__body">
        <span class="site-dl-user__avatar">
            <img src="{{ avatar(item.id) }}" alt="" width="40" height="40" loading="lazy">
            {% if item.user_is_online %}<span class="site-dl-user__online" title="{{ __('Online') }}"></span>{% endif %}
        </span>
        <div class="site-dl-user__main">
            {% if item.user_profile_link %}
                <a class="site-dl-user__name" href="{{ item.user_profile_link }}">{{ item.name }}</a>
            {% else %}
                <span class="site-dl-user__name">{{ item.name }}</span>
            {% endif %}
            {% if item.files_count is defined %}
                {% set count_label = n__('%d file', '%d files', item.files_count)|format(item.files_count) %}
                {% if item.files_url|default('') %}
                    <a class="site-dl-user__files" href="{{ item.files_url }}">{{ count_label }}</a>
                {% else %}
                    <span class="site-dl-user__files">{{ count_label }}</span>
                {% endif %}
            {% endif %}
        </div>
        {% if can('users.origin.view') %}
            {% include '@theme/components/moderator-meta.twig' with {
                ip: item.ip|default(''), ip_via_proxy: item.ip_via_proxy|default(''), user_agent: item.browser|default('')
            } only %}
        {% endif %}
    </div>
</article>
