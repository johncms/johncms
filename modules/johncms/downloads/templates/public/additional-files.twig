{#
    Files attached to a file besides the main one: the current ones and the form that adds one more.

    @var additional_files array  id, name, rus_name, display_date, display_size, edit_url, delete_url
    @var action_url       string
    @var file_url         string  The page of the file the attachments belong to.
    @var extensions       string  Allowed extensions, joined into one line.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    {% if additional_files %}
        <section class="site-dlf__section mb-3">
        <h2 class="site-dlf__h2 site-dl-form__title">{{ __('Current files') }}</h2>
        <div>
            {% for file in additional_files %}
                <div class="border-bottom pb-3 mb-3 site-dl-form__item">
                    <div class="d-flex w-100 justify-content-between">
                        <h3 class="h6 fw-bold mb-1">{{ file.rus_name }}</h3>
                        <small class="text-muted">{{ file.display_date }}</small>
                    </div>
                    <p class="mb-1">{{ file.name }} ({{ file.display_size }})</p>
                    <div class="d-flex gap-2">
                        <a href="{{ file.edit_url }}" class="btn btn-primary btn-sm">{{ __('Edit') }}</a>
                        {% include '@downloads/public/components/delete-form.twig' with {
                            action: file.delete_url,
                            fields: {more_id: file.id},
                            question: __('Delete the additional file “%s”?')|format(file.rus_name),
                            text: '',
                            label: __('Delete'),
                            class: 'btn btn-danger btn-sm',
                        } only %}
                    </div>
                </div>
            {% endfor %}
        </div>
        </section>
    {% endif %}

    <form class="site-dl-form site-dlf__section" name="file_upload_form" action="{{ action_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <h2 class="site-dlf__h2 site-dl-form__title">{{ __('Add file') }}</h2>
        <div class="mb-3">
            <label class="form-label" for="fail">{{ __('Choose file') }}</label>
            <input type="file" class="form-control" id="fail" name="fail">
            <div class="form-text">
                {{ __('Max. Size') }}: {{ config('johncms.flsz') }} kb.
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="link_file">{{ __('Or link to it') }}</label>
            <input type="text" class="form-control" id="link_file" placeholder="{{ __('Link to file') }}"
                   name="link_file" value="">
        </div>
        <div class="mb-3">
            <label class="form-label" for="new_file">{{ __('Save as') }}</label>
            <input type="text" class="form-control" id="new_file" placeholder="{{ __('Save as') }}"
                   name="new_file" value="" maxlength="100">
            <div class="form-text">{{ __('max. 100 characters') }}</div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="name_link">{{ __('Link to download file') }}</label>
            <input type="text" class="form-control" id="name_link" placeholder="{{ __('Link to download file') }}"
                   name="name_link" value="{{ __('Download the additional file') }}" maxlength="200" required>
        </div>

        <div class="form-text">{{ __('Allowed extensions') }}: {{ extensions }}</div>

        <div class="site-dl-form__actions">
            <a href="{{ file_url }}" class="btn btn-outline-secondary">
                {% include '@theme/components/icon.twig' with {name: 'chevron-left', size: 14, class: 'site-icon--directional'} only %} {{ __('Cancel') }}
            </a>
            <button type="submit" name="submit" value="1" class="btn btn-primary">
                {% include '@theme/components/icon.twig' with {name: 'check', size: 14} only %} {{ __('Save') }}
            </button>
        </div>
    </form>
{% endblock %}
