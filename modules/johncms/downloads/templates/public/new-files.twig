{#
    Files added in the last days, everywhere or in one category and below it.

    @var files      array        Presented files, see FilePresenter::present().
    @var total      int
    @var pagination \Twig\Markup Null when everything fits on one page.
    @var category   array|null   name, url of the category the list is narrowed to.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    {% if category %}
        <p class="site-page-heading__subtitle"><span>{{ __('In the section') }} <a href="{{ category.url }}">{{ category.name }}</a></span></p>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="site-downloads">
        <div class="site-downloads__toolbar">
            {% include '@downloads/public/components/collections-nav.twig' with {current: 'new'} only %}
        </div>
        {% include '@downloads/public/components/file-list.twig' with {
            heading: __('Files'), count: total, files: files, pagination: pagination,
            empty_icon: 'sparkles', empty_title: __('No new files'), empty_text: __('Files added in the last three days appear here.'),
        } only %}
    </div>
{% endblock %}
