{#
    Editing the name, the download link, the description and the MP3 tags of a file.

    @var file_data  array  text, name_link, desc
    @var audio_tags array  artist, title, album, genre, year; empty for a file that is not audio.
    @var action_url string
    @var file_url   string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    <form class="site-dl-form site-dlf__section" name="file_edit_form" action="{{ action_url }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <div class="mb-3">
            <label class="form-label" for="text">{{ __('Name for display') }}</label>
            <input type="text" class="form-control" id="text" placeholder="{{ __('Name for display') }}"
                   name="text" value="{{ file_data.text }}" maxlength="200" required>
        </div>
        <div class="mb-3">
            <label class="form-label" for="name_link">{{ __('Link to download file') }}</label>
            <input type="text" class="form-control" id="name_link" placeholder="{{ __('Link to download file') }}"
                   name="name_link" value="{{ file_data.name_link }}" maxlength="200" required>
        </div>
        <div class="mb-3">
            {% include '@theme/components/editor.twig' with {
                label: __('Description'),
                name: 'desc',
                value: file_data.desc
            } only %}
        </div>
        {% if audio_tags %}
            <details class="site-dl-form__group mt-3">
                <summary>{{ __('Edit MP3 Tags') }}</summary>
                <div>
                    <div class="mt-2">
                        <label class="form-label" for="audio_artist">{{ __('Artist') }}</label>
                        <input type="text" class="form-control" id="audio_artist" placeholder="{{ __('Artist') }}"
                               name="audio[artist]" value="{{ audio_tags.artist }}">
                    </div>
                    <div class="mt-2">
                        <label class="form-label" for="audio_title">{{ __('Title') }}</label>
                        <input type="text" class="form-control" id="audio_title" placeholder="{{ __('Title') }}"
                               name="audio[title]" value="{{ audio_tags.title }}">
                    </div>
                    <div class="mt-2">
                        <label class="form-label" for="audio_album">{{ __('Album') }}</label>
                        <input type="text" class="form-control" id="audio_album" placeholder="{{ __('Album') }}"
                               name="audio[album]" value="{{ audio_tags.album }}">
                    </div>
                    <div class="mt-2">
                        <label class="form-label" for="audio_genre">{{ __('Genre') }}</label>
                        <input type="text" class="form-control" id="audio_genre" placeholder="{{ __('Genre') }}"
                               name="audio[genre]" value="{{ audio_tags.genre }}">
                    </div>
                    <div class="mt-2">
                        <label class="form-label" for="audio_year">{{ __('Year') }}</label>
                        <input type="text" class="form-control" id="audio_year" placeholder="{{ __('Year') }}"
                               name="audio[year]" value="{{ audio_tags.year }}">
                    </div>
                </div>
            </details>
        {% endif %}
        <div class="site-dl-form__actions">
            <a href="{{ file_url }}" class="btn btn-outline-secondary">
                {% include '@theme/components/icon.twig' with {name: 'chevron-left', size: 14, class: 'site-icon--directional'} only %} {{ __('Cancel') }}
            </a>
            <button type="submit" name="submit" value="1" class="btn btn-primary">
                {% include '@theme/components/icon.twig' with {name: 'check', size: 14} only %} {{ __('Save') }}
            </button>
        </div>
    </form>
{% endblock %}
