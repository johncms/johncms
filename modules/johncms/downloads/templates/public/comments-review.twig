{#
    The latest comments of all the files, for a moderator to look through.

    @var items      list<\Johncms\Comments\Application\DTO\LatestCommentDTO>
    @var pagination \Twig\Markup|null
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    <section class="site-discussion">
        {% if items is empty %}
            <div class="site-discussion__empty">{{ __('The list is empty') }}</div>
        {% else %}
            <div class="site-discussion__feed">
                {% for item in items %}
                    <div>
                        <p class="site-discussion__count mb-1"><a href="{{ item.subject.url }}">{{ item.subject.title }}</a></p>
                        {% include '@theme/components/comments/comment.twig' with {
                            comment: item.comment,
                            subject: item.subject,
                            page: 1,
                            added: false,
                            can_reply: false,
                        } only %}
                    </div>
                {% endfor %}
            </div>
            {% if pagination %}<div class="site-discussion__pagination">{{ pagination }}</div>{% endif %}
        {% endif %}
    </section>
{% endblock %}
