{#
    The catalogue: the main page of the downloads (id = 0) or one category. Subcategories come
    first, then the files of this very level.

    @var id          int          Current category, 0 on the main page.
    @var summary     string       Description of the category, empty on the main page.
    @var stat        array        sections, files — what the heading says the section holds.
    @var total_new   int          New files here and below, for the chip.
    @var new_url     string
    @var categories  array        Cards, see CatalogPresenter::categories().
    @var files       array        Presented files of this page, see FilePresenter::present().
    @var total_files int          Files of this very level.
    @var sort        array|null   Links of the sorting, null when there is nothing to sort.
    @var pagination  \Twig\Markup|null
    @var can_upload  bool         The visitor may upload into this category.
    @var can_manage  bool         The visitor may manage categories and files.
    @var can_review  bool         The visitor may open the review of comments.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    <p class="site-page-heading__subtitle">
        {% if summary %}<span>{{ summary }}</span>{% endif %}
        <span class="site-page-stat">
            <span class="site-page-stat__dot" aria-hidden="true"></span>
            {% if stat.sections > 0 %}
                {{ (id ? n__('%d subsection', '%d subsections', stat.sections) : n__('%d section', '%d sections', stat.sections))|format(stat.sections) }} ·
            {% endif %}
            {{ n__('%d file', '%d files', stat.files)|format(stat.files) }}
        </span>
    </p>
{% endblock %}

{% block content %}
    <div class="site-downloads">
        <div class="site-downloads__toolbar">
            <nav class="site-downloads__chips" aria-label="{{ __('Collections') }}">
                {% if total_new > 0 %}
                    <a class="site-chip" href="{{ new_url }}">
                        {% include '@theme/components/icon.twig' with {name: 'sparkles', size: 12} only %}
                        {{ __('New Files') }} <span class="site-chip__count">{{ total_new|format_number }}</span>
                    </a>
                {% endif %}
                <a class="site-chip" href="/downloads/search/">{% include '@theme/components/icon.twig' with {name: 'search', size: 12} only %} {{ __('Search') }}</a>
                <a class="site-chip" href="/downloads/top/">{% include '@theme/components/icon.twig' with {name: 'trophy', size: 12} only %} {{ __('Top Files') }}</a>
                <a class="site-chip" href="/downloads/top-users/">{% include '@theme/components/icon.twig' with {name: 'users', size: 12} only %} {{ __('Top Users') }}</a>
                {% if app.user.isValid %}
                    <a class="site-chip" href="/downloads/favorites/">{% include '@theme/components/icon.twig' with {name: 'star', size: 12} only %} {{ __('Favorites') }}</a>
                {% endif %}
                {% if can_review %}
                    <a class="site-chip" href="/downloads/comments-review/">{% include '@theme/components/icon.twig' with {name: 'messages-square', size: 12} only %} {{ __('Review comments') }}</a>
                {% endif %}
            </nav>
            {% if can_upload or can_manage %}
                <div class="site-downloads__actions">
                    {% if can_upload and id %}
                        <a class="btn btn-primary btn-sm" href="/downloads/upload/{{ id }}/">
                            {% include '@theme/components/icon.twig' with {name: 'upload', size: 14} only %} {{ __('Upload File') }}
                        </a>
                    {% endif %}
                    {% if can_manage %}
                        {% include '@downloads/public/components/section-actions.twig' with {id: id} only %}
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {% if categories %}
            <section aria-labelledby="downloads-sections-title">
                <h2 class="site-downloads__heading" id="downloads-sections-title">
                    {{ id ? __('Subsections') : __('Sections') }}
                    <span class="site-downloads__count">{{ categories|length }}</span>
                </h2>
                <div class="site-downloads__list">
                    {% for category in categories %}
                        {% include '@downloads/public/components/category-card.twig' with {category: category, can_manage: can_manage, can_reorder: categories|length > 1} only %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if files or not categories %}
            <section id="downloads-files" aria-labelledby="downloads-files-title">
                <div class="site-downloads__heading-row">
                    <h2 class="site-downloads__heading" id="downloads-files-title">
                        {{ __('Files') }}
                        <span class="site-downloads__count">{{ total_files|format_number }}</span>
                    </h2>
                    {% if sort %}
                        <div class="site-downloads__sort">
                            <span class="site-downloads__sort-label" id="downloads-sort-label">{{ __('Sorting') }}</span>
                            <div class="site-segmented" role="group" aria-labelledby="downloads-sort-label">
                                {% for field in sort.fields %}
                                    <a class="site-segmented__item" href="{{ field.url }}"{% if field.active %} aria-current="true"{% endif %}>{{ field.label }}</a>
                                {% endfor %}
                            </div>
                            <a class="site-downloads__order" href="{{ sort.order_url }}"
                                title="{{ sort.ascending ? __('ascending') : __('descending') }}"
                                aria-label="{{ sort.ascending ? __('Sort in descending order') : __('Sort in ascending order') }}">
                                {% include '@theme/components/icon.twig' with {name: sort.ascending ? 'chevron-up' : 'chevron-down', size: 13} only %}
                            </a>
                        </div>
                    {% endif %}
                </div>
                <div class="site-downloads__list">
                    {% for file in files %}
                        {% include '@downloads/public/components/file-row.twig' with {file: file} only %}
                    {% else %}
                        {% include '@theme/components/empty-state.twig' with {
                            icon: 'folder', title: __('The section is empty'), description: __('Files of the section will appear here.')
                        } only %}
                    {% endfor %}
                </div>
                {% if pagination %}<div class="site-downloads__pagination">{{ pagination }}</div>{% endif %}
            </section>
        {% endif %}
    </div>
{% endblock %}
