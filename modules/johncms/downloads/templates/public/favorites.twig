{#
    The files the visitor keeps in the favorites.

    @var files       array        Presented files, see FilePresenter::present().
    @var total_files int
    @var pagination  \Twig\Markup Null when everything fits on one page.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    <div class="site-downloads">
        <div class="site-downloads__toolbar">
            {% include '@downloads/public/components/collections-nav.twig' with {current: 'favorites'} only %}
        </div>
        {% include '@downloads/public/components/file-list.twig' with {
            heading: __('Files'), count: total_files, files: files, pagination: pagination,
            empty_icon: 'star', empty_title: __('The favorites are empty'), empty_text: __('Add a file from its page to find it here.'),
        } only %}
    </div>
{% endblock %}
