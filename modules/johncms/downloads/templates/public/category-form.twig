{#
    Creating and editing a category. The name of the directory on the disk is set once, when the
    category is created, so the field is absent in the edit form.

    @var folder_params array  name, rus_name, desc, user_down, format
    @var action_url    string
    @var cancel_url    string
    @var extensions    string Allowed extensions, joined into one line.
    @var edit_form     bool
    @var can_set_rules bool   Only the owner of the site sets who may upload and what.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    <form class="site-dl-form site-dlf__section" name="folder_form" action="{{ action_url }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if not edit_form %}
            <div class="mb-3">
                <label class="form-label" for="name">{{ __('Folder name') }}</label>
                <input type="text" class="form-control" id="name" placeholder="{{ __('Folder name') }}"
                       name="name" value="{{ folder_params.name }}" required>
                <div class="form-text">{{ __('Only latin characters and numbers') }}</div>
            </div>
        {% endif %}
        <div class="mb-3">
            <label class="form-label" for="rus_name">{{ __('Title to display') }}</label>
            <input type="text" class="form-control" id="rus_name" placeholder="{{ __('Title to display') }}"
                   name="rus_name" value="{{ folder_params.rus_name }}" required>
        </div>
        <div class="mb-3">
            <label class="form-label" for="desc">{{ __('Description') }}</label>
            <textarea id="desc" class="form-control" maxlength="500" name="desc" cols="24" rows="4">{{ folder_params.desc }}</textarea>
        </div>
        {% if can_set_rules %}
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" name="user_down" value="1" id="user_down"{% if folder_params.user_down %} checked{% endif %}>
                <label class="form-check-label" for="user_down">{{ __('Allow users to upload files') }}</label>
            </div>
            <div class="mb-3">
                <label class="form-label" for="format">{{ __('Allowed extensions') }}</label>
                <input type="text" class="form-control" id="format" placeholder="{{ __('Allowed extensions') }}"
                       name="format" value="{{ folder_params.format }}">
                <div class="form-text">{{ __('You can write only the following extensions') }}: {{ extensions }}</div>
            </div>
        {% endif %}
        <div class="site-dl-form__actions">
            <a href="{{ cancel_url }}" class="btn btn-outline-secondary">
                {% include '@theme/components/icon.twig' with {name: 'chevron-left', size: 14, class: 'site-icon--directional'} only %} {{ __('Cancel') }}
            </a>
            <button type="submit" name="submit" value="1" class="btn btn-primary">
                {% include '@theme/components/icon.twig' with {name: 'check', size: 14} only %} {{ __('Save') }}
            </button>
        </div>
    </form>
{% endblock %}
