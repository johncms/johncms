{#
    Files waiting to be accepted by a moderator.

    @var files      array        Presented files with accept_url and delete_url added.
    @var total      int
    @var pagination \Twig\Markup Null when everything fits on one page.
    @var urls       array        downloads
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if files is empty %}
        <div class="row">
            <div class="col-md-6">
                <div class="alert alert-info">{{ __('The list is empty') }}</div>
            </div>
        </div>
    {% else %}
        {% for file in files %}
            {% include '@downloads/public/components/file-row.twig' with {file: file} only %}
        {% endfor %}
    {% endif %}

    {% if total %}
        <form action="/downloads/moderation/accept-all" method="post" class="mb-2 mt-3"
            data-confirm="{{ __('Accept all files?') }}"
            data-confirm-text="{{ n__('%d file awaiting moderation becomes visible to everyone.', '%d files awaiting moderation become visible to everyone.', total)|format(total) }}"
            data-confirm-button="{{ __('Accept all files') }}" data-confirm-tone="primary">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <button type="submit" class="btn btn-primary">{{ __('Accept all files') }}</button>
        </form>
    {% endif %}

    {% if total %}
        <div>
            <div>{{ __('Total') }}: {{ total }}</div>
            {% if pagination %}
                <div class="mt-1">{{ pagination }}</div>
            {% endif %}
        </div>
    {% endif %}

    <div class="mt-3">
        <a href="{{ urls.downloads }}">{{ __('Downloads') }}</a>
    </div>
{% endblock %}
