{#
    The search by the name of a file, or by its description too.

    @var files                 array        Presented files, see FilePresenter::present().
    @var total                 int
    @var pagination            \Twig\Markup Null when everything fits on one page.
    @var search_query          string
    @var search_in_description bool
    @var searched              bool         False until a query the search takes has been sent.
    @var error                 string       Why the query was not taken; empty otherwise.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    <div class="site-downloads">
        <div class="site-downloads__toolbar">
            {% include '@downloads/public/components/collections-nav.twig' with {current: 'search'} only %}
        </div>

        <form action="/downloads/search/" method="get" class="site-dl-search" role="search">
            <div class="site-news-search site-dl-search__field{% if error %} is-invalid{% endif %}">
                <input name="search" type="search" value="{{ search_query }}" maxlength="64" required minlength="2"
                    placeholder="{{ __('Search query') }}" aria-label="{{ __('Search query') }}"
                    {% if error %}aria-invalid="true" aria-describedby="downloads-search-error"{% endif %}>
                <button type="submit" class="btn" aria-label="{{ __('Search') }}" title="{{ __('Search') }}">
                    {% include '@theme/components/icon.twig' with {name: 'search', size: 16} only %}
                </button>
            </div>
            <div class="form-check site-dl-search__option">
                <input class="form-check-input" type="checkbox" name="id" value="1" id="downloads-search-description"{% if search_in_description %} checked{% endif %}>
                <label class="form-check-label" for="downloads-search-description">{{ __('Search in description') }}</label>
            </div>
            {% if error %}
                <p class="site-dl-search__error" id="downloads-search-error">{{ error }}</p>
            {% endif %}
        </form>

        {% if searched %}
            {% include '@downloads/public/components/file-list.twig' with {
                heading: __('Found'), count: total, files: files, pagination: pagination,
                empty_icon: 'search', empty_title: __('Nothing found'), empty_text: __('Try another word or search in the descriptions too.'),
            } only %}
            <p><a href="/downloads/search/">{{ __('New Search') }}</a></p>
        {% else %}
            {% include '@theme/components/empty-state.twig' with {
                icon: 'search', title: __('Search the files'), description: __('By the name of a file, without regard to case; from 2 to 64 characters.')
            } only %}
        {% endif %}
    </div>
{% endblock %}
