{#
    What came out of importing a file: whether the screenshot made it and where to go next.

    @var id                    int    Category the file went into.
    @var urls                  array  view_file_url, category_url
    @var screen_attached       bool   Null when no screenshot was sent at all.
    @var screen_attached_error string Message of the image library, when there is one.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    <section class="site-dlf__section site-dl-result">
        <span class="site-dl-result__icon" aria-hidden="true">{% include '@theme/components/icon.twig' with {name: 'circle-check', size: 22} only %}</span>
        <div class="site-dl-result__main">
            <h2 class="site-dlf__h2">{{ __('File attached') }}</h2>
            {% if screen_attached is not null %}
                <ul class="site-dl-result__list">
                    {% if screen_attached is same as(true) %}
                        <li>{{ __('Screenshot is attached') }}</li>
                    {% else %}
                        <li class="site-dl-result__warning">{{ __('Screenshot not attached') }} {{ screen_attached_error }}</li>
                    {% endif %}
                </ul>
            {% endif %}
        </div>
    </section>
    <div class="site-dl-form__actions">
        <a href="{{ urls.category_url }}" class="btn btn-outline-secondary">
            {% include '@theme/components/icon.twig' with {name: 'chevron-left', size: 14, class: 'site-icon--directional'} only %} {{ __('Back') }}
        </a>
        <div class="d-flex flex-wrap gap-2">
            <a href="/downloads/import/{{ id }}/" class="btn btn-outline-secondary">{{ __('Import more') }}</a>
            <a href="{{ urls.view_file_url }}" class="btn btn-primary">{{ __('Open the file') }}</a>
        </div>
    </div>
{% endblock %}
