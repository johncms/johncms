{#
    Uploading a file into a category. A rejected form comes back with its fields filled in and the
    reasons beside them; only the chosen file has to be picked again, as no browser keeps it.

    @var action_url string
    @var form       array  category, category_url, extensions (list), max_size (KB), moderated
    @var values     array  new_file, text, name_link, opis
    @var errors     array  Messages by field: fail, new_file, text, name_link.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block page_subtitle %}
    <p class="site-page-heading__subtitle"><span>{{ __('In the section') }} <a href="{{ form.category_url }}">{{ form.category }}</a></span></p>
{% endblock %}

{% macro field(name, label, hint, values, errors, attributes) %}
    {% set field_errors = errors[name]|default([]) %}
    <div class="site-dl-form__field">
        <label class="form-label" for="upload-{{ name }}">{{ label }}</label>
        <input type="text" class="form-control{{ field_errors ? ' is-invalid' : '' }}" id="upload-{{ name }}" name="{{ name }}"
            value="{{ values[name]|default('') }}" aria-describedby="upload-{{ name }}-hint{{ field_errors ? ' upload-' ~ name ~ '-errors' : '' }}"
            {{ attributes|raw }}>
        <div class="form-text" id="upload-{{ name }}-hint">{{ hint }}</div>
        {% if field_errors %}<div class="invalid-feedback d-block" id="upload-{{ name }}-errors">{{ field_errors|join(' ') }}</div>{% endif %}
    </div>
{% endmacro %}
{% import _self as upload %}

{% block content %}
    {% if errors and not errors.fail|default(false) %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-warning', alert: __('Choose the file again: the browser does not keep it after an error.')} only %}
    {% endif %}
    <form class="site-dl-form" name="file_upload_form" action="{{ action_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">

        <section class="site-dlf__section">
            <h2 class="site-dlf__h2 site-dl-form__title">{{ __('File') }}</h2>
            {% set file_errors = errors.fail|default([]) %}
            <div class="site-dl-form__field">
                <label class="form-label" for="upload-fail">{{ __('Choose file') }}</label>
                <input type="file" class="form-control{{ file_errors ? ' is-invalid' : '' }}" id="upload-fail" name="fail" required
                    accept="{% for extension in form.extensions %}.{{ extension }}{% if not loop.last %},{% endif %}{% endfor %}"
                    aria-describedby="upload-fail-hint{{ file_errors ? ' upload-fail-errors' : '' }}">
                <div class="form-text" id="upload-fail-hint">
                    {{ __('Up to %d KB.')|format(form.max_size) }} {{ __('Allowed extensions') }}: {{ form.extensions|join(', ') }}
                </div>
                {% if file_errors %}<div class="invalid-feedback d-block" id="upload-fail-errors">{{ file_errors|join(' ') }}</div>{% endif %}
            </div>
            {% if form.moderated %}
                <p class="site-dl-form__note">{% include '@theme/components/icon.twig' with {name: 'info', size: 14} only %} {{ __('A moderator checks the file before it appears in the downloads.') }}</p>
            {% endif %}
        </section>

        <section class="site-dlf__section">
            <h2 class="site-dlf__h2 site-dl-form__title">{{ __('Names') }}</h2>
            {{ upload.field('text', __('File Name'), __('The title on the site; the name of the file if left empty. Up to 200 characters.'), values, errors, 'maxlength="200"') }}
            {{ upload.field('new_file', __('Save as'), __('The name of the file on disk, without the extension; the original name if left empty. Up to 100 characters.'), values, errors, 'maxlength="100"') }}
            {{ upload.field('name_link', __('Link to download file'), __('The text of the download link. Up to 200 characters.'), values, errors, 'maxlength="200" required') }}
        </section>

        <section class="site-dlf__section">
            <h2 class="site-dlf__h2 site-dl-form__title">{{ __('Screenshot and description') }}</h2>
            <div class="site-dl-form__field">
                <label class="form-label" for="upload-screen">{{ __('Choose screenshot') }}</label>
                <input type="file" class="form-control" id="upload-screen" name="screen" accept="image/*" aria-describedby="upload-screen-hint">
                <div class="form-text" id="upload-screen-hint">{{ __('Optional. More screenshots can be added on the page of the file.') }}</div>
            </div>
            {% include '@theme/components/editor.twig' with {
                label: __('Description'),
                name: 'opis',
                id: 'upload-opis',
                value: values.opis|default(''),
            } only %}
        </section>

        <div class="site-dl-form__actions">
            <a href="{{ form.category_url }}" class="btn btn-outline-secondary">
                {% include '@theme/components/icon.twig' with {name: 'chevron-left', size: 14, class: 'site-icon--directional'} only %} {{ __('Cancel') }}
            </a>
            <button type="submit" name="submit" value="1" class="btn btn-primary">
                {% include '@theme/components/icon.twig' with {name: 'upload', size: 14} only %} {{ __('Upload') }}
            </button>
        </div>
    </form>
{% endblock %}
