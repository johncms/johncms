{#
    Choosing the category to move a file into: one level of the tree at a time.

    @var file_name  string
    @var sections   array  id, rus_name, section_open_url, can_move
    @var action_url string Where the move is posted.
    @var current_id int    The category opened in the browser, 0 in the root and in the category of the file.
    @var back_url   string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    {% if sections %}
        <div class="h4 fw-bold">{{ __('Select a section to move') }}</div>
        <div class="list-group">
            {% for section in sections %}
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                        <a href="{{ section.section_open_url }}" class="mb-1">{{ section.rus_name }}</a>
                        {% if section.can_move %}
                            {% include '@downloads/public/components/move-form.twig' with {
                                action_url: action_url,
                                file_name: file_name,
                                cat_id: section.id,
                                cat_name: section.rus_name,
                                label: __('Move file to this section'),
                                class: 'btn btn-primary btn-sm',
                            } only %}
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">{{ __('The list is empty') }}</div>
    {% endif %}
    {% if current_id %}
        <div class="mt-3">
            {% include '@downloads/public/components/move-form.twig' with {
                action_url: action_url,
                file_name: file_name,
                cat_id: current_id,
                cat_name: '',
                label: __('Move file here'),
                class: 'btn btn-primary',
            } only %}
        </div>
    {% endif %}
    <div class="mt-3">
        <a href="{{ back_url }}">{{ __('Cancel') }}</a>
    </div>
{% endblock %}
