{#
    Screenshots of a file: the current ones and the form that adds one more.

    @var screens      array  url, preview, file_name
    @var action_url   string
    @var file_url     string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content_class %}site-content--contained{% endblock %}

{% block content %}
    {% if screens %}
        <section class="site-dlf__section mb-3">
        <h2 class="site-dlf__h2 site-dl-form__title">{{ __('Current screenshots') }}</h2>
        <div>
            {% for screen in screens %}
                <div class="d-flex align-items-center gap-3 mb-3 border-bottom pb-3">
                    <a href="{{ screen.url }}" title="{{ screen.file_name }}" data-source="{{ screen.url }}" class="image-preview">
                        <img src="{{ screen.preview }}" width="96" height="60" class="rounded object-fit-cover" alt="{{ screen.file_name }}">
                    </a>
                    <div class="flex-grow-1 min-w-0">
                        <h3 class="h6 fw-bold text-break">{{ screen.file_name }}</h3>
                        {% include '@downloads/public/components/delete-form.twig' with {
                            action: action_url ~ 'delete',
                            fields: {screen: screen.file_name},
                            question: __('Delete the screenshot “%s”?')|format(screen.file_name),
                            text: '',
                            label: __('Delete'),
                            class: 'btn btn-danger btn-sm',
                        } only %}
                    </div>
                </div>
            {% endfor %}
        </div>
        </section>
    {% endif %}

    <form class="site-dl-form site-dlf__section" name="file_upload_form" action="{{ action_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <h2 class="site-dlf__h2 site-dl-form__title">{{ __('Add screenshot') }}</h2>
        <div class="mb-3">
            <label class="form-label" for="fail">{{ __('Choose file') }}</label>
            <input type="file" class="form-control" id="fail" name="screen">
            <div class="form-text">
                {{ __('Max. Size') }}: {{ config('johncms.flsz') }} kb.
            </div>
        </div>

        <div class="site-dl-form__actions">
            <a href="{{ file_url }}" class="btn btn-outline-secondary">
                {% include '@theme/components/icon.twig' with {name: 'chevron-left', size: 14, class: 'site-icon--directional'} only %} {{ __('Cancel') }}
            </a>
            <button type="submit" name="submit" value="1" class="btn btn-primary">
                {% include '@theme/components/icon.twig' with {name: 'check', size: 14} only %} {{ __('Save') }}
            </button>
        </div>
    </form>
{% endblock %}
