{#
    Screenshots of a file: the current ones and the form that adds one more.

    @var screens      array  url, file_name
    @var action_url   string
    @var file_url     string
    @var delete_token string One-time token of the delete form, checked against the session.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if screens %}
        <div class="h4 fw-bold">{{ __('Current screenshots') }}</div>
        <div class="mt-3 mb-4">
            {% for screen in screens %}
                <div class="media align-items-end mb-3 border-bottom pb-3">
                    <a href="{{ screen.url }}" title="{{ screen.file_name }}" data-source="{{ screen.url }}" class="image-preview">
                        <img src="{{ screen.url }}" class="me-3" style="width: 64px;" alt="{{ screen.file_name }}">
                    </a>
                    <div class="media-body">
                        <h5 class="fw-bold mt-0">{{ screen.file_name }}</h5>
                        <form action="{{ action_url }}?do={{ screen.file_name|url_encode }}" method="post">
                            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                            <input type="hidden" name="delete_token" value="{{ delete_token }}">
                            <button type="submit" class="btn btn-danger btn-sm">{{ __('Delete') }}</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="h4 fw-bold">{{ __('Add screenshot') }}</div>
    <form name="file_upload_form" action="{{ action_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <div class="form-group">
            <div class="custom-file">
                <input type="file" class="custom-file-input" id="fail" name="screen" aria-describedby="file_label">
                <label class="custom-file-label" for="fail">{{ __('Choose file') }}</label>
            </div>
            <div class="text-muted mb-3 small">
                {{ __('Max. Size') }}: {{ config('johncms.flsz') }} kb.
            </div>
        </div>

        <div>
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Save') }}</button>
            <a href="{{ file_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
