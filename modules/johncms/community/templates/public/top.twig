{#
    The most active users, by one of the activity counters.

    @param array    tabs       Counters to choose from, one of them active.
    @param string   active_tab
    @param iterable list
    @param int      total
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="mb-3 mt-n1" role="group">
        {% for tab in tabs %}
            <a href="{{ tab.url }}" class="btn btn-outline-secondary mt-1 {{ tab.active ? 'active' }}">{{ tab.name }}</a>
        {% endfor %}
    </div>

    {% include '@community/public/components/user-list.twig' with {list: list, total: total, active_tab: active_tab} only %}

    <div class="mt-3">
        <div>
            <a href="/community/">{{ __('Back') }}</a>
        </div>
    </div>
{% endblock %}
