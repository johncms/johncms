{#
    The users whose messages do not reach the visitor.

    @var blocklist  iterable     Contacts, each with its contactUser loaded.
    @var total      int
    @var pagination \Twig\Markup Null when everything fits on one page.
    @var nav_active string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% include '@mail/public/components/nav.twig' with {active: nav_active} only %}

    {% if total == 0 %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: __('The list is empty')} only %}
    {% else %}
        {% for contact in blocklist %}
            {% set blocked = contact.contactUser %}
            <div class="user-row card shadow border-0 mb-2">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="user-avatar me-2 me-md-4">
                            <div class="avatar-image rounded-circle overflow-hidden">
                                <img src="{{ avatar(blocked.id) }}" class="img-fluid" alt=".">
                            </div>
                            <div class="user-status {{ blocked.is_online ? 'online' : 'offline' }}"></div>
                        </div>
                        <div class="overflow-auto flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                                <div class="user-name">
                                    <a href="/profile/{{ blocked.id }}" class="text-decoration-none fw-bold">{{ blocked.name }}</a>
                                </div>
                                <div class="text-muted small">
                                    {{ contact.time|display_date }}
                                </div>
                            </div>
                            <div class="user-info small text-muted">
                                {{ __('User since:') }} {{ blocked.datereg|display_date }}
                            </div>
                            <div class="mt-3">
                                <a href="/mail/write/{{ blocked.id }}" class="btn btn-sm btn-outline-primary">{{ __('Correspondence') }}</a>
                                <a href="/mail/delete-contact/{{ blocked.id }}" class="btn btn-sm btn-outline-danger">{{ __('Delete') }}</a>
                                <a href="/mail/unblock/{{ blocked.id }}" class="btn btn-sm btn-outline-warning">{{ __('Unblock') }}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% if pagination %}
            <div class="mt-3">
                {{ pagination }}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
