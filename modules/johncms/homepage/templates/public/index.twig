{#
    @var blocks list<\Johncms\View\Homepage\HomepageBlock> Module blocks, in order.
    @var bottom_blocks list<\Johncms\View\Homepage\HomepageBlock> Blocks below the navigation tiles.
    @var site_name string Site name from the system settings.
    @var welcome_text string Optional plain text, independent of the SEO description.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="site-home">
        <section class="site-home__welcome" aria-labelledby="site-home-title">
            <h1 id="site-home-title">{{ site_name }}</h1>
            {% if welcome_text %}<p class="site-home__intro">{{ welcome_text }}</p>{% endif %}
            {% if not app.user.isValid %}
                <div class="site-home__actions">
                    {% if can('registration.register') %}
                        <a class="btn btn-primary" href="/registration">
                            {% include '@theme/components/icon.twig' with {name: 'user-plus', size: 14} only %}
                            {{ d__('system', 'Registration') }}
                        </a>
                    {% endif %}
                    <a class="btn btn-secondary" href="/login">{{ d__('system', 'Log In') }}</a>
                </div>
            {% endif %}
        </section>

        {% if blocks %}
            <div class="site-home__blocks">
                {% for block in blocks %}
                    {% include block.template with block.data only %}
                {% endfor %}
            </div>
        {% endif %}

        {% set sections = menu_items('main') %}
        {% if sections %}
            <nav class="site-home__sections" aria-label="{{ __('Site sections') }}">
                {% for item in sections %}
                    {% set badge = item.badge %}
                    <a class="site-home__tile" href="{{ item.url }}">
                        <span class="site-home__tile-head">
                            {% if item.icon %}
                                <span class="site-home__tile-icon">
                                    {% include '@theme/components/icon.twig' with {name: item.icon, image: item.hasImageIcon, size: 18} only %}
                                </span>
                            {% endif %}
                            {% if badge > 0 %}<span class="badge text-bg-light" dir="ltr">+{{ badge|format_number }}</span>{% endif %}
                        </span>
                        <span class="site-home__tile-title">{{ item.title }}</span>
                    </a>
                {% endfor %}
            </nav>
        {% endif %}
        {% for block in bottom_blocks %}
            {% include block.template with block.data only %}
        {% endfor %}
    </div>
{% endblock %}
