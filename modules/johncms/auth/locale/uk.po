#: modules/registration/templates/registration_result.phtml:5
msgid "Registration"
msgstr "Реєстрація"

#: modules/registration/src/Application/Controllers/RegistrationController.php:104
msgid "You must accept the consent to continue"
msgstr "Щоб продовжити, ви повинні прийняти згоду"

#: modules/registration/src/Application/UseCases/RegisterUserUseCase.php:62
msgid "Registration on the website"
msgstr "Реєстрація на сайті"

#: modules/registration/templates/email_confirmed.phtml:11
#: modules/registration/templates/email_confirmed.phtml:12
msgid "Email confirmation"
msgstr "Підтвердження електронної пошти"

#: modules/registration/templates/email_confirmed.phtml:17
msgid "User is not found"
msgstr "Користувача не знайдено"

#: modules/registration/templates/email_confirmed.phtml:19
msgid "Thanks! Your e-mail has been successfully confirmed."
msgstr "Дякую! Ваш електронний лист підтверджено."

#: modules/registration/templates/email_confirmed.phtml:26
msgid "Error when confirming e-mail. Invalid confirmation code."
msgstr "Помилка під час підтвердження електронної пошти. Невірний код підтвердження."

#: modules/registration/templates/index.phtml:13
msgid "You can get authorized on the site after confirmation of your registration."
msgstr "Ви зможете авторизуватися на сайті після підтвердження Вашої реєстрації."

#: modules/registration/templates/index.phtml:21
msgid "Please, do not register names like 111, shhhh, uuuu, etc. They will be deleted. <br /> Also all the profiles registered via proxy servers will be deleted"
msgstr "Будь ласка, не реєструйте імена, як 111, shhhh, uuuu і т. д. Вони будуть видалені. <br /> Також будуть видалені всі профілі, зареєстровані через проксі-сервери"

#: modules/registration/templates/index.phtml:25
msgid "Choose Nickname"
msgstr "Виберіть нік"

#: modules/registration/templates/index.phtml:34
msgid "Username"
msgstr "Ім'я користувача"

#: modules/registration/templates/index.phtml:40
msgid "Min. 2, Max. 20 characters.<br />Allowed letters of the russian and latin alphabets, numbers and symbols - = @ ! ? ~ _ ( ) [ ] . * (Except zero)"
msgstr "Мін. 2, макс. 20 символів.<br />Дозволені букви Кирилиці і Латиниці, цифри і знаки - = @ ! ? ~ _ ( ) [ ] . * (окрім нуля)"

#: modules/registration/templates/index.phtml:44
#: modules/registration/templates/index.phtml:53
msgid "Assign a password"
msgstr "Встановити пароль"

#: modules/registration/templates/index.phtml:61
#: modules/registration/templates/index.phtml:68
msgid "E-mail"
msgstr "Електронна пошта"

#: modules/registration/templates/index.phtml:76
msgid "Select Gender"
msgstr "Виберіть стать"

#: modules/registration/templates/index.phtml:79
msgid "Man"
msgstr "Чоловік"

#: modules/registration/templates/index.phtml:80
msgid "Woman"
msgstr "Жінка"

#: modules/registration/templates/index.phtml:87
#: modules/registration/templates/index.phtml:94
msgid "Your name"
msgstr "Ваше ім'я"

#: modules/registration/templates/index.phtml:101
msgid "Tell us a little about yourself"
msgstr "Розкажіть нам трохи про себе"

#: modules/registration/templates/index.phtml:108
#: modules/registration/templates/index.phtml:118
msgid "Verification code"
msgstr "Перевірочний код"

#: modules/registration/templates/index.phtml:110
msgid "Enter verification code"
msgstr "Введіть перевірочний код"

#: modules/registration/templates/index.phtml:124
msgid "If you cannot see the image code, enable graphics in your browser and refresh this page"
msgstr "Якщо Ви не бачите малюнок з кодом, увімкніть підтримку графіки в налаштуваннях браузера та перезавантажте сторінку"

#: modules/registration/templates/registration_closed.phtml:12
msgid "Registration is temporarily closed"
msgstr "Реєстрація тимчасово закрита"

#: modules/registration/templates/registration_result.phtml:9
msgid "Your registration data"
msgstr "Ваші реєстраційні дані"

#: modules/registration/templates/registration_result.phtml:11
msgid "Congratulations! You have successfully registered on the site."
msgstr "Вітаємо! Ви успішно зареєструвались на сайті."

#: modules/registration/templates/registration_result.phtml:14
msgid "Your ID"
msgstr "Ваш ID"

#: modules/registration/templates/registration_result.phtml:15
msgid "Your Username"
msgstr "Ваш логін"

#: modules/registration/templates/registration_result.phtml:16
msgid "Your Password"
msgstr "Ваш пароль"

#: modules/registration/templates/registration_result.phtml:19
msgid "Now you just need to confirm your email address.<br> Please check your email and follow the instructions in it."
msgstr "Тепер вам потрібно лише підтвердити свою електронну адресу."

#: modules/registration/templates/registration_result.phtml:21
msgid "Please, wait until a moderator approves your registration"
msgstr "Будь ласка, зачекайте підтвердження Вашої реєстрації адміністратором"

#: modules/registration/templates/registration_result.phtml:23
msgid "Enter"
msgstr "Вхід"

msgid "Login"
msgstr "Увійти"

msgid "You have not entered login"
msgstr "Ви не ввели логін"

msgid "You have not entered password"
msgstr "Ви не ввели пароль"

msgid "Personal"
msgstr "Особисте"

msgid "Logout"
msgstr "Вихід"

msgid "Authorization failed"
msgstr "Помилка авторизації"

msgid "The security code is not correct"
msgstr "Код перевірки введено не правильно"

msgid "Continue"
msgstr "Продовжити"

msgid "You didn't confirm your email address. Please check your email and follow the instructions in it."
msgstr "Ви не підтвердили свою адресу електронної пошти. Будь ласка, перевірте свою електронну скриньку і дотримуйтесь інструкцій, що містяться у листі."

msgid "Sorry, but your request for registration is not considered yet. Please, be patient."
msgstr "Вибачте, але ваша заявка на реєстрацію ще не розглянута. Будь ласка, зачекайте."

msgid "Authorization"
msgstr "Авторизація"

msgid "Password"
msgstr "Гасло"

msgid "Forgot password?"
msgstr "Забули гасло?"

msgid "Are you sure you want to leave the site?"
msgstr "Ви впевнені, що бажаєте покинути цей сайт?"

msgid "Cancel"
msgstr "Скасувати"

msgid "Remember me"
msgstr "Запам'ятати мене"

msgid "Too many attempts. Try again in %s."
msgstr "Забагато спроб. Повторіть через %s."

msgid "%d minute"
msgid_plural "%d minutes"
msgstr[0] "%d хвилину"
msgstr[1] "%d хвилини"
msgstr[2] "%d хвилин"
msgstr[3] "%d хвилин"

msgid "Back"
msgstr "Назад"

msgid "Restore password"
msgstr "Відновити пароль"

msgid "Incorrect code"
msgstr "Невірний код"

msgid "Check your e-mail for further information"
msgstr "Перевірте ваш e-mail для отримання додаткової інформації"

msgid "Password successfully changed.<br>New password sent to your E-mail address."
msgstr "Пароль успішно змінено.<br>Новий пароль висланий на вашу адресу E-mail."

msgid "Your new password"
msgstr "Ваш новий пароль"

msgid "User does not exists"
msgstr "Користувача не існує"

msgid "Time allotted for the password recovery has been exceeded"
msgstr "Час, відведений на відновлення пароля, вийшов"

msgid "The required fields are not filled"
msgstr "Обов'язкові поля не заповнені"

msgid "Invalid Email address"
msgstr "Невірна E-mail адреса"

msgid "Password can be recovered 1 time per day"
msgstr "Пароль можна відновлювати не частіше 1 разу на добу"

msgid "Password recovery"
msgstr "Відновлення пароля"

msgid "Your E-mail"
msgstr "Ваш E-mail"

msgid "Password will be send to E-mail address specified in your profile.<br />WARNING !! If E-mail address has not been specified in your profile, you will not be able to recover your password."
msgstr "Пароль буде висланий на E-mail адресу, вказану у Вашій анкеті.<br />УВАГА !! Якщо в анкеті не була вказана E-mail адреса, Ви не зможете відновити пароль."

msgid "A new password will be generated and sent to the E-mail address specified in your profile."
msgstr "Новий пароль буде згенеровано та надіслано на адресу електронної пошти, вказану у вашому профілі."
