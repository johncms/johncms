{#
    The login form.

    @var error      array  Messages about what went wrong with the previous attempt.
    @var user_login string
    @var remember   bool   Initial state of the "remember me" checkbox.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <h4>{{ __('Authorization') }}</h4>
        {% if error %}
            {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: error} only %}
        {% endif %}
        <div class="form-group">
            <label for="login">{{ __('Username') }}</label>
            <input type="text"
                   class="form-control"
                   maxlength="20"
                   name="n"
                   id="login"
                   required
                   value="{{ user_login }}"
                   placeholder="{{ __('Username') }}"
            >
        </div>
        <div class="form-group">
            <label for="password">{{ __('Password') }}</label>
            <input
                type="password"
                class="form-control"
                name="p"
                maxlength="20"
                id="password"
                required
                placeholder="{{ __('Password') }}"
            >
        </div>
        <div class="form-check mb-3">
            <input type="checkbox"
                   class="form-check-input"
                   name="remember"
                   value="1"
                   id="remember"
                   {{ remember ? 'checked' : '' }}
            >
            <label class="form-check-label" for="remember">{{ __('Remember me') }}</label>
        </div>
        <button type="submit" name="login" value="1" class="btn btn-fill btn-primary">{{ __('Login') }}</button>
        <a href="/password-recovery" class="btn btn-link">{{ __('Forgot password?') }}</a>
        <div class="mt-3">
            <a href="/registration" class="me-2">{{ __('Registration') }}</a>
        </div>
    </form>
    {% include '@theme/components/external-providers.twig' only %}
{% endblock %}
