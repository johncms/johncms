{#
    The files that came with the messages.

    @var data array nav_active, items, total, pagination, back_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% include '@mail/public/components/nav.twig' with {active: data.nav_active|default('')} only %}

    {% if data.items is empty %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: __('The list is empty')} only %}
    {% endif %}

    {% for item in data.items %}
        <div class="user-row card shadow border-0 mb-2">
            <div class="card-body">
                <div class="d-flex align-items-start">
                    <div class="user-avatar me-2 me-md-4">
                        <div class="avatar-image rounded-circle overflow-hidden">
                            <img src="{{ avatar(item.user_id) }}" class="img-fluid" alt=".">
                        </div>
                        <div class="user-status {{ item.user_is_online ? 'online' : 'offline' }} shadow"></div>
                    </div>
                    <div class="overflow-auto flex-grow-1">
                        <div class="user-name">
                            {% if item.user_id %}
                                <a href="{{ item.profile_url }}" class="user-login me-2">{{ item.name }}</a>
                            {% else %}
                                <a class="user-login me-2">{{ item.name }}</a>
                            {% endif %}
                        </div>
                        <div class="small">
                            <a href="{{ item.download_url }}">{{ item.file_name }}</a> ({{ item.file_size }}) ({{ item.download_count }})
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer"></div>
        </div>
    {% endfor %}

    <div class="mt-4">
        {% if data.pagination %}
            <div>
                {{ data.pagination }}
            </div>
        {% endif %}

        {% if data.total > 0 %}
            <div>{{ __('Total:') }} {{ data.total }}</div>
        {% endif %}
    </div>
    <div>
        <a href="{{ data.back_url }}">{{ __('Back') }}</a>
    </div>
{% endblock %}
