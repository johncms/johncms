{#
    Confirmation of an action over the mail: deleting a conversation, blocking a contact.

    @var data array message, form_action, hidden_inputs, submit_btn_name, back_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="row">
        <div class="col-md-6">
            <div class="alert alert-danger">
                <div class="pb-2">
                    {{ data.message }}
                </div>
                <div>
                    <form action="{{ data.form_action }}" method="post">
                        {% for hidden_input in data.hidden_inputs|default([]) %}
                            <input type="hidden" name="{{ hidden_input.name }}" value="{{ hidden_input.value }}">
                        {% endfor %}
                        <button type="submit" name="submit" value="1" class="btn btn-danger btn-sm">{{ data.submit_btn_name }}</button>
                        <a href="{{ data.back_url }}" class="btn btn-outline-secondary btn-sm">{{ __('Cancel') }}</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
