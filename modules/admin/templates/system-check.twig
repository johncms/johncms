{#
    What the environment of the site supports.

    @var array sections Groups of checks: title and rows of name, value, description, error.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% for section in sections %}
        <h2 class="mb-3">{{ section.title }}</h2>
        <table class="table table-bordered responsive-table">
            <thead>
            <tr>
                <th scope="col" style="width: 20%;">{{ __('Check name') }}</th>
                <th scope="col">{{ __('Value') }}</th>
                <th scope="col">{{ __('Description') }}</th>
            </tr>
            </thead>
            <tbody>
            {% for check in section.checks %}
                <tr>
                    <th scope="row">{{ check.name }}</th>
                    <td data-title="{{ __('Value') }}" class="break-word {{ check.error ? 'text-danger' : 'text-success' }}">{{ check.value }}</td>
                    <td data-title="{{ __('Description') }}">{{ check.description }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endfor %}
{% endblock %}
