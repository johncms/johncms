<?php

/**
 * @var Mobicms\Render\Template\Template $this
 * @var array<int, array<string, mixed>> $items
 * @var int $total
 * @var int $per_page
 * @var int $type
 * @var list<array{url: string, name: string, active: bool}> $filters
 * @var string $add_url
 * @var string $clear_url
 * @var string $pagination
 * @var string $csrf_token
 */

$this->layout('system::layout/default');

$miniForm = function (string $action, string $label, string $class) use ($csrf_token): string {
    return '<form method="post" action="' . $this->e($action) . '" class="d-inline me-2">'
        . '<input type="hidden" name="csrf_token" value="' . $csrf_token . '">'
        . '<button type="submit" class="' . $class . '">' . $label . '</button></form>';
};
?>
<div class="mb-3">
    <?php foreach ($filters as $filter): ?>
        <a href="<?= $this->e($filter['url']) ?>" class="btn btn-outline-secondary mt-1 <?= ($filter['active'] ? 'active' : '') ?>"><?= $this->e($filter['name']) ?></a>
    <?php endforeach; ?>
</div>
<?php if (! empty($items)): ?>
    <?php foreach ($items as $item): ?>
        <div class="new_post-item without_avatar">
            <div class="d-flex justify-content-between align-items-center">
                <a href="<?= $this->e($item['link']) ?>" class="h3" target="_blank" rel="noopener noreferrer"><?= $this->e($item['name']) ?></a>
                <div>
                    <?php if ($item['active']): ?>
                        <span class="badge rounded-pill bg-success"><?= __('On') ?></span>
                    <?php else: ?>
                        <span class="badge rounded-pill bg-danger"><?= __('Off') ?></span>
                    <?php endif; ?>
                </div>
            </div>
            <div class="post-body small">
                <div><?= __('Start date') ?>: <?= $this->e($item['display_time']) ?></div>
                <div><?= __('Disposition') ?>: <?= $this->e($item['place']) ?></div>
                <div><?= __('Show') ?>: <?= $this->e($item['show_for']) ?></div>
                <div><?= __('Agreement') ?>: <?= $this->e($item['agreement']) ?></div>
                <div><?= __('Remains') ?>: <?= $this->e($item['remains']) ?></div>
                <div><?= __('Link type') ?>: <?= $item['direct_link'] ? __('Direct Link') : __('Redirect') ?></div>
                <div><?= __('Style settings') ?>: <?= ! empty($item['styles']) ? $this->e($item['styles']) : __('Default') ?></div>
            </div>
            <div class="d-flex align-items-center mt-1">
                <?= $miniForm('/admin/ads/' . $item['id'] . '/up', __('Up'), 'btn btn-link p-0') ?>
                <?= $miniForm('/admin/ads/' . $item['id'] . '/down', __('Down'), 'btn btn-link p-0') ?>
                <a href="/admin/ads/<?= $item['id'] ?>/edit" class="me-2"><?= __('Edit') ?></a>
                <a href="/admin/ads/<?= $item['id'] ?>/delete" class="text-danger me-2"><?= __('Delete') ?></a>
                <?= $miniForm('/admin/ads/' . $item['id'] . '/toggle', ($item['active'] ? __('Hide') : __('Show')), 'btn btn-link p-0 text-danger') ?>
            </div>
        </div>
    <?php endforeach; ?>
<?php else: ?>
    <?= $this->fetch('system::app/alert', ['alert_type' => 'alert-info', 'alert' => __('The list is empty')]) ?>
<?php endif; ?>
<div class="mt-4">
    <?php if ($total > $per_page): ?>
        <div><?= $pagination ?></div>
    <?php endif; ?>
    <?php if ($total > 0): ?>
        <div><?= __('Total:') ?> <?= $total ?></div>
    <?php endif; ?>
</div>
<div>
    <div class="mb-3 mt-2">
        <a href="<?= $this->e($add_url) ?>" class="btn btn-primary btn-sm"><?= __('Add link') ?></a>
        <a href="<?= $this->e($clear_url) ?>" class="btn btn-danger btn-sm"><?= __('Delete inactive links') ?></a>
    </div>
    <div>
        <a href="/admin/"><?= __('Back') ?></a>
    </div>
</div>
