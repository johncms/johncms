{#
    The form of a new ban.

    @var string form_action
    @var array  errors       Validation messages, empty on the first render.
    @var int    field_height Rows of the reason field, from the settings of the visitor.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger shadow border-0', alert: errors} only %}

    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <div class="form-group">
            <label for="ip">{{ __('IP address') }}</label>
            <input type="text" name="ip" class="form-control" id="ip" placeholder="{{ __('IP address') }}">
        </div>

        <h3>{{ __('Ban type') }}</h3>
        <div class="form-check">
            <input type="radio" id="term1" name="term" value="1" class="form-check-input" checked="checked">
            <label class="form-check-label" for="term1">{{ __('Block') }}</label>
        </div>
        <div class="form-check">
            <input type="radio" id="term3" name="term" value="3" class="form-check-input">
            <label class="form-check-label" for="term3">{{ __('Registration') }}</label>
        </div>
        <div class="form-check">
            <input type="radio" id="term2" name="term" value="2" class="form-check-input">
            <label class="form-check-label" for="term2">{{ __('Redirect') }}</label>
        </div>

        <div class="form-group mt-2">
            <label for="url">{{ __('Redirect URL') }}</label>
            <input type="text" name="url" class="form-control" id="url" placeholder="{{ __('Redirect URL') }}">
            <div class="small text-muted">{{ __('If the ban on Redirect, then specify the URL') }}</div>
        </div>

        <div class="form-group">
            <label for="reason">{{ __('Reason') }}</label>
            <textarea class="form-control" rows="{{ field_height }}" name="reason" id="reason"></textarea>
        </div>

        <div class="alert alert-info">
            <b>{{ __('Example:') }}</b><br>
            <div><span class="fw-bold">10.5.7.1</span> &mdash; {{ __('Ban one address') }}</div>
            <div><span class="fw-bold">10.5.7.1-10.5.7.100</span> &mdash; {{ __('Ban range of address') }}</div>
            <div><span class="fw-bold">10.5.*.*</span> &mdash; {{ __('Ban on a mask. There will banned from the entrie subnet, begining with address 0 and ending with 255') }}</div>
        </div>

        <div class="mt-3">
            <input type="submit" value="{{ __('Save') }}" class="btn btn-primary"/>
            <a href="/admin/ip-bans" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
