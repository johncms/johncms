{#
    The form of a counter, for a new one and for an existing one.

    @var string form_action
    @var int    id                     Null when a new counter is being added.
    @var string name
    @var string counter_1
    @var string counter_2
    @var int    mode
    @var bool   require_cookie_consent
    @var bool   enabled
    @var int    field_height           Rows of a code field, from the settings of the visitor.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if id %}
            <input type="hidden" value="{{ id }}" name="id">
        {% endif %}
        <div class="form-group">
            <label for="name">{{ __('Name') }}</label>
            <input type="text" name="name" class="form-control" id="name" value="{{ name }}" placeholder="{{ __('Name') }}">
        </div>
        <div class="form-group">
            <label for="link1">{{ __('Option 1') }}</label>
            <textarea class="form-control" rows="{{ field_height }}" name="link1" id="link1">{{ counter_1 }}</textarea>
            <div class="small text-muted">{{ __('Code for main page') }}</div>
        </div>
        <div class="form-group">
            <label for="link2">{{ __('Option 2') }}</label>
            <textarea class="form-control" rows="{{ field_height }}" name="link2" id="link2">{{ counter_2 }}</textarea>
            <div class="small text-muted">{{ __('Code for other pages') }}</div>
        </div>

        <h3>{{ __('Display mode') }}</h3>
        <div class="form-check">
            <input type="radio" id="mode1" name="mode" value="1" class="form-check-input"{% if mode == 0 or mode == 1 %} checked="checked"{% endif %}>
            <label class="form-check-label" for="mode1">{{ __('Default') }}</label>
        </div>
        <div class="small text-muted">
            {{ __('On the main showing option 1, on the other pages option 2.<br>If &quot;option 2&quot; not filled, counter would only appear on the main page.')|raw }}
        </div>

        <div class="form-check">
            <input type="radio" id="term3" name="mode" value="2" class="form-check-input"{% if mode == 2 %} checked="checked"{% endif %}>
            <label class="form-check-label" for="term3">{{ __('Option 1') }}</label>
        </div>
        <div class="form-check">
            <input type="radio" id="term2" name="mode" value="3" class="form-check-input"{% if mode == 3 %} checked="checked"{% endif %}>
            <label class="form-check-label" for="term2">{{ __('Option 2') }}</label>
        </div>

        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" name="switch" value="1" id="switch"{% if enabled %} checked="checked"{% endif %}>
            <label class="form-check-label" for="switch">{{ __('Enabled') }}</label>
        </div>

        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" name="require_cookie_consent" value="1" id="require_cookie_consent"{% if require_cookie_consent %} checked="checked"{% endif %}>
            <label class="form-check-label" for="require_cookie_consent">{{ __('Load only after cookie consent') }}</label>
        </div>
        <div class="small text-muted">
            {{ __('If enabled, the counter code runs only after the visitor accepts the cookie banner. Requires the cookie banner to be enabled.') }}
        </div>

        <div class="alert alert-info mb-3 mt-3">
            <div class="fw-bold">{{ __('WARNING!') }}</div>
            <div>{{ __('Make sure you have correctly entered the code. It must meet the standard of XML') }}</div>
            <div>{{ __('If you click &quot;View&quot; and XHTML errors occured, then click &quot;Back&quot; button in your browser, return to this form and correct the errors.')|raw }}</div>
        </div>

        <div class="mt-3">
            <input type="submit" value="{{ __('Viewing') }}" class="btn btn-primary"/>
            <a href="/admin/counters" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
