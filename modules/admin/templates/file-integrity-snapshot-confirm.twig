{#
    Confirmation of taking a new snapshot of the files.

    @var string form_action
    @var string back_url
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    <div class="alert alert-danger">
        <div class="pb-2">
            {{ __('WARNING!!!<br>Before continuing make sure that all the files have been identified in the scanning mode distribution reliable and contain no unauthorized modifications.')|raw }}
        </div>
    </div>
    <div class="text-muted mb-3 alert alert-info">
        {{ __('This procedure creates a list of all script files to your site, calculates the checksums and writes to the database, for later comparison.') }}
    </div>
    <div>
        <form action="{{ form_action }}" method="post">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <button type="submit" class="btn btn-danger">{{ __('Create snapshot') }}</button>
            <a href="{{ back_url }}" class="btn btn-outline-secondary">{{ __('Cancel') }}</a>
        </form>
    </div>
{% endblock %}
