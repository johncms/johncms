{#
    The settings of the karma.

    @var array  settings        Current values, keyed by setting name.
    @var string form_action
    @var string clear_url
    @var string error_message   Empty unless the last save failed.
    @var string success_message Empty unless a save has just succeeded.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger shadow border-0', alert: error_message} only %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success shadow border-0', alert: success_message} only %}

    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <div class="form-group">
            <label for="karma_points">{{ __('Voices per day') }}</label>
            <input type="text" name="karma_points" class="form-control" id="karma_points" value="{{ settings.karma_points }}">
        </div>

        <h3>{{ __('Restriction for vote') }}</h3>

        <div class="form-group">
            <label for="forum">{{ __('Forum posts') }}</label>
            <input type="text" name="forum" class="form-control" id="forum" value="{{ settings.forum }}">
        </div>

        <h3>{{ __('General Settings') }}</h3>

        <div class="form-check">
            <input type="checkbox" class="form-check-input" name="on" value="1" id="on"{% if settings.on %} checked{% endif %}>
            <label class="form-check-label" for="on">{{ __('Switch module ON') }}</label>
        </div>

        <div class="form-check">
            <input type="checkbox" class="form-check-input" name="adm" value="1" id="adm"{% if settings.adm %} checked{% endif %}>
            <label class="form-check-label" for="adm">{{ __('Forbid to vote for the administration') }}</label>
        </div>

        <div class="mt-3">
            <input type="submit" value="{{ __('Save') }}" class="btn btn-primary"/>
            <a href="/admin/" class="btn btn-secondary">{{ __('Cancel') }}</a>
            <a href="{{ clear_url }}" class="btn btn-danger float-right">{{ __('Clear Karma') }}</a>
        </div>
    </form>
{% endblock %}
