<?php

/**
 * @var Mobicms\Render\Template\Template $this
 * @var \Illuminate\Support\Collection<int, \Johncms\Modules\Admin\Domain\Models\Counter> $items
 * @var string $add_url
 * @var string $csrf_token
 */

$this->layout('system::layout/default');

$miniForm = function (string $action, string $label, string $class) use ($csrf_token): string {
    return '<form method="post" action="' . $this->e($action) . '" class="d-inline me-2">'
        . '<input type="hidden" name="csrf_token" value="' . $csrf_token . '">'
        . '<button type="submit" class="' . $class . '">' . $label . '</button></form>';
};
?>

<?php if ($items->isEmpty()): ?>
    <?= $this->fetch('system::app/alert', ['alert_type' => 'alert-info', 'alert' => __('The list is empty')]) ?>
<?php endif; ?>
<?php foreach ($items as $item): ?>
    <div class="new_post-item without_avatar">
        <div class="d-flex justify-content-between align-items-center">
            <a href="/admin/counters/<?= $item->id ?>" class="h3"><?= $this->e($item->name) ?></a>
            <div>
                <?php if ($item->switch === 1): ?>
                    <span class="badge rounded-pill bg-success"><?= __('On') ?></span>
                <?php else: ?>
                    <span class="badge rounded-pill bg-danger"><?= __('Off') ?></span>
                <?php endif; ?>
            </div>
        </div>
        <div class="mt-2 d-flex align-items-center">
            <?= $miniForm('/admin/counters/' . $item->id . '/up', __('Up'), 'btn btn-link p-0') ?>
            <?= $miniForm('/admin/counters/' . $item->id . '/down', __('Down'), 'btn btn-link p-0') ?>
            <a href="/admin/counters/<?= $item->id ?>/edit" class="me-2"><?= __('Edit') ?></a>
            <a href="/admin/counters/<?= $item->id ?>/delete" class="me-2 text-danger"><?= __('Delete') ?></a>
        </div>
    </div>
<?php endforeach; ?>

<div class="mt-2">
    <?php if ($items->isNotEmpty()): ?>
        <div class="mb-2"><?= __('Total:') ?> <?= $items->count() ?></div>
    <?php endif; ?>
    <a href="<?= $this->e($add_url) ?>" class="btn btn-primary"><?= __('Add') ?></a>
</div>
<div class="mt-2">
    <a href="/admin/"><?= __('Back') ?></a>
</div>
