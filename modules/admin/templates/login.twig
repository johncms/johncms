{#
    The way into the panel.

    @var array  errors     What went wrong with the last attempt, empty on the first render.
    @var string user_login The name that was entered, kept across a failed attempt.
#}
{% extends '@admin/layouts/guest.twig' %}

{% block content %}
    <div class="min-vh-100 d-flex align-items-center">
        <div class="card w-100 mx-auto" style="max-width: 500px;">
            <div class="card-body">
                <form method="post">
                    <div class="text-center mb-2">
                        <img src="{{ asset('images/logo.svg') }}" alt="logo" style="max-width: 200px;" class="img-fluid">
                    </div>

                    <h4>{{ __('Authorization') }}</h4>
                    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors} only %}

                    <div class="form-group">
                        <label for="login">{{ __('Username') }}</label>
                        <input type="text"
                               class="form-control"
                               maxlength="20"
                               name="n"
                               id="login"
                               required
                               value="{{ user_login }}"
                               placeholder="{{ __('Username') }}"
                        >
                    </div>
                    <div class="form-group">
                        <label for="password">{{ __('Password') }}</label>
                        <input
                            type="password"
                            class="form-control"
                            name="p"
                            maxlength="20"
                            id="password"
                            required
                            placeholder="{{ __('Password') }}"
                        >
                    </div>
                    <button type="submit" name="login" value="1" class="btn btn-fill btn-primary">{{ __('Login') }}</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
