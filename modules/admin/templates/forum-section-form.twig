{#
    A new category, or a new section of one.

    @var int    parent_id           Null when a top-level category is being added.
    @var string parent_section_name
    @var string form_action
    @var string back_url
    @var int    field_height        Rows of the description field, from the settings of the visitor.
    @var array  errors              Validation messages, empty on the first render.
    @var array  access_options      Access modes of a section: value, label.
    @var array  type_options        Section types: value, label.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger shadow border-0', alert: errors} only %}

    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if parent_id %}
            <h3>{{ __('Parent section:') }} {{ parent_section_name }}</h3>
        {% endif %}
        <div class="form-group">
            <label for="name">{{ __('Title') }}</label>
            <input type="text" name="name" class="form-control" id="name" placeholder="{{ __('Title') }}" required>
            <div class="text-muted small">{{ __('Min. 2, Max. 30 characters') }}</div>
        </div>

        <div class="form-group">
            <label for="desc">{{ __('Description') }}</label>
            <textarea class="form-control" rows="{{ field_height }}" name="desc" id="desc"></textarea>
            <div class="small text-muted">{{ __('Optional field') }}<br>{{ __('Min. 2, Max. 500 characters') }}</div>
        </div>

        {% if parent_id %}
            <h3>{{ __('Common access') }}</h3>
            {% for option in access_options %}
                <div class="form-check">
                    <input type="radio" id="allow{{ option.value }}" name="allow" value="{{ option.value }}" class="form-check-input"{% if loop.first %} checked="checked"{% endif %}>
                    <label class="form-check-label" for="allow{{ option.value }}">{{ option.label }}</label>
                </div>
            {% endfor %}
        {% endif %}

        <h3 class="mt-3">{{ __('Section type') }}</h3>
        {% for option in type_options %}
            <div class="form-check">
                <input type="radio" id="section_type{{ option.value }}" name="section_type" value="{{ option.value }}" class="form-check-input"{% if loop.first %} checked="checked"{% endif %}>
                <label class="form-check-label" for="section_type{{ option.value }}">{{ option.label }}</label>
            </div>
        {% endfor %}

        <div class="mt-3">
            <input type="submit" value="{{ __('Add') }}" class="btn btn-primary">
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
