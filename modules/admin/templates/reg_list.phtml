<?php

/**
 * @var Mobicms\Render\Template\Template $this
 * @var array<int, array<string, mixed>> $items
 * @var int $total
 * @var int $per_page
 * @var string $form_action
 * @var string|null $success_message
 * @var string $pagination
 * @var string $csrf_token
 */

$this->layout('system::layout/default');

$postButton = function (string $action, array $fields, string $label, string $class = 'btn btn-link p-0 me-3 align-baseline') use ($form_action, $csrf_token): string {
    $html = '<form method="post" action="' . $this->e($form_action . $action) . '" class="d-inline">'
        . '<input type="hidden" name="csrf_token" value="' . $csrf_token . '">';
    foreach ($fields as $name => $value) {
        $html .= '<input type="hidden" name="' . $this->e($name) . '" value="' . $this->e((string) $value) . '">';
    }

    return $html . '<button type="submit" class="' . $class . '">' . $label . '</button></form>';
};
?>
<?php if (! empty($success_message)): ?>
    <div class="alert alert-success shadow border-0"><?= $this->e($success_message) ?></div>
<?php endif; ?>

<?php if (empty($items)): ?>
    <?= $this->fetch('system::app/alert', ['alert_type' => 'alert-info', 'alert' => __('The list is empty')]) ?>
<?php endif; ?>

<?php foreach ($items as $item): ?>
    <?= $this->fetch('admin::user_row', ['item' => $item]) ?>
    <div class="mt-2 mb-4 d-flex flex-wrap">
        <?= $postButton('/approve', ['id' => $item['id']], __('Approve')) ?>
        <?= $postButton('/delete', ['id' => $item['id']], __('Delete')) ?>
        <?= $postButton('/delete-by-ip', ['ip' => $item['ip_int']], __('Remove IP')) ?>
    </div>
<?php endforeach; ?>

<div class="mt-4">
    <?php if ($total > $per_page): ?>
        <div><?= $pagination ?></div>
    <?php endif; ?>

    <?php if ($total > 0): ?>
        <div><?= __('Total:') ?> <?= $total ?></div>
        <div class="mt-2 mb-3 d-flex">
            <?= $postButton('/approve-all', [], __('Confirm all'), 'btn btn-primary me-2') ?>
            <?= $postButton('/delete-all', [], __('Delete all'), 'btn btn-danger') ?>
        </div>
    <?php endif; ?>
</div>
<div>
    <a href="/admin/"><?= __('Back') ?></a>
</div>
