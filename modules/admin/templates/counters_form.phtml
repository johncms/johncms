        <input type="radio" id="term3" name="mode" value="2" class="custom-control-input" <?= ($mode === 2 ? 'checked="checked" ' : '') ?>>
        <label class="custom-control-label" for="term3"><?= __('Option 1') ?></label>
    </div>
    <div class="custom-control custom-radio">
        <input type="radio" id="term2" name="mode" value="3" class="custom-control-input" <?= ($mode === 3 ? 'checked="checked" ' : '') ?>>
        <label class="custom-control-label" for="term2"><?= __('Option 2') ?></label>
    </div>

    <div class="custom-control custom-checkbox mt-3">
