        <label class="custom-control-label" for="switch"><?= __('Enabled') ?></label>
    </div>

    <div class="custom-control custom-checkbox mt-3">
        <input type="checkbox" class="custom-control-input" name="require_cookie_consent" value="1" id="require_cookie_consent" <?= $require_cookie_consent ? 'checked="checked"' : '' ?>>
        <label class="custom-control-label" for="require_cookie_consent"><?= __('Load only after cookie consent') ?></label>
    </div>
    <div class="small text-muted">
        <?= __('If enabled, the counter code runs only after the visitor accepts the cookie banner. Requires the cookie banner to be enabled.') ?>
    </div>

    <div class="alert alert-info mb-3 mt-3">
        <div class="fw-bold"><?= __('WARNING!') ?></div>
        <div><?= __('Make sure you have correctly entered the code. It must meet the standard of XML') ?></div>
        <div><?= __('If you click &quot;View&quot; and XHTML errors occured, then click &quot;Back&quot; button in your browser, return to this form and correct the errors.') ?></div>
