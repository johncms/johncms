 * @var bool $require_cookie_consent
 * @var bool $enabled
 * @var int $field_height
 * @var string $csrf_token
 */

$this->layout('system::layout/default');
?>
<form action="<?= $this->e($form_action) ?>" method="post">
    <input type="hidden" name="csrf_token" value="<?= $csrf_token ?>">
    <?php if (! empty($id)): ?>
        <input type="hidden" value="<?= $id ?>" name="id">
    <?php endif; ?>
    <div class="form-group">
        <label for="name"><?= __('Name') ?></label>
        <input type="text" name="name" class="form-control" id="name" value="<?= $this->e($name) ?>" placeholder="<?= __('Name') ?>">
    </div>
    <div class="form-group">
        <label for="link1"><?= __('Option 1') ?></label>
        <textarea class="form-control" rows="<?= $field_height ?>" name="link1" id="link1"><?= $this->e($counter_1) ?></textarea>
        <div class="small text-muted"><?= __('Code for main page') ?></div>
    </div>
    <div class="form-group">
        <label for="link2"><?= __('Option 2') ?></label>
        <textarea class="form-control" rows="<?= $field_height ?>" name="link2" id="link2"><?= $this->e($counter_2) ?></textarea>
        <div class="small text-muted"><?= __('Code for other pages') ?></div>
    </div>

    <h3><?= __('Display mode') ?></h3>
    <div class="custom-control custom-radio">
        <input type="radio" id="mode1" name="mode" value="1" class="custom-control-input"
            <?= ($mode === 0 || $mode === 1 ? 'checked="checked" ' : '') ?>>
        <label class="custom-control-label" for="mode1"><?= __('Default') ?></label>
    </div>
    <div class="small text-muted">
        <?= __('On the main showing option 1, on the other pages option 2.<br>If &quot;option 2&quot; not filled, counter would only appear on the main page.') ?>
    </div>

