<?php

/**
 * @var Mobicms\Render\Template\Template $this
 * @var array<int, array<string, mixed>> $items
 * @var array<int, array{name: string, url: string, active: bool}> $filters
 * @var int $total
 * @var int $per_page
 * @var bool $show_amnesty
 * @var string $amnesty_url
 * @var string $pagination
 */

$this->layout('system::layout/default');
?>
<div class="btn-group btn-group-sm input-group-sm mb-3" role="group">
    <div class="input-group-prepend">
        <div class="input-group-text"><?= __('Sort') ?></div>
    </div>
    <?php foreach ($filters as $filter): ?>
        <a href="<?= $this->e($filter['url']) ?>" class="btn btn-outline-secondary <?= $filter['active'] ? 'active' : '' ?>"><?= $this->e($filter['name']) ?></a>
    <?php endforeach ?>
</div>

<?php if ($items === []): ?>
    <?= $this->fetch('system::app/alert', ['alert_type' => 'alert-info', 'alert' => __('The list is empty')]) ?>
<?php endif ?>

<?php foreach ($items as $item): ?>
    <?= $this->fetch('admin::user_row', ['item' => $item]) ?>
<?php endforeach ?>

<div class="mt-4">
    <?php if ($total > $per_page): ?>
        <div><?= $pagination ?></div>
    <?php endif ?>
    <?php if ($total > 0): ?>
        <div><?= __('Total:') ?> <?= $total ?></div>
        <?php if ($show_amnesty): ?>
            <div class="mt-2 mb-3">
                <a href="<?= $this->e($amnesty_url) ?>" class="btn btn-primary"><?= __('Amnesty') ?></a>
            </div>
        <?php endif ?>
    <?php endif ?>
</div>
<div>
    <a href="/admin"><?= __('Back') ?></a>
</div>
