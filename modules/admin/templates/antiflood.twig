{#
    How often a visitor may post.

    @var array  settings        Current values: mode, day, night, dayfrom, dayto.
    @var array  mode_options    Modes: value, label, hint.
    @var string form_action
    @var string error_message   Empty unless the last save failed.
    @var string success_message Empty unless a save has just succeeded.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger shadow border-0', alert: error_message} only %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-success shadow border-0', alert: success_message} only %}

    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <h3>{{ __('Operation mode') }}</h3>

        {% for option in mode_options %}
            <div class="form-check">
                <input type="radio" class="form-check-input" name="mode" value="{{ option.value }}" id="mode{{ option.value }}"{% if settings.mode == option.value %} checked{% endif %}>
                <label class="form-check-label" for="mode{{ option.value }}">{{ option.label }}</label>
                {% if option.hint %}
                    <div class="text-muted small">{{ option.hint|raw }}</div>
                {% endif %}
            </div>
        {% endfor %}

        <h3 class="mt-3">{{ __('Time limit') }}</h3>
        <div class="form-group">
            <label for="day">{{ __('Day') }}</label>
            <input type="text" name="day" class="form-control" id="day" value="{{ settings.day }}">
        </div>
        <div class="form-group">
            <label for="night">{{ __('Night') }}</label>
            <input type="text" name="night" class="form-control" id="night" value="{{ settings.night }}">
        </div>
        <h3 class="mt-3">{{ __('Day mode') }}</h3>
        <div class="form-group">
            <label for="dayfrom">{{ __('Beginning of day') }}</label>
            <input type="text" name="dayfrom" class="form-control" id="dayfrom" value="{{ settings.dayfrom }}">
        </div>
        <div class="form-group">
            <label for="dayto">{{ __('End of day') }}</label>
            <input type="text" name="dayto" class="form-control" id="dayto" value="{{ settings.dayto }}">
        </div>
        <div class="mt-3">
            <input type="submit" name="submit" value="{{ __('Save') }}" class="btn btn-primary"/>
            <a href="/admin/" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
