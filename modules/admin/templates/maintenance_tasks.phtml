<?php

/**
 * @var Mobicms\Render\Template\Template $this
 * @var list<Johncms\Modules\Admin\Application\DTO\MaintenanceTaskDTO> $tasks
 * @var string $form_action
 * @var string|null $error_message
 * @var string|null $success_message
 * @var string $csrf_token
 */

$this->layout('system::layout/default');

$statusLabels = [
    'queued'  => __('Queued'),
    'running' => __('Running'),
    'done'    => __('Completed'),
    'failed'  => __('Failed'),
];
$statusClasses = [
    'queued'  => 'bg-info',
    'running' => 'bg-warning text-dark',
    'done'    => 'bg-success',
    'failed'  => 'bg-danger',
];
?>
<?php if (! empty($error_message)): ?>
    <div class="alert alert-danger shadow border-0"><?= $this->e($error_message) ?></div>
<?php endif ?>
<?php if (! empty($success_message)): ?>
    <div class="alert alert-success shadow border-0"><?= $this->e($success_message) ?></div>
<?php endif ?>

<div class="alert alert-info shadow border-0">
    <?= __('Background tasks are started by the scheduler within a minute (a configured cron for "schedule:run" is required). Refresh the page to update the status.') ?>
</div>

<?php foreach ($tasks as $task): ?>
    <div class="card mb-3 shadow border-0">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h5 class="card-title mb-0 me-auto"><?= $this->e($task->title) ?></h5>
                <?php if ($task->background): ?>
                    <span class="badge bg-secondary"><?= __('Background') ?></span>
                <?php endif ?>
                <?php if ($task->status !== null): ?>
                    <span class="badge <?= $statusClasses[$task->status] ?? 'bg-secondary' ?>">
                        <?= $this->e($statusLabels[$task->status] ?? $task->status) ?>
                    </span>
                <?php endif ?>
            </div>
            <?php if (! empty($task->description)): ?>
                <div class="text-muted small mt-1"><?= $this->e($task->description) ?></div>
            <?php endif ?>
            <div class="text-muted small mt-1">
                <code><?= $this->e($task->commandName) ?></code>
                <?php if ($task->finishedAt !== null): ?>
                    &middot; <?= __('Last run') ?>: <?= $this->e($task->finishedAt) ?>
                <?php endif ?>
            </div>
            <?php if ($task->output !== ''): ?>
                <details class="mt-2">
                    <summary class="small"><?= __('Last output') ?></summary>
                    <pre class="small text-light p-2 rounded mt-1 mb-0" style="white-space: pre-wrap; background-color: #2d2d2d"><?= $this->e($task->output) ?></pre>
                </details>
            <?php endif ?>
            <form action="<?= $this->e($form_action) ?>" method="post" class="mt-2">
                <input type="hidden" name="csrf_token" value="<?= $csrf_token ?>">
                <input type="hidden" name="command" value="<?= $this->e($task->commandName) ?>">
                <button type="submit" class="btn btn-primary btn-sm" <?= $task->isPending() ? 'disabled' : '' ?>>
                    <?= $task->background ? __('Queue the task') : __('Run') ?>
                </button>
            </form>
        </div>
    </div>
<?php endforeach ?>

<?php if ($tasks === []): ?>
    <div class="alert alert-warning shadow border-0"><?= __('There are no available tasks') ?></div>
<?php endif ?>
