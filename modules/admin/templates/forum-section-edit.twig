{#
    An existing category or section.

    @var array  item           Values of the form, keyed by field name.
    @var array  errors         Validation messages, keyed by field name.
    @var array  categories     Options of the parent select: id, name, selected.
    @var array  access_options Access modes of a section: value, label.
    @var array  type_options   Section types: value, label.
    @var string form_action
    @var string back_url
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}"/>
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors.csrf_token|default([])} only %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors.parent|default([])} only %}

        <div class="form-group">
            <label for="name">{{ __('Title') }}</label>
            <input type="text" name="name" class="form-control{% if errors.name|default([]) is not empty %} is-invalid{% endif %}" id="name" value="{{ item.name }}" placeholder="{{ __('Title') }}" required>
            {% if errors.name|default([]) is not empty %}
                <div class="invalid-feedback d-block">{{ errors.name|join(', ') }}</div>
            {% endif %}
            <div class="text-muted small">{{ __('Min. 2, Max. 150 characters') }}</div>
        </div>

        <div class="form-group">
            <label for="sort">{{ __('Order') }}</label>
            <input type="text" name="sort" class="form-control" id="sort" value="{{ item.sort }}" placeholder="{{ __('Order') }}" required>
            <div class="text-muted small">{{ __('Only numbers') }}</div>
        </div>

        <div class="form-group">
            <label for="description">{{ __('Description') }}</label>
            <textarea class="form-control" rows="2" name="description" id="description">{{ item.description }}</textarea>
            <div class="small text-muted">{{ __('Optional field') }}<br>{{ __('Min. 2, Max. 500 characters') }}</div>
        </div>

        <div class="form-group">
            <label for="meta_description">{{ __('Meta description') }}</label>
            <textarea name="meta_description" class="form-control" id="meta_description" rows="2">{{ item.meta_description }}</textarea>
        </div>
        <div class="form-group">
            <label for="meta_keywords">{{ __('Meta keywords') }}</label>
            <textarea name="meta_keywords" class="form-control" id="meta_keywords" rows="2">{{ item.meta_keywords }}</textarea>
        </div>

        <h3>{{ __('Common access') }}</h3>
        {% for option in access_options %}
            <div class="form-check">
                <input type="radio" id="access{{ option.value }}" name="access" value="{{ option.value }}" class="form-check-input"{% if item.access == option.value %} checked="checked"{% endif %}>
                <label class="form-check-label" for="access{{ option.value }}">{{ option.label }}</label>
            </div>
        {% endfor %}

        <h3 class="mt-3">{{ __('Section type') }}</h3>
        {% for option in type_options %}
            <div class="form-check">
                <input type="radio" id="section_type{{ option.value }}" name="section_type" value="{{ option.value }}" class="form-check-input"{% if item.section_type == option.value %} checked="checked"{% endif %}>
                <label class="form-check-label" for="section_type{{ option.value }}">{{ option.label }}</label>
            </div>
        {% endfor %}

        <div class="form-group">
            <label for="parent" class="h3 mt-3">{{ __('Category') }}</label>
            <select name="parent" id="parent" class="form-control">
                {% for category in categories %}
                    <option value="{{ category.id }}"{% if category.selected %} selected="selected"{% endif %}>{{ category.name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="mt-3">
            <input type="submit" value="{{ __('Save') }}" class="btn btn-primary">
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
