<?php

/**
 * @var Mobicms\Render\Template\Template $this
 * @var bool $edit_form
 * @var string $form_action
 * @var string $back_url
 * @var array<string, mixed> $fields
 * @var array<string, array<int, string>> $errors
 * @var list<string> $contexts
 * @var list<array{code: string, name: string}> $languages
 * @var string $locale
 * @var string $csrf_token
 */

$this->layout('system::layout/default');
?>

<div style="max-width: 720px">
    <form method="post" action="<?= $this->e($form_action) ?>">
        <input type="hidden" name="csrf_token" value="<?= $csrf_token ?>">

        <div class="form-group">
            <label for="context"><?= __('Context') ?></label>
            <input type="text"
                   id="context"
                   name="context"
                   list="context_list"
                   class="form-control <?= isset($errors['context']) ? 'is-invalid' : '' ?>"
                   value="<?= $this->e($fields['context']) ?>">
            <datalist id="context_list">
                <?php foreach ($contexts as $context): ?>
                    <option value="<?= $this->e($context) ?>"></option>
                <?php endforeach ?>
            </datalist>
            <?php if (isset($errors['context'])): ?>
                <div class="invalid-feedback"><?= implode('<br>', $errors['context']) ?></div>
            <?php endif ?>
            <div class="text-muted small"><?= __('Where the consent is shown, e.g. register, feedback, newsletter.') ?></div>
        </div>

        <div class="form-group">
            <label for="language"><?= __('Language') ?></label>
            <select id="language"
                    name="language"
                    class="form-control col-sm-3 <?= isset($errors['language']) ? 'is-invalid' : '' ?>">
                <?php foreach ($languages as $language): ?>
                    <option value="<?= $this->e($language['code']) ?>" <?= $fields['language'] === $language['code'] ? 'selected' : '' ?>>
                        <?= $this->e($language['name']) ?> (<?= $this->e($language['code']) ?>)
                    </option>
                <?php endforeach ?>
            </select>
            <?php if (isset($errors['language'])): ?>
                <div class="invalid-feedback d-block"><?= implode('<br>', $errors['language']) ?></div>
            <?php endif ?>
        </div>

        <div class="form-group">
            <label for="title"><?= __('Title') ?></label>
            <input type="text"
                   id="title"
                   name="title"
                   class="form-control <?= isset($errors['title']) ? 'is-invalid' : '' ?>"
                   value="<?= $this->e($fields['title']) ?>">
            <?php if (isset($errors['title'])): ?>
                <div class="invalid-feedback"><?= implode('<br>', $errors['title']) ?></div>
            <?php endif ?>
        </div>

        <?= $this->fetch('consent::admin/ckeditor', [
            'label'  => __('Text'),
            'name'   => 'text',
            'id'     => 'text',
            'value'  => $this->e($fields['text']),
            'errors' => isset($errors['text']) ? implode(', ', $errors['text']) : '',
            'locale' => $locale,
        ]) ?>

        <div class="form-group">
            <label for="version"><?= __('Version') ?></label>
            <input type="text"
                   id="version"
                   name="version"
                   class="form-control col-sm-3 <?= isset($errors['version']) ? 'is-invalid' : '' ?>"
                   value="<?= $this->e($fields['version']) ?>">
            <?php if (isset($errors['version'])): ?>
                <div class="invalid-feedback"><?= implode('<br>', $errors['version']) ?></div>
            <?php endif ?>
        </div>

        <div class="custom-control custom-checkbox mb-2">
            <input type="checkbox" class="custom-control-input" name="is_required" value="1" id="is_required" <?= $fields['is_required'] ? 'checked' : '' ?>>
            <label class="custom-control-label" for="is_required"><?= __('Required (blocks the form without the checkbox)') ?></label>
        </div>

        <div class="custom-control custom-checkbox mb-3">
            <input type="checkbox" class="custom-control-input" name="is_active" value="1" id="is_active" <?= $fields['is_active'] ? 'checked' : '' ?>>
            <label class="custom-control-label" for="is_active"><?= __('Active') ?></label>
        </div>

        <button type="submit" class="btn btn-primary"><?= __('Save') ?></button>
        <a href="<?= $this->e($back_url) ?>" class="btn btn-secondary"><?= __('Cancel') ?></a>
    </form>
</div>
