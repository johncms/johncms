<?php

/**
 * @var Mobicms\Render\Template\Template $this
 * @var array<int, array<string, mixed>> $items
 * @var string $create_url
 * @var string $log_url
 * @var string $pagination
 * @var string|null $success_message
 */

$this->layout('system::layout/default');
?>

<?php if (! empty($success_message)): ?>
    <div class="alert alert-success shadow border-0"><?= $this->e($success_message) ?></div>
<?php endif ?>

<div class="mb-3">
    <a href="<?= $this->e($create_url) ?>" class="btn btn-primary"><?= __('Add consent') ?></a>
    <a href="<?= $this->e($log_url) ?>" class="btn btn-secondary"><?= __('Consent log') ?></a>
</div>

<?php if (empty($items)): ?>
    <?= $this->fetch('system::app/alert', ['alert_type' => 'alert-info', 'alert' => __('The list is empty')]) ?>
<?php else: ?>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
            <tr>
                <th><?= __('Context') ?></th>
                <th><?= __('Language') ?></th>
                <th><?= __('Title') ?></th>
                <th><?= __('Version') ?></th>
                <th><?= __('Required') ?></th>
                <th><?= __('Active') ?></th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($items as $item): ?>
                <tr>
                    <td><code><?= $this->e($item['context']) ?></code></td>
                    <td><?= $this->e($item['language_name']) ?> (<?= $this->e($item['language']) ?>)</td>
                    <td>
                        <?php if ($item['view_url'] !== null): ?>
                            <a href="<?= $this->e($item['view_url']) ?>" target="_blank"><?= $this->e($item['title']) ?></a>
                        <?php else: ?>
                            <?= $this->e($item['title']) ?>
                        <?php endif ?>
                    </td>
                    <td><?= $this->e($item['version']) ?></td>
                    <td>
                        <?php if ($item['is_required']): ?>
                            <span class="badge text-bg-warning"><?= __('Yes') ?></span>
                        <?php else: ?>
                            <span class="badge text-bg-light border"><?= __('No') ?></span>
                        <?php endif ?>
                    </td>
                    <td>
                        <?php if ($item['is_active']): ?>
                            <span class="badge text-bg-success"><?= __('Yes') ?></span>
                        <?php else: ?>
                            <span class="badge text-bg-secondary"><?= __('No') ?></span>
                        <?php endif ?>
                    </td>
                    <td class="text-nowrap">
                        <a href="<?= $this->e($item['edit_url']) ?>"><?= __('Edit') ?></a>
                        <a href="<?= $this->e($item['delete_url']) ?>" class="text-danger ms-2"><?= __('Delete') ?></a>
                    </td>
                </tr>
            <?php endforeach ?>
            </tbody>
        </table>
    </div>
    <?= $pagination ?>
<?php endif ?>
