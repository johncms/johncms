<?php

/**
 * @var Mobicms\Render\Template\Template $this
 * @var array<int, array<string, mixed>> $items
 * @var string $back_url
 * @var string $pagination
 */

$this->layout('system::layout/default');
?>

<?php if (empty($items)): ?>
    <?= $this->fetch('system::app/alert', ['alert_type' => 'alert-info', 'alert' => __('The list is empty')]) ?>
<?php else: ?>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
            <tr>
                <th>#</th>
                <th><?= __('User') ?></th>
                <th><?= __('Consent') ?></th>
                <th><?= __('Version') ?></th>
                <th><?= __('IP address') ?></th>
                <th><?= __('Date') ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($items as $item): ?>
                <tr>
                    <td><?= (int) $item['id'] ?></td>
                    <td>
                        <?php if ($item['user_id'] !== null): ?>
                            <a href="/profile/<?= (int) $item['user_id'] ?>"><?= (int) $item['user_id'] ?></a>
                        <?php else: ?>
                            <span class="text-muted"><?= __('Guest') ?></span>
                        <?php endif ?>
                    </td>
                    <td>
                        <?= $item['consent_title'] !== null ? $this->e($item['consent_title']) : '#' . (int) $item['consent_id'] ?>
                    </td>
                    <td><?= $this->e($item['version']) ?></td>
                    <td><?= $this->e($item['ip_address']) ?></td>
                    <td><?= $this->e((string) $item['accepted_at']) ?></td>
                </tr>
            <?php endforeach ?>
            </tbody>
        </table>
    </div>
    <?= $pagination ?>
<?php endif ?>

<div class="mt-2">
    <a href="<?= $this->e($back_url) ?>"><?= __('Back') ?></a>
</div>
