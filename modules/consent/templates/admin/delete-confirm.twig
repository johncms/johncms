{#
    Confirmation of deleting a consent.

    @var array  consent     Title, context and version of what is about to be deleted.
    @var string form_action
    @var string back_url
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    <div class="alert alert-warning">
        {{ __('Are you sure you want to delete this consent?') }}
        <div class="mt-2"><strong>{{ consent.title }}</strong>
            ({{ consent.context }}, {{ __('Version') }}: {{ consent.version }})
        </div>
    </div>

    <form method="post" action="{{ form_action }}">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <button type="submit" class="btn btn-danger">{{ __('Delete') }}</button>
        <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
    </form>
{% endblock %}
