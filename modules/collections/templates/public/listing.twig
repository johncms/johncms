{#
    A collection listing: the sections of the current level and the items in it.

    @param list<array{name: string, url: string}>                sections
    @param list<array{name: string, preview: ?Markup, url: string}> items
    @param ?Markup pagination
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if sections is not empty %}
        <div class="list-group mb-3">
            {% for section in sections %}
                <a class="list-group-item list-group-item-action" href="{{ section.url }}">{{ section.name }}</a>
            {% endfor %}
        </div>
    {% endif %}

    {% if items is empty and sections is empty %}
        <div class="alert alert-info">{{ __('The list is empty') }}</div>
    {% else %}
        {% for item in items %}
            <div class="mb-3 pb-2 border-bottom">
                <h3 class="h5 mb-1"><a href="{{ item.url }}">{{ item.name }}</a></h3>
                {% if item.preview %}
                    {# Sanitized by the content formatter of the module, so it stays markup. #}
                    <div class="text-muted">{{ item.preview }}</div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}

    {% if pagination %}
        <div class="mt-3">{{ pagination }}</div>
    {% endif %}
{% endblock %}
