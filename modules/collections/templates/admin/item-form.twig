{#
    An item of a collection, new or existing, together with the fields the collection defines.

    @var string form_action
    @var string back_url
    @var int    id              Null when a new item is being added.
    @var array  fields          Values of the form, keyed by field name.
    @var bool   has_sections
    @var array  section_options Sections to put the item in, keyed by id.
    @var array  field_defs      Fields of the collection: input_name, name, type, multiple, value.
    @var array  errors          Validation messages, empty on the first render.
#}
{% extends '@admin/layouts/default.twig' %}

{% block content %}
    {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger shadow border-0', alert: errors} only %}

    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if id is not null %}
            <input type="hidden" name="id" value="{{ id }}">
        {% endif %}

        <div class="form-group">
            <label for="name">{{ __('Name') }}</label>
            <input type="text" name="name" class="form-control" id="name" value="{{ fields.name }}">
        </div>

        <div class="form-group mt-2">
            <label for="code">{{ __('Code') }}</label>
            <input type="text" name="code" class="form-control" id="code" value="{{ fields.code }}">
            <div class="text-muted small">{{ __('Machine code: lowercase latin letters, digits, hyphen and underscore. Leave empty to generate it from the name automatically') }}</div>
        </div>

        {% if has_sections %}
            <div class="form-group mt-2">
                <label for="section_id">{{ __('Section') }}</label>
                <select name="section_id" class="form-control" id="section_id">
                    <option value="0">{{ __('— none —') }}</option>
                    {% for id, name in section_options %}
                        <option value="{{ id }}"{% if fields.section_id == id %} selected{% endif %}>{{ name }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}

        <div class="form-group mt-2">
            <label for="sort">{{ __('Sorting') }}</label>
            <input type="number" name="sort" class="form-control" id="sort" value="{{ fields.sort }}">
        </div>

        <div class="form-group mt-2">
            <label for="active_from">{{ __('Active from') }}</label>
            <input type="text" name="active_from" class="form-control" id="active_from" placeholder="YYYY-MM-DD HH:MM:SS" value="{{ fields.active_from }}">
        </div>

        <div class="form-group mt-2">
            <label for="active_to">{{ __('Active to') }}</label>
            <input type="text" name="active_to" class="form-control" id="active_to" placeholder="YYYY-MM-DD HH:MM:SS" value="{{ fields.active_to }}">
        </div>

        <div class="form-group mt-2">
            {% include '@theme/components/editor.twig' with {
                name: 'preview_text',
                label: __('Preview text'),
                value: fields.preview_text
            } only %}
        </div>

        <div class="form-group mt-2">
            {% include '@theme/components/editor.twig' with {
                name: 'detail_text',
                label: __('Detail text'),
                value: fields.detail_text
            } only %}
        </div>

        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" name="active" value="1" id="active"{% if fields.active %} checked{% endif %}>
            <label class="form-check-label" for="active">{{ __('Active') }}</label>
        </div>

        {% if field_defs is not empty %}
            <hr>
            <h3 class="h5">{{ __('Fields') }}</h3>
            {% for def in field_defs %}
                {% set input_id = 'f_' ~ def.input_name %}
                {% if def.multiple %}
                    <div class="form-group mt-2">
                        <label for="{{ input_id }}">{{ def.name }}</label>
                        <textarea name="{{ def.input_name }}" class="form-control" id="{{ input_id }}" rows="3">{{ def.value }}</textarea>
                        <div class="text-muted small">{{ __('One value per line') }}</div>
                    </div>
                {% elseif def.type == 'boolean' %}
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" name="{{ def.input_name }}" value="1" id="{{ input_id }}"{% if def.value == '1' %} checked{% endif %}>
                        <label class="form-check-label" for="{{ input_id }}">{{ def.name }}</label>
                    </div>
                {% elseif def.type == 'text' or def.type == 'html' %}
                    <div class="form-group mt-2">
                        <label for="{{ input_id }}">{{ def.name }}</label>
                        <textarea name="{{ def.input_name }}" class="form-control" id="{{ input_id }}" rows="4">{{ def.value }}</textarea>
                    </div>
                {% elseif def.type == 'integer' or def.type == 'double' %}
                    <div class="form-group mt-2">
                        <label for="{{ input_id }}">{{ def.name }}</label>
                        <input type="number"{% if def.type == 'double' %} step="any"{% endif %} name="{{ def.input_name }}" class="form-control" id="{{ input_id }}" value="{{ def.value }}">
                    </div>
                {% else %}
                    <div class="form-group mt-2">
                        <label for="{{ input_id }}">{{ def.name }}</label>
                        <input type="text" name="{{ def.input_name }}" class="form-control" id="{{ input_id }}" value="{{ def.value }}">
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">{{ __('Save') }}</button>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
