{#
    Confirmation of deleting an article.

    @param int    id
    @param string name
    @param string article_url
    @param bool   deleted
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if deleted %}
        <div class="alert alert-success">{{ __('Article "%s" has been deleted.', name) }}</div>
        <div class="mt-3">
            <a href="/library/">{{ __('Back to Library') }}</a>
        </div>
    {% else %}
        <div class="alert alert-danger">
            <div>{{ __('Are you sure you want to delete the article "%s"? This action cannot be undone.', name) }}</div>
            <div class="mt-2">
                <a href="/library/article/{{ id }}/delete?yes" class="btn btn-danger btn-sm">{{ __('Yes, Delete') }}</a>
                <a href="{{ article_url }}" class="btn btn-secondary btn-sm">{{ __('Cancel') }}</a>
            </div>
        </div>
    {% endif %}
{% endblock %}
