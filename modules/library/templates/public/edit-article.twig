{#
    The edit form of an article, and the confirmation that replaces it once the changes are saved.

    @param int          id
    @param bool         saved
    @param string       article_url
    @param string       name
    @param string       announce
    @param string       text
    @param bool         text_editable Very long texts are edited elsewhere, not in the browser.
    @param string       tags
    @param bool         cover
    @param bool         is_admin
    @param array[]      categories    Sections the article may be moved to, admins only.
    @param int          cat_id
    @param bool         premod
    @param bool         comments
    @param int          count_views
    @param int          field_height
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if saved %}
        <div class="alert alert-success">{{ __('Changes saved successfully.') }}</div>
        <div class="mt-2"><a href="{{ article_url }}">{{ __('Back to Article') }}</a></div>
    {% else %}
        <form action="/library/article/{{ id }}/edit" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                {% if cover %}
                    <div><img src="/upload/library/images/big/{{ id }}.png" alt="cover"/></div>
                    <div class="alarm"><a href="/library/article/{{ id }}/image/delete">{{ __('Delete Cover Image') }}</a></div>
                {% endif %}
                <div class="custom-file mt-2">
                    <input type="file" class="custom-file-input" id="image" name="image" aria-describedby="file_label">
                    <label class="custom-file-label" for="image">{{ __('To upload a photo') }}</label>
                </div>
            </div>

            <div class="form-group">
                <label for="name">{{ __('Title') }}</label>
                <input type="text" name="name" class="form-control" id="name"
                       value="{{ name }}"
                       placeholder="{{ __('Title') }}" required>
            </div>

            <div class="form-group">
                <label for="announce">{{ __('Announce') }}</label>
                <textarea class="form-control" rows="{{ field_height }}"
                          name="announce" id="announce">{{ announce }}</textarea>
            </div>

            {% if text_editable %}
                <div class="form-group">
                    {% include '@library/public/components/editor.twig' with {label: __('Text'), value: text} only %}
                </div>
            {% else %}
                <div class="alert alert-info">{{ __('The text of the Article can not be edited, a large amount of data !!!') }}</div>
                <input type="hidden" name="text" value="do_not_change">
            {% endif %}

            <div class="form-group">
                <label for="tags">{{ __('Tags') }}</label>
                <input name="tags" class="form-control" type="text" id="tags" value="{{ tags }}">
            </div>

            {% if is_admin %}
                {% if categories %}
                    <div class="mt-2">
                        <label for="move">{{ __('Move to Section') }}</label>
                        <select name="move" class="form-control" id="move">
                            {% for category in categories %}
                                <option value="{{ category.id }}"{% if category.id == cat_id %} selected{% endif %}>
                                    {{ category.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}

                <div class="custom-control custom-checkbox mt-3">
                    <input type="checkbox" class="custom-control-input" name="premod" value="1" id="premod"{% if premod %} checked{% endif %}>
                    <label class="custom-control-label" for="premod">{{ __('Verified') }}</label>
                </div>
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" name="comments" value="1" id="comments"{% if comments %} checked{% endif %}>
                    <label class="custom-control-label" for="comments">{{ __('Commenting on the Article') }}</label>
                </div>
                <div class="form-group mt-3">
                    <label for="count_views">{{ __('Number of readings') }}</label>
                    <input type="text" name="count_views" id="count_views" class="form-control"
                           value="{{ count_views }}"/>
                </div>
            {% endif %}

            <div class="mt-3">
                <input type="submit" name="submit" value="{{ __('Save') }}" class="btn btn-primary">
                <a href="{{ article_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
            </div>
        </form>
    {% endif %}
{% endblock %}
