{#
    Entry page of the library: the top level sections and the ways into the listings.

    @param int     total
    @param array[] sections
    @param int     new_articles Articles added over the last three days, 0 hides the button.
    @param bool    admin
    @param int     premod_count Articles awaiting moderation.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="mb-2 mt-n2">
        {% if new_articles %}
            <a href="/library/new" class="btn btn-outline-primary btn-sm me-1 mt-1">
                {{ __('New Articles') }} <span class="badge text-bg-secondary rounded-pill ms-1">{{ new_articles }}</span>
            </a>
        {% endif %}
        <a href="/library/search" class="btn btn-outline-primary btn-sm me-1 mt-1">{{ __('Search') }}</a>
        <a href="/library/top" class="btn btn-outline-primary btn-sm me-1 mt-1">{{ __('Rating articles') }}</a>
        <a href="/library/latest-comments" class="btn btn-outline-primary btn-sm me-1 mt-1">{{ __('Latest comments') }}</a>
    </div>

    {% if total %}
        {% for section in sections %}
            <div class="forum-section">
                <div class="section-header d-flex justify-content-between border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <a href="{{ section.url }}" class="text-dark-brown">{{ section.name }}</a>
                        <span class="badge rounded-pill counter-badge border ms-3">{{ section.counter }}</span>
                    </div>
                </div>
                {% if section.description %}
                    <div class="small mt-1 text-muted">
                        <div>{{ section.description }}</div>
                    </div>
                {% endif %}
                {% if admin %}
                    <div class="small pt-1">
                        {% include '@library/public/components/section-admin-panel.twig' with {
                            section_id: 0,
                            section_item_id: section.id,
                            position: section.position,
                            total: total
                        } only %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        <div class="alert alert-info shadow border-0">{{ __('The list is empty') }}</div>
    {% endif %}

    {% if admin %}
        <div class="mt-3">
            <a href="/library/section/create" class="btn btn-primary">{{ __('Create Section') }}</a>
            {% if premod_count %}
                <a href="/library/premod" class="btn btn-warning ms-2">
                    {{ __('Moderation Articles') }} <span class="badge text-bg-dark rounded-pill ms-1">{{ premod_count }}</span>
                </a>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
