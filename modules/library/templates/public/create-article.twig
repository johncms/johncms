{#
    The form a new article is written in, and the confirmation that replaces it once it is saved.

    @param bool         success
    @param bool         approved    Whether the article went live at once or waits for a moderator.
    @param string       form_url
    @param string       cat_url
    @param ?string      article_url Known only after the article is saved.
    @param list<string> errors
    @param string       name
    @param string       announce
    @param string       text
    @param string       tags
    @param int          field_height
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if success %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: __('Article added')} only %}
        {% if approved %}
            <div class="mt-3"><a href="{{ article_url }}">{{ __('To Article') }}</a></div>
        {% else %}
            <div class="alert alert-info mt-2">{{ __('Thank you for what we have written. After checking moderated, your Article will be published in the library.') }}</div>
            <div class="mt-3"><a href="{{ cat_url }}">{{ __('To Section') }}</a></div>
        {% endif %}
    {% else %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors} only %}
        <form name="form" action="{{ form_url }}" method="post" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
            <div class="form-group">
                <label for="name">{{ __('Title') }}</label>
                <input type="text" name="name" class="form-control" id="name" value="{{ name }}" placeholder="{{ __('Title') }}" required>
            </div>

            <div class="form-group">
                <label for="announce">{{ __('Announce') }}</label>
                <textarea class="form-control" rows="{{ field_height }}" name="announce" id="announce">{{ announce }}</textarea>
            </div>

            <div class="form-group">
                {% include '@theme/components/editor.twig' with {name: 'text', label: __('Text'), value: text} only %}
            </div>

            <div class="custom-control custom-checkbox">
                <input type="checkbox" class="custom-control-input" name="comments" value="1" id="comments" checked>
                <label class="custom-control-label" for="comments">{{ __('Commenting on the Article') }}</label>
            </div>

            <div class="custom-file mt-3">
                <input type="file" class="custom-file-input" id="image" name="image" accept="image/*">
                <label class="custom-file-label" for="image">{{ __('To upload a photo') }}</label>
            </div>

            <div class="custom-file mt-3">
                <input type="file" class="custom-file-input" id="textfile" name="textfile" accept="text/plain">
                <label class="custom-file-label" for="textfile">{{ __('Select the text file') }}</label>
                <div class="text-muted small">{{ __('Text entry field will be ignored') }}</div>
            </div>

            <div class="form-group mt-2">
                <label for="tags">{{ __('Tags') }}</label>
                <input name="tags" class="form-control" type="text" id="tags" value="{{ tags }}">
            </div>

            <div class="mt-3">
                <input type="submit" name="submit" value="{{ __('Save') }}" class="btn btn-primary">
                <a href="{{ cat_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
            </div>
        </form>
    {% endif %}
{% endblock %}
