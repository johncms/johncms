<?php

/**
 * @var int    $id
 * @var string $name
 * @var bool   $deleted
 */

$this->layout('system::layout/default');
?>

<?php if ($deleted) : ?>
    <div class="alert alert-success"><?= sprintf(__('Cover image for article "%s" has been deleted.'), $this->e($name)) ?></div>
    <div class="mt-3">
        <a href="/library/article/<?= $id ?>/edit"><?= __('Back to Article') ?></a>
    </div>
<?php else : ?>
    <div class="alert alert-danger">
        <div><?= sprintf(__('Are you sure you want to delete the cover image for article "%s"?'), $this->e($name)) ?></div>
        <div class="mt-2">
            <a href="/library/article/<?= $id ?>/image/delete?yes" class="btn btn-danger btn-sm"><?= __('Yes, Delete') ?></a>
            <a href="/library/article/<?= $id ?>/edit" class="btn btn-secondary btn-sm"><?= __('Cancel') ?></a>
        </div>
    </div>
<?php endif; ?>
