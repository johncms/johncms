$this->layout('system::layout/default');
?>

<div class="mb-3">
    <div><?= __('Sort') ?></div>
    <?php foreach ($data['filters'] as $filter): ?>
        <a href="<?= $filter['url'] ?>" class="btn btn-outline-secondary mt-1 btn-sm <?= ($filter['active'] ? 'active' : '') ?>"><?= $filter['name'] ?></a>
    <?php endforeach; ?>
</div>

<?php if ($total) : ?>
    <?php foreach ($items as $top) : ?>
        <div class="new_post-item without_avatar">
            <a href="<?= $top['url'] ?>" class="post-title"><?= $this->e($top['name']) ?></a>
            <div class="post-body"><?= $this->e($top['announce']) ?></div>
            <div class="text-muted small d-flex align-items-center flex-wrap">
                <div class="me-2">
                    <span><?= __('Section:') ?></span> <a href="<?= $top['cat_url'] ?>"><?= $this->e($top['cat_name']) ?></a>
                </div>
                <div class="me-2">
                    <span><?= __('Author:') ?></span><?= $top['who'] ?>
                </div>
                <div class="d-flex align-items-center me-1">
                    <span class="pe-1"><?= __('Rating:') ?></span><?= $top['ratingView'] ?>
                </div>
                <div>
                    <?php if ($top['comments']) : ?>
                        <a href="/library/article/<?= $top['id'] ?>/comments"><?= __('Comments:') ?></a>
                        (<?= $top['comm_count'] ?>)
                    <?php endif; ?>
                </div>
            </div>
        </div>
    <?php endforeach; ?>
<?php else : ?>
    <div class="row">
        <div class="col-md-5">
            <div class="alert alert-info shadow border-0"><?= __('The list is empty') ?></div>
        </div>
    </div>
<?php endif; ?>
<div class="phdr"><a href="/library/"><?= __('Back') ?></a></div>
