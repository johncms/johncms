            <label for="name"><?= __('Title') ?></label>
            <input type="text" name="name" class="form-control" id="name" value="<?= htmlspecialchars($name) ?>" placeholder="<?= __('Title') ?>" required>
        </div>

        <div class="form-group">
            <label for="announce"><?= __('Announce') ?></label>
            <textarea class="form-control" rows="<?= $user->config->fieldHeight ?>" name="announce" id="announce"><?= htmlspecialchars($announce) ?></textarea>
