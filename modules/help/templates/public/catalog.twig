{#
    A catalogue of sets — of smilies or of avatars.

    @param list<array{url: string, name: string, count: int}> items
    @param string back_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="row">
        <div class="col-md-6">
            {% if items is empty %}
                {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: __('The list is empty')} only %}
            {% else %}
                <div class="list-group">
                    {% for item in items %}
                        <a href="{{ item.url }}" class="list-group-item d-flex justify-content-between align-items-center">
                            {{ item.name }}
                            <span class="badge rounded-pill">{{ item.count }}</span>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
            <div class="mt-3">
                <a href="{{ back_url }}">{{ __('Back') }}</a>
            </div>
        </div>
    </div>
{% endblock %}
