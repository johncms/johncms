{#
    Smilies of one set, with checkboxes to add them to the personal collection.

    @param list<array{lat_smile: string, smile: string, picture: string, can_add: bool}> items
    @param string   form_action
    @param int      user_smilies_current How many the visitor already has.
    @param int      user_smilies_max
    @param int      total
    @param ?Markup  pagination
    @param string   back_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if items is empty %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: __('The list is empty')} only %}
    {% else %}
        {% if app.user.isValid %}<form action="{{ form_action }}" method="post">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">{% endif %}
        <div class="row">
            <div class="col-md-6">
                {% if user_smilies_current|default(0) %}
                    <div class="alert alert-info">
                        <a href="/help/smilies/my/">{{ __('My smilies') }}</a>
                        ({{ user_smilies_current }} / {{ user_smilies_max }})
                    </div>
                {% endif %}

                <div class="list-group">
                    {% for item in items %}
                        <div class="list-group-item d-flex align-items-center">
                            <div class="custom-control custom-checkbox align-items-center me-2">
                                <input type="checkbox" class="custom-control-input" name="add_sm[]"
                                       value="{{ item.lat_smile }}" id="check_{{ item.lat_smile }}"{% if not item.can_add %} disabled{% endif %}>
                                <label class="custom-control-label" for="check_{{ item.lat_smile }}"></label>
                            </div>
                            <div class="me-3">
                                <img src="{{ item.picture }}" alt="{{ item.smile }}">
                            </div>
                            <div>
                                :{{ item.lat_smile }}: {{ __('or') }} :{{ item.smile }}:
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% if app.user.isValid %}
            <div class="mt-3">
                <input type="submit" name="add" value="{{ __('Add') }}" class="btn btn-primary">
            </div>
            </form>
        {% endif %}
    {% endif %}

    {% include '@help/public/components/list-footer.twig' with {pagination: pagination, total: total, back_url: back_url} only %}
{% endblock %}
