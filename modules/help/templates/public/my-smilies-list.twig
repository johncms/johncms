{#
    The personal collection of smilies, with checkboxes to remove them.

    @param list<array{lat_smile: string, smile: string, picture: Markup, can_del: bool}> items
    @param string   form_action
    @param int      total
    @param ?Markup  pagination
    @param string   back_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if items is empty %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: __('The list is empty')} only %}
        <a href="/help/smilies/" class="btn btn-primary mt-3">{{ __('Add Smilies') }}</a>
    {% else %}
        {% if app.user.isValid %}<form action="{{ form_action }}" method="post">{% endif %}
        <div class="row">
            <div class="col-md-6">
                <div class="list-group">
                    {% for item in items %}
                        <div class="list-group-item d-flex align-items-center">
                            <div class="custom-control custom-checkbox align-items-center me-2">
                                <input type="checkbox" class="custom-control-input" name="delete_sm[]"
                                       value="{{ item.lat_smile }}" id="check_{{ item.lat_smile }}"{% if not item.can_del %} disabled{% endif %}>
                                <label class="custom-control-label" for="check_{{ item.lat_smile }}"></label>
                            </div>
                            <div class="me-3">
                                {# The picture is the rendered smiley, an image tag by contract. #}
                                {{ item.picture }}
                            </div>
                            <div>
                                :{{ item.lat_smile }}: {{ __('or') }} {{ item.smile }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% if app.user.isValid %}
            <div class="mt-3">
                <input type="submit" name="delete" value="{{ __('Delete') }}" class="btn btn-primary">
            </div>
            </form>
        {% endif %}
    {% endif %}

    {% include '@help/public/components/list-footer.twig' with {pagination: pagination, total: total, back_url: back_url} only %}
{% endblock %}
