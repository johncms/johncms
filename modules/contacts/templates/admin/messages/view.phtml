<?php

/**
 * @var Mobicms\Render\Template\Template $this
 * @var Johncms\Modules\Contacts\Domain\Models\ContactMessage $message
 * @var bool $is_processed
 * @var string $created_at
 * @var string $processed_at
 * @var string $back_url
 * @var string $process_url
 * @var string $delete_url
 * @var string|null $success_message
 * @var string $csrf_token
 */

$this->layout('system::layout/default');
?>

<?php if (! empty($success_message)): ?>
    <div class="alert alert-success shadow border-0"><?= $this->e($success_message) ?></div>
<?php endif ?>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3"><?= __('Date') ?></dt>
            <dd class="col-sm-9"><?= $this->e($created_at) ?></dd>

            <dt class="col-sm-3"><?= __('Sender') ?></dt>
            <dd class="col-sm-9"><?= $this->e($message->name) ?></dd>

            <dt class="col-sm-3"><?= __('E-mail') ?></dt>
            <dd class="col-sm-9">
                <a href="mailto:<?= $this->e($message->email) ?>"><?= $this->e($message->email) ?></a>
            </dd>

            <dt class="col-sm-3"><?= __('Status') ?></dt>
            <dd class="col-sm-9">
                <?php if ($is_processed): ?>
                    <span class="badge text-bg-success"><?= __('Processed') ?></span>
                    <?php if ($processed_at !== ''): ?>
                        <span class="text-muted small"><?= $this->e($processed_at) ?></span>
                    <?php endif ?>
                <?php else: ?>
                    <span class="badge text-bg-danger"><?= __('New') ?></span>
                <?php endif ?>
            </dd>

            <dt class="col-sm-3"><?= __('IP address') ?></dt>
            <dd class="col-sm-9">
                <?= $this->e($message->ip_address) ?>
                <?php if (! empty($message->user_agent)): ?>
                    <div class="text-muted small"><?= $this->e($message->user_agent) ?></div>
                <?php endif ?>
            </dd>

            <dt class="col-sm-3"><?= __('Message') ?></dt>
            <dd class="col-sm-9 mb-0"><?= nl2br($this->e($message->message)) ?></dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    <a href="<?= $this->e($back_url) ?>" class="btn btn-secondary"><?= __('Back') ?></a>

    <?php if (! $is_processed): ?>
        <form method="post" action="<?= $this->e($process_url) ?>">
            <input type="hidden" name="csrf_token" value="<?= $csrf_token ?>">
            <button type="submit" class="btn btn-primary"><?= __('Mark as processed') ?></button>
        </form>
    <?php endif ?>

    <a href="<?= $this->e($delete_url) ?>" class="btn btn-danger"><?= __('Delete') ?></a>
</div>
