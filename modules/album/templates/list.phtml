/**
 * @var array  $owner
 * @var array  $albums
 * @var int    $total_photos
 * @var string $create_url
 */

// title / page_title are provided globally via Render::addData() in the controller.
$this->layout('system::layout/default');
?>
<div class="mb-3">
    <?= $this->fetch('album::user_row', ['item' => $owner]) ?>
</div>

<?php if (! empty($create_url)): ?>
    <div class="mb-3">
        <a href="<?= $this->e($create_url) ?>" class="btn btn-primary"><?= __('Create Album') ?></a>
    </div>
<?php endif; ?>

<?php foreach ($albums as $album): ?>
    <div class="forum-section mb-2">
        <div class="section-header d-flex justify-content-between <?= (empty($album['description']) ? 'border-0 pb-0' : '') ?>">
            <div class="d-flex align-items-center">
                <a class="user-login me-2" href="<?= $this->e($album['album_url']) ?>"><?= $this->e($album['name']) ?></a>
                <span class="badge rounded-pill text-bg-light border ms-3"><?= $album['count_photos'] ?></span>
            </div>
        </div>
        <?php if (! empty($album['description'])): ?>
            <div class="small pt-1 text-muted">
                <div><?= $this->e($album['description']) ?></div>
            </div>
        <?php endif; ?>
        <?php if (! empty($album['has_edit'])): ?>
            <div class="pt-1 small">
                <form action="<?= $this->e($album['up_url']) ?>" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" value="<?= $this->e($csrf_token) ?>">
                    <button type="submit" class="btn btn-link p-0 me-2 align-baseline"><?= __('Up') ?></button>
                </form>
                <form action="<?= $this->e($album['down_url']) ?>" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" value="<?= $this->e($csrf_token) ?>">
                    <button type="submit" class="btn btn-link p-0 me-2 align-baseline"><?= __('Down') ?></button>
                </form>
                <a href="<?= $this->e($album['edit_url']) ?>" class="me-2"><?= __('Edit') ?></a>
                <a href="<?= $this->e($album['delete_url']) ?>" class="me-2"><?= __('Delete') ?></a>
            </div>
        <?php endif; ?>
    </div>
<?php endforeach; ?>
