/**
 * @var \Johncms\Modules\Album\Application\DTO\PhotoViewDTO[] $photos
 * @var int $total
 * @var int $per_page
 * @var bool $has_add_photo
 * @var string $upload_url
 * @var string $pagination
 */

// title / page_title are provided globally via Render::addData() in the controller.
$this->layout('system::layout/default');
?>
<?php if (empty($photos)): ?>
    <?= $this->fetch(
        'system::app/alert',
        [
            'alert_type' => 'alert-info',
            'alert'      => __('The list is empty'),
        ]
    ) ?>
<?php endif; ?>

<?php if ($has_add_photo): ?>
    <div class="mb-3">
        <a href="<?= $this->e($upload_url) ?>" class="btn btn-primary"><?= __('Add image') ?></a>
    </div>
<?php endif; ?>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-3">
    <?php foreach ($photos as $photo): ?>
        <div class="col mb-4">
            <div class="card py-0 h-100 overflow-hidden">
                <a href="<?= $this->e($photo->detailUrl) ?>">
                    <div class="album-photo" style="background: url('<?= $this->e($photo->previewPicture) ?>');"></div>
                </a>
                <div class="card-body d-flex px-3 flex-column justify-content-between">
                    <?php if ($photo->previewText): ?>
                        <p class="card-text"><?= $this->e($photo->previewText) ?></p>
                    <?php endif ?>
                    <?php if (! empty($photo->userName) || ! empty($photo->albumName)): ?>
                        <div class="small">
                            <span class="text-nowrap pe-2">
                                <?= __('User:') ?> <a href="<?= $this->e($photo->userAlbumsUrl) ?>"><?= $this->e($photo->userName) ?></a>
                            </span>
                            <span class="text-nowrap">
                                <?= __('Album:') ?> <a href="<?= $this->e($photo->userAlbumUrl) ?>"><?= $this->e($photo->albumName) ?></a>
                            </span>
                        </div>
                    <?php endif; ?>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <div>
                        <!-- Vote -->
                        <?php if ($photo->canVote): ?>
                            <a href="<?= $this->e($photo->likeUrl) ?>" class="text-decoration-none pe-2">
                                <svg class="icon download-button-icon mt-n2">
                                    <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#like"></use>
                                </svg>
                                <span><?= $photo->votePlus ?></span>
                            </a>
                            <a href="<?= $this->e($photo->dislikeUrl) ?>" class="text-decoration-none pe-2">
                                <svg class="icon download-button-icon me-1">
                                    <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#dislike"></use>
                                </svg>
                                <span><?= $photo->voteMinus ?></span>
                            </a>
                        <?php else: ?>
                            <div class="d-inline pe-2 text-muted">
                                <svg class="icon download-button-icon mt-n2">
                                    <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#like"></use>
                                </svg>
                                <span><?= $photo->votePlus ?></span>
                            </div>
                            <div class="d-inline pe-2 text-muted">
                                <svg class="icon download-button-icon me-1">
                                    <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#dislike"></use>
                                </svg>
                                <span><?= $photo->voteMinus ?></span>
                            </div>
                        <?php endif; ?>
                        <!-- // Vote -->
                        <a href="<?= $this->e($photo->commentsUrl) ?>" class="text-decoration-none">
                            <svg class="icon download-button-icon" style="margin-top: -2px;">
                                <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#forum"></use>
                            </svg>
                            <span><?= $photo->commCount ?></span>
                        </a>
                    </div>
                    <div>
                        <div class="text-muted">
                            <svg class="icon download-button-icon mt-n1">
                                <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#eye"></use>
                            </svg>
                            <span><?= $photo->views ?></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <?php endforeach; ?>
</div>

<?php if ($total > $per_page): ?>
    <div>
        <?= $pagination ?>
    </div>
<?php endif; ?>

<?php if ($total > 0): ?>
    <div><?= __('Total') ?>: <?= $total ?></div>
<?php endif; ?>
