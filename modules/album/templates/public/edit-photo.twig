{#
    Editing the description of a photo.

    @param string action_url
    @param string back_url
    @param string image_url
    @param string description
    @param int    field_height
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="file_edit_form" action="{{ action_url }}" method="post">
        <div class="mb-3">
            <img src="{{ image_url }}" alt=".">
        </div>

        <div class="form-group">
            <label for="description">{{ __('Description') }}</label>
            <textarea id="description" name="description" class="form-control" rows="{{ field_height }}">{{ description }}</textarea>
        </div>
        <div class="mt-3">
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Save') }}</button>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
