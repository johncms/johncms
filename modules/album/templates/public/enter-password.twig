{#
    Password prompt of a protected album.

    @param string action_url
    @param string back_url
    @param string error_message
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="file_edit_form" action="{{ action_url }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if error_message|default('') %}
            {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger border-0', alert: error_message} only %}
        {% endif %}
        <p>{{ __('You must type a password to view this album') }}</p>
        <div class="form-group">
            <label for="password">{{ __('Password') }}</label>
            <input type="password" class="form-control" id="password"
                   name="password" required>
        </div>

        <div class="mt-3">
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Enter') }}</button>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
