{#
    Moving a photo to another album.

    @param string action_url
    @param string back_url
    @param array  albums
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="file_edit_form" action="{{ action_url }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <div class="form-group">
            <label for="al">{{ __('Select Album') }}</label>
            <select name="al" id="al" class="form-control">
                {% for album in albums %}
                    <option value="{{ album.id }}">{{ album.name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="mt-3">
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Move') }}</button>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
