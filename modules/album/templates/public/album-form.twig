{#
    Creating or editing an album.

    @param string action_url
    @param string back_url
    @param string error_message
    @param array  form_data     name, description, password, access
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="file_edit_form" action="{{ action_url }}" method="post">
        {% if error_message|default('') %}
            {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger border-0', alert: error_message} only %}
        {% endif %}
        <div class="form-group">
            <label for="name">{{ __('Title') }}</label>
            <input type="text" class="form-control" id="name" name="name" value="{{ form_data.name|default('') }}" minlength="3" maxlength="200" required>
        </div>
        <div class="form-group">
            <label for="description">{{ __('Description') }}</label>
            <textarea id="description" name="description" class="form-control" rows="{{ field_height }}">{{ form_data.description|default('') }}</textarea>
        </div>
        <div class="form-group">
            <label for="password">{{ __('Password') }}</label>
            <input type="text" class="form-control" id="password" name="password" value="{{ form_data.password|default('') }}">
        </div>

        <h3>{{ __('Access') }}</h3>

        {% set access = form_data.access|default(0) %}
        <div class="custom-control custom-radio">
            <input type="radio" id="all" name="access" value="4" class="custom-control-input"{% if not access or access == 4 %} checked{% endif %}>
            <label class="custom-control-label" for="all">{{ __('Everyone') }}</label>
        </div>
        <div class="custom-control custom-radio">
            <input type="radio" id="pass" name="access" value="2" class="custom-control-input"{% if access == 2 %} checked{% endif %}>
            <label class="custom-control-label" for="pass">{{ __('With Password') }}</label>
        </div>
        <div class="custom-control custom-radio">
            <input type="radio" id="for_me" name="access" value="1" class="custom-control-input"{% if access == 1 %} checked{% endif %}>
            <label class="custom-control-label" for="for_me">{{ __('Only for me') }}</label>
        </div>

        <div class="mt-3">
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Save') }}</button>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
