/**
 * @var \Johncms\Modules\Album\Application\DTO\PhotoDetailDTO|null $photo
 * @var int $total
 * @var int $per_page
 * @var string $success_message
 * @var string $album_list_url
 * @var string $album_url
 * @var string $pagination
 */

// title / page_title are provided globally via Render::addData() in the controller.
$this->layout('system::layout/default');
?>
<?php if ($photo === null): ?>
    <?= $this->fetch(
        'system::app/alert',
        [
            'alert_type' => 'alert-info',
            'alert'      => __('The list is empty'),
        ]
    ) ?>
<?php endif; ?>
<?php if (! empty($success_message)): ?>
    <?= $this->fetch(
        'system::app/alert',
        [
            'alert_type' => 'alert-success border-0',
            'alert'      => $success_message,
        ]
    ) ?>
<?php endif; ?>
<?php if ($photo !== null): ?>
    <div class="row">
        <div class="col-md-5">
            <a href="<?= $this->e($photo->picture) ?>" title="<?= __('Photo') ?> "
               data-source="<?= $this->e($photo->downloadUrl) ?>" class="image-preview">
                <img src="<?= $this->e($photo->previewPicture) ?>" alt="." class="img-fluid">
            </a>
        </div>
    </div>
    <?php if (! empty($photo->formattedDescription)): ?>
        <div class="description mt-3 border-top pt-3">
            <?= $photo->formattedDescription ?>
        </div>
    <?php endif; ?>
    <div class="text-muted mt-3 mb-3 border-top border-bottom pt-2 pb-2">
        <div><?= __('Views') ?>: <?= $photo->views ?></div>
        <div><?= __('Downloads') ?>: <?= $photo->downloads ?></div>
        <div><?= __('Date') ?>: <?= $this->e($photo->displayDate) ?></div>
        <div>
            <?= __('User') ?>: <a href="<?= $this->e($photo->userAlbumsUrl) ?>"><?= $this->e($photo->userName) ?></a>
        </div>
        <div>
            <?= __('Album') ?>: <a href="<?= $this->e($photo->userAlbumUrl) ?>"><?= $this->e($photo->albumName) ?></a>
        </div>
        <div>
            <span><?= __('Rating') ?>:</span>
            <span class="pe-2 fw-bold"><?= $photo->rating ?></span>
            <!-- Vote -->
            <?php if ($photo->canVote): ?>
                <form action="<?= $this->e($photo->likeUrl) ?>" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" value="<?= $this->e($csrf_token) ?>">
                    <button type="submit" class="btn btn-link text-decoration-none p-0 pe-2 align-baseline">
                        <svg class="icon download-button-icon mt-n2">
                            <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#like"></use>
                        </svg>
                        <span><?= $photo->votePlus ?></span>
                    </button>
                </form>
                <form action="<?= $this->e($photo->dislikeUrl) ?>" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" value="<?= $this->e($csrf_token) ?>">
                    <button type="submit" class="btn btn-link text-decoration-none p-0 pe-2 align-baseline">
                        <svg class="icon download-button-icon me-1">
                            <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#dislike"></use>
                        </svg>
                        <span><?= $photo->voteMinus ?></span>
                    </button>
                </form>
            <?php else: ?>
                <div class="d-inline pe-2 text-muted">
                    <svg class="icon download-button-icon mt-n2">
                        <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#like"></use>
                    </svg>
                    <span><?= $photo->votePlus ?></span>
                </div>
                <div class="d-inline pe-2 text-muted">
                    <svg class="icon download-button-icon me-1">
                        <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#dislike"></use>
                    </svg>
                    <span><?= $photo->voteMinus ?></span>
                </div>
            <?php endif; ?>
            <!-- // Vote -->
        </div>
    </div>

    <div class="border-bottom pb-3">
        <svg class="icon download-button-icon me-1 mt-n1">
            <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#download"/>
        </svg>
        <a href="<?= $this->e($photo->downloadUrl) ?>"><?= __('Download') ?></a>
    </div>

    <?php if ($photo->canComment): ?>
        <div class="mt-3 pb-3 border-bottom">
            <svg class="icon download-button-icon me-1">
                <use xlink:href="<?= $this->asset('icons/sprite.svg') ?>#forum"/>
            </svg>
            <a href="<?= $this->e($photo->commentsUrl) ?>"><?= __('Comments') ?></a> (<?= $photo->commCount ?>)
        </div>
    <?php endif; ?>

    <?php if ($photo->canManage): ?>
        <div class="btn-group mt-3">
            <div class="dropdown">
                <button class="btn btn-danger dropdown-toggle btn-sm" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <?= __('Actions') ?>
                </button>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                    <?php if ($photo->isOwner): ?>
                        <a class="dropdown-item" href="<?= $this->e($photo->addToProfileUrl) ?>">
                            <?= __('Add to Profile') ?>
                        </a>
                    <?php endif; ?>
                    <a class="dropdown-item" href="<?= $this->e($photo->editUrl) ?>"><?= __('Edit') ?></a>
                    <a class="dropdown-item" href="<?= $this->e($photo->moveUrl) ?>"><?= __('Move') ?></a>
                    <a class="dropdown-item" href="<?= $this->e($photo->deleteUrl) ?>"><?= __('Delete') ?></a>
                </div>
            </div>
        </div>
    <?php endif; ?>

<?php endif; ?>

<?php if ($total > $per_page): ?>
    <div class="mt-4">
        <?= $pagination ?>
    </div>
<?php endif; ?>

<?php if ($total > 0): ?>
    <div><?= __('Total') ?>: <?= $total ?></div>
<?php endif; ?>

<div class="mt-2">
    <a href="<?= $this->e($album_url) ?>"><?= __('Back') ?></a><br>
    <a href="<?= $this->e($album_list_url) ?>"><?= __('Album List') ?></a>
</div>
