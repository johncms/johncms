{#
    Body of the language modal, loaded over AJAX — a fragment, so it names no layout.

    @param array languages Available languages, keyed by locale code.
#}
<div class="modal-header align-items-center">
    <h4 class="modal-title">
        {{ __('Select language') }}
    </h4>
    <button type="button" class="btn btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <form action="/language/" method="post" name="select_language">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% for code, language in languages %}
            <div class="custom-control custom-radio mb-2">
                <input type="radio" id="lang_{{ code }}" name="setlng" class="form-check-input custom-control-input" value="{{ code }}"{% if code == app.locale %} checked{% endif %}>
                <label class="form-check-label custom-control-label ms-2" for="lang_{{ code }}">
                    <img class="icon icon-flag" src="{{ asset('images/flags/' ~ code|lower ~ '.svg') }}" alt=".">
                    {{ language.name }}
                </label>
            </div>
        {% endfor %}
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-primary select_language">{{ __('Apply') }}</button>
</div>
