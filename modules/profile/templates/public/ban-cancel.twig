{#
    Confirmation of lifting a ban or clearing the ban history.

    @param string message
    @param string form_action
    @param string submit_name
    @param string back_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <div>
            {{ message }}
        </div>
        <div class="mt-3">
            <input type="submit" name="submit" value="{{ submit_name }}" class="btn btn-primary"/>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
