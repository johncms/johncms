{#
    Addresses the user has visited from.

    @param string   message
    @param iterable items
    @param int      total
    @param ?Markup  pagination
    @param string   back_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if message|default('') %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-info', alert: message} only %}
    {% endif %}
    <table class="table table-striped">
        <thead>
        <tr class="bg-secondary text-white">
            <th>{{ __('IP address') }}</th>
            <th>{{ __('Date') }}</th>
        </tr>
        </thead>
        <tbody>
        {% if items is empty %}
            <tr>
                <td colspan="2" class="text-center">
                    {{ __('The list is empty') }}
                </td>
            </tr>
        {% endif %}
        {% for item in items %}
            <tr>
                <td><a href="{{ item.search_url }}">{{ item.ip }}</a></td>
                <td>{{ item.display_date }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% include '@profile/public/components/list-footer.twig' with {pagination: pagination, total: total, back_url: back_url} only %}
{% endblock %}
