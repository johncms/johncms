{#
    Confirming that a new password may be generated.

    @param string form_action
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form action="{{ form_action }}" method="post">
        <div class="alert alert-info">
            {{ __('A new password will be generated and sent to the E-mail address specified in your profile.') }}
        </div>
        <input type="submit" value="{{ __('Continue') }}" class="btn btn-primary"/>
    </form>
{% endblock %}
