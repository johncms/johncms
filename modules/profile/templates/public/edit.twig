{#
    Editing a profile.

    @param array  user            Attributes of the profile being edited.
    @param array  form_data       Current values of the form.
    @param array  errors          Validation messages, keyed by field.
    @param string success_message
    @param string form_action
    @param string back_url
    @param bool   has_avatar
    @param int    field_height
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% set is_self = app.user.isValid and app.user.id == user.id %}
    {% set is_admin = app.user.isValid and app.user.rights >= 7 %}

    {% if success_message|default('') %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}
    {% endif %}
    {% if errors.csrf_token is defined %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-danger', alert: errors.csrf_token} only %}
    {% endif %}

    <div class="border-0">
        <form action="{{ form_action }}" method="post">
            <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}"/>
            <div class="pb-2">
                <div>
                    {{ __('Username') }}: <b>{{ user.name_lat }}</b>
                </div>

                {% if is_admin %}
                    <div class="form-group">
                        <label for="name">{{ __('Nickname') }}</label>
                        <input type="text"
                               class="form-control {{ errors.name is defined ? 'is-invalid' }}"
                               name="name"
                               id="name"
                               value="{{ form_data.name }}"
                               required
                               placeholder="{{ __('Nickname') }}"
                               maxlength="20"
                               minlength="2"
                        >
                        {% include '@theme/components/field-errors.twig' with {errors: errors.name|default([])} only %}
                        <div class="small text-muted">{{ __('Min.2, Max. 20') }}</div>
                    </div>
                {% else %}
                    <div>
                        {{ __('Nickname') }}: <b>{{ user.name }}</b>
                    </div>
                {% endif %}
                <div class="form-group">
                    <label for="status">{{ __('Status') }}</label>
                    <input type="text"
                           class="form-control {{ errors.status is defined ? 'is-invalid' }}"
                           name="status"
                           id="status"
                           value="{{ form_data.status }}"
                           placeholder="{{ __('Status') }}"
                           maxlength="50"
                    >
                    {% include '@theme/components/field-errors.twig' with {errors: errors.status|default([])} only %}
                    <div class="small text-muted">{{ __('Max. 50') }}</div>
                </div>
                <div class="mb-3">
                    <div class="mb-2">
                        {{ __('Avatar') }}
                    </div>
                    <div class="user-avatar">
                        <div class="avatar-image rounded-circle overflow-hidden shadow">
                            <img src="{{ avatar(user.id) }}" class="img-fluid" alt="">
                        </div>
                    </div>
                    <div class="mt-2">
                        <a href="/profile/{{ user.id }}/edit/avatar" class="btn btn-primary btn-sm">{{ __('Upload') }}</a>
                        {% if is_self %}
                            <a href="/help/avatars/" class="btn btn-primary btn-sm">{{ __('Select in Catalog') }}</a>
                        {% endif %}
                        {% if has_avatar %}
                            <button type="submit" formaction="/profile/{{ user.id }}/edit/delete-avatar" formmethod="post" formnovalidate class="btn btn-danger btn-sm">{{ __('Delete') }}</button>
                        {% endif %}
                    </div>
                </div>

                <div class="mb-3">
                    <div class="mb-2">
                        {{ __('Photo') }}
                    </div>
                    {% if user.photo.photo_preview|default('') %}
                        <div class="mb-2">
                            <a href="{{ user.photo.photo }}" title="{{ __('Photo') }} "
                               data-source="{{ user.photo.photo }}" class="image-preview">
                                <img src="{{ user.photo.photo_preview }}" class="img-thumbnail" alt=".">
                            </a>
                        </div>
                    {% endif %}
                    <div class="mt-2">
                        <a href="/profile/{{ user.id }}/edit/photo" class="btn btn-primary btn-sm">{{ __('Upload') }}</a>
                        {% if user.photo.photo_preview|default('') %}
                            <button type="submit" formaction="/profile/{{ user.id }}/edit/delete-photo" formmethod="post" formnovalidate class="btn btn-danger btn-sm">{{ __('Delete') }}</button>
                        {% endif %}
                    </div>
                </div>

                <h3>{{ __('Personal info') }}</h3>

                <div class="form-group">
                    <label for="imname">{{ __('Your name') }}</label>
                    <input type="text"
                           class="form-control {{ errors.imname is defined ? 'is-invalid' }}"
                           name="imname"
                           id="imname"
                           value="{{ form_data.imname }}"
                           placeholder="{{ __('Your name') }}"
                    >
                    {% include '@theme/components/field-errors.twig' with {errors: errors.imname|default([])} only %}
                </div>

                <div class="form-group">
                    <label for="day">{{ __('Date of birth (d.m.y)') }}</label>
                    <div class="form-row align-items-center">
                        <div class="col">
                            <input type="text" id="day" value="{{ form_data.dayb }}" size="2" placeholder="{{ __('Day') }}"
                                   maxlength="2" name="dayb" class="form-control {{ errors.dayb is defined ? 'is-invalid' }}">
                            {% include '@theme/components/field-errors.twig' with {errors: errors.dayb|default([])} only %}
                        </div>
                        <div class="col flex-grow-0">-</div>
                        <div class="col">
                            <input type="text" value="{{ form_data.monthb }}" size="2" maxlength="2" name="monthb" placeholder="{{ __('Month') }}"
                                   class="form-control {{ errors.monthb is defined ? 'is-invalid' }}">
                            {% include '@theme/components/field-errors.twig' with {errors: errors.monthb|default([])} only %}
                        </div>
                        <div class="col flex-grow-0">-</div>
                        <div class="col">
                            <input type="text" value="{{ form_data.yearofbirth }}" size="4" maxlength="4" name="yearofbirth" placeholder="{{ __('Year') }}"
                                   class="form-control {{ errors.yearofbirth is defined ? 'is-invalid' }}">
                            {% include '@theme/components/field-errors.twig' with {errors: errors.yearofbirth|default([])} only %}
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="live">{{ __('City, Country') }}</label>
                    <input type="text"
                           class="form-control {{ errors.live is defined ? 'is-invalid' }}"
                           name="live"
                           id="live"
                           value="{{ form_data.live }}"
                           placeholder="{{ __('City, Country') }}"
                    >
                    {% include '@theme/components/field-errors.twig' with {errors: errors.live|default([])} only %}
                </div>
                <div class="form-group">
                    <label for="about">{{ __('About myself') }}</label>
                    <textarea id="about" rows="{{ field_height }}" class="form-control" name="about">{{ form_data.about }}</textarea>
                </div>

                <h3>{{ __('Contacts') }}</h3>
                <div class="form-group">
                    <label for="mibile">{{ __('Phone number') }}</label>
                    <input type="text"
                           class="form-control {{ errors.mibile is defined ? 'is-invalid' }}"
                           name="mibile"
                           id="mibile"
                           value="{{ form_data.mibile }}"
                           placeholder="{{ __('Phone number') }}"
                    >
                    {% include '@theme/components/field-errors.twig' with {errors: errors.mibile|default([])} only %}
                </div>
                <div class="form-group">
                    <label for="mail">{{ __('E-mail') }}</label>
                    <input type="email"
                           class="form-control {{ errors.mail is defined ? 'is-invalid' }}"
                           name="mail"
                           id="mail"
                           value="{{ form_data.mail }}"
                           placeholder="{{ __('E-mail') }}"
                    >
                    {% include '@theme/components/field-errors.twig' with {errors: errors.mail|default([])} only %}
                    {% if user.new_email|default('') %}
                        <div class="alert alert-danger mt-3">
                            {{ __('The new email address is:') }} <b>{{ user.new_email }}</b><br>
                            {{ __('Please check your email and confirm it.') }}
                        </div>
                    {% endif %}
                </div>
                <div class="custom-control custom-checkbox">
                    <input type="hidden" name="mailvis" value="0">
                    <input type="checkbox" class="custom-control-input" name="mailvis" value="1" id="mailvis"{% if form_data.mailvis %} checked{% endif %}>
                    <label class="custom-control-label" for="mailvis">{{ __('Show in Profile') }}</label>
                </div>
                <div class="small text-muted">{{ __('Warning! Write your e-mail correctly. Your password will be sent to the email address on record for this account.') }}</div>

                <div class="form-group mt-2">
                    <label for="skype">{{ __('Skype') }}</label>
                    <input type="text"
                           class="form-control {{ errors.skype is defined ? 'is-invalid' }}"
                           name="skype"
                           id="skype"
                           value="{{ form_data.skype }}"
                           placeholder="{{ __('Skype') }}"
                    >
                    {% include '@theme/components/field-errors.twig' with {errors: errors.skype|default([])} only %}
                </div>

                <div class="form-group">
                    <label for="www">{{ __('Site') }}</label>
                    <input type="text"
                           class="form-control {{ errors.www is defined ? 'is-invalid' }}"
                           name="www"
                           id="www"
                           value="{{ form_data.www }}"
                           placeholder="{{ __('Site') }}"
                    >
                    {% include '@theme/components/field-errors.twig' with {errors: errors.www|default([])} only %}
                </div>

                {% if is_admin %}
                    <h3>{{ __('Administrative Functions') }}</h3>

                    <div class="form-group">
                        <label for="admin_notes">{{ __('Admin notes') }}</label>
                        <textarea id="admin_notes" rows="{{ field_height }}" class="form-control" name="admin_notes">{{ form_data.admin_notes }}</textarea>
                    </div>

                    <div class="custom-control custom-checkbox">
                        <input type="hidden" name="karma_off" value="0">
                        <input type="checkbox" class="custom-control-input" name="karma_off" value="1" id="karma_off"{% if form_data.karma_off %} checked{% endif %}>
                        <label class="custom-control-label" for="karma_off">{{ __('Prohibit Karma') }}</label>
                    </div>
                    <div class="mt-2 mb-3">
                        <a href="/profile/{{ user.id }}/password" class="btn btn-outline-primary btn-sm">{{ __('Change Password') }}</a>
                        {% if app.user.rights > user.rights %}
                            <button type="submit" formaction="/profile/{{ user.id }}/reset-settings" formmethod="post" formnovalidate class="btn btn-outline-primary btn-sm">{{ __('Reset User options to default') }}</button>
                        {% endif %}
                    </div>

                    <h3>{{ __('Select gender') }}</h3>
                    <div class="custom-control custom-radio">
                        <input type="radio" id="m" name="sex" value="m" class="custom-control-input"{% if form_data.sex == 'm' %} checked="checked"{% endif %}>
                        <label class="custom-control-label" for="m">{{ __('Man') }}</label>
                    </div>
                    <div class="custom-control custom-radio">
                        <input type="radio" id="zh" name="sex" value="zh" class="custom-control-input"{% if form_data.sex == 'zh' %} checked="checked"{% endif %}>
                        <label class="custom-control-label" for="zh">{{ __('Woman') }}</label>
                    </div>

                    {% if not is_self %}
                        <h3 class="mt-3">{{ __('Position on the Site') }}</h3>
                        {% set roles = [
                            {id: 'user', value: 0, name: __('User')},
                            {id: 'fmod', value: 3, name: __('Forum Moderator')},
                            {id: 'dmod', value: 4, name: __('Download Moderator')},
                            {id: 'lmod', value: 5, name: __('Library Moderator')},
                            {id: 'smod', value: 6, name: __('Super Moderator')}
                        ] %}
                        {% if app.user.rights == 9 %}
                            {% set roles = roles|merge([
                                {id: 'adm', value: 7, name: __('Administrator')},
                                {id: 'sv', value: 9, name: __('Supervisor')}
                            ]) %}
                        {% endif %}
                        {% for role in roles %}
                            <div class="custom-control custom-radio">
                                <input type="radio" id="{{ role.id }}" name="rights" value="{{ role.value }}" class="custom-control-input"{% if form_data.rights == role.value %} checked="checked"{% endif %}>
                                <label class="custom-control-label" for="{{ role.id }}">{{ role.name }}</label>
                            </div>
                        {% endfor %}
                    {% endif %}
                {% endif %}

                <div class="mt-3">
                    <input type="submit" name="submit" value="{{ __('Save') }}" class="btn btn-primary"/>
                    <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
                </div>
            </div>
        </form>
    </div>
{% endblock %}
