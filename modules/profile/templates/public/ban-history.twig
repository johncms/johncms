{#
    Bans a user has received.

    @param string   user_name
    @param iterable items
    @param int      total
    @param ?Markup  pagination
    @param string   clear_history_url Empty when the visitor may not clear it.
    @param string   back_url
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <h4>{{ __('User:') }} {{ user_name }}</h4>
    {% if total %}
        {% for item in items %}
            <div class="user-row card shadow border-0 mb-2">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="overflow-auto flex-grow-1">
                            <div class="user-name d-flex align-items-center">
                                <span class="user-login me-2">{{ item.ban_type_name }}</span>
                                <span class="text-muted">{{ item.ban_started }}</span>
                                {% if item.remain %}
                                    <span class="badge bg-danger rounded-pill ms-auto">{{ __('Active') }}</span>
                                {% endif %}
                            </div>
                            <div>
                                {{ item.reason_formatted }}
                            </div>
                            <div class="text-muted small mb-2">
                                {% if app.user.isValid and app.user.rights > 0 %}
                                    <div>
                                        {{ __('Blocked by:') }}: {{ item.ban_who }}
                                    </div>
                                {% endif %}
                                <div>
                                    {{ __('Time:') }} {{ item.time_name }}
                                </div>
                                {% if item.remain %}
                                    <div>
                                        {{ __('Remains:') }} {{ item.remain }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div>
                        {% for button in item.buttons|default([]) %}
                            <a href="{{ button.url }}" class="btn btn-primary btn-sm">{{ button.name }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <div class="row">
            <div class="col-md-6">
                <div class="alert alert-info">{{ __('List is empty') }}</div>
            </div>
        </div>
    {% endif %}

    {% if total %}
        <div>
            <div>{{ __('Total') }}: {{ total }}</div>
            {% if pagination %}
                <div class="mt-1">{{ pagination }}</div>
            {% endif %}
        </div>
    {% endif %}

    {% if clear_history_url|default('') %}
        <div class="mt-2">
            <a href="{{ clear_history_url }}" class="btn btn-danger btn-sm">{{ __('Clear history') }}</a>
        </div>
    {% endif %}

    <div class="mt-3">
        <div>
            <a href="{{ back_url }}">{{ __('Back') }}</a>
        </div>
    </div>
{% endblock %}
