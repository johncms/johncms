{#
    Who may write to the visitor.

    @param array  buttons
    @param string success_message
    @param string form_action
    @param array  set_mail_user
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% include '@profile/public/components/settings-tabs.twig' with {buttons: buttons} only %}

    {% if success_message|default('') %}
        {% include '@theme/components/alert.twig' with {alert_type: 'alert-success', alert: success_message} only %}
    {% endif %}
    <form action="{{ form_action }}" method="post">
        <h3>{{ __('Who can write you?') }}</h3>

        <div class="custom-control custom-radio">
            <input type="radio" id="access1" name="access" value="0" class="custom-control-input"{% if not set_mail_user.access %} checked="checked"{% endif %}>
            <label class="custom-control-label" for="access1">{{ __('All can write') }}</label>
        </div>
        <div class="custom-control custom-radio">
            <input type="radio" id="access2" name="access" value="1" class="custom-control-input"{% if set_mail_user.access == 1 %} checked="checked"{% endif %}>
            <label class="custom-control-label" for="access2">{{ __('Only my contacts') }}</label>
        </div>

        <div class="mt-3">
            <input type="submit" name="submit" value="{{ __('Save') }}" class="btn btn-primary"/>
            <a href="/profile/account" class="btn btn-secondary">{{ __('Cancel') }}</a>
        </div>
    </form>
{% endblock %}
