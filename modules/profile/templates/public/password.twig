{#
    Changing the password.

    @param string form_action
    @param string back_url
    @param bool   show_old_password_field
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if show_old_password_field %}
            <div class="form-group">
                <label for="oldpass">{{ __('Enter old password') }}</label>
                <input type="password"
                       class="form-control"
                       name="oldpass"
                       id="oldpass"
                       value=""
                       placeholder="{{ __('Enter old password') }}"
                >
            </div>
        {% endif %}

        <div class="form-group">
            <label for="newpass">{{ __('Enter new password') }}</label>
            <input type="password"
                   class="form-control"
                   name="newpass"
                   id="newpass"
                   value=""
                   placeholder="{{ __('Enter new password') }}"
            >
        </div>
        <div class="form-group">
            <label for="newconf">{{ __('Repeat password') }}</label>
            <input type="password"
                   class="form-control"
                   name="newconf"
                   id="newconf"
                   value=""
                   placeholder="{{ __('Repeat password') }}"
            >
        </div>

        <input type="submit" name="submit" value="{{ __('Save') }}" class="btn btn-primary"/>
        <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Cancel') }}</a>
    </form>
{% endblock %}
