{#
    Search results, by words or by tag.

    @param ?iterable articles   Null when nothing has been searched for yet.
    @param ?Markup   pagination
    @param string    query      What has been searched for.
    @param string    form_action
    @param string    form_field
    @param string    form_placeholder
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div>
        {% include '@news/public/components/search-form.twig' with {
            action: form_action,
            field: form_field,
            placeholder: form_placeholder,
            value: query
        } only %}
    </div>
    <div>
        {% if articles is not null and articles|length > 0 %}
            {% for article in articles %}
                {% include '@news/public/components/article-row.twig' with {article: article} only %}
            {% endfor %}
            {% if pagination %}
                <div class="mt-3">
                    {{ pagination }}
                </div>
            {% endif %}
        {% else %}
            <div class="alert alert-info">{{ __('The search didn\'t yield any results.') }}</div>
        {% endif %}
    </div>
{% endblock %}
