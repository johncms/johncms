{#
    Attaching a file to a post, and the answer after it has been attached.

    @var action_url    string
    @var back_url      string
    @var file_attached bool
    @var max_size      int    Allowed size of the file, in kilobytes.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if file_attached %}
        <div class="alert alert-success">
            {{ __('File attached') }}
        </div>
        <div class="mt-3">
            <a href="{{ action_url }}" class="btn btn-primary">{{ __('Add more') }}</a>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Back to topic') }}</a>
        </div>
    {% else %}
        <form name="new_topic" action="{{ action_url }}" method="post" enctype="multipart/form-data">
            <div class="input-group">
                <div class="custom-file">
                    <input type="file" class="custom-file-input" id="fail" name="fail" aria-describedby="file_label" required>
                    <label class="custom-file-label" for="fail">{{ __('Choose file') }}</label>
                </div>
            </div>
            <div class="text-muted mb-3 small">
                {{ __('Max. Size') }}: {{ max_size }} kb.
            </div>
            <div>
                <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Upload') }}</button>
                <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Back to topic') }}</a>
            </div>
        </form>
    {% endif %}
{% endblock %}
