{#
    Writing a message into a topic: a new one, a reply or a quote.

    @var form_action string
    @var back_url    string
    @var token       string One-time token of the form, kept in the session.
    @var topic_name  string
    @var msg         string Body of the message, prefilled for a reply and a quote.
    @var add_file    bool   The visitor asked to attach a file after writing.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="message_form" action="{{ form_action }}" method="post">
        <input type="hidden" name="token" value="{{ token }}">
        <div class="h4">{{ __('Topic') }}: {{ topic_name }}</div>

        {% include '@forum/public/components/editor.twig' with {
            label: __('Message'),
            value: msg,
            errors: ''
        } only %}
        <div class="custom-control custom-checkbox mb-3">
            <input type="checkbox" class="custom-control-input" name="addfiles" value="1" id="addfiles"{% if add_file %} checked="checked"{% endif %}>
            <label class="custom-control-label" for="addfiles">{{ __('Add File') }}</label>
        </div>
        <div>
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Write') }}</button>
        </div>
        <div class="mt-3">
            <a href="/help/?act=smileys" class="pe-2">{{ __('Smilies') }}</a> <a href="{{ back_url }}">{{ __('Back') }}</a>
        </div>
    </form>
{% endblock %}
