{#
    Confirmation of deleting the poll of a topic.

    @var delete_url string
    @var back_url   string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="alert alert-danger">
        <div class="pb-2">
            {{ __('Do you really want to delete a poll?') }}
        </div>
        <div>
            <a href="{{ delete_url }}" class="me-2 btn btn-danger btn-sm">{{ __('Delete') }}</a>
            <a href="{{ back_url }}" class="me-2 btn btn-primary btn-sm">{{ __('Cancel') }}</a>
        </div>
    </div>
{% endblock %}
