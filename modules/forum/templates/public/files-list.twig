{#
    Files of one kind attached in the forum, each with the post it came with.

    @var files         array        Rows of the listing, post_text is markup.
    @var total         int
    @var pagination    \Twig\Markup Null when everything fits on one page.
    @var new_url       string
    @var new_count     int
    @var back_url      string
    @var back_url_name string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if new_count|default(0) %}
        <div class="border-top border-bottom mb-3">
            <div class="py-3">
                <a href="{{ new_url }}">{{ __('New Files') }}</a>
                <span class="badge rounded-pill bg-danger">{{ new_count }}</span>
            </div>
        </div>
    {% endif %}

    {% if files is empty %}
        <div class="alert alert-info">
            {{ __('The list is empty') }}
        </div>
    {% endif %}

    <div>
        {% for file in files %}
            <div class="new_post-item border-bottom shadow mb-2">
                <div class="new_post-header d-flex justify-content-between">
                    <div class="post-user">
                        {% if file.user_profile_link %}
                            <a href="{{ file.user_profile_link }}">
                                <div class="avatar">
                                    <img src="{{ avatar(file.user_id) }}" class="img-fluid" alt=".">
                                </div>
                            </a>
                        {% else %}
                            <div class="avatar">
                                <img src="{{ avatar(file.user_id) }}" class="img-fluid" alt=".">
                            </div>
                        {% endif %}
                        <span class="user-status {{ file.user_is_online ? 'online' : 'offline' }} shadow"></span>
                        {% if file.user_rights_name %}
                            <div class="post-of-user"
                                 data-bs-toggle="tooltip"
                                 data-bs-placement="top"
                                 data-bs-html="true"
                                 title="{{ file.user_rights_name }}">
                                <svg class="icon-post">
                                    <use xlink:href="{{ asset('icons/sprite.svg') }}?4#check"/>
                                </svg>
                            </div>
                        {% endif %}
                    </div>
                    <div class="flex-grow-1 post-user d-flex flex-wrap overflow-hidden d-flex align-items-center">
                        <div class="w-100">
                            {% if file.user_profile_link %}
                                <a href="{{ file.user_profile_link }}"><span class="user-name d-inline me-2">{{ file.user_name }}</span></a>
                            {% else %}
                                <div class="user-name d-inline me-2">{{ file.user_name }}</div>
                            {% endif %}
                            <a href="{{ file.post_url|default('') }}"
                               class="post-meta d-inline me-2"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="{{ __('Link to post') }}">
                                {{ file.post_time }}
                            </a>
                        </div>
                        {% if file.status %}
                            <div class="overflow-hidden text-nowrap text-dark-brown overflow-ellipsis small">
                                <span class="fw-bold">{{ file.status }}</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="post-body">
                    {{ file.post_text }}
                </div>
                <div class="pt-1 pb-1">
                    <div class="d-flex flex-wrap pt-2">
                        <div class="attached-file pe-3 d-flex flex-column justify-content-between">
                            <div class="d-flex justify-content-center align-items-center">
                                {% if file.file_preview %}
                                    <a href="{{ file.file_url }}" class="image-preview" data-source="{{ file.file_url }}" title="{{ file.filename }}">
                                        <img src="{{ file.file_preview }}" class="img-thumbnail thumb-limit-height" alt="{{ file.filename }}">
                                    </a>
                                {% else %}
                                    <a href="{{ file.file_url }}">
                                        <svg class="icon attachment-icon">
                                            <use xlink:href="{{ asset('icons/sprite.svg') }}#file"/>
                                        </svg>
                                    </a>
                                {% endif %}
                            </div>
                            <div class="pt-1">
                                <div class="text-muted small d-flex flex-wrap justify-content-center">
                                    <div class="text-nowrap pe-1">
                                        <svg class="icon downloads-icon">
                                            <use xlink:href="{{ asset('icons/sprite.svg') }}#download"/>
                                        </svg>
                                        {{ file.dlcount }}
                                    </div>
                                    <div>({{ file.file_size }}&nbsp;kb)</div>
                                </div>
                                <div class="file-name">
                                    <a href="{{ file.file_url }}" title="{{ file.filename }}">{{ file.filename }}</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% if file.post_url|default('') or file.topic_url|default('') %}
                    <div class="post-footer d-flex">
                        <div class="ms-auto">
                            {% if file.post_url|default('') %}
                                <a href="{{ file.post_url }}" class="ms-2">{{ __('To message') }}</a>
                            {% endif %}
                            {% if file.topic_url|default('') %}
                                <a href="{{ file.topic_url }}" class="ms-2">{{ __('To topic') }}</a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <div class="mb-3">
        <div>{{ __('Total') }}: {{ total }}</div>
        {% if pagination %}
            <div class="mt-1">{{ pagination }}</div>
        {% endif %}
    </div>

    {% if back_url %}
        <div class="mb-3">
            <a href="{{ back_url }}">{{ back_url_name }}</a><br>
            <a href="/forum/">{{ __('Forum') }}</a>
        </div>
    {% endif %}
{% endblock %}
