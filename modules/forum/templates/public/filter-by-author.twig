{#
    Choosing the authors whose posts stay visible in a topic.

    @var set_filter_action   string
    @var clear_filter_action string
    @var back_url            string
    @var list                array  user_id, user_name, count
    @var selected_user_ids   array  Identifiers already saved in the session.
    @var saved               bool
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% if saved %}
        <div class="alert alert-success">{{ __('Changes saved') }}</div>
    {% endif %}
    <form action="{{ set_filter_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        {% if list is empty %}
            <div class="alert alert-info">
                {{ __('The list is empty') }}
            </div>
        {% else %}
            <div class="alert alert-warning mb-3 shadow">{{ __('Filter will be display posts from selected authors only') }}</div>
            <div class="card shadow mb-3">
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        {% for item in list %}
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="custom-control custom-checkbox">
                                    <input class="custom-control-input" type="checkbox" name="users[]" value="{{ item.user_id }}"
                                           id="user_{{ item.user_id }}"{% if item.user_id in selected_user_ids %} checked{% endif %}>
                                    <label class="custom-control-label" for="user_{{ item.user_id }}">{{ item.user_name }}</label>
                                </div>
                                <div class="badge rounded-pill text-bg-secondary">{{ item.count }}</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
        <div>
            {% if list %}
                <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Filter') }}</button>
                {% if selected_user_ids %}
                    <button type="submit" formaction="{{ clear_filter_action }}" class="btn btn-outline-secondary">{{ __('Cancel Filter') }}</button>
                {% endif %}
            {% endif %}
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Back to topic') }}</a>
        </div>
    </form>
{% endblock %}
