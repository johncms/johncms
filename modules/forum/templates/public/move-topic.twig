{#
    Moving a topic: the sections of the current category, and the other categories to open instead.

    @var form_action       string
    @var back_url          string
    @var current_section   \Johncms\Modules\Forum\Domain\Models\ForumSection
    @var current_sections  array Sections of the category being looked at.
    @var other_categories  array
    @var other_category_url_prefix string Link of a category, its identifier is appended.
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="move_topic" class="card card-body shadow" action="{{ form_action }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <div class="mb-2">
            <div>{{ __('Category') }}</div>
            <b>{{ current_section.name }}</b>
        </div>
        {% if current_sections %}
            <div class="form-group">
                <label for="section">{{ __('New section') }}</label>
                <select class="form-control" name="razd" id="section">
                    {% for section in current_sections %}
                        <option value="{{ section.id }}">{{ section.name }}</option>
                    {% endfor %}
                </select>
            </div>
        {% else %}
            <div class="alert alert-warning">
                {{ __('Category is empty') }}
            </div>
        {% endif %}
        <div>
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Move') }}</button>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Back to topic') }}</a>
        </div>
        {% if other_categories %}
            <div class="mt-4">
                <div class="h4">{{ __('Other categories') }}</div>
                <ul class="list-group list-group-flush">
                    {% for category in other_categories %}
                        <li class="list-group-item">
                            <a href="{{ other_category_url_prefix }}{{ category.id }}">{{ category.name }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </form>
{% endblock %}
