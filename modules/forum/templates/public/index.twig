{#
    The root of the forum: the categories with their sections.

    @var sections     iterable Categories, each with its subsections loaded.
    @var online       array    online_u, online_g
    @var files_count  int
    @var unread_count int
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    {% include '@forum/public/components/header.twig' with {
        unread_count: unread_count,
        files_count: files_count,
        files_url: '/forum/files/',
        files_name: __('Files')
    } only %}

    {% for section in sections %}
        <div class="forum-section">
            <div class="section-header">
                <div class="d-flex align-items-center">
                    <a href="{{ section.url }}" class="section-name">{{ section.name }}</a>
                    <span class="badge rounded-pill counter-badge ms-3">{{ section.section_type ? section.topics_count : section.subsections_count }}</span>
                </div>
                {% if section.subsections_count %}
                    <div class="toggle d-flex flex-grow-1 justify-content-end align-items-center pe-2 collapsed cursor-pointer"
                         data-bs-toggle="collapse" data-bs-target="#subsections_{{ section.id }}" aria-expanded="false" aria-controls="subsections">
                        <svg class="icon icon-chevron-bottom text-dark-brown">
                            <use xlink:href="{{ asset('icons/sprite.svg') }}#chevron-bottom"/>
                        </svg>
                    </div>
                {% endif %}
            </div>
            {% if section.subsections_count %}
                <div class="collapse subsections" id="subsections_{{ section.id }}">
                    <div class="pt-2">
                        {% for subsection in section.subsections %}
                            <span class="pe-2">&raquo;</span><a href="{{ subsection.url }}" class="text-dark-brown">{{ subsection.name }}</a><br>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            {% if section.description %}
                <div class="small pt-2 text-muted">{{ section.description }}</div>
            {% endif %}
        </div>
    {% endfor %}

    {% include '@forum/public/components/footer.twig' with {
        online: online,
        who_url: '/forum/visitors/',
        who_name: __('Who in Forum')
    } only %}
{% endblock %}
