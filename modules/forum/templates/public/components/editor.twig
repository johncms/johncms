{#
    The message editor of the forum, as a Vue component. Uploading is on: a post carries files.

    @var label  string
    @var value  string
    @var errors string Messages of the field, already joined into one line.
#}
{% if app.locale != 'en' and asset_exists('ckeditor5/translations/' ~ app.locale ~ '.js') %}
    <script src="{{ asset('ckeditor5/translations/' ~ app.locale ~ '.js', true) }}"></script>
{% endif %}
<script src="{{ asset('ckeditor5/ckeditor.js', true) }}"></script>
<div class="vue_app">
    <ckeditor-input-component
        upload_url="/forum/upload_file/"
        name="msg"
        language="{{ app.locale }}"
        errors="{{ errors|default('') }}"
        id="msg"
        label="{{ label }}"
        value="{{ value|default('') }}"
        :allow_upload="true"
    ></ckeditor-input-component>
</div>
