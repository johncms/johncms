{#
    Adding a poll to a topic. The number of answers is changed by submitting the same form.

    @var action_url string
    @var back_url   string
    @var poll_name  string
    @var count_vote int    Answer fields on the form, from 2 to 20.
    @var votes      array  input_name, input_label, input_value
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <form name="new_topic" action="{{ action_url }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
        <input type="hidden" name="count_vote" value="{{ count_vote }}">
        <div class="form-group">
            <label for="name_vote">{{ __('Poll') }}</label>
            <input type="text" class="form-control" id="name_vote" placeholder="{{ __('Poll') }}"
                   name="name_vote" value="{{ poll_name }}" maxlength="200" required>
            <div class="small text-muted">{{ __('Maximum length: 200 characters') }}</div>
        </div>

        <h4>{{ __('Answers') }}</h4>
        {% for vote in votes %}
            <div class="form-group">
                <label for="vote_{{ vote.input_name }}">{{ vote.input_label }}</label>
                <input type="text" class="form-control" id="vote_{{ vote.input_name }}" placeholder="{{ vote.input_label }}"
                       name="{{ vote.input_name }}" value="{{ vote.input_value }}" maxlength="150">
                <div class="small text-muted">{{ __('Maximum length: 150 characters') }}</div>
            </div>
        {% endfor %}

        <div class="mb-4">
            {% if count_vote < 20 %}
                <button type="submit" name="plus" value="1" class="btn btn-outline-primary btn-sm">{{ __('Add Answer') }}</button>
            {% endif %}
            {% if count_vote > 2 %}
                <button type="submit" name="minus" value="1" class="btn btn-outline-danger btn-sm">{{ __('Delete last') }}</button>
            {% endif %}
        </div>
        <div>
            <button type="submit" name="submit" value="1" class="btn btn-primary">{{ __('Save') }}</button>
            <a href="{{ back_url }}" class="btn btn-secondary">{{ __('Back to topic') }}</a>
        </div>
    </form>
{% endblock %}
