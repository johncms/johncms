{#
    Confirmation of deleting a file attached to a post.

    @var delete_action string
    @var back_url      string
#}
{% extends '@theme/layouts/default.twig' %}

{% block content %}
    <div class="alert alert-danger">
        <div class="pb-2">
            {{ __('Do you really want to delete?') }}
        </div>
        <div>
            <form action="{{ delete_action }}" method="post">
                <input type="hidden" name="csrf_token" value="{{ app.csrf_token }}">
                <button type="submit" name="delfile" value="1" class="btn btn-danger btn-sm">{{ __('Delete') }}</button>
                <a href="{{ back_url }}" class="btn btn-outline-secondary btn-sm">{{ __('Cancel') }}</a>
            </form>
        </div>
        <div class="mt-2 text-muted small">
            {{ __('After deleting, one point will be subtracted from the counter of forum posts') }}
        </div>
    </div>
{% endblock %}
