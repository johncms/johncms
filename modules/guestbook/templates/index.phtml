        'system::app/alert',
        [
            'alert_type' => 'alert-success',
            'alert'      => $data['message'],
        ]
    ) ?>
<?php endif; ?>
<?php if ($data['can_write']): ?>
    <div class="row">
        <div class="col-12">
            <?php if (! empty($data['errors']['csrf_token'])): ?>
