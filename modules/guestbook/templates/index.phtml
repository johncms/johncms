                        <?php if (! empty($data['errors']['name'])): ?>
                            <div class="invalid-feedback d-block"><?= implode(', ', $data['errors']['name']) ?></div>
                        <?php endif ?>
                    </div>
                <?php endif; ?>
                <?= $this->fetch(
                    'guestbook::ckeditor',
                    [
                        'label'  => __('Message'),
                        'errors' => implode(', ', $data['errors']['message'] ?? []),
