#: install/steps/step_2.php:30
#, php-format
msgid "The PHP version must be at least %s"
msgstr "Versiunea PHP trebuie să fie cel puțin %s"

#: install/steps/step_2.php:34
#: install/steps/step_2.php:40
#: install/steps/step_2.php:46
#: install/steps/step_2.php:52
#: install/steps/step_2.php:58
