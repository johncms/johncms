#: install/steps/step_2.php:36
msgid "PHP extension PDO must be installed"
msgstr "Extensia PHP PDO trebuie instalată"

#: install/steps/step_2.php:39
msgid "Imagick or GD extension"
msgstr "Imagine sau extensie GD"

#: install/steps/step_2.php:42
msgid "You must install the php extension Imagick or GD"
msgstr "Trebuie să instalaţi php extension Imagick sau GD"

#: install/steps/step_2.php:45
msgid "zlib extension"
msgstr "extensie zlib"

#: install/steps/step_2.php:48
msgid "PHP extension zlib must be installed"
msgstr "Extensia PHP zlib trebuie instalată"

#: install/steps/step_2.php:51
msgid "mbstring extension"
msgstr "Extensie mbstring"

#: install/steps/step_2.php:54
msgid "PHP extension mbstring must be installed"
msgstr "Extensia PHP trebuie instalată"

#: install/steps/step_2.php:57
msgid "fileinfo extension"
msgstr "extensie fileinfo"

#: install/steps/step_2.php:60
msgid "PHP extension fileinfo must be installed"
msgstr "Fisierul extensiei PHP trebuie instalat"

#: install/steps/step_3.php:124
msgid "Correct work of JohnCMS is not guaranteed on your version of mysql server.<br>You can ignore this warning at your own risk."
msgstr "Funcționarea corectă a JohnCMS nu este garantată pe versiunea ta de server mysql.<br>Poți ignora această avertizare pe propriul risc."

#: install/steps/step_3.php:125
#, php-format
msgid "Server name: <b>%s</b>. <br>Your mysql server version is <b>%s</b>. But <b>%s</b> is required."
msgstr "Numele serverului: <b>%s</b>. <br>Versiunea serverului mysql este <b>%s</b>. Dar <b>%s</b> este necesară."

#: install/steps/step_3.php:129
msgid "The system requires a properly configured <a href='https://www.php.net/manual/en/intro.mysqlnd.php' target='_blank'>MySQL Native Driver (mysqlnd)</a>."
msgstr "Sistemul necesită configurarea corectă a <a href='https://www.php.net/manual/en/intro.mysqlnd.php' target='_blank'>Driver nativ MySQL (mysqlnd)</a>."

#: install/steps/step_3.php:130
msgid "Please contact your hosting provider's technical support to resolve this issue."
msgstr "Vă rugăm să contactați asistența tehnică a furnizorului dvs. de găzduire pentru a rezolva această problemă."

#: install/steps/step_3.php:134
msgid "ERROR: Can't write database.local.php"
msgstr "EROARE: Nu se poate scrie baza de date.local.php"

#: install/steps/step_3.php:140
msgid "Invalid database host name"
msgstr "Nume gazdă bază de date nevalid"

#: install/steps/step_3.php:142
msgid "Invalid database user or password"
msgstr "Utilizator sau parolă invalidă pentru baza de date"

#: install/steps/step_3.php:144
msgid "Database does not exist"
msgstr "Baza de date nu există"

#: install/steps/step_4.php:167
msgid "ERROR: Can't write system.local.php"
msgstr "EROARE: Nu se poate scrie system.local.php"

#: install/steps/step_5.php:15
#: install/steps/step_5.php:16
msgid "Complete the installation"
msgstr "Finalizează instalarea"

#: install/templates/step_1.phtml:3
msgid "Welcome to JohnCMS installation wizard"
msgstr "Bine ați venit la asistentul pentru instalarea JohnCMS"

#: install/templates/step_1.phtml:6
msgid "During the installation process, a basic check of the hosting will be performed for compliance with the CMS requirements."
msgstr "În timpul procesului de instalare, se va efectua o verificare de bază a găzduirii pentru a se asigura conformitatea cu cerințele CMS."

#: install/templates/step_1.phtml:7
msgid "If errors occurred during the installation stage and you do not know how to solve them, you can ask for help on <a href=\"https://johncms.com/forum/\" class=\"text-underline\" rel=\"nofollow\" target=\"_blank\">our forum.</a>"
msgstr "Dacă au apărut erori în timpul etapei de instalare și nu știți cum să le rezolvați, poți cere ajutor în <a href=\"https://johncms.com/forum/\" class=\"text-underline\" rel=\"nofollow\" target=\"_blank\">forumul nostru.</a>"

